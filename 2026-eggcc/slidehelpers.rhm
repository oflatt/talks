#lang rhombus
import:
  slideshow open   // re-exports pict + pict/text
  draw
  "write.rhm" open

// Ported from ../talks/2022-explanations-talk/slidehelpers.rkt, and rebuilt on
// `write.rhm`: every shape here is drawn from a path it knows, so a press can trace
// its outline and sweep its fill in, and every word in it is text that writes.

export:
  make_bubble
  make_arrow
  make_gear
  bubble_shape
  Spike
  rounded_path
  arrow_path
  callout
  multi_callout
  reword_between
  outline_to_header
  section_header
  clamp01
  lerp
  smooth
  arrow
  arrows
  arrow_morph
  fade_in
  pale
  border_width
  corner_radius
  talk_blue
  talk_light_blue
  talk_green
  talk_red

def border_width = 3
def corner_radius = -0.15            // negative = fraction of the smaller side

// COLORS
def talk_blue = draw.Color(38, 132, 235)
def talk_light_blue = talk_blue.scale(2)
def talk_green = draw.Color("green").scale(0.5)
def talk_red = draw.Color("red")

fun pale(c :: draw.Color) :: draw.Color:
  c.scale(4)

fun gap_stack(child :: Pict, ...) :: Pict:
  stack.left(~sep: slide.gap, child, ...)

fun shape_size(content :: Pict,
               width :: maybe(Real), height :: maybe(Real),
               padding :: Real):
  values(width || (content.width + padding * 2),
         height || (content.height + padding * 2))

// `rectangle`'s `~rounded` is a fraction of the smaller side when negative; a path
// wants pixels.
fun absolute_radius(r :: Real, w :: Real, h :: Real) :: Real:
  if r < 0 | -r * math.min(w, h) | r

// ---------------------------------------------------------------------------
// The one shape every bubble is: a rounded body, with any number of spikes growing
// out of its sides to the things it is about.
//
// A spike leaves a `side` of the body (`#'top`, `#'right`, `#'bottom`, `#'left`),
// centred `base` along that side from its top or left, and runs out to its tip --
// all in the body's own coordinates, so a tip is usually outside the body. The path
// goes out to the tip and back, so the base is never drawn: the outline itself
// protrudes, which is what makes it one shape rather than a box with a triangle
// stuck on.
class Spike(side, base :: Real, tip_x :: Real, tip_y :: Real)

// The path, and how the body sits inside the picture it needs: `(ox, oy)` is the
// body's top-left corner in the picture, and `(W, H)` the picture's size, grown to
// hold every tip.
fun bubble_shape(~width: w :: Real, ~height: h :: Real,
                 ~radius: r :: Real,
                 ~spikes: spikes :: List = [],
                 ~base: half_base :: Real = 15.0):
  def xs = [0.0, w] ++ (for List (s :~ Spike in spikes): s.tip_x)
  def ys = [0.0, h] ++ (for List (s :~ Spike in spikes): s.tip_y)
  def min_x = for values(m :~ Real = 0.0) (v :~ Real in xs): math.min(m, v)
  def max_x = for values(m :~ Real = w) (v :~ Real in xs): math.max(m, v)
  def min_y = for values(m :~ Real = 0.0) (v :~ Real in ys): math.min(m, v)
  def max_y = for values(m :~ Real = h) (v :~ Real in ys): math.max(m, v)
  def ox = -min_x
  def oy = -min_y
  // where a quarter circle's bezier handles go, from the corner it rounds
  def c = r * (1.0 - 0.5523)
  fun at(x :: Real, y :: Real): [x + ox, y + oy]
  fun on_side(side, ~reverse: rev :: Boolean = #false) :: List:
    def picked = for List (s :~ Spike in spikes): keep_when s.side == side; s
    def sorted = picked.sort(fun (a :~ Spike, b :~ Spike): a.base < b.base)
    if rev | sorted.reverse() | sorted
  def pth = draw.Path()
  fun spikes_along(items :: List, in_edge, out_edge):
    for (s :~ Spike in items):
      pth.line_to(in_edge(s.base))
      pth.line_to(at(s.tip_x, s.tip_y))
      pth.line_to(out_edge(s.base))
  // clockwise from the top-left corner
  pth.move_to(at(r, 0))
  spikes_along(on_side(#'top),
               fun (b): at(b - half_base, 0), fun (b): at(b + half_base, 0))
  pth.line_to(at(w - r, 0))
  pth.curve_to(at(w - c, 0), at(w, c), at(w, r))
  spikes_along(on_side(#'right),
               fun (b): at(w, b - half_base), fun (b): at(w, b + half_base))
  pth.line_to(at(w, h - r))
  pth.curve_to(at(w, h - c), at(w - c, h), at(w - r, h))
  spikes_along(on_side(#'bottom, ~reverse: #true),
               fun (b): at(b + half_base, h), fun (b): at(b - half_base, h))
  pth.line_to(at(r, h))
  pth.curve_to(at(c, h), at(0, h - c), at(0, h - r))
  spikes_along(on_side(#'left, ~reverse: #true),
               fun (b): at(0, b + half_base), fun (b): at(0, b - half_base))
  pth.line_to(at(0, r))
  pth.curve_to(at(0, c), at(c, 0), at(r, 0))
  pth.close()
  values(pth, ox, oy, max_x - min_x, max_y - min_y)

// A plain rounded rectangle, as a path.
fun rounded_path(w :: Real, h :: Real, r :: Real) :: draw.Path:
  def (pth, _, _, _, _) = bubble_shape(~width: w, ~height: h, ~radius: r)
  pth

// The bubble's shell in the deck's clothes: pale fill, saturated border, drawn from
// its path so that a press can write it.
fun bubble_shell(w :: Real, h :: Real, r :: Real, line_color :: draw.Color,
                 ~spikes: spikes :: List = [], ~base: half_base :: Real = 15.0):
  def (pth, ox, oy, W, H) = bubble_shape(~width: w, ~height: h, ~radius: r,
                                         ~spikes: spikes, ~base: half_base)
  values(written_shape(pth, ~width: W, ~height: H,
                       ~fill: pale(line_color), ~line: line_color,
                       ~line_width: border_width),
         ox, oy)

// ---------------------------------------------------------------------------
// Rewording: a bubble whose words change while its shell stays.
//
// A bubble remembers how it was built -- what shell it draws at a size, what is in
// it, and where that goes -- so that two bubbles of the same family can be played
// one into the other: the old words unwrite, the shell eases to the new size, and
// the new words write. `magic_between` asks for this when a key is drawn as one
// bubble in one frame and another in the next.
class Reword(kind, color :: draw.Color,
             shell_at :: Function.of_arity(2),
             content :: Pict, width :: Real, height :: Real,
             place :: Function.of_arity(3))

fun reworded(p :: Pict, r :: Reword) :: Pict:
  p.set_metadata(p.metadata() ++ { #'reword: r })

fun reword_of(p :: Pict) :: maybe(Reword):
  def m = p.metadata()
  if m.has_key(#'reword) | m[#'reword] | #false

fun same_color(a :: draw.Color, b :: draw.Color) :: Boolean:
  a.red == b.red && a.green == b.green && a.blue == b.blue

// The press from bubble `a` to bubble `b`, as one animated pict, or `#false` when
// they are not the same kind of thing.
fun reword_between(a :: Pict, b :: Pict, ~extent: extent :: Real = 1.0) :: maybe(Pict):
  def ra = reword_of(a)
  def rb = reword_of(b)
  cond
  | !(ra && rb): #false
  | (ra :~ Reword).kind != (rb :~ Reword).kind: #false
  | !same_color((ra :~ Reword).color, (rb :~ Reword).color): #false
  | ~else:
      def ra2 :~ Reword = ra
      def rb2 :~ Reword = rb
      def same_words = words_of(ra2.content) == words_of(rb2.content)
      def wa = writer(ra2.content)
      def wb = writer(rb2.content)
      animate(~extent: extent, ~bend: fun (x): x,
              fun (t):
                def s = smooth(t)
                def w = lerp(ra2.width, rb2.width, s)
                def h = lerp(ra2.height, rb2.height, s)
                def shell :~ Pict = rb2.shell_at(w, h)
                // The same words in a shell of another size -- a box made room for
                // something else in it -- keep their words and only the shell moves.
                def (words, r):
                  cond
                  | same_words: values(rb2.content, rb2)
                  | t < 0.5: values(wa.frame(1.0 - 2.0 * t), ra2)
                  | ~else: values(wb.frame(2.0 * t - 1.0), rb2)
                def [dx, dy] = (r :~ Reword).place(w, h, (r :~ Reword).content)
                overlay(~horiz: #'left, ~vert: #'top, ~dx: dx, ~dy: dy, shell, words)
                  .refocus(shell))

// ---------------------------------------------------------------------------
// A rounded rectangle around `child`s: pale fill, saturated border. Written, the
// outline is traced, the fill sweeps in under it, and then whatever is inside is
// written in turn -- `write` finds the parts. A child that animates already is
// played after the shell has been drawn, in its own epochs, which is what makes
// `make_bubble` compose with the rest of the pict vocabulary.
fun make_bubble(~width: width :: maybe(Real) = #false,
                ~height: height :: maybe(Real) = #false,
                ~padding: padding :: Real = 30,
                ~color: color :: draw.Color || String = talk_blue,
                child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  def (w, h) = shape_size(settled(content), width, height, padding)
  fun shell_at(w :: Real, h :: Real) :: Pict:
    def (shell, _, _) = bubble_shell(w, h, absolute_radius(corner_radius, w, h), line_color)
    shell
  fun place(w :: Real, h :: Real, c :: Pict) :: List:
    [(w - c.width) / 2, (h - c.height) / 2]
  def shell = shell_at(w, h)
  // centred by `overlay` rather than at a measured offset, so that a child whose
  // size changes as it plays stays in the middle of the shell at every frame
  fun over(c :: Pict) :: Pict:
    overlay(shell, c).refocus(shell)
  def whole = reworded(over(content),
                       Reword(#'bubble, line_color, shell_at, content, w, h, place))
  if moving(content)
  | // the shell writes itself around the room the content will take, and then the
    // content plays; `~join: #'splice` makes those one press
    switch(write(over(content.snapshot(0, 0).ghost())), whole, ~join: #'splice)
  | whole

// ---------------------------------------------------------------------------
// A fat arrow in the same clothes as `make_bubble`: pale fill, saturated border,
// and whatever it is labelled with written inside its shaft rather than beside it.
// A step in a diagram that a bubble points at, or that a bubble is, should not have
// to be drawn as a different kind of thing from the boxes it runs between.
//
// `head` is how much of the width the point takes and `shaft` how much of the
// height the bar is, so the same call gives a stubby arrow or a long one depending
// only on what is written in it.
fun arrow_path(w :: Real, h :: Real, ~head: head :: Real, ~shaft: shaft :: Real,
               ~facing: facing = #'right) :: draw.Path:
  def hw = w * head                     // the point
  def sy0 = (h - h * shaft) / 2         // and the bar it grows out of
  def sy1 = sy0 + h * shaft
  fun x(v :: Real) :: Real: if facing == #'left | w - v | v
  def p = draw.Path()
  p.move_to([x(0), sy0])
  p.line_to([x(w - hw), sy0])
  p.line_to([x(w - hw), 0])
  p.line_to([x(w), h / 2])
  p.line_to([x(w - hw), h])
  p.line_to([x(w - hw), sy1])
  p.line_to([x(0), sy1])
  p.close()
  p

fun make_arrow(~width: width :: maybe(Real) = #false,
               ~height: height :: maybe(Real) = #false,
               ~padding: padding :: Real = 20,
               ~color: color :: draw.Color || String = talk_blue,
               ~head: head :: Real = 0.34,
               ~shaft: shaft :: Real = 0.62,
               child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  // wide enough that the label fits the part of the shape it is centred in, with
  // `padding` either side of it -- see `place` below for which part that is
  def w = width || ((content.width + 2 * padding) / (1 - head * shaft))
  def h = height || ((content.height + 2 * padding) / shaft)
  fun shell_at(w :: Real, h :: Real) :: Pict:
    written_shape(arrow_path(w, h, ~head: head, ~shaft: shaft),
                  ~width: w, ~height: h,
                  ~fill: pale(line_color), ~line: line_color, ~line_width: border_width)
  // Across: the bar, plus the wedge of the point that is still at least as tall as
  // the bar. Not the whole shape -- the point tapers to nothing, so the room beside
  // a label centred on the bounding box is flat and empty on its left and a closing
  // taper on its right, and the label reads as shoved at the point. Not the bar
  // alone either, which reads as shoved the other way. The wedge is where the
  // point's edge, from (w - hw, 0) to (w, h/2), passes the top of the bar at `sy0`:
  // that is `w - hw * shaft`, since `2 * sy0 / h` is `1 - shaft`.
  //
  // Down the descent, not down the whole box: a line of text is as tall as its font,
  // and what is drawn of it stops at the baseline unless something in it has a tail.
  // Centring the box therefore hangs the letters half a descent high -- which on a
  // label of capitals and x-height, which is what these are, is the whole of what
  // makes it look off centre.
  fun place(w :: Real, h :: Real, c :: Pict) :: List:
    def text_w = w - w * head * shaft
    [(text_w - c.width) / 2, (h - (c.height - c.descent)) / 2]
  def shell = shell_at(w, h)
  def [dx, dy] = place(w, h, content)
  reworded(overlay(~horiz: #'left, ~vert: #'top, ~dx: dx, ~dy: dy, shell, content)
             .refocus(shell),
           Reword(#'arrow, line_color, shell_at, content, w, h, place))

// A cog, for the step of a picture that is a machine rather than a thing: teeth
// round a pale body, in the same colours as the bubbles. Two shapes, so that the
// body is drawn and then the hub: the hub is a ring on the body, not a hole in it.
fun make_gear(~size: size :: Real = 120,
              ~teeth: teeth :: Int = 10,
              ~color: color :: draw.Color || String = talk_blue,
              ~depth: depth :: Real = 0.24,
              ~hub: hub :: Real = 0.34) :: Pict:
  def line_color = as_color(color)
  def r_out = size / 2
  def r_in = r_out * (1 - depth)
  def step = 2 * math.pi / teeth
  fun at_angle(rad :: Real, a :: Real) :: List:
    [r_out + rad * math.cos(a), r_out + rad * math.sin(a)]
  def body:
    def p = draw.Path()
    for (i in 0..teeth):
      def a = i * step
      // one tooth: out along the top of it, down the far side, and round the root
      def corners:
        [[r_out, a], [r_out, a + step * 0.32],
         [r_in, a + step * 0.5], [r_in, a + step * 0.82]]
      for ([rad, ang] in corners, k in 0..):
        def pt = at_angle(rad, ang)
        if i == 0 && k == 0 | p.move_to(pt) | p.line_to(pt)
    p.close()
    p
  def hole:
    def p = draw.Path()
    p.ellipse([r_out - r_out * hub, r_out - r_out * hub, 2 * r_out * hub, 2 * r_out * hub])
    p
  overlay(written_shape(body, ~width: size, ~height: size,
                        ~fill: pale(line_color), ~line: line_color, ~line_width: border_width),
          written_shape(hole, ~width: size, ~height: size,
                        ~line: line_color, ~line_width: border_width))

// ---------------------------------------------------------------------------
// Callouts: a bubble with a spike, aimed at something already placed on `on`.

// One spike, from whichever side `spike` names, to the point `at` finds on `on`.
// The body sits `~reach` past the point, centred on it along the side it leaves.
fun callout(~on: on :: Pict,
            ~at: at :: Find,
            ~spike: spike = #'s,
            ~color: color :: draw.Color || String = talk_blue,
            ~padding: padding :: Real = 14,
            ~reach: reach :: Real = 30,
            ~corner_radius: cr :: Real = corner_radius,
            child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  def (tx, ty) = at.in(on)
  def w = content.width + 2 * padding
  def h = content.height + 2 * padding
  // where the body's top-left goes, and the spike that meets the point from it
  def (bx, by, sp):
    match spike
    | #'w: values(tx + reach, ty - h / 2, Spike(#'left, h / 2, -reach, h / 2))
    | #'e: values(tx - reach - w, ty - h / 2, Spike(#'right, h / 2, w + reach, h / 2))
    | #'n: values(tx - w / 2, ty + reach, Spike(#'top, w / 2, w / 2, -reach))
    | #'s: values(tx - w / 2, ty - reach - h, Spike(#'bottom, w / 2, w / 2, h + reach))
    | ~else: error(~who: #'callout, "spike must be one of n, s, e, w", error.val(spike))
  def (shell, ox, oy) = bubble_shell(w, h, absolute_radius(cr, w, h), line_color,
                                     ~spikes: [sp])
  def bubble:
    overlay(~horiz: #'left, ~vert: #'top, ~dx: ox + padding, ~dy: oy + padding,
            shell, content)
  overlay(~horiz: #'left, ~vert: #'top, ~dx: bx - ox, ~dy: by - oy, on, bubble)
    .refocus(on)

// A bubble that reaches out to several targets at once, every spike part of the one
// outline.
//
// Every target is met from whichever edge of the body faces it, worked out from
// where things ended up rather than chosen by the caller: the ray from the body's
// centre towards a target leaves the body by one of its four sides, and that is the
// side its spike grows from. The tip is where that same ray, travelling back,
// leaves the target -- so a spike lands on the target's near edge rather than
// aiming at its middle, which is what keeps it clear of whatever sits between.
//
// Spikes on an edge are spread along it in their targets' own order and never
// closer than `~base` allows, and the body grows if an edge is asked for more
// spikes than it has room for. Two spikes whose bases overlap make the outline
// cross itself, and a self-crossing path strokes those inner edges too -- which is
// what draws a line across the middle of a spike.
//
// The body sits just off `on`'s edge by default (`~horiz`/`~vert`/`~gap`). Give
// `~place` a pict already inside `on` to put the body's top-left corner there
// instead, for when the bubble has to land in a particular gap in the picture.
fun multi_callout(~on: on :: Pict,
                  ~at: targets :: List.of(Pict),
                  ~place: place :: maybe(Pict) = #false,
                  ~horiz: horiz :: HorizAlignment = #'right,
                  ~vert: vert :: VertAlignment = #'top,
                  ~gap: gap :: Real = 24,
                  ~dy: dy :: Real = 0,
                  ~color: color :: draw.Color || String = talk_blue,
                  ~padding: padding :: Real = 14,
                  ~base: half_base :: Real = 15,
                  ~corner_radius: cr :: Real = corner_radius,
                  child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = stack.left(~sep: 6, child, ...)
  // The radius comes from the body the content asks for, not the larger body the
  // spikes may force: a negative `~corner_radius` is a fraction of the smaller side,
  // so measuring it against the grown size would round the corners off in proportion
  // to how many spikes there are, and fatter corners eat the straight edge they need.
  def nat_w = content.width + 2 * padding
  def nat_h = content.height + 2 * padding
  def r = absolute_radius(cr, nat_w, nat_h)
  def pitch = 2 * half_base + 6
  def end_room = r + half_base + 5

  // How far a ray from a box's centre heading (dx, dy) travels before it leaves the
  // box of half-extent (hw, hh), and which pair of sides it leaves by.
  fun exit_scale(hw :: Real, hh :: Real, dx :: Real, dy :: Real) :: Real:
    def sx = if dx == 0 | 1.0e9 | hw / math.abs(dx)
    def sy = if dy == 0 | 1.0e9 | hh / math.abs(dy)
    math.min(sx, sy)
  fun leaves_sideways(hw :: Real, hh :: Real, dx :: Real, dy :: Real) :: Boolean:
    def sx = if dx == 0 | 1.0e9 | hw / math.abs(dx)
    def sy = if dy == 0 | 1.0e9 | hh / math.abs(dy)
    sx <= sy

  fun origin_for(bw :: Real, bh :: Real):
    if place
    | Find.top_left(place).in(on)
    | block:
        def slot = blank(~width: bw, ~height: bh)
        def sdx = if horiz == #'right | bw + gap | -(bw + gap)
        def probe = overlay(~horiz: horiz, ~vert: vert, ~dx: sdx, ~dy: dy, on, slot)
        Find.top_left(slot).in(probe)

  // A provisional body at its natural size is enough to say which edge each target
  // belongs to; growing the body afterwards never moves a target across a side.
  def (px, py) = origin_for(nat_w, nat_h)
  def pcx = px + nat_w / 2
  def pcy = py + nat_h / 2
  def marked:
    for List (tg :: Pict in targets):
      def (tx, ty) = Find.center(tg).in(on)
      def side:
        if leaves_sideways(nat_w / 2, nat_h / 2, tx - pcx, ty - pcy)
        | (if tx > pcx | #'right | #'left)
        | (if ty > pcy | #'bottom | #'top)
      [tg, tx, ty, side]
  fun on_side(s, along :: Int) :: List:
    def picked:
      for List (t in marked):
        skip_when t[3] != s
        t
    picked.sort(fun (a :~ List, b :~ List): (a[along] :~ Real) < (b[along] :~ Real))
  def tops = on_side(#'top, 1)
  def bots = on_side(#'bottom, 1)
  def lefts = on_side(#'left, 2)
  def rights = on_side(#'right, 2)

  fun room_for(n :: Int) :: Real: n * pitch + 2 * end_room
  def w = math.max(nat_w, room_for(math.max(tops.length(), bots.length())))
  def h = math.max(nat_h, room_for(math.max(lefts.length(), rights.length())))
  def (bx, by) = origin_for(w, h)
  def cx = bx + w / 2
  def cy = by + h / 2

  // Bases in their targets' own order, pushed apart to `pitch` and kept inside the
  // corners: one sweep forwards, then one back, the usual way of placing labels
  // along an axis. Keeping the order is also what stops two spikes crossing.
  fun spread(vals :: List, lo :: Real, hi :: Real) :: List:
    def up:
      for values(acc :~ List = []) (v :~ Real in vals):
        def floor = if acc == [] | lo | (acc.last :~ Real) + pitch
        acc ++ [math.max(v, floor)]
    def down:
      for values(acc :~ List = []) (v :~ Real in up.reverse()):
        def ceiling = if acc == [] | hi | (acc.last :~ Real) - pitch
        acc ++ [math.min(v, ceiling)]
    down.reverse()

  // the tip, in the body's coordinates
  fun tip_of(t :~ List) :: List:
    def tg :~ Pict = t[0]
    def tx :~ Real = t[1]
    def ty :~ Real = t[2]
    def s = exit_scale(tg.width / 2, tg.height / 2, cx - tx, cy - ty)
    [tx + (cx - tx) * s - bx, ty + (cy - ty) * s - by]

  fun spikes_for(items :: List, side, along :: Int, lo :: Real, hi :: Real) :: List:
    def wants = for List (t :~ List in items): (t[along] :~ Real) - (if along == 1 | bx | by)
    def bases = spread(wants, lo, hi)
    for List (t :~ List in items, b :~ Real in bases):
      def [tipx, tipy] = tip_of(t)
      Spike(side, b, tipx, tipy)
  def spikes:
    spikes_for(tops, #'top, 1, end_room, w - end_room)
      ++ spikes_for(bots, #'bottom, 1, end_room, w - end_room)
      ++ spikes_for(lefts, #'left, 2, end_room, h - end_room)
      ++ spikes_for(rights, #'right, 2, end_room, h - end_room)

  def (shell, ox, oy) = bubble_shell(w, h, r, line_color, ~spikes: spikes, ~base: half_base)
  // Centred in the body, not pinned to its top: the body is often larger than the
  // text asked for, because the spikes need a run of edge to leave from, and
  // top-aligning the text puts all of that slack underneath it as a blank patch.
  def bubble:
    overlay(~horiz: #'left, ~vert: #'top,
            ~dx: ox + (w - content.width) / 2, ~dy: oy + (h - content.height) / 2,
            shell, content)
  // the body sits at (ox, oy) inside `bubble`, so undo that to land it where the
  // body was reckoned to go
  overlay(~horiz: #'left, ~vert: #'top, ~dx: bx - ox, ~dy: by - oy, on, bubble)
    .refocus(on)

// ---------------------------------------------------------------------------
// Arrows between picts that are already placed on `on`.
//
// Ported from `autoarrow` in ../2022-explanations-talk/slidehelpers.rkt, with one
// change: the line runs along the segment between the two centres and stops at
// each pict's bounding box, instead of leaving from whichever side faces the
// other pict. A diagonal edge then meets a box where a ruler would put it, which
// is what Keynote draws for a connector, and a fan of edges out of one node
// spreads around its border instead of bunching up at one side's midpoint.
// `~from_at` and `~to_at` override either end, as `#:finder1`/`#:finder2` did.
//
// `from` and `to` may be Racket picts, such as the ones glide-pptx's runtime
// builds, as long as they are the very picts placed on `on`: that is how they
// are found again.

fun as_pict(q) :: Pict:
  if q is_a Pict | q | Pict.from_handle(q)

// How round a pict's corners are, as a share of its shorter side: what a node built
// by `graph_node` says about itself, read through whatever has been wrapped round it
// since -- a scale, a colour -- and 0 for anything that says nothing.
fun corner_of(p :: Pict) :: Real:
  def m = p.metadata()
  cond
  | m.has_key(#'corner): m[#'corner]
  | p.children.length() == 1: corner_of(p.children[0])
  | ~else: 0.0

// Where a ray from the centre of a `w` by `h` box in direction (dx, dy) leaves
// the box, as a multiple of (dx, dy). `corner` is how round the box's corners are,
// as a share of the shorter side: a ray leaving through a corner meets the rounded
// border inside the box's own corner, and an arrow aimed at the box would stop
// short of the ink.
fun border_scale(dx :: Real, dy :: Real, w :: Real, h :: Real,
                 ~corner: corner :: Real = 0.0) :: Real:
  def far = 1.0e9  // a ray with no run (or no rise) never reaches that pair of sides
  def tx = if math.abs(dx) > 1.0e-9 | (w / 2) / math.abs(dx) | far
  def ty = if math.abs(dy) > 1.0e-9 | (h / 2) / math.abs(dy) | far
  def t_box = math.min(tx, ty)
  def r = corner * math.min(w, h)
  def px = dx * t_box
  def py = dy * t_box
  cond
  | r <= 0.0 || math.abs(px) < w / 2 - r || math.abs(py) < h / 2 - r: t_box
  | ~else:
      // through a corner: where the ray meets the circle that rounds it
      def cx = (if px < 0 | -1.0 | 1.0) * (w / 2 - r)
      def cy = (if py < 0 | -1.0 | 1.0) * (h / 2 - r)
      def dd = dx * dx + dy * dy
      def dc = dx * cx + dy * cy
      def disc = dc * dc - dd * (cx * cx + cy * cy - r * r)
      if disc <= 0.0 | t_box | (dc + math.sqrt(disc)) / dd

// A colour part way from one to another.
fun lerp_color(a :: draw.Color, b :: draw.Color, t :: Real) :: draw.Color:
  fun ch(x :: Real, y :: Real) :: Int:
    math.min(255, math.max(0, math.exact(math.round(lerp(x, y, t)))))
  draw.Color(ch(a.red, b.red), ch(a.green, b.green), ch(a.blue, b.blue),
             lerp(a.alpha, b.alpha, t))

// Both ends of the line `arrow` would draw between two picts on `on`, in `on`'s
// own coordinates: from the border of `from` to the border of `to`, along the line
// between their centres, `gap` clear of each, shifted sideways by `shift`, or from
// and to wherever `~from_at` and `~to_at` say instead.
fun arrow_ends(on :: Pict, from :: Pict, to :: Pict,
               ~gap: gap :: Real = 0, ~shift: shift :: Real = 0,
               ~from_at: from_at :: maybe(Find) = #false,
               ~to_at: to_at :: maybe(Find) = #false) :: List:
  def (fx, fy) = Find.center(from).in(on)
  def (tx, ty) = Find.center(to).in(on)
  def dx = tx - fx
  def dy = ty - fy
  def dist = math.max(1.0e-9, math.sqrt(dx * dx + dy * dy))
  def ux = dx / dist
  def uy = dy / dist
  def tf = border_scale(dx, dy, from.width, from.height, ~corner: corner_of(from))
  def tt = border_scale(dx, dy, to.width, to.height, ~corner: corner_of(to))
  def px = -uy * shift
  def py = ux * shift
  def (sx, sy):
    if from_at
    | (from_at :~ Find).in(on)
    | values(fx + dx * tf + ux * gap + px, fy + dy * tf + uy * gap + py)
  def (ex, ey):
    if to_at
    | (to_at :~ Find).in(on)
    | values(tx - dx * tt - ux * gap + px, ty - dy * tt - uy * gap + py)
  [sx, sy, ex, ey]

// An arrowhead no longer than the line it is on can carry: on a short edge between
// two close nodes, a head sized for the pen swallows the whole line.
fun head_for(lw :: Real, requested :: maybe(Real), length :: Real) :: Real:
  math.min(requested || 4 * lw, math.max(4.0, 0.45 * length))

fun arrow(~on: on :: Pict,
          from_in,
          to_in,
          ~style: style :: ConnectStyle = #'arrow,
          ~color: color :: draw.Color || String = "black",
          ~line_width: lw :: Real = border_width,
          // the original's 25 on a 6-wide line; `connect` itself defaults to 16
          ~arrow_size: arrow_size :: maybe(Real) = #false,
          ~line_style: line_style :: ConnectLineStyle = #'solid,
          // clearance between each box and the line
          ~gap: gap :: Real = 0,
          // slide the whole line sideways, at right angles to itself. Two nodes
          // can be joined by more than one edge -- an operand feeding an operator
          // *and* an e-class saying they are the same value -- and without this the
          // second lies exactly on top of the first.
          ~shift: shift :: Real = 0,
          ~from_at: from_at :: maybe(Find) = #false,
          ~to_at: to_at :: maybe(Find) = #false,
          ~label: label :: maybe(Pict) = #false,
          ~label_dx: label_dx :: Real = 0,
          ~label_dy: label_dy :: Real = -10,
          ~order: order :: OverlayOrder = #'front) :: Pict:
  def from = as_pict(from_in)
  def to = as_pict(to_in)
  def (fx, fy) = Find.center(from).in(on)
  def (tx, ty) = Find.center(to).in(on)
  def dx = tx - fx
  def dy = ty - fy
  def dist = math.sqrt(dx * dx + dy * dy)
  cond
  | dist < 1.0e-9: on   // one on top of the other: nothing to draw
  | ~else:
      def [sx, sy, ex, ey] = arrow_ends(on, from, to, ~gap: gap, ~shift: shift,
                                        ~from_at: from_at, ~to_at: to_at)
      // How much of the line to draw: a fraction of the way along is a nearer far
      // end. The head travels with the nib, which is what drawing an arrow looks
      // like.
      def drawn = smooth(current_draw())
      def nx = lerp(sx, ex, drawn)
      def ny = lerp(sy, ey, drawn)
      def length = math.sqrt((ex - sx) * (ex - sx) + (ey - sy) * (ey - sy))
      connect(~on: on, Find.abs(sx, sy), Find.abs(nx, ny),
              ~style: style,
              ~line: as_color(color),
              ~line_width: lw,
              ~arrow_size: head_for(lw, arrow_size, length),
              ~line_style: line_style,
              ~label: (if drawn >= 1.0 | label | #false),
              ~label_dx: label_dx,
              ~label_dy: label_dy,
              ~order: order)

// Several arrows in one style: `edges` is a list of `[from, to]` pairs.
fun arrows(~on: on :: Pict, edges :: List.of(List), ~& kws) :: Pict:
  for values(p = on) ([from, to] in edges):
    arrow(~on: p, from, to, ~& kws)

// One arrow becoming another, `t` of the way: the line `a` would draw between its
// two picts turns into the line `b` would draw between its two, end for end, in
// colour and weight, dashed for the first half and solid for the rest. For a
// rule's pointer at the node it matched becoming the edge of the node the rule
// added -- the same fact, said first as a match and then as structure.
fun arrow_morph(~on: on :: Pict, ~t: t :: Real,
                ~from_a: fa_in, ~to_a: ta_in,
                ~from_b: fb_in, ~to_b: tb_in,
                ~color_a: color_a :: draw.Color || String,
                ~color_b: color_b :: draw.Color || String,
                ~line_width_a: lwa :: Real, ~line_width_b: lwb :: Real,
                ~gap_a: gap_a :: Real = 0, ~gap_b: gap_b :: Real = 0,
                ~from_at_a: from_at_a :: maybe(Find) = #false,
                ~from_at_b: from_at_b :: maybe(Find) = #false,
                ~to_at_b: to_at_b :: maybe(Find) = #false,
                ~dashed_a: dashed_a :: Boolean = #true) :: Pict:
  def [asx, asy, aex, aey] = arrow_ends(on, as_pict(fa_in), as_pict(ta_in), ~gap: gap_a,
                                        ~from_at: from_at_a)
  def [bsx, bsy, bex, bey] = arrow_ends(on, as_pict(fb_in), as_pict(tb_in), ~gap: gap_b,
                                        ~from_at: from_at_b, ~to_at: to_at_b)
  def s = smooth(t)
  def sx = lerp(asx, bsx, s)
  def sy = lerp(asy, bsy, s)
  def ex = lerp(aex, bex, s)
  def ey = lerp(aey, bey, s)
  def lw = lerp(lwa, lwb, s)
  def length = math.sqrt((ex - sx) * (ex - sx) + (ey - sy) * (ey - sy))
  connect(~on: on, Find.abs(sx, sy), Find.abs(ex, ey),
          ~style: #'arrow,
          ~line: lerp_color(as_color(color_a), as_color(color_b), s),
          ~line_width: lw,
          ~arrow_size: head_for(lw, #false, length),
          ~line_style: (if dashed_a && t < 0.5 | #'short_dash | #'solid))

// ---------------------------------------------------------------------------
// Where we are in the talk. This is the ICFP talk's outline: a numbered disc per
// section down a spine, each disc its own hue, the one we are on lit and haloed
// and the others dimmed back, with the spine filled in as far as we have got.
//
// What is new here are the two ends: the previous slide's header magic-moves down
// into the list as a divider arrives, and the list then magic-moves back into the
// top margin, the discs flying between a column and a row and the other sections'
// labels fading on the way. That only works because the settled discs and labels are built
// once and handed to both layouts -- `magic_move` matches picts by identity, so a
// disc rebuilt per frame would match nothing and the move would be a dissolve.

fun absr(x :: Real) :: Real: if x < 0.0 | -x | x

// A fully saturated rainbow colour for t in 0..1 (HSV hue -> RGB), as in the
// ICFP talk's `rainbow.rhm`; inlined rather than depending on that whole module.
fun hue_color(t :: Real) :: draw.Color:
  def h = clamp01(t) * 6.0
  fun byte(x :: Real):
    math.min(255, math.max(0, math.exact(math.floor(clamp01(x) * 255.0))))
  draw.Color(byte(absr(h - 3.0) - 1.0), byte(2.0 - absr(h - 2.0)), byte(2.0 - absr(h - 4.0)))

def outline_r = 54.0             // disc radius
// The lit disc carries a halo wider than the disc, and `place_center` at x = r
// would put its left edge past zero -- which grows the row's bounding box to the
// left and shifts every row placed after it, so the discs stop lining up. The
// column sits far enough in for the widest halo to fit.
def outline_left = 44.0
def outline_glow = 50.0          // halo, added to the disc's diameter
def outline_row = 172.0          // one row of the list
def outline_gap = 56.0           // disc to label
def outline_text = 52.0          // label font size

fun hue_of(i :: Int, n :: Int) :: draw.Color:
  hue_color(1.0 * i / math.max(1.0, 1.0 * (n - 1)) * 0.85)

// `hl` is how lit this one is, 0 to 1.
fun outline_disc(i :: Int, n :: Int, hl :: Real) :: Pict:
  def hue = hue_of(i, n)
  def rr = outline_r * (1.0 + 0.18 * hl)
  def num:
    def b = text("" +& (i + 1), ~font: current_font() with (weight = #'bold))
    b.scale(outline_r * 0.86 / b.height * (1.0 + 0.12 * hl))
  def core = overlay(circle(~size: rr * 2, ~fill: hue, ~line: #false),
                     num.colorize(draw.Color(255, 255, 255)))
  def glow = circle(~size: rr * 2 + outline_glow, ~fill: hue, ~line: #false).alpha(0.34 * hl)
  overlay(glow, core.alpha(lerp(0.55, 1.0, hl)))

// A label, in the outline's size, in one colour: written text, so that the first
// divider can write the list out.
fun outline_plain(str :: String, ~color: color) :: Pict:
  written_text(str, ~font: current_font() with (size = outline_text), ~color: color)

// A label at highlight `hl`: the accent when we are on it, ordinary text dimmed
// back when we are not, and a touch larger when lit.
fun outline_label(dim :: Pict, lit :: Pict, hl :: Real) :: Pict:
  overlay(dim.alpha(lerp(0.62, 0.0, hl)), lit.alpha(hl)).scale(lerp(1.0, 1.08, hl))

fun place_center(base :: Pict, p :: Pict, cx :: Real, cy :: Real) :: Pict:
  overlay(~horiz: #'left, ~vert: #'top,
          ~dx: cx - p.width / 2, ~dy: cy - p.height / 2, base, p)
fun place_left(base :: Pict, p :: Pict, x :: Real, cy :: Real) :: Pict:
  overlay(~horiz: #'left, ~vert: #'top, ~dx: x, ~dy: cy - p.height / 2, base, p)

// `~label_width` is the room the labels get. The list is centred on the canvas,
// so its width decides where it sits -- and a lit label is 8% wider than a dim
// one, so measuring the labels handed in would move the whole list sideways as
// the lit one changes. The discs hide a 20pt drift; the thin, faint spine does
// not, and drifting across pixel boundaries made it flicker. Callers that
// animate pass the width of the widest label at its lit size, once.
// `shots` is one keepsake per row, or `#false` for a row that has none yet: a
// picture of what that section was, for the sections the talk has been through. The
// column they sit in is part of the layout's width, and the layout is centred on the
// slide -- so the list slides left to make room the first time one turns up, and
// stays where it is after that.
// The line the discs are threaded on, as one pict for the whole talk. Both layouts
// draw *this*, at their own two scales: `magic_move` matches picts by identity and
// interpolates the horizontal and vertical scales separately, so the upright spine of
// the list lies down into the header's track and stands back up again. Two bars built
// to size would be two picts, and one would fade out while the other faded in
// somewhere else, which is not the line going anywhere.
//
// A bar is a square that is scaled to the length it needs, upright in the list and
// flat in the header, and a rounded square stretched a hundred times one way is an
// ellipse. So the square draws itself with an eye on the scale it is being drawn
// at: it reads the surface's transformation, works out how big it will land, and
// rounds its corners by half the *shorter* side as landed -- so the ends are round
// on the screen whichever way it has been stretched, and stay round as the move
// between the two layouts stretches it the other way.
def outline_bar = 9.0
fun stadium(color :: draw.Color) :: Pict:
  def s = outline_bar
  dc(fun (target :: draw.DC, dx, dy):
       def tr = target.transformation
       def sx = math.max(1.0e-6, math.abs(tr.xx))
       def sy = math.max(1.0e-6, math.abs(tr.yy))
       def rd = math.min(s * sx, s * sy) / 2.0
       def rx = rd / sx
       def ry = rd / sy
       def k = 0.5523
       def p = draw.Path()
       p.move_to([dx + rx, dy])
       p.line_to([dx + s - rx, dy])
       p.curve_to([dx + s - rx + k * rx, dy], [dx + s, dy + ry - k * ry], [dx + s, dy + ry])
       p.line_to([dx + s, dy + s - ry])
       p.curve_to([dx + s, dy + s - ry + k * ry], [dx + s - rx + k * rx, dy + s],
                  [dx + s - rx, dy + s])
       p.line_to([dx + rx, dy + s])
       p.curve_to([dx + rx - k * rx, dy + s], [dx, dy + s - ry + k * ry], [dx, dy + s - ry])
       p.line_to([dx, dy + ry])
       p.curve_to([dx, dy + ry - k * ry], [dx + rx - k * rx, dy], [dx + rx, dy])
       p.close()
       target.save()
       target.pen := draw.Pen.none
       target.brush := draw.Brush(~color: color)
       target.path(p)
       target.restore(),
     ~width: s, ~height: s)
def outline_spine_bar = stadium(draw.Color(120, 120, 120)).alpha(0.22)
def outline_walk_bar = stadium(talk_blue)

fun outline_layout(discs :: List.of(Pict), labels :: List.of(Pict),
                   ~current: current :: Real, ~canvas: canvas :: Pict,
                   ~color: color = talk_blue,
                   ~label_width: label_width :: maybe(Real) = #false,
                   ~shots: shots :: maybe(List) = #false,
                   ~disc_prog: disc_prog :: maybe(List) = #false) :: Pict:
  def n = discs.length()
  def lab_w = label_width
                || (for values(m :~ Real = 0.0) (p :~ Pict in labels): math.max(m, p.width))
  def disc_cx = outline_left + outline_r
  def shot_x = disc_cx + outline_r + outline_gap + lab_w + outline_gap
  def shot_w:
    if !shots
    | 0.0
    | for values(m :~ Real = 0.0) (q in shots :~ List):
        if q | math.max(m, (q :~ Pict).width) | m
  def w = shot_x + shot_w
  def h = n * outline_row
  def base = blank(~width: w, ~height: h)
  fun row_cy(i :: Real) :: Real: i * outline_row + outline_row / 2
  def y0 = row_cy(0.0)
  def yN = row_cy(1.0 * (n - 1))
  def spine:
    place_center(base, outline_spine_bar.scale(1.0, (yN - y0) / outline_bar),
                 disc_cx, (y0 + yN) / 2)
  def cc = math.max(0.0, math.min(1.0 * (n - 1), current))
  def yfill = row_cy(cc)
  def walked:
    if yfill - y0 > 0.5
    | place_center(spine, outline_walk_bar.scale(1.0, (yfill - y0) / outline_bar),
                   disc_cx, (y0 + yfill) / 2)
    | spine
  recur go(i = 0, acc :~ Pict = walked):
    if i >= n
    | overlay(canvas, acc).refocus(canvas)
    | def dp :~ Real = (if disc_prog | (disc_prog[i] :~ Real) | 1.0)
      def acc1 = place_center(acc, discs[i].scale(smooth(dp)), disc_cx, row_cy(1.0 * i))
      def acc2 = place_left(acc1, labels[i], disc_cx + outline_r + outline_gap,
                            row_cy(1.0 * i))
      def acc3:
        def q = if shots | (shots :~ List)[i] | #false
        // centred in the column rather than flush with its left edge: they are cut
        // to different shapes and a ragged left edge reads as a mistake
        if q
        | place_left(acc2, q, shot_x + (shot_w - (q :~ Pict).width) / 2,
                     row_cy(1.0 * i))
        | acc2
      go(i + 1, acc3)

// The same discs and labels shrunk into the top margin. Only the section we are
// on keeps its label; the rest are simply absent, so `magic_move` fades them.
//
// The discs keep the spine they were threaded on, laid down flat. Without it the
// outline's grey line has nothing to become and `magic_move` simply fades it, which
// reads as the talk losing a piece of furniture on the way up rather than putting
// it away. The walked part of it is here too, so the header says how far along the
// talk is in the same way the list did.
fun header_layout(discs :: List.of(Pict), labels :: List.of(Pict),
                  ~at: at :: Int, ~canvas: canvas :: Pict,
                  ~color: color = talk_blue,
                  ~disc_scale: ds :: Real = 0.30,
                  ~text_scale: ts :: Real = 0.44,
                  ~dx: dx :: Real = 64.0, ~cy: cy :: Real = 36.0) :: Pict:
  def n = discs.length()
  def step = outline_r * 2 * ds + 20.0
  def x0 = dx + outline_r * ds
  def xN = x0 + (n - 1) * step
  def track_h = 7.0
  def track:
    place_center(canvas,
                 outline_spine_bar.scale((xN - x0) / outline_bar,
                                         track_h / outline_bar),
                 (x0 + xN) / 2, cy)
  def walked:
    def xf = x0 + at * step
    if xf - x0 > 0.5
    | place_center(track,
                   outline_walk_bar.scale((xf - x0) / outline_bar,
                                          track_h / outline_bar),
                   (x0 + xf) / 2, cy)
    | track
  recur go(i = 0, acc :~ Pict = walked):
    if i >= n
    | place_left(acc, labels[at].scale(ts), dx + n * step + 14.0, cy).refocus(canvas)
    | go(i + 1, place_center(acc, discs[i].scale(ds),
                             dx + outline_r * ds + i * step, cy))

fun outline_to_header(items :: List.of(String),
                      ~at: at :: Int,
                      ~canvas: canvas :: Pict,
                      ~color: color = talk_blue,
                      ~intro: intro :: Boolean = #false,
                      ~shots: all_shots :: maybe(List) = #false,
                      // What the next slide opens with -- its title, on a transparent
                      // layer the size of the canvas -- to be written while the list
                      // goes up into the header, so that the press that puts the
                      // outline away is the press that brings the next slide's title
                      // on, and the cut to that slide then changes nothing.
                      ~next: next :: maybe(Pict) = #false,
                      ~extent: extent :: Real = 1.0) :: Pict:
  def n = items.length()
  // only the sections already behind us have one to show
  def shots:
    cond
    | !all_shots: #false
    | ~else:
        for List (i in 0..n):
          if i < at | (all_shots :~ List)[i] | #false
  def line_color = as_color(color)
  def written = for List (s in items): outline_plain(s, ~color: draw.Color(0, 0, 0))
  def written_lit = for List (s in items): outline_plain(s, ~color: line_color)
  // each label's own writer, for the first divider to write the list out with
  def writers = for List (q :~ Pict in written): writer(q)
  // the settled pieces, built once: these are what the header shows and what the
  // move matches on
  // the widest label at its lit size, so every layout below is the same width
  def lab_w = 1.08 * (for values(m :~ Real = 0.0) (q :~ Pict in written): math.max(m, q.width))
  def discs = for List (i in 0..n): outline_disc(i, n, (if i == at | 1.0 | 0.0))
  def labels = for List (i in 0..n):
                 outline_label(written[i], written_lit[i], (if i == at | 1.0 | 0.0))
  def full = outline_layout(discs, labels, ~current: 1.0 * at, ~canvas: canvas, ~color: color,
                            ~label_width: lab_w, ~shots: shots)
  def head = header_layout(discs, labels, ~at: at, ~canvas: canvas, ~color: color)
  def opening:
    if intro
    | block:
        // each row writes itself out, its disc popping in just ahead of the text
        def step = 0.62 / math.max(1.0, 1.0 * n)
        animate(~extent: 2.0, ~bend: fun (x): x,
                fun (p):
                  if p >= 1.0
                  | full
                  | block:
                      def prog = for List (i in 0..n): clamp01((p - i * step) / 0.36)
                      def ls = for List (i in 0..n):
                                 def rv = prog[i]
                                 def lab = outline_label(written[i], written_lit[i],
                                                         (if i == at | clamp01((p - 0.84) / 0.16) | 0.0))
                                 if rv >= 1.0
                                 | lab
                                 | overlay(~horiz: #'left, ~vert: #'top,
                                           lab.ghost(),
                                           (writers[i] :~ Writer).frame(clamp01(rv)))
                      def ds = for List (i in 0..n):
                                 outline_disc(i, n, (if i == at | clamp01((p - 0.84) / 0.16) | 0.0))
                      outline_layout(ds, ls, ~current: lerp(-1.0, 1.0 * at, clamp01((p - 0.84) / 0.16)),
                                     ~canvas: canvas, ~color: color, ~label_width: lab_w,
                                     ~shots: shots, ~disc_prog: prog))
    | block:
        // The header of the slide just left, exactly as `section_header` drew it,
        // magic-moving back down into the list: the discs fly from their row into
        // the column, the label of the section just finished grows back to its
        // place, and the other labels and the spine fade in around them. It is
        // built from its own settled discs and labels, so that the two layouts
        // share the picts the move matches on.
        def prev = math.max(0, at - 1)
        def discs0 = for List (i in 0..n): outline_disc(i, n, (if i == prev | 1.0 | 0.0))
        def labels0 = for List (i in 0..n):
                        outline_label(written[i], written_lit[i], (if i == prev | 1.0 | 0.0))
        def head0 = header_layout(discs0, labels0, ~at: prev, ~canvas: canvas,
                                  ~color: color)
        def full0 = outline_layout(discs0, labels0, ~current: 1.0 * prev,
                                   ~canvas: canvas, ~color: color, ~label_width: lab_w,
                                   ~shots: shots)
        def descent = magic_move(head0, full0, ~extent: extent, ~other: #'fade).time_pad(~after: -1)
        // the marker walking down from the section just finished to this one
        def walk:
          animate(~extent: 1.1,
                  fun (p):
                    if p >= 1.0
                    | full
                    | block:
                        def cur = lerp(1.0 * (at - 1), 1.0 * at, smooth(p))
                        def ds = for List (i in 0..n):
                                   outline_disc(i, n, clamp01(1.0 - absr(cur - i)))
                        def ls = for List (i in 0..n):
                                   outline_label(written[i], written_lit[i], clamp01(1.0 - absr(cur - i)))
                        outline_layout(ds, ls, ~current: cur, ~canvas: canvas, ~color: color,
                                       ~label_width: lab_w, ~shots: shots))
        // `~join: #'splice` merges the descent's epoch with the walk's, so the marker
        // sets off the moment the list lands and the two are one animation rather
        // than two -- an epoch is a press, and this is one beat, not two.
        switch(descent, walk, ~join: #'splice)
  // `magic_move`'s epoch 0 *is* the move and its epoch 1 is the settled result --
  // measured, not assumed -- so it is the tail that has to go, not the head.
  // `~other: #'fade` -- the picts the two layouts do *not* have in common are the
  // three labels the header drops, and `magic_move`'s default `#'switch` cuts them
  // out abruptly. Fading them lets them go with the discs they belong to.
  def up:
    cond
    | !next: magic_move(full, head, ~extent: extent, ~other: #'fade).time_pad(~after: -1)
    | ~else:
        // The same move, drawn over the next slide's title as it is written: the
        // two layouts are built again over a clear canvas so the move can go on top
        // of the title, and the page itself goes underneath. The list is up in
        // `extent` as before and the press runs on while the title finishes.
        def clear = blank(~width: canvas.width, ~height: canvas.height)
        def full_t = outline_layout(discs, labels, ~current: 1.0 * at, ~canvas: clear,
                                    ~color: color, ~label_width: lab_w, ~shots: shots)
        def head_t = header_layout(discs, labels, ~at: at, ~canvas: clear, ~color: color)
        def move = magic_move(full_t, head_t, ~extent: extent, ~other: #'fade)
                     .time_pad(~after: -1)
        def title_w = writer(next :~ Pict)
        def whole = extent + 0.6
        def rise = extent / whole
        animate(~extent: whole, ~bend: fun (x): x,
                fun (t):
                  overlay(~horiz: #'left, ~vert: #'top,
                          canvas,
                          title_w.frame(clamp01((t - 0.15) / 0.85)),
                          move.snapshot(0, clamp01(t / rise))))
  // Two presses: the list arrives -- written out the first time, flown down out of
  // the header after that, with the marker walking on -- and rests, which is the
  // moment to say where the talk has got to; then the next press puts it away in
  // the top margin, writing the next slide's title under it if it was given one.
  switch(opening, up)

fun section_header(items :: List.of(String),
                   ~at: at :: Int,
                   ~canvas: canvas :: Pict,
                   ~color: color = talk_blue) :: Pict:
  def n = items.length()
  def line_color = as_color(color)
  def written = for List (s in items): outline_plain(s, ~color: draw.Color(0, 0, 0))
  def written_lit = for List (s in items): outline_plain(s, ~color: line_color)
  def discs = for List (i in 0..n): outline_disc(i, n, (if i == at | 1.0 | 0.0))
  def labels = for List (i in 0..n):
                 outline_label(written[i], written_lit[i], (if i == at | 1.0 | 0.0))
  header_layout(discs, labels, ~at: at, ~canvas: canvas, ~color: color)

// ---------------------------------------------------------------------------

// Reveal `extra` over `base` as one new slide step: written, unless it brings an
// arrival of its own.
fun fade_in(base :: Pict, extra :: Pict,
            ~horiz: horiz :: HorizAlignment = #'center,
            ~vert: vert :: VertAlignment = #'center,
            ~dx: dx :: Real = 0,
            ~dy: dy :: Real = 0) :: Pict:
  def rest = settled(base)
  fun over(e :: Pict) :: Pict:
    overlay(~horiz: horiz, ~vert: vert, ~dx: dx, ~dy: dy, rest, e)
      .refocus(rest)
  // How a thing arrives is an animation in the epoch *before* its time box: this
  // is the epoch the press runs, and at the end of it `extra` is simply there. So
  // the epoch count is two, not three: the arrival's own last frame is already
  // `extra` at full.
  //
  // `over` of an animated pict is animated, which is all that is needed to put the
  // appearance in that epoch. An `extra` that animates already -- one built as a
  // write, or as an animation of its own -- is left to arrive its own way.
  switch(base, over(as_written(extra)))
