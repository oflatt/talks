#lang rhombus
import:
  slideshow open   // re-exports pict + pict/text
  draw
  pict/balloon as balloon
  pict/rhombus as rh          // code metrics, for pinning bubbles onto code
  "write.rhm"
  lib("pict/main.rkt") as rkt
  lib("pict/flash.rkt") as rkt_flash

// Ported from ../talks/2022-explanations-talk/slidehelpers.rkt

export:
  make_bubble
  make_flash
  make_node
  outline_to_header
  section_header
  clamp01
  lerp
  smooth
  arrow
  arrows
  callout
  code_callout
  subst
  multi_callout
  callout_note
  absolute_radius
  brace
  braced
  fade_in
  fade_through
  anim_box
  in_anim_box
  on_ghost
  explain_times
  timeline_geom
  TimelineGeom
  pale
  border_width
  corner_radius
  talk_blue
  talk_light_blue
  talk_green
  talk_red

def border_width = 3
def corner_radius = -0.15            // negative = fraction of the smaller side

// COLORS
def talk_blue = draw.Color(38, 132, 235)
def talk_light_blue = talk_blue.scale(2)
def talk_green = draw.Color("green").scale(0.5)
def talk_red = draw.Color("red")

fun pale(c :: draw.Color) :: draw.Color:
  c.scale(4)

fun as_color(c :: draw.Color || String) :: draw.Color:
  if c is_a String | draw.Color(c) | c

fun gap_stack(child :: Pict, ...) :: Pict:
  stack.left(~sep: slide.gap, child, ...)

fun shape_size(content :: Pict,
               width :: maybe(Real), height :: maybe(Real),
               padding :: Real):
  values(width || (content.width + padding * 2),
         height || (content.height + padding * 2))

// A rounded rectangle around `child`s: pale fill, saturated border.
fun make_bubble(~width: width :: maybe(Real) = #false,
                ~height: height :: maybe(Real) = #false,
                ~padding: padding :: Real = 30,
                ~color: color :: draw.Color || String = talk_blue,
                child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  def (w, h) = shape_size(content, width, height, padding)
  rectangle(~around: content,
            ~width: w,
            ~height: h,
            ~fill: pale(line_color),
            ~line: line_color,
            ~line_width: border_width,
            ~rounded: corner_radius,
            // The original ends in `pin-over`, which keeps the rectangle's
            ~refocus: #false)

// A starburst. Rhombus's pict has no flash shape, so this lifts `pict/flash`.
fun flash_shape(w :: Real, h :: Real, color :: draw.Color) :: Pict:
  fun styled(make, c :: draw.Color) :: Pict:
    Pict.from_handle(rkt.linewidth(border_width,
                                   rkt.colorize(make(w, h), c.handle)))
  overlay(~horiz: #'left, ~vert: #'top,
          styled(rkt_flash.#{filled-flash}, pale(color)),
          styled(rkt_flash.#{outline-flash}, color))

fun make_flash(~width: width :: maybe(Real) = #false,
               ~height: height :: maybe(Real) = #false,
               ~padding: padding :: Real = 30,
               // the original defaults this one to the string "blue" (pure
               // blue), not to the `blue` color object `make_bubble` uses
               ~color: color :: draw.Color || String = "blue",
               child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  def (w, h) = shape_size(content, width, height, padding)
  def shape = flash_shape(w, h, line_color)
  overlay(shape, content).refocus(shape)

// Callouts wrap `pict/balloon`, which draws the bubble-plus-spike as one shape

// `rectangle`'s `~rounded` is a fraction of the smaller side when negative;
// `pict/balloon` wants absolute pixels. Rule from racket/draw's `dc-path%`.
fun absolute_radius(r :: Real, w :: Real, h :: Real) :: Real:
  if r < 0 | -r * math.min(w, h) | r

fun body_size(content :: Pict, hmargin :: Real, vmargin :: Real):
  values(content.width + hmargin * 2, content.height + vmargin * 2)

fun callout(~on: on :: Pict,
            ~at: at :: Find,
            ~spike: spike :: balloon.CompassDirection = #'s,
            ~color: color :: draw.Color || String = talk_blue,
            // #false keeps `pict/balloon`'s own margin defaults
            ~padding: padding :: maybe(Real) = #false,
            ~corner_radius: cr :: Real = corner_radius,
            child :: Pict, ...,
            ~& kws) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  def hmargin = padding || balloon.current_horiz_margin()
  def vmargin = padding || balloon.current_vert_margin()
  def (w, h) = body_size(content, hmargin, vmargin)
  balloon.pin(content,
              ~on: on,
              ~at: at,
              ~spike: spike,
              ~horiz_margin: hmargin,
              ~vert_margin: vmargin,
              ~corner_radius: absolute_radius(cr, w, h),
              ~fill: pale(line_color),
              ~line: line_color,
              ~line_width: border_width,
              ~& kws)

// The same bubble without a spike or a target, for when you want to place it
// yourself. Note this is a balloon outline, not `make_bubble`'s rectangle.
// A callout pinned to a zero-size marker sitting in a line of code. Such a
// marker has no height, so it sits on the text's baseline and a plain `Find` at
// it lands under the word rather than on it. Aim by which side the bubble is on:
// the top of the line for a bubble above, the bottom for one below, the middle
// of the line for one off to either side.
fun code_callout(~on: on :: Pict,
                 ~at: target :: Pict,
                 ~spike: spike :: balloon.CompassDirection = #'s,
                 child :: Pict, ...,
                 ~& kws) :: Pict:
  def m = rh.current_rhombus_tt()("X")
  def at:
    match spike
    | #'s: Find.top(target, ~dy: -m.ascent)
    | #'n: Find.bottom(target, ~dy: m.descent)
    | #'e: Find.left(target, ~dy: -m.ascent / 2)
    | ~else: Find.right(target, ~dy: -m.ascent / 2)
  callout(~on: on, ~at: at, ~spike: spike, child, ..., ~& kws)

// `replace`, without handing the replacement the identity of the pict it replaced.
//
// `Pict.replace` defaults to `~as_rebuilt: #true`, which re-labels the replacement
// with the replaced pict's identity so that a later rebuild can find the same slot.
// That is the right default for the talk's other uses, and exactly wrong for
// substituting repeatedly: the next `replace` finds the whole inserted group under
// the old identity and swaps *that*, instead of descending to the copies of the
// target inside it. The picture then stops changing after one round.
fun subst(p :: Pict, from :: Pict, to :: Pict) :: Pict:
  p.replace(from, to, ~as_rebuilt: #false)

// A bubble that reaches out to several targets at once. `pict/balloon` draws a
// single spike, and separate arrows to several targets read as wiring rather than
// as one label -- so this draws the body and every spike as one path, which is what
// makes the outline itself protrude the way the deck's other bubbles do.
//
// Every target is met from whichever edge of the body faces it, worked out from
// where things ended up rather than chosen by the caller: the ray from the body's
// centre towards a target leaves the body by one of its four sides, and that is the
// side its spike grows from. The tip is where that same ray, travelling back,
// leaves the target -- so a spike lands on the target's near edge rather than
// aiming at its middle, which is what keeps it clear of whatever sits between.
//
// Spikes on an edge are spread along it in their targets' own order and never
// closer than `~base` allows, and the body grows if an edge is asked for more
// spikes than it has room for. Two spikes whose bases overlap make the outline
// cross itself, and a self-crossing path strokes those inner edges too -- which is
// what draws a line across the middle of a spike.
//
// The body sits just off `on`'s edge by default (`~horiz`/`~vert`/`~gap`). Give
// `~place` a pict already inside `on` to put the body's top-left corner there
// instead, for when the bubble has to land in a particular gap in the picture.
fun multi_callout(~on: on :: Pict,
                  ~at: targets :: List.of(Pict),
                  ~place: place :: maybe(Pict) = #false,
                  ~horiz: horiz :: HorizAlignment = #'right,
                  ~vert: vert :: VertAlignment = #'top,
                  ~gap: gap :: Real = 24,
                  ~dy: dy :: Real = 0,
                  ~color: color :: draw.Color || String = talk_blue,
                  ~padding: padding :: Real = 14,
                  ~base: half_base :: Real = 15,
                  ~corner_radius: cr :: Real = corner_radius,
                  child :: Pict, ...) :: Pict:
  def line_color = as_color(color)
  def content = stack.left(~sep: 6, child, ...)
  // The radius comes from the body the content asks for, not the larger body the
  // spikes may force: a negative `~corner_radius` is a fraction of the smaller side,
  // so measuring it against the grown size would round the corners off in proportion
  // to how many spikes there are, and fatter corners eat the straight edge they need.
  def nat_w = content.width + 2 * padding
  def nat_h = content.height + 2 * padding
  def r = absolute_radius(cr, nat_w, nat_h)
  def pitch = 2 * half_base + 6
  def end_room = r + half_base + 5

  // How far a ray from a box's centre heading (dx, dy) travels before it leaves the
  // box of half-extent (hw, hh), and which pair of sides it leaves by.
  fun exit_scale(hw :: Real, hh :: Real, dx :: Real, dy :: Real) :: Real:
    def sx = if dx == 0 | 1.0e9 | hw / math.abs(dx)
    def sy = if dy == 0 | 1.0e9 | hh / math.abs(dy)
    math.min(sx, sy)
  fun leaves_sideways(hw :: Real, hh :: Real, dx :: Real, dy :: Real) :: Boolean:
    def sx = if dx == 0 | 1.0e9 | hw / math.abs(dx)
    def sy = if dy == 0 | 1.0e9 | hh / math.abs(dy)
    sx <= sy

  fun origin_for(bw :: Real, bh :: Real):
    if place
    | Find.top_left(place).in(on)
    | block:
        def slot = blank(~width: bw, ~height: bh)
        def sdx = if horiz == #'right | bw + gap | -(bw + gap)
        def probe = overlay(~horiz: horiz, ~vert: vert, ~dx: sdx, ~dy: dy, on, slot)
        Find.top_left(slot).in(probe)

  // A provisional body at its natural size is enough to say which edge each target
  // belongs to; growing the body afterwards never moves a target across a side.
  def (px, py) = origin_for(nat_w, nat_h)
  def pcx = px + nat_w / 2
  def pcy = py + nat_h / 2
  def marked:
    for List (tg :: Pict in targets):
      def (tx, ty) = Find.center(tg).in(on)
      def side:
        if leaves_sideways(nat_w / 2, nat_h / 2, tx - pcx, ty - pcy)
        | (if tx > pcx | #'right | #'left)
        | (if ty > pcy | #'bottom | #'top)
      [tg, tx, ty, side]
  fun on_side(s, along :: Int) :: List:
    def picked:
      for List (t in marked):
        skip_when t[3] != s
        t
    picked.sort(fun (a :~ List, b :~ List): (a[along] :~ Real) < (b[along] :~ Real))
  def tops = on_side(#'top, 1)
  def bots = on_side(#'bottom, 1)
  def lefts = on_side(#'left, 2)
  def rights = on_side(#'right, 2)

  fun room_for(n :: Int) :: Real: n * pitch + 2 * end_room
  def w = math.max(nat_w, room_for(math.max(tops.length(), bots.length())))
  def h = math.max(nat_h, room_for(math.max(lefts.length(), rights.length())))
  def (bx, by) = origin_for(w, h)
  def cx = bx + w / 2
  def cy = by + h / 2

  // Bases in their targets' own order, pushed apart to `pitch` and kept inside the
  // corners: one sweep forwards, then one back, the usual way of placing labels
  // along an axis. Keeping the order is also what stops two spikes crossing.
  fun spread(vals :: List, lo :: Real, hi :: Real) :: List:
    def up:
      for values(acc :~ List = []) (v :~ Real in vals):
        def floor = if acc == [] | lo | (acc.last :~ Real) + pitch
        acc ++ [math.max(v, floor)]
    def down:
      for values(acc :~ List = []) (v :~ Real in up.reverse()):
        def ceiling = if acc == [] | hi | (acc.last :~ Real) - pitch
        acc ++ [math.min(v, ceiling)]
    down.reverse()

  fun tip_of(t :~ List) :: List:
    def tg :~ Pict = t[0]
    def tx :~ Real = t[1]
    def ty :~ Real = t[2]
    def s = exit_scale(tg.width / 2, tg.height / 2, cx - tx, cy - ty)
    [tx + (cx - tx) * s - bx, ty + (cy - ty) * s - by]

  def top_xs = for List (t :~ List in tops): (t[1] :~ Real) - bx
  def bot_xs = for List (t :~ List in bots): (t[1] :~ Real) - bx
  def left_ys = for List (t :~ List in lefts): (t[2] :~ Real) - by
  def right_ys = for List (t :~ List in rights): (t[2] :~ Real) - by
  def top_bases = spread(top_xs, end_room, w - end_room)
  def bot_bases = spread(bot_xs, end_room, w - end_room)
  def left_bases = spread(left_ys, end_room, h - end_room)
  def right_bases = spread(right_ys, end_room, h - end_room)

  // the drawing surface has to cover the body and every tip
  def all_tips = for List (t in marked): tip_of(t)
  def (min_x, max_x):
    for values(a :~ Real = 0.0, b :~ Real = w) (p :~ List in all_tips):
      values(math.min(a, p[0] :~ Real), math.max(b, p[0] :~ Real))
  def (min_y, max_y):
    for values(a :~ Real = 0.0, b :~ Real = h) (p :~ List in all_tips):
      values(math.min(a, p[1] :~ Real), math.max(b, p[1] :~ Real))
  def ox = -min_x
  def oy = -min_y
  def k = r * 0.55                     // circle-ish bezier handle, as in `brace`

  def path:
    def pth = draw.Path()
    fun at(x :: Real, y :: Real): [x + ox, y + oy]
    // out to the tip and back, so the base is never drawn: the outline itself is
    // what protrudes, exactly as a balloon's spike does
    fun spikes(items :: List, bases :: List, in_edge, out_edge):
      for (i in 0 .. items.length()):
        def tp :~ List = tip_of(items[i])
        def b :~ Real = bases[i]
        pth.line_to(in_edge(b))
        pth.line_to(at(tp[0] :~ Real, tp[1] :~ Real))
        pth.line_to(out_edge(b))
    // clockwise from the top-left corner
    pth.move_to(at(r, 0))
    spikes(tops, top_bases,
           fun (b): at(b - half_base, 0), fun (b): at(b + half_base, 0))
    pth.line_to(at(w - r, 0))
    pth.curve_to(at(w - k, 0), at(w, k), at(w, r))
    spikes(rights, right_bases,
           fun (b): at(w, b - half_base), fun (b): at(w, b + half_base))
    pth.line_to(at(w, h - r))
    pth.curve_to(at(w, h - k), at(w - k, h), at(w - r, h))
    spikes(bots.reverse(), bot_bases.reverse(),
           fun (b): at(b + half_base, h), fun (b): at(b - half_base, h))
    pth.line_to(at(r, h))
    pth.curve_to(at(k, h), at(0, h - k), at(0, h - r))
    spikes(lefts.reverse(), left_bases.reverse(),
           fun (b): at(0, b + half_base), fun (b): at(0, b - half_base))
    pth.line_to(at(0, r))
    pth.curve_to(at(0, k), at(k, 0), at(r, 0))
    pth.close()
    pth
  def shape:
    dc(fun (d :: draw.DC, ddx, ddy):
         d.path(path, ~dx: ddx, ~dy: ddy),
       ~width: max_x - min_x,
       ~height: max_y - min_y,
       ~fill: pale(line_color),
       ~line: line_color,
       ~line_width: border_width)
  // Centred in the body, not pinned to its top: the body is often larger than the
  // text asked for, because the spikes need a run of edge to leave from, and
  // top-aligning the text puts all of that slack underneath it as a blank patch.
  def bubble:
    overlay(~horiz: #'left, ~vert: #'top,
            ~dx: ox + (w - content.width) / 2, ~dy: oy + (h - content.height) / 2,
            shape, content)
  // the body sits at (ox, oy) inside `bubble`, so undo that to land it where the
  // body was reckoned to go
  overlay(~horiz: #'left, ~vert: #'top, ~dx: bx - ox, ~dy: by - oy, on, bubble)
    .refocus(on)

fun callout_note(~color: color :: draw.Color || String = talk_blue,
                 ~padding: padding :: maybe(Real) = #false,
                 ~corner_radius: cr :: Real = corner_radius,
                 child :: Pict, ...,
                 ~& kws) :: Pict:
  def line_color = as_color(color)
  def content = gap_stack(child, ...)
  def hmargin = padding || balloon.current_horiz_margin()
  def vmargin = padding || balloon.current_vert_margin()
  def (w, h) = body_size(content, hmargin, vmargin)
  balloon.note(content,
               ~hmargin: hmargin,
               ~vmargin: vmargin,
               ~corner_radius: absolute_radius(cr, w, h),
               ~fill: pale(line_color),
               ~line: line_color,
               ~line_width: border_width,
               ~& kws)

// ---------------------------------------------------------------------------
// Arrows between picts that are already placed on `on`.
//
// Ported from `autoarrow` in ../2022-explanations-talk/slidehelpers.rkt, with one
// change: the line runs along the segment between the two centres and stops at
// each pict's bounding box, instead of leaving from whichever side faces the
// other pict. A diagonal edge then meets a box where a ruler would put it, which
// is what Keynote draws for a connector, and a fan of edges out of one node
// spreads around its border instead of bunching up at one side's midpoint.
// `~from_at` and `~to_at` override either end, as `#:finder1`/`#:finder2` did.
//
// `from` and `to` may be Racket picts, such as the ones glide-pptx's runtime
// builds, as long as they are the very picts placed on `on`: that is how they
// are found again.

fun as_pict(q) :: Pict:
  if q is_a Pict | q | Pict.from_handle(q)

// Where a ray from the centre of a `w` by `h` box in direction (dx, dy) leaves
// the box, as a multiple of (dx, dy).
fun border_scale(dx :: Real, dy :: Real, w :: Real, h :: Real) :: Real:
  def far = 1.0e9  // a ray with no run (or no rise) never reaches that pair of sides
  def tx = if math.abs(dx) > 1.0e-9 | (w / 2) / math.abs(dx) | far
  def ty = if math.abs(dy) > 1.0e-9 | (h / 2) / math.abs(dy) | far
  math.min(tx, ty)

fun arrow(~on: on :: Pict,
          from_in,
          to_in,
          ~style: style :: ConnectStyle = #'arrow,
          ~color: color :: draw.Color || String = "black",
          ~line_width: lw :: Real = border_width,
          // the original's 25 on a 6-wide line; `connect` itself defaults to 16
          ~arrow_size: arrow_size :: maybe(Real) = #false,
          ~line_style: line_style :: ConnectLineStyle = #'solid,
          // clearance between each box and the line
          ~gap: gap :: Real = 0,
          // slide the whole line sideways, at right angles to itself. Two nodes
          // can be joined by more than one edge -- an operand feeding an operator
          // *and* an e-class saying they are the same value -- and without this the
          // second lies exactly on top of the first.
          ~shift: shift :: Real = 0,
          ~from_at: from_at :: maybe(Find) = #false,
          ~to_at: to_at :: maybe(Find) = #false,
          ~label: label :: maybe(Pict) = #false,
          ~label_dx: label_dx :: Real = 0,
          ~label_dy: label_dy :: Real = -10,
          ~order: order :: OverlayOrder = #'front) :: Pict:
  def from = as_pict(from_in)
  def to = as_pict(to_in)
  def (fx, fy) = Find.center(from).in(on)
  def (tx, ty) = Find.center(to).in(on)
  def dx = tx - fx
  def dy = ty - fy
  def dist = math.sqrt(dx * dx + dy * dy)
  cond
  | dist < 1.0e-9: on   // one on top of the other: nothing to draw
  | ~else:
      def ux = dx / dist
      def uy = dy / dist
      def tf = border_scale(dx, dy, from.width, from.height)
      def tt = border_scale(dx, dy, to.width, to.height)
      // unit normal to the segment, for `~shift`
      def px = -uy * shift
      def py = ux * shift
      connect(~on: on,
              from_at || Find.center(from, ~dx: dx * tf + ux * gap + px,
                                     ~dy: dy * tf + uy * gap + py),
              to_at || Find.center(to, ~dx: -(dx * tt + ux * gap) + px,
                                   ~dy: -(dy * tt + uy * gap) + py),
              ~style: style,
              ~line: as_color(color),
              ~line_width: lw,
              ~arrow_size: arrow_size || 4 * lw,
              ~line_style: line_style,
              ~label: label,
              ~label_dx: label_dx,
              ~label_dy: label_dy,
              ~order: order)

// Several arrows in one style: `edges` is a list of `[from, to]` pairs.
fun arrows(~on: on :: Pict, edges :: List.of(List), ~& kws) :: Pict:
  for values(p = on) ([from, to] in edges):
    arrow(~on: p, from, to, ~& kws)

// ---------------------------------------------------------------------------
// Where we are in the talk. This is the ICFP talk's outline: a numbered disc per
// section down a spine, each disc its own hue, the one we are on lit and haloed
// and the others dimmed back, with the spine filled in as far as we have got.
//
// What is new here are the two ends: the previous slide's header magic-moves down
// into the list as a divider arrives, and the list then magic-moves back into the
// top margin, the discs flying between a column and a row and the other sections'
// labels fading on the way. That only works because the settled discs and labels are built
// once and handed to both layouts -- `magic_move` matches picts by identity, so a
// disc rebuilt per frame would match nothing and the move would be a dissolve.

fun clamp01(x :: Real) :: Real: math.min(1.0, math.max(0.0, x))
fun absr(x :: Real) :: Real: if x < 0.0 | -x | x
fun lerp(a :: Real, b :: Real, t :: Real) :: Real: a + (b - a) * t
fun smooth(t :: Real) :: Real:
  def u = clamp01(t)
  u * u * (3.0 - 2.0 * u)

// A fully saturated rainbow colour for t in 0..1 (HSV hue -> RGB), as in the
// ICFP talk's `rainbow.rhm`; inlined rather than depending on that whole module.
fun hue_color(t :: Real) :: draw.Color:
  def h = clamp01(t) * 6.0
  fun byte(x :: Real):
    math.min(255, math.max(0, math.exact(math.floor(clamp01(x) * 255.0))))
  draw.Color(byte(absr(h - 3.0) - 1.0), byte(2.0 - absr(h - 2.0)), byte(2.0 - absr(h - 4.0)))

def outline_r = 54.0             // disc radius
// The lit disc carries a halo wider than the disc, and `place_center` at x = r
// would put its left edge past zero -- which grows the row's bounding box to the
// left and shifts every row placed after it, so the discs stop lining up. The
// column sits far enough in for the widest halo to fit.
def outline_left = 44.0
def outline_glow = 50.0          // halo, added to the disc's diameter
def outline_row = 172.0          // one row of the list
def outline_gap = 56.0           // disc to label
def outline_text = 52.0          // label font size

fun hue_of(i :: Int, n :: Int) :: draw.Color:
  hue_color(1.0 * i / math.max(1.0, 1.0 * (n - 1)) * 0.85)

// `hl` is how lit this one is, 0 to 1.
fun outline_disc(i :: Int, n :: Int, hl :: Real) :: Pict:
  def hue = hue_of(i, n)
  def rr = outline_r * (1.0 + 0.18 * hl)
  def num:
    def b = bold("" +& (i + 1))
    b.scale(outline_r * 0.86 / b.height * (1.0 + 0.12 * hl))
  def core = overlay(circle(~size: rr * 2, ~fill: hue, ~line: #false),
                     num.colorize(draw.Color(255, 255, 255)))
  def glow = circle(~size: rr * 2 + outline_glow, ~fill: hue, ~line: #false).alpha(0.34 * hl)
  overlay(glow, core.alpha(lerp(0.55, 1.0, hl)))

// The settled label is plain text, not the writer's last frame: `write_out` leaves
// its final glyph heavier than the rest, and that frame is what the header would
// otherwise carry for the whole section. The ICFP talk swaps the same way.
fun outline_plain(str :: String) :: Pict:
  parameterize { current_font: current_font() with (size = outline_text) }:
    t(str)

fun outline_writer(str :: String, ~color: color) :: Pict:
  write.write_out(str, ~font: current_font() with (size = outline_text),
                  ~color: color, ~extent: 1.0)

// A label at highlight `hl`: the accent when we are on it, ordinary text dimmed
// back when we are not, and a touch larger when lit.
//
// It takes the two colourings rather than one and a `colorize`, because `colorize`
// only replaces an *inherited* colour and `write_out` draws with an explicit one --
// so recolouring a written label does nothing and every label comes out black.
fun outline_label(dim :: Pict, lit :: Pict, hl :: Real) :: Pict:
  overlay(dim.alpha(lerp(0.62, 0.0, hl)), lit.alpha(hl)).scale(lerp(1.0, 1.08, hl))

fun place_center(base :: Pict, p :: Pict, cx :: Real, cy :: Real) :: Pict:
  overlay(~horiz: #'left, ~vert: #'top,
          ~dx: cx - p.width / 2, ~dy: cy - p.height / 2, base, p)
fun place_left(base :: Pict, p :: Pict, x :: Real, cy :: Real) :: Pict:
  overlay(~horiz: #'left, ~vert: #'top, ~dx: x, ~dy: cy - p.height / 2, base, p)

// `~label_width` is the room the labels get. The list is centred on the canvas,
// so its width decides where it sits -- and a lit label is 8% wider than a dim
// one, so measuring the labels handed in would move the whole list sideways as
// the lit one changes. The discs hide a 20pt drift; the thin, faint spine does
// not, and drifting across pixel boundaries made it flicker. Callers that
// animate pass the width of the widest label at its lit size, once.
fun outline_layout(discs :: List.of(Pict), labels :: List.of(Pict),
                   ~current: current :: Real, ~canvas: canvas :: Pict,
                   ~color: color = talk_blue,
                   ~label_width: label_width :: maybe(Real) = #false,
                   ~disc_prog: disc_prog :: maybe(List) = #false) :: Pict:
  def line_color = as_color(color)
  def n = discs.length()
  def lab_w = label_width
                || (for values(m :~ Real = 0.0) (p :~ Pict in labels): math.max(m, p.width))
  def disc_cx = outline_left + outline_r
  def w = disc_cx + outline_r + outline_gap + lab_w
  def h = n * outline_row
  def base = blank(~width: w, ~height: h)
  fun row_cy(i :: Real) :: Real: i * outline_row + outline_row / 2
  def y0 = row_cy(0.0)
  def yN = row_cy(1.0 * (n - 1))
  def spine:
    place_center(base,
                 rectangle(~width: 9.0, ~height: yN - y0,
                           ~fill: draw.Color(120, 120, 120), ~line: #false,
                           ~rounded: -0.5).alpha(0.22),
                 disc_cx, (y0 + yN) / 2)
  def cc = math.max(0.0, math.min(1.0 * (n - 1), current))
  def yfill = row_cy(cc)
  def walked:
    if yfill - y0 > 0.5
    | place_center(spine,
                   rectangle(~width: 9.0, ~height: yfill - y0, ~fill: line_color,
                             ~line: #false, ~rounded: -0.5),
                   disc_cx, (y0 + yfill) / 2)
    | spine
  recur go(i = 0, acc :~ Pict = walked):
    if i >= n
    | overlay(canvas, acc).refocus(canvas)
    | def dp :~ Real = (if disc_prog | (disc_prog[i] :~ Real) | 1.0)
      def acc1 = place_center(acc, discs[i].scale(smooth(dp)), disc_cx, row_cy(1.0 * i))
      go(i + 1, place_left(acc1, labels[i], disc_cx + outline_r + outline_gap, row_cy(1.0 * i)))

// The same discs and labels shrunk into the top margin. Only the section we are
// on keeps its label; the rest are simply absent, so `magic_move` fades them.
fun header_layout(discs :: List.of(Pict), labels :: List.of(Pict),
                  ~at: at :: Int, ~canvas: canvas :: Pict,
                  ~disc_scale: ds :: Real = 0.30,
                  ~text_scale: ts :: Real = 0.44,
                  ~dx: dx :: Real = 64.0, ~cy: cy :: Real = 36.0) :: Pict:
  def n = discs.length()
  def step = outline_r * 2 * ds + 20.0
  recur go(i = 0, acc :~ Pict = canvas):
    if i >= n
    | place_left(acc, labels[at].scale(ts), dx + n * step + 14.0, cy).refocus(canvas)
    | go(i + 1, place_center(acc, discs[i].scale(ds),
                             dx + outline_r * ds + i * step, cy))

fun outline_to_header(items :: List.of(String),
                      ~at: at :: Int,
                      ~canvas: canvas :: Pict,
                      ~color: color = talk_blue,
                      ~intro: intro :: Boolean = #false,
                      ~extent: extent :: Real = 1.2) :: Pict:
  def n = items.length()
  def line_color = as_color(color)
  def writers = for List (s in items): outline_writer(s, ~color: draw.Color(0, 0, 0))
  def plain = for List (s in items): outline_plain(s)
  def written = for List (q :~ Pict in plain): q.colorize(draw.Color(0, 0, 0))
  def written_lit = for List (q :~ Pict in plain): q.colorize(line_color)
  // the settled pieces, built once: these are what the header shows and what the
  // move matches on
  // the widest label at its lit size, so every layout below is the same width
  def lab_w = 1.08 * (for values(m :~ Real = 0.0) (q :~ Pict in plain): math.max(m, q.width))
  def discs = for List (i in 0..n): outline_disc(i, n, (if i == at | 1.0 | 0.0))
  def labels = for List (i in 0..n):
                 outline_label(written[i], written_lit[i], (if i == at | 1.0 | 0.0))
  def full = outline_layout(discs, labels, ~current: 1.0 * at, ~canvas: canvas, ~color: color,
                            ~label_width: lab_w)
  def head = header_layout(discs, labels, ~at: at, ~canvas: canvas)
  def opening:
    if intro
    | block:
        // each row writes itself out, its disc popping in just ahead of the text
        def step = 0.62 / math.max(1.0, 1.0 * n)
        animate(~extent: 2.6,
                fun (p):
                  if p >= 1.0
                  | full
                  | block:
                      def prog = for List (i in 0..n): clamp01((p - i * step) / 0.36)
                      def ls = for List (i in 0..n):
                                 def rv = prog[i]
                                 def lab = outline_label(written[i], written_lit[i],
                                                         (if i == at | clamp01((p - 0.84) / 0.16) | 0.0))
                                 if rv >= 1.0
                                 | lab
                                 | overlay(~horiz: #'left, ~vert: #'top,
                                           lab.ghost(),
                                           (writers[i] :~ Pict).snapshot(0, clamp01(rv)))
                      def ds = for List (i in 0..n):
                                 outline_disc(i, n, (if i == at | clamp01((p - 0.84) / 0.16) | 0.0))
                      outline_layout(ds, ls, ~current: lerp(-1.0, 1.0 * at, clamp01((p - 0.84) / 0.16)),
                                     ~canvas: canvas, ~color: color, ~label_width: lab_w,
                                     ~disc_prog: prog))
    | block:
        // The header of the slide just left, exactly as `section_header` drew it,
        // magic-moving back down into the list: the discs fly from their row into
        // the column, the label of the section just finished grows back to its
        // place, and the other labels and the spine fade in around them. It is
        // built from its own settled discs and labels, so that the two layouts
        // share the picts the move matches on.
        def prev = math.max(0, at - 1)
        def discs0 = for List (i in 0..n): outline_disc(i, n, (if i == prev | 1.0 | 0.0))
        def labels0 = for List (i in 0..n):
                        outline_label(written[i], written_lit[i], (if i == prev | 1.0 | 0.0))
        def head0 = header_layout(discs0, labels0, ~at: prev, ~canvas: canvas)
        def full0 = outline_layout(discs0, labels0, ~current: 1.0 * prev,
                                   ~canvas: canvas, ~color: color, ~label_width: lab_w)
        def descent = magic_move(head0, full0, ~extent: extent, ~other: #'fade).time_pad(~after: -1)
        // the marker walking down from the section just finished to this one
        def walk:
          animate(~extent: 1.4,
                  fun (p):
                    if p >= 1.0
                    | full
                    | block:
                        def cur = lerp(1.0 * (at - 1), 1.0 * at, smooth(p))
                        def ds = for List (i in 0..n):
                                   outline_disc(i, n, clamp01(1.0 - absr(cur - i)))
                        def ls = for List (i in 0..n):
                                   outline_label(written[i], written_lit[i], clamp01(1.0 - absr(cur - i)))
                        outline_layout(ds, ls, ~current: cur, ~canvas: canvas, ~color: color,
                                       ~label_width: lab_w))
        // spliced: the walk starts the moment the descent lands, in the same beat,
        // so arriving at the slide still costs no press before the move up
        switch(descent, walk, ~join: #'splice)
  // `magic_move`'s epoch 0 *is* the move and its epoch 1 is the settled result --
  // measured, not assumed -- so it is the tail that has to go, not the head.
  // `~other: #'fade` -- the picts the two layouts do *not* have in common are the
  // three labels the header drops, and `magic_move`'s default `#'switch` cuts them
  // out abruptly. Fading them lets them go with the discs they belong to.
  switch(opening,
         magic_move(full, head, ~extent: extent, ~other: #'fade).time_pad(~after: -1))

fun section_header(items :: List.of(String),
                   ~at: at :: Int,
                   ~canvas: canvas :: Pict,
                   ~color: color = talk_blue) :: Pict:
  def n = items.length()
  def line_color = as_color(color)
  def plain = for List (s in items): outline_plain(s)
  def written = for List (q :~ Pict in plain): q.colorize(draw.Color(0, 0, 0))
  def written_lit = for List (q :~ Pict in plain): q.colorize(line_color)
  def discs = for List (i in 0..n): outline_disc(i, n, (if i == at | 1.0 | 0.0))
  def labels = for List (i in 0..n):
                 outline_label(written[i], written_lit[i], (if i == at | 1.0 | 0.0))
  header_layout(discs, labels, ~at: at, ~canvas: canvas)

// A horizontal curly brace; `#'down` puts the tip at the bottom.
fun brace(~width: width :: Real,
          ~height: height :: Real = 12,
          ~dir: dir :: matching(#'down || #'up) = #'down,
          ~color: color :: draw.Color || String = "black",
          ~line_width: lw :: Real = 2) :: Pict:
  def r = math.min(height / 2, width / 4)     // arm radius, never past midspan
  def k = r * 0.55                            // circle-ish bezier handle
  def mid = width / 2
  // Each half is its own `Path`: sharing one path makes the second `move_to`
  // close the first subpath, which strokes a diagonal back to its start.
  fun half(end_x :: Real, sign :: Real) :: draw.Path:
    // `sign` is +1 for the left half, -1 for the right
    def p = draw.Path()
    p.move_to([end_x, 0])
    p.curve_to([end_x, k], [end_x + sign * (r - k), r], [end_x + sign * r, r])
    p.line_to([mid - sign * r, r])
    p.curve_to([mid - sign * (r - k), r], [mid, r + k], [mid, 2 * r])
    p
  def left = half(0, 1)
  def right = half(width, -1)
  def p:
    dc(fun (dc :: draw.DC, dx, dy):
         dc.path(left, ~dx: dx, ~dy: dy)
         dc.path(right, ~dx: dx, ~dy: dy),
       ~width: width,
       ~height: 2 * r,
       ~line: color,
       ~line_width: lw)
  if dir == #'down | p | p.vflip()

fun braced(~width: width :: Real,
           ~height: height :: Real = 12,
           ~dir: dir :: matching(#'down || #'up) = #'down,
           ~color: color :: draw.Color || String = "black",
           ~line_width: lw :: Real = 2,
           ~sep: sep :: Real = 6,
           label :: Pict) :: Pict:
  def b = brace(~width: width, ~height: height, ~dir: dir,
                ~color: color, ~line_width: lw)
  if dir == #'down
  | stack(~sep: sep, b, label)
  | stack(~sep: sep, label, b)

// ---------------------------------------------------------------------------

// Reveal `extra` over `base` by fading it in as one new slide step, rather than
fun fade_in(base :: Pict, extra :: Pict,
            ~horiz: horiz :: HorizAlignment = #'center,
            ~vert: vert :: VertAlignment = #'center,
            ~dx: dx :: Real = 0,
            ~dy: dy :: Real = 0) :: Pict:
  def settled = base.snapshot(math.max(0, base.duration - 1), 1.0)
  fun over(e :: Pict) :: Pict:
    overlay(~horiz: horiz, ~vert: vert, ~dx: dx, ~dy: dy, settled, e)
      .refocus(settled)
  // Two epochs, not three: the fade's own last frame is already `extra` at full
  switch(base,
         animate(fun (t): over(extra.alpha(t))))

// Dissolve `from` into `to` over one epoch. Unlike `cross_fade`, the two are
// only briefly on screen together (`~overlap` of the epoch), so blocks of text
// that don't line up don't spend the middle of the transition mashed together.
fun fade_through(from :: Pict, to :: Pict,
                 ~overlap: overlap :: Real = 0.15,
                 ~extent: extent :: Real = 1,
                 ~horiz: horiz :: HorizAlignment = #'center,
                 ~vert: vert :: VertAlignment = #'center) :: Pict:
  def out_end = (1.0 + overlap) / 2.0        // `from` is gone by here
  def in_start = (1.0 - overlap) / 2.0       // `to` starts here
  fun clamp01(x :: Real) :: Real: math.min(1.0, math.max(0.0, x))
  def slot = overlay(~horiz: horiz, ~vert: vert, from.ghost(), to.ghost())
  animate(~extent: extent,
          fun (n):
            overlay(~horiz: horiz, ~vert: vert,
                    slot,
                    from.alpha(clamp01((out_end - n) / out_end)),
                    to.alpha(clamp01((n - in_start) / (1.0 - in_start)))))

// `timeline` launders its epoch dots, so their positions have to be derived
// from its layout. Keep in sync with pict/private/timeline_pict.rhm.
fun explain_times(duration :: Int, steps :: PosInt = 4) :: List:
  List.append(& for List (i in 0..duration):
                  for List (s in 0..steps):
                    if s == 0 | i | i + s * math.inexact(1/steps))
    ++ [duration]

class TimelineGeom(dot_x0 :: Real, pitch :: Real, dot_y :: Real, span :: Real):
  // centre of the k'th sample column, from the timeline's left edge
  method dot_cx(k :: Int) :: Real: dot_x0 + k * pitch

// `p` is what was passed to `explain_anim`; `tl` is the timeline it returned.
fun timeline_geom(p :: Pict, tl :: Pict, ~steps: steps :: PosInt = 4) :: TimelineGeom:
  def times = explain_times(p.duration, steps)
  def snaps :~ List.of(Pict):
    for List (t in times):
      p.snapshot(math.exact(math.floor(t)), t - math.floor(t))
  def w: for values(m = 0.0) (s :~ Pict in snaps): math.max(m, s.width)
  def imgs_h: for values(m = 0.0) (s :~ Pict in snaps): math.max(m, s.height)
  def n = times.length()
  def pitch = w + 20
  // whichever row is wider decides where the dots row starts
  def dots_row_w = n * 10 + (n - 1) * (w + 10) + 48
  def imgs_row_w = n * w + (n - 1) * 20
  def inner_w = math.max(dots_row_w, imgs_row_w)
  TimelineGeom(20 + (inner_w - dots_row_w) / 2 + 24 + 5,
               pitch,
               // dots sit at the bottom of the dots row, which is what is left
               // of the height once the pads, the gap and the snapshots go
               10 + (tl.height - 20 - 10 - imgs_h) - 5,
               // first dot to last -- symmetric, so a centred brace of this
               // width lines up under the timeline with no further offsetting
               (n - 1) * pitch)

// An animation changes size as it runs, and every combiner re-lays-out each
// frame -- so a running pict drags its neighbours around, and a lone one drifts
// as the slide re-centres. `anim_box` is an empty box as big as `p` ever gets:
// four samples an epoch is enough to bound code that grows into a picture.
fun anim_box(p :: Pict) :: Pict:
  def q :~ Pict = p
  overlay(~horiz: #'left, ~vert: #'top,
          & (for List (i in 0 .. math.max(1, q.duration)):
               overlay(~horiz: #'left, ~vert: #'top,
                       & (for List (k in 0 .. 5):
                            q.snapshot(i, k / 4.0).ghost()))))

fun in_anim_box(p :: Pict,
                ~horiz: horiz :: HorizAlignment = #'left,
                ~vert: vert :: VertAlignment = #'top) :: Pict:
  overlay(~horiz: horiz, ~vert: vert, anim_box(p), p)

fun on_ghost(p :: Pict, make :: Function.of_arity(1)) :: Pict:
  def g = p.ghost()
  (make(g) :~ Pict).refocus(g)

// A small labelled box, wider than it is tall, that highlights by swapping its
// border to `talk_blue` at double width.
fun make_node(label :: String, highlighted = #false) :: Pict:
  def element = t(label)
  rectangle(~around: element,
            ~width: math.max(50, element.width + 10),
            ~height: element.height + 10,
            ~fill: draw.Color("gray").scale(2),   // a single `light`, unlike the bubbles
            ~line: if highlighted | talk_blue | draw.Color("black"),
            ~line_width: if highlighted | border_width * 2 | border_width,
            ~rounded: corner_radius,
            ~refocus: #false)
