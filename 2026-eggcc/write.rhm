#lang rhombus
// Writing things out, the way 3Blue1Brown does: a pen traces the outline of each
// letter and the ink fills in behind it; a box has its border drawn and its fill
// faded up under it; anything that is neither -- a photograph, a robot -- simply
// fades up. All of it from the geometry the thing was drawn with, never from its
// pixels.
//
// The protocol is small. A primitive that knows how it is drawn -- `written_text`,
// `written_shape`, `written_stroke` -- carries an `Arrival` in its metadata: a
// function from progress to a frame, with the same bounds as the thing itself. A
// composite of such primitives is an ordinary pict; `write(p)` walks it, finds the
// primitives with their places and scales, and plays their arrivals one after
// another with some overlap, in the order the picture was put together. A leaf
// the walk cannot see into is faded in. A part a ghost only reserves room for is
// skipped, because a ghost draws nothing and the walk asks each piece whether it
// draws before it looks inside.
//
// `write(p)` is one epoch with `p` itself as its last frame, so it costs no press
// that `p` did not already cost: writing changes an epoch's extent, never a pict's
// duration. `unwrite(p)` is the same played backwards, for words that are being
// taken back before others replace them.

import:
  pict open
  draw
  "ink.rhm" open

export:
  Arrival
  arriving
  arrival_of
  already
  popped
  faded
  ink_bounds
  written_text
  written_shape
  written_stroke
  text_pen_width
  Writer
  writer
  write
  unwrite
  extent_for
  unwrite_pace
  words_of
  rewrite_between
  looks_same
  as_written
  settled
  moving
  current_draw
  smooth
  clamp01
  lerp
  as_color

// ------------------------------------------------------------------ small sums

fun clamp01(x :: Real) :: Real: math.min(1.0, math.max(0.0, x))
fun lerp(a :: Real, b :: Real, t :: Real) :: Real: a + (b - a) * t
fun smooth(t :: Real) :: Real:
  def u = clamp01(t)
  u * u * (3.0 - 2.0 * u)
fun as_color(c) :: draw.Color:
  if c is_a draw.Color | c | draw.Color(c)

// How much of a line to draw. An arrow between two nodes is not written from an
// outline -- its geometry is known, so the honest thing is to draw the first `n` of
// it with the head at the nib. `magic_between` binds this for the edges a press is
// bringing on, and `arrow` reads it.
Parameter.def current_draw :: Real: 1.0

// ------------------------------------------------------------------ the protocol

// How a pict arrives: `frame(n)` is the picture at progress `n` in 0..1, with the
// pict's own bounds, and `frame(1)` is the pict. `weight` is how long the arrival
// wants, in seconds, before the whole is fitted to the extent it is given. `lead`
// is how far through this arrival the next part of a picture may begin: words
// start early on a shell that is still filling in, late on a word before them.
// `kind` says what it is -- `#'text`, `#'shape`, `#'stroke`, `#'still` -- so the
// words of a picture can be told from its boxes.
class Arrival(frame :: Function.of_arity(1), weight :: Real,
              ~kind: kind = #'shape, ~lead: lead :: Real = 0.6)

fun arriving(p :: Pict, a :: Arrival) :: Pict:
  p.set_metadata(p.metadata() ++ { #'arrival: a })

fun arrival_of(p :: Pict) :: maybe(Arrival):
  def m = p.metadata()
  if m.has_key(#'arrival) | m[#'arrival] | #false

// `p`, already there: it takes no time and is simply present once the press is
// over. For a copy laid exactly over ink that is on the slide already -- the pieces
// of a line that are about to fly out of it -- where writing it again would trace
// letters the room can already see, and showing it early would show them before
// the ink under it has been written. It has no words of its own, so a press that
// turns it into something else cross-fades rather than rewording.
fun already(p :: Pict) :: Pict:
  arriving(p, Arrival(fun (n): if n >= 1.0 | p | p.ghost(), 0.0, ~kind: #'still, ~lead: 0.0))

// Two arrivals for things that are not written. A label pops: it grows in from a
// little smaller than itself, overshooting a touch as it fades up, the way a label
// arrives in a Manim scene -- for a big short word over a picture, which is read at
// a glance rather than followed letter by letter. A title fades where it stands.
// Both keep the pict's own bounds, so what they are placed by never moves.
fun back_out(t :: Real) :: Real:
  def c1 = 1.70158
  def c3 = c1 + 1.0
  1.0 + c3 * math.expt(t - 1.0, 3) + c1 * math.expt(t - 1.0, 2)
fun pop_frame(p :: Pict, n :: Real) :: Pict:
  cond
  | n >= 1.0: p
  | n <= 0.0: p.ghost()
  | ~else:
      def k = back_out(n)
      def s = 0.55 + 0.45 * k
      def a = smooth(clamp01(n / 0.6))
      // from a little below its place, up into it -- overshooting with the scale
      def g = p.ghost()
      overlay(~dy: 0.45 * p.height * (1.0 - k), g, p.scale(s).alpha(a)).refocus(g)
fun popped(p :: Pict, ~weight: weight :: Real = 0.45) :: Pict:
  arriving(p, Arrival(fun (n): pop_frame(p, n), weight, ~kind: #'pop, ~lead: 0.5))
fun faded(p :: Pict, ~weight: weight :: Real = 0.6) :: Pict:
  arriving(p, Arrival(fun (n):
                        cond
                        | n >= 1.0: p
                        | n <= 0.0: p.ghost()
                        | ~else: p.alpha(smooth(n)),
                      weight, ~kind: #'fade, ~lead: 0.5))

// Where a pict's ink is, as `[x0, y0, x1, y1]` in its own coordinates, or `#false`
// for one that draws nothing. For lining things up on what is drawn rather than on
// a box that may carry a margin of transparent padding.
fun ink_bounds(p :: Pict) :: maybe(List):
  def w = math.exact(math.ceiling(p.width))
  def h = math.exact(math.ceiling(p.height))
  cond
  | w <= 0 || h <= 0: #false
  | ~else:
      def bm = draw.Bitmap([w + 2, h + 2])
      p.draw(bm.make_dc(), ~dx: 1, ~dy: 1)
      def px = bm.argb_pixels()
      def bw = w + 2
      def found:
        for values(b :~ List = [bw, h + 2, -1, -1]) (i in 0..bw * (h + 2)):
          skip_when px[i * 4] <= 8
          def x = i mod bw
          def y = i div bw
          [math.min(b[0], x), math.min(b[1], y), math.max(b[2], x), math.max(b[3], y)]
      if found[2] < 0
      | #false
      | [found[0] - 1, found[1] - 1, found[2], found[3]]

// ------------------------------------------------------------------ text

fun text_pen_width(font :: draw.Font) :: Real:
  math.max(1.4, font.size / 20.0)

// A string, written: each glyph's outline is traced and then the glyph fills in as
// the outline fades out from under the fill, glyph after glyph with the overlap
// manim gives its `Write`. At rest it is exactly `text(str, ~font: font)` in the
// colour asked for -- the outline path and the drawn text land on the same pixels.
fun written_text(str :: String,
                 ~font: font :: draw.Font = draw.Font(),
                 ~color: color = "black") :: Pict:
  def col = as_color(color)
  def base = text(str, ~font: font).colorize(col)
  def lw = text_pen_width(font)
  def cell = Array(#false)
  fun glyphs() :: List:
    when !cell[0]
    | cell[0] := text_glyphs(text_ink(str, font))
    cell[0]
  fun frame(n :: Real) :: Pict:
    cond
    | n >= 1.0: base
    | n <= 0.0: base.ghost()
    | ~else:
        def gs = glyphs()
        def G = math.max(1, gs.length())
        // the staggered start, as manim has it: every glyph takes the same share,
        // and the next begins before the last is done
        def lag = math.min(4.0 / (G + 1.0), 0.2)
        def tt = (G - 1) * lag + 1.0
        dc(fun (target :: draw.DC, dx, dy):
             target.save()
             for (g :~ Ink in gs, i in 0..):
               def u = n * tt - i * lag
               cond
               | u <= 0.0: #void
               | u >= 1.0:
                   target.pen := draw.Pen.none
                   target.brush := draw.Brush(~color: col)
                   target.path(path_of(g), ~dx: dx, ~dy: dy)
               | u < 0.5:
                   stroke_prefix(target, g, 2.0 * u, draw.Pen(~color: col, ~width: lw),
                                 ~dx: dx, ~dy: dy)
               | ~else:
                   // the fill comes in as the traced line goes out from under it, so
                   // the finished glyph is no heavier than one that was simply drawn
                   def fill_in = (u - 0.5) * 2.0
                   target.pen := draw.Pen.none
                   target.brush := draw.Brush(~color: col with (alpha = fill_in))
                   target.path(path_of(g), ~dx: dx, ~dy: dy)
                   stroke_prefix(target, g, 1.0,
                                 draw.Pen(~color: col with (alpha = 1.0 - fill_in), ~width: lw),
                                 ~dx: dx, ~dy: dy)
             target.restore(),
           ~width: base.width, ~height: base.height,
           ~ascent: base.ascent, ~descent: base.descent)
  arriving(base, Arrival(frame, math.min(1.8, 0.5 + 0.035 * str.length()), ~kind: #'text))

// ------------------------------------------------------------------ shapes

// A shape drawn from a path: its fill, then its outline. Writing it traces the
// outline with the pen while the fill fades up underneath, and whatever is inside
// it may start writing as soon as the outline is a third drawn. `~paint` replaces
// the plain fill with a painter of its own, for a box in two colours; it is handed
// the opacity the fill has reached.
fun written_shape(path :: draw.Path,
                  ~width: w :: Real, ~height: h :: Real,
                  ~ascent: ascent :: Real = h, ~descent: descent :: Real = 0,
                  ~fill: fill = #false,
                  ~line: line = #false,
                  ~line_width: lw :: Real = 3.0,
                  ~style: style :: draw.Pen.Style = #'solid,
                  ~paint: paint = #false) :: Pict:
  def line_color = line && as_color(line)
  def fill_color = fill && as_color(fill)
  fun pen() :: draw.Pen:
    if line_color
    | draw.Pen(~color: line_color, ~width: lw, ~style: style)
    | draw.Pen.none
  fun paint_fill(target :: draw.DC, dx, dy, alpha :: Real):
    cond
    | paint: paint(target, dx, dy, alpha)
    | fill_color:
        def c :~ draw.Color = fill_color
        target.pen := draw.Pen.none
        target.brush := draw.Brush(~color: c with (alpha = c.alpha * alpha))
        target.path(path, ~dx: dx, ~dy: dy)
    | ~else: #void
  def base:
    dc(fun (target :: draw.DC, dx, dy):
         target.save()
         paint_fill(target, dx, dy, 1.0)
         when line_color
         | target.pen := pen()
           target.brush := draw.Brush.none
           target.path(path, ~dx: dx, ~dy: dy)
         target.restore(),
       ~width: w, ~height: h, ~ascent: ascent, ~descent: descent)
  def cell = Array(#false)
  fun ink() :: Ink:
    when !cell[0]
    | cell[0] := path_ink(path)
    cell[0]
  fun frame(n :: Real) :: Pict:
    cond
    | n >= 1.0: base
    | n <= 0.0: base.ghost()
    | ~else:
        dc(fun (target :: draw.DC, dx, dy):
             target.save()
             paint_fill(target, dx, dy, smooth(if line_color | n / 0.7 | n))
             when line_color
             | stroke_prefix(target, ink(), clamp01(n / 0.6), pen(), ~dx: dx, ~dy: dy)
             target.restore(),
           ~width: w, ~height: h, ~ascent: ascent, ~descent: descent)
  arriving(base, Arrival(frame, math.min(1.1, 0.4 + (w + h) / 900.0),
                         ~kind: #'shape, ~lead: 0.3))

// A line drawn along a path with a pen -- a fat translucent one for the tube round
// an e-class, a dashed one for the equality down its middle. Writing it is the pen
// travelling the path.
fun written_stroke(path :: draw.Path, ~width: w :: Real, ~height: h :: Real,
                   ~pen: pen :: draw.Pen,
                   ~weight: weight :: Real = 0.6) :: Pict:
  def base:
    dc(fun (target :: draw.DC, dx, dy):
         target.save()
         target.pen := pen
         target.brush := draw.Brush.none
         target.path(path, ~dx: dx, ~dy: dy)
         target.restore(),
       ~width: w, ~height: h)
  def cell = Array(#false)
  fun ink() :: Ink:
    when !cell[0]
    | cell[0] := path_ink(path)
    cell[0]
  fun frame(n :: Real) :: Pict:
    cond
    | n >= 1.0: base
    | n <= 0.0: base.ghost()
    | ~else:
        dc(fun (target :: draw.DC, dx, dy):
             target.save()
             stroke_prefix(target, ink(), n, pen, ~dx: dx, ~dy: dy)
             target.restore(),
           ~width: w, ~height: h)
  arriving(base, Arrival(frame, weight, ~kind: #'stroke))

// ------------------------------------------------------------------ the walk

// A piece of a picture that arrives on its own: what it is, how (or `#false` to
// fade), and where it sits in the root's coordinates, at what scale.
class Part(pict :: Pict, arrival :: maybe(Arrival),
           x :: Real, y :: Real, sx :: Real, sy :: Real)

// Whether a pict draws anything at all, found out by drawing it small. A ghost, a
// blank and an invisible layer all say no, and that is how the walk knows to leave
// them alone -- there is no other way to ask.
fun has_ink(p :: Pict) :: Boolean:
  def w = p.width
  def h = p.height
  cond
  | w <= 0.0 || h <= 0.0: #false
  | ~else:
      def s = math.min(1.0, 160.0 / math.max(w, h))
      def bw = math.exact(math.ceiling(w * s)) + 2
      def bh = math.exact(math.ceiling(h * s)) + 2
      def bm = draw.Bitmap([bw, bh])
      def q = if s < 1.0 | p.scale(s) | p
      q.draw(bm.make_dc(), ~dx: 1, ~dy: 1)
      def px = bm.argb_pixels()
      recur go(i = 0):
        cond
        | i >= bw * bh: #false
        | px[i * 4] > 8: #true
        | ~else: go(i + 1)

// Whether two picts draw the same picture, found out by drawing them: the same
// size, and the same pixels at a quarter of it, give or take anti-aliasing. A
// scene rebuilt for every press makes a new pict for each of its keys, and this is
// how the ones that did not change are told from the ones that did.
fun looks_same(a :: Pict, b :: Pict) :: Boolean:
  def pa = settled(a)
  def pb = settled(b)
  cond
  | math.abs(pa.width - pb.width) > 0.5 || math.abs(pa.height - pb.height) > 0.5: #false
  | pa.width <= 0.0 || pa.height <= 0.0: #true
  | ~else:
      def s = 0.25
      def w = math.exact(math.ceiling(pa.width * s)) + 2
      def h = math.exact(math.ceiling(pa.height * s)) + 2
      fun pixels(p :: Pict):
        def bm = draw.Bitmap([w, h])
        p.scale(s).draw(bm.make_dc(), ~dx: 1, ~dy: 1)
        bm.argb_pixels()
      def xa = pixels(pa)
      def xb = pixels(pb)
      recur go(i = 0, bad = 0):
        cond
        | bad > 8: #false
        | i >= w * h * 4: #true
        | math.abs(xa[i] - xb[i]) > 24: go(i + 1, bad + 1)
        | ~else: go(i + 1, bad)

// Where `k` sits inside `node`: its top-left and its size as placed, or `#false`
// when it is not there once and only once.
fun locate(k :: Pict, node :: Pict) :: maybe(List):
  try:
    def (x0, y0) = Find.top_left(k).maybe_in(node)
    def (x1, y1) = Find.bottom_right(k).maybe_in(node)
    if x0 && x1 && y0 && y1
    | [x0, y0, x1 - x0, y1 - y0]
    | #false
    ~catch _:
      #false

fun parts_of(root :: Pict) :: List:
  fun walk(node :: Pict, x :: Real, y :: Real, sx :: Real, sy :: Real, acc :~ List) :: List:
    def a = arrival_of(node)
    def kids = node.children
    cond
    | a: acc ++ [Part(node, a, x, y, sx, sy)]
    | kids == []: acc ++ [Part(node, #false, x, y, sx, sy)]
    | ~else:
        def inked = for List (k :~ Pict in kids): keep_when has_ink(k); k
        def spots = for List (k :~ Pict in inked): locate(k, node)
        if spots.contains(#false)
        | // something inside is drawn twice, or cannot be placed: the whole piece
          // comes in at once instead
          acc ++ [Part(node, #false, x, y, sx, sy)]
        | for values(a2 :~ List = acc) (k :~ Pict in inked, spot :~ List in spots):
            def [kx, ky, kw, kh] = spot
            def ksx = if k.width > 0.0 | sx * kw / k.width | sx
            def ksy = if k.height > 0.0 | sy * kh / k.height | sy
            walk(k, x + sx * kx, y + sy * ky, ksx, ksy, a2)
  if has_ink(root) | walk(root, 0.0, 0.0, 1.0, 1.0, []) | []

// The words of a picture, in the order they are written: what a press compares to
// decide whether a key has been reworded or merely restyled.
fun words_of(p :: Pict) :: List:
  for List (part :~ Part in parts_of(p)):
    keep_when part.arrival && (part.arrival :~ Arrival).kind == #'text
    def d :~ List = part.pict.description()
    keep_when d.length() > 0
    d[0]

// ------------------------------------------------------------------ the writer

// How long a piece that only fades wants, and how far into it the next may start.
def fade_weight = 0.5
def fade_lead = 0.5
// The pace, which scales what the parts add up to: under 1 is quicker. The limits
// are wide, so that what a picture takes follows how much there is to write rather
// than cramming a long sentence into the time a short one gets.
def write_cap = 3.0
def write_floor = 0.3
def write_pace = 0.5
// Taking words back is quicker than putting them down: an unwrite runs at this
// share of the write's time.
def unwrite_pace = 0.5
// The most a picture's parts may add up to, in weight. Past this the parts are
// started closer together rather than the picture taking longer: a long paragraph
// has its lines in flight at once, the way Manim's `Write` shortens its lag as the
// text grows, and finishes in the same time a shorter one would.
def write_span = 4.0

class Writer(root :: Pict, parts :: List, starts :: List, durs :: List, total :: Real):
  // The picture at progress `n`, linear in time.
  method frame(n :: Real) :: Pict:
    cond
    | n >= 1.0: root
    | n <= 0.0 || parts == []: root.ghost()
    | ~else:
        def t = n * total
        def g = root.ghost()
        def drawn:
          for values(acc :~ Pict = g) (i in 0..parts.length()):
            def part :~ Part = parts[i]
            def start :~ Real = starts[i]
            def dur :~ Real = durs[i]
            def u = (t - start) / dur
            skip_when u <= 0.0
            def f :~ Pict:
              cond
              | part.arrival: (part.arrival :~ Arrival).frame(math.min(1.0, u))
              | u >= 1.0: part.pict
              | ~else: part.pict.alpha(smooth(u))
            def placed = if part.sx == 1.0 && part.sy == 1.0 | f | f.scale(part.sx, part.sy)
            overlay(~horiz: #'left, ~vert: #'top, ~dx: part.x, ~dy: part.y, acc, placed)
        if drawn === g | g | drawn.refocus(g)

fun writer(root :: Pict) :: Writer:
  def parts = parts_of(root)
  fun weight_of(part :~ Part) :: Real:
    if part.arrival | (part.arrival :~ Arrival).weight | fade_weight
  fun lead_of(part :~ Part) :: Real:
    if part.arrival | (part.arrival :~ Arrival).lead | fade_lead
  // a part that takes no time is there at once; it still needs a moment to divide by
  def durs = for List (part :~ Part in parts): math.max(0.001, weight_of(part))
  def spaced:
    for values(acc :~ List = []) (i in 0..parts.length()):
      if i == 0
      | [0.0]
      | acc ++ [(acc.last :~ Real) + weight_of(parts[i - 1]) * lead_of(parts[i - 1])]
  fun span_of(starts :~ List) :: Real:
    for values(m :~ Real = 0.0) (s :~ Real in starts, d :~ Real in durs): math.max(m, s + d)
  // over the span, the starts are drawn together -- each part keeps its own time,
  // and more of them are in flight at once -- so that the whole ends at the span
  def starts:
    cond
    | span_of(spaced) <= write_span || parts.length() < 2: spaced
    | ~else:
        def k:
          for values(k :~ Real = 1.0) (s :~ Real in spaced, d :~ Real in durs):
            if s > 0.0 | math.min(k, math.max(0.0, (write_span - d) / s)) | k
        for List (s :~ Real in spaced): s * k
  Writer(root, parts, starts, durs, span_of(starts))

fun extent_for(total :: Real) :: Real:
  math.min(write_cap, math.max(write_floor, total * write_pace))

// `p`, written out: one epoch, `p` itself at the end of it, `p`'s own bounds
// throughout. The extent follows what there is to write unless the caller says.
fun write(p :: Pict,
          ~extent: ext :: maybe(Real) = #false,
          ~bend: bend = fun (x): x) :: Pict:
  def w = writer(p)
  def last = Array(p, w)
  fun writer_for(q :: Pict) :: Writer:
    if q === last[0]
    | last[1]
    | block:
        def nw = writer(q)
        last[0] := q
        last[1] := nw
        nw
  animate(~deps: [p], ~extent: ext || extent_for(w.total), ~bend: bend,
          fun (n, ~deps: [q :~ Pict]): writer_for(q).frame(n))

// `p` taken back the way it came: the fill drains and the outline retreats.
fun unwrite(p :: Pict,
            ~extent: ext :: maybe(Real) = #false,
            ~bend: bend = fun (x): x) :: Pict:
  def w = writer(p)
  animate(~extent: ext || unwrite_pace * extent_for(w.total), ~bend: bend,
          fun (n): w.frame(1.0 - n))

// One thing said and then another in its place: `a` unwrites, then `b` writes, in
// one epoch. `#false` unless both have words and the words differ -- a node that
// only changes colour is not reworded, and a ghost becoming a thing is not either.
fun rewrite_between(a :: Pict, b :: Pict,
                    ~extent: ext :: maybe(Real) = #false) :: maybe(Pict):
  def wa = words_of(a)
  def wb = words_of(b)
  cond
  | wa == [] || wb == [] || wa == wb: #false
  | ~else:
      // the old words go at the unwriting pace, the new come at the writing one,
      // and the press takes what the two add up to
      def ra = writer(a)
      def rb = writer(b)
      def out_t = unwrite_pace * extent_for(ra.total)
      def in_t = extent_for(rb.total)
      def split = out_t / (out_t + in_t)
      animate(~extent: ext || (out_t + in_t), ~bend: fun (x): x,
              fun (t):
                if t < split
                | ra.frame(1.0 - t / split)
                | rb.frame((t - split) / (1.0 - split)))

// Whether a pict has an animation of its own already.
fun moving(p :: Pict) :: Boolean:
  p.duration > 1 || p.epoch_extent(0) > 0

// The settled picture of a pict: what it looks like once whatever it does is done.
fun settled(p :: Pict) :: Pict:
  if moving(p) | p.snapshot(math.max(0, p.duration - 1), 1.0) | p

// `p`, written -- unless it already animates, in which case that *is* how it
// arrives and writing it again would throw its own animation away. This is what
// lets an animated pict be handed to a helper as a child: the helper asks for it
// written and gets back what the caller built.
fun as_written(p :: Pict, ~& kws) :: Pict:
  if moving(p) | p | write(p, ~& kws)
