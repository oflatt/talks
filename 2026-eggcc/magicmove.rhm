#lang rhombus
import:
  pict as pc
  draw
  "write.rhm"
  "slidehelpers.rhm".reword_between

export:
  Frame
  magic_between
  magic_still
  magic_press
  magic_slide
  band_below
  band_edges
  band_nodes
  band_above

// -------------------------------------------------------------------------------------
// A magic move over what is on the slide, rather than over two finished pictures
//
// `pict`'s own `magic_move` compares two finished pictures and animates the picts it
// can find in both. That is the wrong ground to stand on for a picture of boxes and
// arrows, for four reasons, each of which was measured rather than guessed:
//
//  - A line or a bubble aimed at a pict by a finder does not follow that pict when
//    it moves. The line is baked into the picture it was drawn onto, and moving the
//    pict afterwards cannot redraw it -- moving its bounding box does not help
//    either. Half of a graph is such lines.
//  - A pict drawn twice counts as absent: finders default to a unique match, and
//    drawing a pict twice is the ordinary way to have both something to aim an edge
//    at (a ghost) and a copy over the lines that point at it.
//  - A fade is applied at the *top* of a subtree, and a subtree is spared only if
//    something inside it moves. Being in both pictures protects a pict only if no
//    ancestor of it is faded, and an ancestor is a freshly built composite, which
//    never is in the other picture. So a press that only adds something fades the
//    whole slide, static title and all.
//  - It can only match picts that are pict-library children. Anything inside a pict
//    that some other library built -- every box a slide generator emits -- is one
//    opaque leaf to it, however well finders can see inside.
//
// So this one is told what is on the slide and matches by *key*:
//
//     Frame(~picts: { key: [pict, x, y] or [pict, x, y, band] },
//           ~edges: [spec, ...])
//
// A key both frames have is the same thing. It travels from the one place to the
// other, and if the two frames draw it differently the two drawings cross-fade
// where it stands, so a node that has just been picked turns green without moving.
// A key only one frame has fades in or out. Nothing else is touched, so a page
// under the picture is never redrawn and cannot dim.
//
// Edges are not picts but specs, drawn by the `~wire` the slide passes in. It is
// handed a transparent layer holding a ghost of every pict at wherever it has got
// to, the specs to draw, and the picts by key to aim at, and it is called again for
// every frame of the press -- which is how an arrow follows its nodes instead of
// being swapped for a different arrow. Edges the two frames share are drawn solid,
// and the ones only one of them has fade, so a rerouted edge fades over its
// replacement rather than jumping.
//
// `band` orders the drawing, low to high, 0 by default: a class region goes below
// the nodes, a bubble above them, and the edges land in `~edge_band`. Two things in
// the same band should not overlap, since their order within it is not fixed.

class Frame(~picts: picts :: Map = {},
            ~edges: edges :: List = [])

// The bands, named: what a pict's fourth element is for. Anything is allowed, and
// these four are what a graph needs -- a class region under its nodes, the edges
// under them too, and a bubble or a rule over the top.
def band_below = -2
def band_edges = -1
def band_nodes = 0
def band_above = 1

fun lerp(a :: Real, b :: Real, t :: Real) :: Real: a + (b - a) * t

// A pict that animates -- one that writes itself out, say -- at a moment of its
// own animation. Everything a press does to a pict other than bring it on is done
// to the *settled* picture: a node on its way across the slide is a node that has
// finished being drawn, and redrawing it while it travels is two animations at
// once. Only a key the second frame has and the first does not is sampled as the
// press runs, so a new thing writes itself on the press that brings it.
fun moving(p :: pc.Pict) :: Boolean:
  p.duration > 1 || p.epoch_extent(0) > 0
fun settled(p :: pc.Pict) :: pc.Pict:
  if moving(p) | p.snapshot(math.max(0, p.duration - 1), 1.0) | p
fun sampled(p :: pc.Pict, n :: Real) :: pc.Pict:
  if moving(p) | p.snapshot(0, n) | p
fun as_pict(q) :: pc.Pict: if q is_a pc.Pict | q | pc.Pict.from_handle(q)
fun grab(m :~ Map, key): if m.has_key(key) | m[key] | #false
fun put(base :: pc.Pict, p, x :: Real, y :: Real) :: pc.Pict:
  pc.overlay(~horiz: #'left, ~vert: #'top, ~dx: x, ~dy: y, base, as_pict(p))

// A frame's entry for one key: what to draw, where, and in which band.
fun entry_band(e :~ List) :: Int: if e.length() > 3 | e[3] | 0

fun keys_of(a :: Frame, b :: Frame) :: List: (a.picts ++ b.picts).keys()

// Where each key is at this moment, and which of its two drawings to aim edges at.
// A key in both frames is on its way from the one place to the other; a key in one
// frame stays where that frame puts it and fades instead.
fun spots_between(a :: Frame, b :: Frame, t :: Real) :: Map:
  for values(m :~ Map = {}) (key in keys_of(a, b)):
    def ea :~ List = grab(a.picts, key) || []
    def eb :~ List = grab(b.picts, key) || []
    m ++ { key: (cond
                 | ea == []: [eb[1], eb[2]]
                 | eb == []: [ea[1], ea[2]]
                 | ~else: [lerp(ea[1], eb[1], t), lerp(ea[2], eb[2], t)]) }

// Which drawing of each key the edges are aimed at. The near side of the press: a
// key drawn one way and then another is a different size in the two frames, and
// aiming at the one that has gone leaves the edges attached to a pict that is no
// longer there -- at the end of the press, wrongly, and for good until the next one
// redraws them.
fun picts_between(a :: Frame, b :: Frame, t :: Real) :: Map:
  for values(m :~ Map = {}) (key in keys_of(a, b)):
    def near = if t < 0.5 | a | b
    def far = if t < 0.5 | b | a
    def ea :~ List = grab(near.picts, key) || grab(far.picts, key)
    m ++ { key: settled(as_pict(ea[0])) }

// Everything to draw, as [band, pict, x, y, alpha, n]. A key drawn differently by
// the two frames yields two of these at one place, the arriving drawing over the
// leaving one, which reads as the one turning into the other.
//
// `n` is where to sample a pict that animates: `#false` for the settled picture,
// and `t` for a key this frame is bringing on, so that a pict which writes itself
// out does so over the press that introduces it. A pict that does not animate is
// unaffected either way, and still fades in on its alpha.
fun draws_between(a :: Frame, b :: Frame, t :: Real, appear :~ Map) :: List:
  def spots :~ Map = spots_between(a, b, t)
  List.append(
    & for List (key in keys_of(a, b)):
        def ea :~ List = grab(a.picts, key) || []
        def eb :~ List = grab(b.picts, key) || []
        def [x, y] = spots[key]
        cond
        | ea == []:
            // How it arrives. `appear` holds the written version if this press
            // prepared one; a pict that animates is its own arrival and is played
            // rather than faded, which is what `pict`'s own `magic_move` does with
            // a child it is introducing (`child.snapshot(0, n)`, there) -- the
            // difference being that `magic_move` gives that child an epoch of its
            // own afterwards and a press here has only itself.
            def arriving = grab(appear, key) || eb[0]
            [[entry_band(eb), arriving, x, y,
              (if moving(as_pict(arriving)) | 1.0 | t), t]]
        | eb == []: [[entry_band(ea), ea[0], x, y, 1.0 - t, #false]]
        | ea[0] === eb[0] || grab(appear, key) == #'same:
            [[entry_band(ea), ea[0], x, y, 1.0, #false]]
        | grab(appear, key):
            // the same kind of bubble with other words in it: the old words are
            // taken back and the new ones written, the shell staying put
            [[entry_band(eb), appear[key], x, y, 1.0, t]]
        | ~else: [[entry_band(ea), ea[0], x, y, 1.0 - t, #false],
                  [entry_band(eb), eb[0], x, y, t, #false]])

// The moment `t` of the way from `a` to `b`, over a `base` no press touches.
fun magic_between(base :: pc.Pict, a :: Frame, b :: Frame, t :: Real,
                  ~wire: wire :: Function.of_arity(3) = fun (layer, specs, at): layer,
                  ~edge_band: edge_band :: Int = band_edges,
                  // A second layer of edges, drawn in a band of its own. Some lines
                  // belong over the picture and some under a piece of it -- a graph's
                  // own arrows over its nodes, a pointer out of a floating box under
                  // that box, so that it reads as leaving the box's edge rather than
                  // crossing what is written in it. Both layers are handed every
                  // spec; each draws the ones it is for.
                  ~under_wire: under_wire :: maybe(Function.of_arity(3)) = #false,
                  ~under_band: under_band :: Int = band_below,
                  // A layer that is a function of how far through the press we are,
                  // rather than of what the two frames hold. Everything else here
                  // moves a pict or fades one into another; this is for the things
                  // that have to *change shape* on the way -- a region that grows out
                  // to cover what it has reached, say, which as two picts would be
                  // one dissolving into the other. Called with both frames and `t`.
                  ~stage: stage :: maybe(Function.of_arity(4)) = #false,
                  ~stage_band: stage_band :: Int = band_below,
                  // What each key this press brings on looks like on its way in,
                  // and how a key drawn as one bubble and then another changes,
                  // worked out once by `magic_press` rather than per frame.
                  ~appear: appear :: Map = {},
                  // `[gone, new]` pairs of edge specs: an edge this press takes
                  // away that becomes one it brings on -- a rule's pointer at what
                  // it matched becoming the edge of the node it added. The wire is
                  // asked to draw `[#'morph, gone, new, t]` for each.
                  ~pairs: pairs :: List = []) :: pc.Pict:
  def blank = pc.blank(~width: base.width, ~height: base.height)
  def draws :~ List = draws_between(a, b, t, appear)
  def at :~ Map = picts_between(a, b, t)
  def spots :~ Map = spots_between(a, b, t)
  // a ghost of every pict where it is now: a ghost draws nothing and is still
  // findable, so the edges are drawn on a layer of their own, from the current
  // positions, and each pict is still drawn exactly once
  def ghosts:
    for values(q :~ pc.Pict = blank) (key in at.keys()):
      def [x, y] = spots[key]
      put(q, as_pict(at[key]).ghost(), x, y)
  def both_es: for List (e in a.edges): keep_when b.edges.contains(e); e
  def paired_gone = for List (pr :~ List in pairs): pr[0]
  def paired_new = for List (pr :~ List in pairs): pr[1]
  def gone_es:
    for List (e in a.edges): skip_when b.edges.contains(e) || paired_gone.contains(e); e
  def new_es:
    for List (e in b.edges): skip_when a.edges.contains(e) || paired_new.contains(e); e
  // an edge that is another edge's continuation is drawn as the one turning into
  // the other, by the wire, which is handed both specs and how far along it is
  def morph_es = for List ([gone, new] in pairs): [#'morph, gone, new, t]
  // An edge this press is bringing on is *drawn*, not faded: `current_draw` says
  // how much of it there is yet, and whatever the wire draws lines with reads it.
  // The alpha still ramps, quickly, because a wire may draw more than lines and
  // what does not honour the parameter has to arrive somehow.
  // An edge this press brings on starts once the nodes it joins are most of the
  // way written, and takes the rest of the press to draw.
  def edge_t = math.min(1.0, math.max(0.0, (t - 0.3) / 0.7))
  fun layers_of(draw_them :: Function.of_arity(3)) :: List:
    for List ([specs, al, drawn] in [[both_es, 1.0, 1.0],
                                     [gone_es, 1.0 - t, 1.0],
                                     [new_es, math.min(1.0, 3.0 * edge_t), edge_t],
                                     [morph_es, 1.0, 1.0]]):
      keep_when specs != [] && al > 0.0
      parameterize { write.current_draw: drawn }:
        draw_them(ghosts, specs, at).alpha(al)
  def edge_layers = layers_of(wire)
  def under_layers = if under_wire | layers_of(under_wire) | []
  def stage_layer = if stage | stage(blank, a, b, t) | #false
  def bands :~ List:
    (for List (d :~ List in draws): d[0]) ++ [edge_band]
      ++ (if under_wire | [under_band] | [])
      ++ (if stage | [stage_band] | [])
  def lo = for values(m :~ Int = bands[0]) (v in bands): math.min(m, v)
  def hi = for values(m :~ Int = bands[0]) (v in bands): math.max(m, v)
  for values(q :~ pc.Pict = base) (band in lo..hi + 1):
    // the edges of the band, and then everything placed in it
    def wired:
      def with_stage:
        if band != stage_band || !stage_layer
        | q
        | put(q, stage_layer, 0.0, 0.0)
      def with_under:
        if band != under_band
        | with_stage
        | for values(q :~ pc.Pict = with_stage) (l in under_layers): put(q, l, 0.0, 0.0)
      if band != edge_band
      | with_under
      | for values(q :~ pc.Pict = with_under) (l in edge_layers): put(q, l, 0.0, 0.0)
    for values(q :~ pc.Pict = wired) (d :~ List in draws):
      skip_when d[0] != band || (d[4] :~ Real) == 0.0
      def shown:
        def p = as_pict(d[1])
        if d[5] | sampled(p, d[5]) | settled(p)
      put(q, shown.alpha(d[4]), d[2], d[3])

fun magic_still(base :: pc.Pict, f :: Frame, ~& kws) :: pc.Pict:
  magic_between(base, f, f, 0.0, ~& kws)

// One press. Two frames with no key in common have nothing to move, and the whole
// picture fades: that is worth saying out loud, since it looks exactly like an
// ordinary cross-fade and so passes unnoticed.
// The edges this press takes away that become edges it brings on: a pointer
// (`#'point`, `#'m`) at a node, and an edge arriving at that same node. Each is
// paired once, in order.
fun pair_edges(gone :~ List, new :~ List) :: List:
  def (pairs, _):
    for values(acc :~ List = [], left :~ List = new) (g :~ List in gone):
      skip_when !(g[0] == #'point || g[0] == #'m)
      def hit:
        for values(found = #false) (n :~ List in left):
          skip_when found
          skip_when n[0] == #'point || n[0] == #'m || n[0] == #'grow
          skip_when n.length() < 3 || n[2] != g[2]
          n
      if hit
      | values(acc ++ [[g, hit]], left.remove(hit))
      | values(acc, left)
  pairs

fun magic_press(base :: pc.Pict, a :: Frame, b :: Frame,
                ~extent: extent :: Real = 1.2, ~& kws) :: pc.Pict:
  def shared:
    for values(n :~ Int = 0) (key in a.picts.keys()):
      if b.picts.has_key(key) | n + 1 | n
  cond
  | shared == 0 && a.picts.length() > 0 && b.picts.length() > 0:
      println("magic_press: the two frames share no key, so the whole picture fades")
  | ~else: #void
  // A key only the second frame has is a thing this press introduces, and how a
  // thing arrives is an animation in the epoch before its time box -- which is
  // this epoch. So it is written rather than faded, unless it brought an arrival
  // of its own, in which case that is played instead. A key both frames have but
  // draw as two bubbles of one kind is reworded: the old words unwrite and the new
  // ones write while the shell stays. Worked out here and not in `magic_between`,
  // which runs once per frame.
  def appear:
    for values(m :~ Map = {}) (key in b.picts.keys()):
      def eb :~ List = b.picts[key]
      cond
      | !a.picts.has_key(key): m ++ { key: write.as_written(as_pict(eb[0])) }
      | ~else:
          def ea :~ List = a.picts[key]
          def pa = as_pict(ea[0])
          def pb = as_pict(eb[0])
          cond
          | ea[0] === eb[0]: m
          | write.looks_same(pa, pb):
              // built again for this frame but drawn the same: a scene rebuilt per
              // press makes a new pict for every key, and cross-fading a picture
              // into itself is work, while rewording it would rewrite words that
              // never changed
              m ++ { key: #'same }
          | ~else:
              // a bubble reworded keeps its shell; anything else that says other
              // words unwrites and writes; a restyling -- a node turning green --
              // cross-fades where it stands
              def sw = reword_between(pa, pb) || write.rewrite_between(pa, pb)
              if sw | m ++ { key: sw } | m
  def gone = for List (e in a.edges): skip_when b.edges.contains(e); e
  def new = for List (e in b.edges): skip_when a.edges.contains(e); e
  def pairs = pair_edges(gone, new)
  pc.animate(~extent: extent,
             fun (t): magic_between(base, a, b, t, ~appear: appear, ~pairs: pairs, ~& kws))

// A whole slide: the first frame, then a press to each of the rest.
fun magic_slide(base :: pc.Pict, frames :~ List,
                ~extent: extent :: Real = 1.2, ~& kws) :: pc.Pict:
  pc.switch(magic_still(base, frames[0], ~& kws),
            & for List (i in 1..frames.length()):
                magic_press(base, frames[i - 1], frames[i], ~extent: extent, ~& kws))
