#lang rhombus/and_meta
// The end of the talk, as one slide: the three pictures it turned on, brought back
// one at a time, a fourth for what comes next, and then the people who did it and
// the question.
//
// Each picture comes up large -- most of the slide -- with its line over it, and
// then shrinks to a pane in a grid of two by two, the line going with it to stand
// beside the pane -- so the slide comes to hold the four of them: what was wanted,
// what stood in the way, what got round it, and what it is for. The first three are
// the slides themselves, at rest where each one ended, so a slide that changes
// brings its own reminder with it. The lines stand to the left of the panes rather
// than over them: the slide has width to spare and no height, and a pane is a slide,
// which is wide. Over a big picture a line is one line, large; beside a pane it is
// a word to a line, small, and the one becomes the other on the way down, word by
// word.
//
// The fourth is not a slide but a blank page that three compilers come up on: this
// one, and then two that might be next, each of those with a question mark.
//
// The title slide's backdrop is behind all of it from the start; at the end the
// talk's title comes back on one line over the panes with the faces in one row
// under it, and the question pops. The talk opened on that picture and ends on it,
// with what happened in between below.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "theme.rhm" open
  "backdrop.rhm" open
  "opening.rhm" open
  "workflow.rhm" open
  "dp.rhm" open
  "write.rhm".write
  "write.rhm".faded
  "write.rhm".popped
  pict as pc
  draw
  lib("racket/base.rkt") as rkt
  lib("racket/draw.rkt") as rktdraw
  lib("racket/class.rkt") as rktclass

export:
  slide_summary

// a slide as it ends, at the width given, in a thin frame
def shot_line = draw.Color(170, 170, 170)
fun ended(mk) :: pc.Pict:
  def whole :~ pc.Pict = as_pict(mk())
  whole.snapshot(whole.duration - 1, 1.0)
fun framed(shot :: pc.Pict, w :: Real) :: pc.Pict:
  def small :~ pc.Pict = shot.scale(w / shot.width)
  pc.overlay(small,
             pc.rectangle(~width: small.width, ~height: small.height,
                          ~fill: #false, ~line: shot_line, ~line_width: 2.0, ~rounded: -0.03))

// ------------------------------------------------------------------ the lines
// A line is its pieces -- the first in bold, the rest plain -- laid out one way over
// a big picture, in a row and large, and another beside a pane, stacked and small.
// The pieces are the same picts in both, scaled, so that one layout can become the
// other: each piece moves from its place in the row to its place in the stack.
def label_size = 34.0
def label_w = 210.0                     // the widest piece of any of them, stacked
def label_gap = 16.0
def row_scale = 48.0 / label_size       // how much larger a line is over a big picture
fun label(head :: String, rest :: List) :: List:
  [prose_text(head, ~size: label_size, ~bold: #true),
   & for List (s in rest): prose_text(s, ~size: label_size)]
// the pieces in a row, `k` times their size, centred on `cx` with their bottoms on
// `y_bottom`: `[[pict, x, y], ...]`
fun row_at(pieces :~ List, k :: Real, cx :: Real, y_bottom :: Real) :: List:
  def sep = 0.32 * label_size * k
  def total:
    for values(w :~ Real = -sep) (p :: pc.Pict in pieces): w + p.width * k + sep
  def (out, _):
    for values(acc :~ List = [], x :~ Real = cx - total / 2) (p :: pc.Pict in pieces):
      values(acc ++ [[p.scale(k), x, y_bottom - p.height * k]], x + p.width * k + sep)
  out
// and stacked, each centred, the stack flush right against `x_right` and centred
// on `cy`
fun stack_at(pieces :~ List, x_right :: Real, cy :: Real) :: List:
  def sep = 2.0
  def widest:
    for values(w :~ Real = 0.0) (p :: pc.Pict in pieces): math.max(w, p.width)
  def total:
    for values(h :~ Real = -sep) (p :: pc.Pict in pieces): h + p.height + sep
  def (out, _):
    for values(acc :~ List = [], y :~ Real = cy - total / 2) (p :: pc.Pict in pieces):
      values(acc ++ [[p, x_right - widest + (widest - p.width) / 2, y]], y + p.height + sep)
  out
fun put_all(base :: pc.Pict, placed :~ List) :: pc.Pict:
  for values(q :~ pc.Pict = base) ([p, x, y] in placed): put(q, p, x, y)

// where a picture stands while it is being looked at: most of the slide, with its
// line over it in the band the closing has not filled yet -- beside it, the line
// would land on the lines of the panes already made, which stick out from under it
def big_y = 210.0
def big_h = slide_height - big_y - 20.0
def big_w = big_h * slide_width / slide_height
def big_x = (slide_width - big_w) / 2
fun over_big(pieces :~ List) :: List:
  row_at(pieces, row_scale, slide_width / 2, big_y - label_gap)
// and where it goes after: a pane in a grid of two by two, its line beside it, below
// the room the closing needs for the title and the faces
def pane_w = 670.0
def pane_h = pane_w * slide_height / slide_width
def col_gap = 60.0
def col_w = label_w + label_gap + pane_w
def grid_x0 = (slide_width - 2 * col_w - col_gap) / 2
def grid_top = 270.0
def row_gap = 20.0
fun pane_x(i :: Int) :: Real: grid_x0 + label_w + label_gap + (i mod 2) * (col_w + col_gap)
fun pane_y(i :: Int) :: Real: grid_top + (i div 2) * (pane_h + row_gap)
fun beside_pane(pieces :~ List, i :: Int) :: List:
  stack_at(pieces, pane_x(i) - label_gap, pane_y(i) + pane_h / 2)

// ------------------------------------------------------------- what comes next
// Three compilers on a page of their own: this one, and then two that might be
// next, each of those with a question mark, stepping up and down across the page. Each logo at its own proportions,
// scaled to fill its third of the page, with the mark beside it where there is one.
def page_white = pc.rectangle(~width: slide_width, ~height: slide_height,
                              ~fill: "white", ~line: #false)
def big_question = prose_text("?", ~size: 220.0, ~bold: #true)
fun logo(file :: String, w :: Real, h :: Real) :: pc.Pict:
  as_pict(image_pict(media(file), w, h))
// a logo at the size its file has
fun logo_file(file :: String) :: pc.Pict:
  def bm = rktdraw.#{read-bitmap}(media(file))
  logo(file, rktclass.#{dynamic-send}(bm, #'#{get-width}),
       rktclass.#{dynamic-send}(bm, #'#{get-height}))
// every logo is fitted to the one box, so the three read as the same size: the
// round ones fill it, the wordmark spans it
def mark_box = 440.0
fun fitted(mark :: pc.Pict) :: pc.Pict:
  mark.scale(math.min(mark_box / mark.width, mark_box / mark.height))
fun asking(mark :: pc.Pict) :: pc.Pict:
  pc.beside(~sep: 22.0, ~vert: #'center, fitted(mark), big_question)
fun alone(mark :: pc.Pict) :: pc.Pict: fitted(mark)
// the eggcc logo, cut out of the patch's proof sheet, with no question about it
def eggcc_alone = alone(logo("eggcc.png", 912.0, 912.0))
def openssl_asked = asking(logo("openssl.png", 1200.0, 326.0))
// CompCert's, from `media/compcert.png` once there is one, and until then its name
// the way its site writes it: in capitals, in a geometric face, in a dark blue
def compcert_mark:
  if rkt.#{file-exists?}(media("compcert.png"))
  | logo_file("compcert.png")
  | pc.text("COMPCERT", ~font: draw.Font(~name: "URW Gothic", ~size: 72.0))
      .colorize(draw.Color(0x25, 0x31, 0x83))
// the mark on its own does not say whose it is, so its name goes under it
def compcert_named:
  pc.stack(~sep: 14.0, ~horiz: #'center, fitted(compcert_mark),
           prose_text("CompCert", ~size: 56.0, ~bold: #true))
def compcert_asked = pc.beside(~sep: 22.0, ~vert: #'center, compcert_named, big_question)
// the page, with each of the three on it by as much as `first`, `second` and
// `third` say: this compiler low on the left, the verified one higher in the
// middle, and the library low on the right, the way a path is walked
def low_y = 700.0
def high_y = 380.0
fun next_page(first :: Real, second :: Real, third :: Real) :: pc.Pict:
  fun laid(base :: pc.Pict, q :: pc.Pict, cx :: Real, cy :: Real, a :: Real) :: pc.Pict:
    cond
    | a <= 0.0: base
    | ~else: put(base, (if a >= 1.0 | q | q.alpha(a)), cx - q.width / 2, cy - q.height / 2)
  // spaced evenly across the page, whatever each comes to
  def gap = (slide_width - eggcc_alone.width - compcert_asked.width - openssl_asked.width) / 4
  def cx1 = gap + eggcc_alone.width / 2
  def cx2 = cx1 + eggcc_alone.width / 2 + gap + compcert_asked.width / 2
  def cx3 = cx2 + compcert_asked.width / 2 + gap + openssl_asked.width / 2
  laid(laid(laid(page_white, eggcc_alone, cx1, low_y, first),
            compcert_asked, cx2, high_y, second),
       openssl_asked, cx3, low_y, third)

// ------------------------------------------------------------------ the faces
// The row they come back in, under the title, each face the same size.
def face_w = 120.0
def face_gap = 32.0
def face_top = 118.0
def team_row :~ List:
  def span = team.length() * face_w + (team.length() - 1) * face_gap
  def x0 = (slide_width - span) / 2
  for List ([who, file, crop] in team, k in 0..):
    [as_pict(image_pict(media(file), face_w, face_w, ~crop: crop)),
     x0 + k * (face_w + face_gap), face_top]
// the talk's own title, on one line where the deck puts its titles
def talk_title_pict:
  prose_text(talk_title_lines[0] +& " " +& talk_title_lines[1],
             ~size: 60.0, ~bold: #true, ~arrive: #'pop)
def talk_title_y = 30.0

fun slide_summary():
  // the page, with the picture the talk opened on behind everything
  def page:
    def bare = as_pict(page_canvas())
    put(bare, backdrop(), 0.0, 0.0).refocus(bare)
  def shots:
    [[label("Want:", ["Effectful", "E-Graphs"]), ended(slide_20)],
     [label("Problem:", ["Extraction", "Bottleneck"]), ended(slide_41)],
     [label("Solution:", ["Statewalk DP"]), ended(slide_dp)],
     [label("Future:", ["Powerful", "E-Graph", "Optimizers"]), next_page(1.0, 1.0, 1.0)]]
  // the panes already made, over whatever is behind them
  fun panes_over(back :: pc.Pict, n :: Int) :: pc.Pict:
    for values(q :~ pc.Pict = back) ([pieces, shot] in shots.take(n), i in 0..):
      put_all(put(q, framed(shot, pane_w), pane_x(i), pane_y(i)), beside_pane(pieces, i))
  fun settled_upto(n :: Int) :: pc.Pict: panes_over(page, n)
  // a picture where it is looked at, its line over it
  fun big_over(base :: pc.Pict, shot :: pc.Pict, pieces :~ List) :: pc.Pict:
    put_all(put(base, framed(shot, big_w), big_x, big_y), over_big(pieces))
  // One picture coming up large: it fades in where it will be read, and its line is
  // written over it once it is there -- the picture is what the line is about, so
  // it arrives first.
  fun appear(i :: Int, ~shot: shot = (shots[i] :~ List)[1]) :: pc.Pict:
    def [pieces, _] = shots[i]
    def layer = big_over(blank_slide, faded(shot), pieces)
    pc.overlay(~horiz: #'left, ~vert: #'top, settled_upto(i), write(layer))
  // and going to its pane, the line going with it: each of its pieces from its place
  // in the row over the picture to its place in the stack beside the pane, and from
  // large to small on the way
  fun minimize(i :: Int) :: pc.Pict:
    def [pieces :~ List, shot] = shots[i]
    def base = settled_upto(i)
    def from = over_big(pieces)
    def to = beside_pane(pieces, i)
    // The line goes as one block, straight from over the picture to beside the pane,
    // and unfolds on the way from a row into a stack: its pieces spread out into
    // their lines first and close up sideways after, so that they never pile up.
    fun centre_of(placed :~ List, k :: Real) :: List:
      def xs = for List ([p :: pc.Pict, x, _] in placed): [x, x + p.width * k]
      def ys = for List ([p :: pc.Pict, _, y] in placed): [y, y + p.height * k]
      def x0 = for values(m :~ Real = slide_width) ([a, _] in xs): math.min(m, a)
      def x1 = for values(m :~ Real = 0.0) ([_, b] in xs): math.max(m, b)
      def y0 = for values(m :~ Real = slide_height) ([a, _] in ys): math.min(m, a)
      def y1 = for values(m :~ Real = 0.0) ([_, b] in ys): math.max(m, b)
      [(x0 + x1) / 2, (y0 + y1) / 2]
    def [fcx, fcy] = centre_of(from, 1.0)      // the row's picts are already scaled
    def [tcx, tcy] = centre_of(to, 1.0)
    pc.animate(~extent: 1.0,
               fun (t):
                 def s = smooth(t)
                 def with_picture:
                   put(base, framed(shot, lerp(big_w, pane_w, s)),
                       lerp(big_x, pane_x(i), s), lerp(big_y, pane_y(i), s))
                 def ey = smooth(clamp01(t / 0.6))
                 def ex = smooth(clamp01((t - 0.35) / 0.65))
                 def k = lerp(row_scale, 1.0, ey)
                 def r = k / row_scale
                 def gcx = lerp(fcx, tcx, s)
                 def gcy = lerp(fcy, tcy, s)
                 for values(q :~ pc.Pict = with_picture) (j in 0..pieces.length()):
                   def p :: pc.Pict = pieces[j]
                   def [_, x0, y0] = from[j]
                   def [_, x1, y1] = to[j]
                   // each piece's offset from the block's centre, in the row and in
                   // the stack, measured at the piece's own centre so that it scales
                   // about itself
                   def ox0 = x0 + p.width * row_scale / 2 - fcx
                   def oy0 = y0 + p.height * row_scale / 2 - fcy
                   def ox1 = x1 + p.width / 2 - tcx
                   def oy1 = y1 + p.height / 2 - tcy
                   def ox = lerp(ox0 * r, ox1, ex)
                   def oy = lerp(oy0 * r, oy1, ey)
                   put(q, p.scale(k), gcx + ox - p.width * k / 2, gcy + oy - p.height * k / 2))

  // Then the people who did it, over the four panes: the title and the faces are
  // written in one cascade
  def team_layer:
    def with_title = put(blank_slide, talk_title_pict, title_x, talk_title_y)
    for values(q :~ pc.Pict = with_title) ([face, x, y] in team_row):
      put(q, popped(as_pict(face)), x, y)
  def closing = pc.overlay(~horiz: #'left, ~vert: #'top, settled_upto(4), write(team_layer))
  def closed = closing.snapshot(0, 1.0)
  // and the question, in the corner the one-line title leaves free. The bubble is
  // written, which traces and fills its shell and pops the word in after it: the
  // bubble itself is not animated, it carries how each of its pieces arrives.
  def question:
    def b :~ pc.Pict = make_bubble(~color: talk_green, prose([["Questions?", #'bold]])).scale(1.3)
    put(blank_slide, b, slide_width - b.width - 60.0, talk_title_y)

  // the fourth picture's three arrivals: this compiler on the empty page, and then
  // the two that might be next, one at a time
  fun coming_up(before :: Int) :: pc.Pict:
    def [pieces, _] = shots[3]
    def base = settled_upto(3)
    fun by(k :: Int, t :: Real) :: Real:
      cond
      | k < before: 1.0
      | k == before: smooth(t)
      | ~else: 0.0
    pc.animate(~extent: 0.8,
               fun (t): big_over(base, next_page(by(0, t), by(1, t), by(2, t)), pieces))

  pc.switch(page,
            appear(0), minimize(0),
            appear(1), minimize(1),
            appear(2), minimize(2),
            appear(3, ~shot: next_page(0.0, 0.0, 0.0)),
            coming_up(0), coming_up(1), coming_up(2),
            minimize(3),
            closing,
            pc.overlay(~horiz: #'left, ~vert: #'top, closed, write(question)))
