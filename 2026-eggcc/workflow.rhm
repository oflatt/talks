#lang rhombus/and_meta
// The optimizer's workflow as a row of stages, and the two slides that walk through
// it: once for a program without effects, and once for one with them.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "term.rhm" open
  pict as pc
  draw
  "steps.rhm".corner_frame
  "steps.rhm".steps_wire
  "steps.rhm".step_edges

export:
  slide_40
  slide_41

// -------------------------------------------------------------------------------------
// A stage of the workflow: a bubble in the deck's own style with the stage's name in
// it, on one line or two, and for the stage that runs the rules, the gear under the
// name. One pict rather than a box with a body placed on it, because a stage travels
// -- to the corner of the next slide, or into the row beside another -- and a thing
// that travels has to be one thing.
def flow_gear = make_gear(~size: 190.0, ~teeth: 11)
fun stage_card(lines :~ List, ~width: w :: Real, ~height: h :: Real,
               ~body: body :: maybe(pc.Pict) = #false) :: pc.Pict:
  def name:
    pc.stack(~sep: 2.0, ~horiz: #'center,
             & for List (s in lines): prose_text(s, ~size: 36.0, ~bold: #true))
  as_pict(make_bubble(~width: w, ~height: h, ~color: talk_blue, ~padding: 24,
                      (if body | pc.stack(~sep: 18.0, ~horiz: #'center, name, body) | name)))

// A bubble on one of the stages, built the way the graph slides build theirs: aimed
// at the stage's own pict where the frame has it.
fun flow_callout(page :: pc.Pict, target :~ List,
                 ~body: body :~ List, ~color: color,
                 ~content: content :: pc.Pict) :: List:
  def marker = pc.blank(~width: 1.0, ~height: 1.0)
  def what = as_pict(target[0])
  def probe:
    put(put(page.ghost(), marker, body[0], body[1]), what.ghost(), target[1], target[2])
  [multi_callout(~on: probe, ~place: marker, ~at: [what],
                 ~color: color, ~padding: 20.0, content),
   0.0, 0.0, band_above]

// -------------------------------------------------------------------------------------
// slide_40: the three stages, a press each, and then the three of them going up into
// the corner the next slide keeps them in.
//
// Each card is keyed the way the next slide keys its corner boxes, so the last press
// carries each card to the place that slide draws it, cross-fading into the smaller
// box on the way, and the arrows between them go along. That slide opens on exactly
// what this one lands on, so the show cuts.
fun slide_40():
  def page = titled(flow_title, ~tag: "Pure workflow title", ~nudge: [0.0, 0.0])
  def card_w = 400.0
  def card_h = 160.0
  def rules_h = 340.0
  def mid_y = 520.0
  def card_gap = 150.0
  def row_x:
    def left = (slide_width - (3 * card_w + 2 * card_gap)) / 2
    for List (i in 0..3): left + i * (card_w + card_gap)
  fun standing(key, p :: pc.Pict, x :: Real, h :: Real) :: Map:
    { [#'step, key]: [p, x, mid_y - h / 2, band_above] }
  def c_program = standing(#'program, stage_card(["Insert Program"], ~width: card_w, ~height: card_h),
                           row_x[0], card_h)
  def c_rules = standing(#'rules, stage_card(["Run Rules"], ~width: card_w, ~height: rules_h,
                                             ~body: flow_gear),
                         row_x[1], rules_h)
  def c_extract = standing(#'extract, stage_card(["Extract"], ~width: card_w, ~height: card_h),
                           row_x[2], card_h)
  def e_in = (step_edges(3) :~ List)[0]
  def e_out = (step_edges(3) :~ List)[1]
  def stages:
    [Frame(),
     Frame(~picts: c_program),
     Frame(~picts: c_program ++ c_rules, ~edges: [e_in]),
     Frame(~picts: c_program ++ c_rules ++ c_extract, ~edges: [e_in, e_out]),
     corner_frame]
  magic_slide(page, stages, ~wire: steps_wire,
              ~extent_of: fun (i): if i == stages.length() - 1 | 1.5 | 1.0)

// -------------------------------------------------------------------------------------
// slide_41: the same workflow, once the program has effects.
//
// It comes after the whole of the effectful example, and reads it back as a picture.
// The three stages the first section ended on come up again, and then the row grows
// at both ends and changes in the middle, a press at a time: the program is put into
// a dataflow IR first, which is what makes an effect a value; extraction has to be
// taught which programs it may hand back; the answer is put back into the original
// IR; the rules are written as if nothing had effects; and extraction is the part
// that is hard, which is the rest of the talk.
//
// Five places in the row are laid out from the start, with the three stages in the
// middle three, so that the two that come later have their places waiting and nothing
// that is already up has to move over.
fun slide_41():
  def page = titled(flow_title, ~tag: "Effectful workflow title", ~nudge: [0.0, 0.0])
  def card_w = 320.0
  def card_h = 160.0
  def rules_h = 340.0
  def mid_y = 520.0
  def card_gap = 50.0
  def slot_x:
    def left = (slide_width - (5 * card_w + 4 * card_gap)) / 2
    for List (i in 0..5): left + i * (card_w + card_gap)
  fun standing(key, p :: pc.Pict, slot :: Int, h :: Real) :: Map:
    { [#'step, key]: [p, slot_x[slot], mid_y - h / 2, band_above] }
  fun plain(key, lines :~ List, slot :: Int) :: Map:
    standing(key, stage_card(lines, ~width: card_w, ~height: card_h), slot, card_h)
  def c_in = plain(#'in, ["Translate to", "Dataflow IR"], 0)
  def c_program = plain(#'program, ["Insert Program"], 1)
  def c_rules = standing(#'rules, stage_card(["Run Rules"], ~width: card_w, ~height: rules_h,
                                             ~body: flow_gear),
                         2, rules_h)
  def c_extract = plain(#'extract, ["Extract"], 3)
  // the same stage, once it has been taught about effects: the same key, so the press
  // that renames it rewords the card where it stands
  def c_safe = plain(#'extract, ["Effect-safe", "Extraction"], 3)
  def c_out = plain(#'out, ["Translate to", "Original IR"], 4)
  fun e(from, to) :: List: [#'step, [#'step, from], [#'step, to]]
  def e_in = e(#'in, #'program)
  def e_program = e(#'program, #'rules)
  def e_rules = e(#'rules, #'extract)
  def e_out = e(#'extract, #'out)

  // what each stage has to say for itself, pointing at the stage it is about
  fun target(m :~ Map) :: List: m[m.keys()[0]]
  def threading:
    { #'threading: flow_callout(page, target(c_in), ~body: [40.0, 236.0],
                                ~color: talk_green,
                                ~content: prose_stack(
                                            [[["Effects modeled by", #'plain]],
                                             [["threading", #'bold],
                                              [" functional objects!", #'plain]]])) }
  def refine:
    { #'refine: flow_callout(page, target(c_safe), ~body: [1150.0, 700.0],
                             ~color: talk_green,
                             ~content: prose_stack(
                                         [[["Refine the semantics to", #'plain]],
                                          [["only ", #'plain], ["linear", #'bold],
                                           [" programs", #'plain]]])) }
  def algebraic:
    { #'algebraic: flow_callout(page, target(c_rules), ~body: [740.0, 780.0],
                                ~color: talk_green,
                                ~content: prose_stack([[["Algebraic rules", #'bold]],
                                                       [["over dataflow IR", #'bold]]])) }
  // And the catch, last, in red: the extraction that has been taught about effects
  // is an NP-hard problem -- which is what the next section is about, and the backup
  // slide has the proof.
  def bottleneck:
    { #'bad: flow_callout(page, target(c_safe), ~body: [1180.0, 232.0], ~color: talk_red,
                          ~content: robot_says(
                                      #'frown,
                                      // and, a size down, where the proof is
                                      prose_stack([[["Bottleneck:", #'bold]],
                                                   [["NP-Hard Problem!", #'bold]],
                                                   [["(see paper)", #'sub]]]),
                                      ~sep: 12.0, ~scale: 0.62)) }

  def three = c_program ++ c_rules ++ c_extract
  def four = c_in ++ three
  def four_safe = c_in ++ c_program ++ c_rules ++ c_safe
  def five = four_safe ++ c_out
  magic_slide(
    page,
    [// the three stages again, a press each, as the first section had them
     Frame(),
     Frame(~picts: c_program),
     Frame(~picts: c_program ++ c_rules, ~edges: [e_program]),
     Frame(~picts: three, ~edges: [e_program, e_rules]),
     // then the program goes through a dataflow IR on its way in, and why
     Frame(~picts: four, ~edges: [e_in, e_program, e_rules]),
     Frame(~picts: four ++ threading, ~edges: [e_in, e_program, e_rules]),
     // the rules are still the rules
     Frame(~picts: four ++ threading ++ algebraic, ~edges: [e_in, e_program, e_rules]),
     // extraction is renamed for what it now has to be, and what that means
     Frame(~picts: four_safe ++ threading ++ algebraic, ~edges: [e_in, e_program, e_rules]),
     Frame(~picts: four_safe ++ threading ++ algebraic ++ refine,
           ~edges: [e_in, e_program, e_rules]),
     // the answer goes back to the IR it came from
     Frame(~picts: five ++ threading ++ algebraic ++ refine,
           ~edges: [e_in, e_program, e_rules, e_out]),
     // and the bad news
     Frame(~picts: five ++ threading ++ algebraic ++ refine ++ bottleneck,
           ~edges: [e_in, e_program, e_rules, e_out])],
    ~wire: steps_wire)
