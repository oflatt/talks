#lang rhombus/and_meta
// The `update` example, as one story: what an update does, the chain of them going
// into an e-graph, a rule over them, and the extraction that gets it wrong.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "codebox.rhm" open
  "rules.rhm" open
  "chain.rhm" open
  "apply.rhm" open
  "write.rhm".writer
  "write.rhm".write
  "write.rhm".extent_for
  "write.rhm".unwrite_pace
  "write.rhm".already
  "write.rhm".popped
  "write.rhm".ink_bounds
  "write.rhm".Arrival
  "write.rhm".arriving
  "write.rhm".pop_frame
  "write.rhm".current_draw
  "yarn.rhm" open
  pict as pc
  draw

export:
  slide_egraph
  slide_fork
  slide_rue
  slide_update
  slide_update_story
  update_title

// -------------------------------------------------------------------------------------
// The `update` example, as one story.
//
// Straight-line code first, as anyone would write it; what one `update` does; the
// state values, magic-moved into the code; the e-graph built up one `update` per
// press; a rule over `update`, and the rule applied as a union; and last the
// extraction that takes the wrong term out of what the rule made. The code box
// sits in one place on all four slides, so it stays put across the cuts.

// -------------------------------------------------------------------------------------
// slide_update: the three `update`s, what one does, and where the states come in.
//
// A press explains the operation. The next one magic-moves each line into its
// `(v, ω) = update(...)` form: the pieces already on screen slide right to make
// room, the parentheses and the ωs fade in around them, the bubble staying up;
// one naming the state value arrives under it. Then an aside on what the state
// form allows -- see `update_opening`.
fun slide_update(): update_opening()[#'pict]

// The pieces `slide_update` is made of, for `slide_update_story` to carry on from.
// The title goes on the page here rather than through `titled`, so that the join
// to the next part can take it back: it is the one thing on the slide that changes.
// the title, named once: the divider before this slide writes it as its outline goes up
def update_title = "Update"
fun update_opening() :: Map:
  def title = title_text(update_title)
  def canvas = put(page_canvas(), title, title_x, title_y)
  def parts = code_parts()
  def code_states = code_pict(parts, ~states: #true)
  def code_plain = code_pict(parts, ~states: #false)
  def plain = put(canvas, code_plain, code_x, code_y)
  def with_states = put(canvas, code_states, code_x, code_y)
  // the code on a layer of its own, for the press that writes it onto the page
  def code_layer = put(pc.blank(~width: slide_width, ~height: slide_height),
                       code_plain, code_x, code_y)

  // ---------------------------------------------------------------- the bubbles
  // Both are about the first line and point at it: the spike lands just off the end
  // of that line's own text, inside the box, while the body stays out past the
  // box's edge -- so the spike reaches in over the border rather than stopping at
  // it, which pointed at the box. The first sits high, level with the title, so
  // that the second has the room beside the line and both stay up: the slide builds
  // up rather than swapping one sentence for the next. The line's end moves as the
  // code moves into its state form, and the first bubble's spike follows it.
  def (fx, _) = pc.Find.right(parts[#'frame]).in(plain)
  def body_x = fx + 40.0
  def explain_body = [body_x, 150.0]
  def omega_body = [body_x, 320.0]
  // where line 0 ends on `page`, in the form named: the point the spikes aim at
  fun line_end(form, page :: pc.Pict) :: List:
    def line :~ pc.Pict = ((parts[#'lines] :~ List)[0] :~ Map)[form]
    def (x, y) = pc.Find.right(line).in(page)
    [x + 8.0, y]
  def end_plain = line_end(#'plain, plain)
  def end_states = line_end(#'states, with_states)
  // a bubble aimed at a point: what it points at is a speck there, laundered by
  // `bubble_at`, so every bubble has a target of its own
  def speck = pc.blank(~width: 16.0, ~height: 16.0)
  fun aimed(~at: at :~ List, ~body: body :~ List, ~content: content :: pc.Pict,
            ~color: color = talk_blue) :: pc.Pict:
    bubble_at(speck, ~spot: [at[0] - 8.0, at[1] - 8.0], ~body: body, ~color: color,
              ~content: content)
  fun explain_at(at :~ List) :: pc.Pict:
    aimed(~at: at, ~body: explain_body,
          ~content: prose_stack([[["Write ", #'plain], ["x", #'bold], [" to address ", #'plain],
                                  ["a", #'bold], [",", #'plain]],
                                 [["return the previous value at ", #'plain], ["a", #'bold]]]))
  def explain_plain = explain_at(end_plain)
  def explain_states = explain_at(end_states)
  def omega_bubble:
    aimed(~at: end_states, ~body: omega_body,
          ~content: prose_stack([[["ω", #'plain], ["1", #'sub], [" is the state of memory", #'plain]],
                                 [["after the update", #'plain]]]))

  // The code slides into its state form -- the pieces already on screen move right
  // to make room, the parentheses and the ωs fade in around them -- with the first
  // bubble staying up and its spike following the end of the line it points at.
  // Both play under the same bend, so the tip rides the line's end rather than
  // running ahead of it or behind.
  def moving:
    pc.overlay(~horiz: #'left, ~vert: #'top,
               pc.magic_move(plain, with_states, ~other: #'fade, ~extent: 1.0)
                 .time_pad(~after: -1),
               pc.animate(~extent: 1.0,
                          fun (t): explain_at([lerp(end_plain[0], end_states[0], t),
                                               lerp(end_plain[1], end_states[1], t)])))

  // ------------------------------------------------ who reads which state, and why
  // The point of the state form is that memory is passed along like any other
  // value -- and that is also a freedom: a program in it can read a state that is
  // not the last one. A thread of yarn shows which state each line reads. It comes
  // out of the memory the program is handed and goes into the `update` that reads
  // it, passes under that line and comes out of the state the line leaves, and so
  // on down into the `return`: over the page between the lines and under it through
  // them, so that it weaves. In the program as written it is one thread, and a
  // bubble says that is linear. Then a copy of the program comes up under it and is
  // rewritten so that the second write reads the state the program was handed
  // rather than the first write's. That program is equivalent to the original --
  // the second write overwrites the first, so the memory it leaves is the same, and
  // both writes return what `a` held to begin with -- and a bubble says so. Then the
  // thread is woven through the copy, and it splits: one strand goes on to the
  // `return`, and the other goes through the first write and comes out of its state
  // with nothing to go into -- a frayed end, which turns red as a red bubble names
  // it. The original stays up throughout, so the two can be read against each other.
  def read_at = [[0, #'state_in], [1, #'state_in], [2, #'state]]
  def omega_glyph :: pc.Pict = (parts[#'header] :~ Map)[#'omega]
  def [ink_x0, ink_y0, ink_x1, ink_y1] = ink_bounds(omega_glyph)
  // the box round the ink of the ω that starts the piece `[pict, x, y]`
  fun omega_box(piece :~ List) :: List:
    def [p :: pc.Pict, x, y] = piece
    def lx = x + ink_x0
    def ly = y + p.height - omega_glyph.height + ink_y0
    [lx, ly, lx + ink_x1 - ink_x0, ly + ink_y1 - ink_y0]
  def orig_uses = for List ([k, role] in read_at): code_piece_at(parts, k, role)

  // The copy, under the original, from pieces of its own so that its ωs are things
  // the press can find and change. The ωs it reads with stand in holes in its code,
  // popping in with the lines round them; the rewritten one -- the second write
  // reading the state the program was handed -- sits centred in the room the piece
  // it replaces had.
  def copy_parts = code_parts()
  def copy_dy = (parts[#'frame] :~ pc.Pict).height + 30.0
  def copy_code = code_pict(copy_parts, ~states: #true, ~holes: read_at)
  fun lower(piece :~ List) :: List:
    def [p, x, y] = piece
    [p, x, y + copy_dy]
  // The copy's lines pop in one after another as the box is written, and the ω a
  // line reads with is a key of its own: left to itself it would pop the moment the
  // press starts, ahead of its line. So it is given the line's own timing -- unseen
  // until the line starts, then the same pop over the same stretch -- read off the
  // writer that plays the box: its parts are the frame, the signature, then a line
  // each.
  def copy_w = writer(copy_code)
  fun with_line(p :: pc.Pict, k :: Int) :: pc.Pict:
    def start = (copy_w.starts[k + 2] :~ Real) / copy_w.total
    def dur = (copy_w.durs[k + 2] :~ Real) / copy_w.total
    arriving(p, Arrival(fun (n): pop_frame(p, clamp01((n - start) / dur)),
                        copy_w.total, ~kind: #'pop))
  def copy_uses_written:
    for List ([k, role] in read_at):
      def [p :: pc.Pict, x, y] = lower(code_piece_at(copy_parts, k, role))
      [with_line(p, k), x, y]
  def rewritten = { 1: greek("ω") }
  def copy_uses_forked:
    for List (u :~ List in copy_uses_written, i in 0..):
      if rewritten.has_key(i)
      | def [p :: pc.Pict, x, y] = u
        def other :: pc.Pict = rewritten[i]
        [other, x + (p.width - other.width) / 2, y + p.height - other.height]
      | u
  fun copy_picts(~forked: forked :: Boolean) :: Map:
    def uses = if forked | copy_uses_forked | copy_uses_written
    { #'copy: [copy_code, code_x, code_y + copy_dy, band_nodes] }
      ++ (for values(m :~ Map = {}) (u :~ List in uses, i in 0..):
            // in the code's own band: they stand in blank holes in it, so nothing
            // there is over or under them, and the yarn's trace passes over them as
            // it passes over every other letter of the line
            m ++ { [#'c_use, i]: [u[0], u[1], u[2], band_nodes] })

  // ------------------------------------------------------------------ the yarn
  // Where a thread goes into a letter and comes out of one: just over it and just
  // under it, clear of its ink, and its middle.
  fun cx_of(b :~ List) :: Real: ((b[0] :~ Real) + b[2]) / 2
  fun over_of(b :~ List) :: List: [cx_of(b), (b[1] :~ Real) - 5.0]
  fun under_of(b :~ List) :: List: [cx_of(b), (b[3] :~ Real) + 5.0]
  fun middle_of(b :~ List) :: List: [cx_of(b), ((b[1] :~ Real) + b[3]) / 2]
  fun towards(p :~ List, q :~ List, t :: Real) :: List:
    [p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t]
  fun straight(from :~ List, to :~ List) :: List:
    [from, towards(from, to, 1.0 / 3.0), towards(from, to, 2.0 / 3.0), to]
  fun over_leg(c :~ List) :: List: leg(#'over, & c)
  fun under_leg(c :~ List) :: List: leg(#'under, & c)
  // Down out of a letter into the gap under its line, and along the gap at `lane`
  // to over a letter further right and down into it: two legs, the first turning
  // from down to along so that the thread clears whatever hangs below its line
  // before it sets off.
  fun drop_to(from :~ List, to :~ List, lane :: Real) :: List:
    def turn = [(from[0] :~ Real) + 16.0, lane]
    [[from, [from[0], lane - 4.0], [(from[0] :~ Real) + 4.0, lane], turn],
     [turn, [(turn[0] :~ Real) + ((to[0] :~ Real) - turn[0]) * 0.35, lane], [to[0], lane], to]]
  // under a line, from over one letter to over another to its left: down into the
  // line, along it, and back up
  fun beneath(from :~ List, to :~ List) :: List:
    [from, [from[0], (from[1] :~ Real) + 18.0], [to[0], (to[1] :~ Real) + 18.0], to]
  // over a line, from one point on it to another: up into the gap above and down
  fun arching(from :~ List, to :~ List) :: List:
    [from, [from[0], (from[1] :~ Real) - 22.0], [to[0], (to[1] :~ Real) - 22.0], to]
  // where an `update` begins on its line: over the `u`, on the line's `x`-height
  fun update_at(piece :~ List, row_top :: Real) :: List:
    def [p :: pc.Pict, x, y] = piece
    def cw = p.width / " = update(".length()
    [x + 3.5 * cw, row_top - 5.0]
  // where line 0 ends, which the copy's thread goes round on its way to line 1
  def line0_right = line_end(#'states, with_states)[0] - 8.0
  // How far along its run to the first write the copy's thread splits: a little
  // before it goes down into the write, so that the two strands leave it side by
  // side.
  def split_at = 0.6
  // One program's thread, from the boxes of its six ωs -- the memory it is handed,
  // the one the first write reads and the one it leaves, the same for the second,
  // and the one the `return` reads -- and where its two `update`s begin. In each
  // line the thread goes into the ω the `update` reads, under the arguments and
  // under the `update` itself, up out of the start of it, over into the ω it
  // leaves, and through that and on: memory into an `update`, and out of it as the
  // next. `~split` is for the copy, whose second write reads the memory the
  // program is handed: its thread splits.
  fun threads(s :~ List, a0 :~ List, d0 :~ List, a1 :~ List, d1 :~ List, r :~ List,
              u0 :~ List, u1 :~ List, ~split: split :: Boolean) :: List:
    fun gap(above :~ List, below :~ List) :: Real: ((above[3] :~ Real) + below[1]) / 2
    def start = under_leg(straight(middle_of(s), under_of(s)))
    def [turn0, run0] = drop_to(under_of(s), over_of(a0), gap(s, a0))
    fun write_line(a :~ List, u :~ List, d :~ List) :: List:
      [under_leg(beneath(over_of(a), u)), over_leg(arching(u, over_of(d))),
       under_leg(straight(over_of(d), under_of(d)))]
    // the gap between the two writes holds two threads in the program as written:
    // the one going on to the second write high in it, and the second write's own
    // arch low in it
    def [turn1, run1] = drop_to(under_of(d0), over_of(a1), gap(d0, a1) - 9.0)
    def [turn2, run2] = drop_to(under_of(d1), over_of(r), gap(d1, r))
    def finish = [over_leg(turn2), over_leg(run2), under_leg(straight(over_of(r), middle_of(r)))]
    cond
    | !split:
        [strand([start, over_leg(turn0), over_leg(run0), & write_line(a0, u0, d0),
                 over_leg(turn1), over_leg(run1), & write_line(a1, u1, d1), & finish])]
    | ~else:
        def [trunk, first_in] = split_cubic(& run0, split_at)
        // the strand that goes on: from the split along the gap past the end of
        // line 0, and down round it into the second write
        def f :~ List = (first_in :~ List)[0]
        def heading :~ List = (first_in :~ List)[1]
        def lane = (f[1] :~ Real)
        def w = [line0_right + 36.0, lane]
        def on1 = [f, towards(f, heading, 2.2), [w[0] - 50.0, lane], w]
        def on2 = [w, [w[0] + 24.0, lane], [cx_of(a1), (over_of(a1)[1] :~ Real) - 34.0], over_of(a1)]
        def lead = [start, over_leg(turn0), over_leg(trunk)]
        def live = strand(lead ++ [over_leg(on1), over_leg(on2), & write_line(a1, u1, d1), & finish])
        // and the strand that splits off: into the first write, out of the state it
        // leaves, and down and back into the gap under it, where it frays
        def du :~ List = under_of(d0)
        def loose = [du, [du[0], du[1] + 10.0], [du[0] - 6.0, du[1] + 17.0],
                     [du[0] - 24.0, du[1] + 18.0]]
        def dead = strand([over_leg(first_in), & write_line(a0, u0, d0), over_leg(loose)],
                          ~end: #'fray, ~offset: strand_length(strand(lead)))
        // the split one first, so that it comes out from under the one that goes on
        [dead, live]
  fun op_at(prog :~ Map, k :: Int, dy :: Real) :: List:
    def [p, x, y] = code_piece_at(prog, k, #'op)
    [p, x, y + dy]
  def orig_threads:
    def a0 = omega_box(orig_uses[0])
    def a1 = omega_box(orig_uses[1])
    threads(omega_box(code_piece_at(parts, #'sig, #'omega)), a0,
            omega_box(code_piece_at(parts, 0, #'state)), a1,
            omega_box(code_piece_at(parts, 1, #'state)), omega_box(orig_uses[2]),
            update_at(op_at(parts, 0, 0.0), a0[1]), update_at(op_at(parts, 1, 0.0), a1[1]),
            ~split: #false)
  def copy_threads:
    def a0 = omega_box(copy_uses_forked[0])
    def a1 = omega_box(copy_uses_forked[1])
    // the rewritten ω is a little narrower than the one it replaced, so the row's
    // top is read off the first write's, which is unchanged
    threads(omega_box(lower(code_piece_at(copy_parts, #'sig, #'omega))), a0,
            omega_box(lower(code_piece_at(copy_parts, 0, #'state))), a1,
            omega_box(lower(code_piece_at(copy_parts, 1, #'state))),
            omega_box(copy_uses_forked[2]),
            update_at(op_at(copy_parts, 0, copy_dy), a0[1]),
            update_at(op_at(copy_parts, 1, copy_dy), a1[1]),
            ~split: #true)
  // how far along a program's thread is all of it, frayed end and all
  fun all_of(sts :~ List) :: Real:
    for values(m :~ Real = 0.0) (st in sts): math.max(m, strand_length(st) + 40.0)
  // A program's threads drawn `upto` along, the one that splits off `red` of the
  // way to red; the needle with them while they are being drawn out.
  fun threads_pict(sts :~ List, upto :: Real, red :: Real, ~needle: needle :: Boolean) :: pc.Pict:
    def last = sts.length() - 1
    yarn_pict(for List (st in sts, i in 0..):
                [st, upto, (if i == last | yarn_blue | yarn_color(red)), needle],
              ~width: slide_width, ~height: slide_height)
  // A frame says which threads it shows, and how red the split one is:
  // `[#'yarn, which, red]` among its edges. The press draws them itself, since a
  // thread being drawn out is a shape that grows, not a pict that arrives: one the
  // frame before did not have is drawn out from its start over the press, needle
  // and all, and one whose red changes changes colour where it lies.
  fun threads_of(f :: Frame) :: Map:
    for values(m :~ Map = {}) (e :~ List in f.edges):
      if e[0] == #'yarn | m ++ { e[1]: e[2] } | m
  fun threads_for(which) :: List: if which == #'orig | orig_threads | copy_threads
  fun yarn_stage(layer :: pc.Pict, a :: Frame, b :: Frame, t :: Real) :: pc.Pict:
    def was = threads_of(a)
    def now = threads_of(b)
    def drawn:
      for values(q :~ pc.Pict = layer) (which in now.keys()):
        def sts = threads_for(which)
        def whole = all_of(sts)
        def p:
          if was.has_key(which)
          | threads_pict(sts, whole, (was[which] :~ Real) + ((now[which] :~ Real) - was[which]) * t,
                         ~needle: #false)
          | threads_pict(sts, whole * t, now[which], ~needle: t < 1.0)
        put(q, p, 0.0, 0.0)
    for values(q :~ pc.Pict = drawn) (which in was.keys()):
      skip_when now.has_key(which)
      def sts = threads_for(which)
      put(q, threads_pict(sts, all_of(sts), was[which], ~needle: #false).alpha(1.0 - t), 0.0, 0.0)
  def no_wire = fun (layer, es, at): layer
  def orig_yarn = [[#'yarn, #'orig, 0.0]]
  fun copy_yarn(red :: Real) :: List: [[#'yarn, #'copy, red]]

  // the bubbles: the two about the first line, up throughout; one on each program
  // saying how it uses memory, pointing at its box beside the second write; and
  // one on the copy, beside its first write, saying it is the same program
  def (box_right, _) = pc.Find.right(parts[#'frame]).in(plain)
  def first_write_y = code_y + code_inset + code_row + code_row / 2
  def second_write_y = code_y + code_inset + code_row * 2 + code_row / 2
  def explained = { #'explain: [explain_states, 0.0, 0.0, band_callout] }
  // clear of the bottom of the bubble about ω, which the one about linearity sat on,
  // and -- on the copy -- of the top of the long one under it, which it touched
  def linear_y = 488.0
  def with_omega = explained ++ { #'omega: [omega_bubble, 0.0, 0.0, band_callout] }
  def linear_over:
    // a band above the other bubbles: its spike runs up past the one about ω, and
    // is to be seen doing so
    { #'linear: [aimed(~at: [box_right - 4.0, second_write_y], ~body: [body_x, linear_y],
                       ~content: prose([["uses memory ", #'plain], ["linearly", #'bold]])),
                 0.0, 0.0, band_callout + 1] }
  def equivalent_over:
    { #'equivalent: [aimed(~at: [box_right - 4.0, first_write_y + copy_dy],
                           ~body: [body_x, 650.0], ~color: talk_green,
                           ~content: prose_stack([[["equivalent", #'bold], [" to original", #'plain]],
                                                  [["under dataflow semantics", #'plain]]])),
                     0.0, 0.0, band_callout] }
  // and the one line the rest of the talk answers, under the copy, pointing up at it
  def challenge_over:
    def copy_frame :: pc.Pict = copy_parts[#'frame]
    def under_x = code_x + copy_frame.width / 2
    def under_y = code_y + copy_dy + copy_frame.height
    { #'challenge: [aimed(~at: [under_x, under_y - 4.0], ~body: [under_x - 270.0, under_y + 28.0],
                          ~color: talk_red,
                          ~content: prose_stack([[["central challenge:", #'bold]],
                                                 [["non-linear programs unavoidable in the e-graph!", #'plain]]])),
                    0.0, 0.0, band_callout] }
  def nonlinear_over:
    { #'nonlinear: [aimed(~at: [box_right - 4.0, second_write_y + copy_dy],
                          ~body: [body_x, linear_y + copy_dy], ~color: talk_red,
                          ~content: prose([["uses memory ", #'plain], ["non-linearly", #'bold]])),
                    0.0, 0.0, band_callout + 1] }
  def f_states = Frame(~picts: explained)
  def f_omega = Frame(~picts: with_omega)
  def f_chain = Frame(~picts: with_omega, ~edges: orig_yarn)
  def f_linear = Frame(~picts: with_omega ++ linear_over, ~edges: orig_yarn)
  def f_copy:
    Frame(~picts: with_omega ++ linear_over ++ copy_picts(~forked: #false), ~edges: orig_yarn)
  def f_forked:
    Frame(~picts: with_omega ++ linear_over ++ copy_picts(~forked: #true), ~edges: orig_yarn)
  def f_equivalent:
    Frame(~picts: with_omega ++ linear_over ++ copy_picts(~forked: #true) ++ equivalent_over,
          ~edges: orig_yarn)
  // the thread woven through the copy, splitting
  def f_woven:
    Frame(~picts: with_omega ++ linear_over ++ copy_picts(~forked: #true) ++ equivalent_over,
          ~edges: orig_yarn ++ copy_yarn(0.0))
  // the strand that split off turns red as the bubble that names it comes
  def f_nonlinear:
    Frame(~picts: with_omega ++ linear_over ++ copy_picts(~forked: #true)
                    ++ equivalent_over ++ nonlinear_over,
          ~edges: orig_yarn ++ copy_yarn(1.0))
  def f_challenge:
    Frame(~picts: with_omega ++ linear_over ++ copy_picts(~forked: #true)
                    ++ equivalent_over ++ nonlinear_over ++ challenge_over,
          ~edges: orig_yarn ++ copy_yarn(1.0))
  // a press drawing a thread out takes its time, so that it can be followed
  def weave_extent = 2.6
  fun press(a :: Frame, b :: Frame, ~extent: extent :: Real = 1.0) :: pc.Pict:
    magic_press(with_states, a, b, ~wire: no_wire, ~edge_band: band_wires,
                ~stage: yarn_stage, ~stage_band: band_wires, ~extent: extent)

  // Then everything the slide put up over the program is taken back the way it
  // came: one layer holding all of it in the order it arrived, unwritten in one
  // press -- so the last thing said goes first and the first bubble last -- and
  // the threads drawn back in from their ends as they came. The layer is built by
  // hand rather than read off a frame, since a press fades what goes and does not
  // unwrite it, and since the order things were said in is not the order a frame's
  // map holds them.
  fun yarn_layer(sts :~ List, red :: Real) :: pc.Pict:
    def whole_len = all_of(sts)
    def whole = threads_pict(sts, whole_len, red, ~needle: #false)
    arriving(whole, Arrival(fun (n):
                              cond
                              | n >= 1.0: whole
                              | n <= 0.0: whole.ghost()
                              | ~else: threads_pict(sts, n * whole_len, red, ~needle: #false),
                            0.6, ~kind: #'stroke))
  fun layer_of(over :~ Map, key) :: pc.Pict: (over[key] :~ List)[0]
  // The rewritten copy as one box, its second write's ω set into the line, so that
  // its lines pop out whole. The pieces the frames key are not used here: the
  // timing they carry is for the press that brought them in, and a writer that
  // played it again on its own clock had the return's ω2 gone at the first instant.
  def copy_layer:
    put(blank_slide,
        code_pict(copy_parts, ~states: #true, ~holes: [[1, #'state_in, rewritten[1]]]),
        code_x, code_y + copy_dy)
  def aside_layer:
    pc.overlay(~horiz: #'left, ~vert: #'top,
               explain_states, omega_bubble, yarn_layer(orig_threads, 0.0),
               layer_of(linear_over, #'linear), copy_layer,
               layer_of(equivalent_over, #'equivalent), yarn_layer(copy_threads, 1.0),
               layer_of(nonlinear_over, #'nonlinear),
               layer_of(challenge_over, #'challenge))
  def aside_w = writer(aside_layer)
  def clearing:
    // quicker than the pace a sentence is unwritten at: this is the slide being
    // cleared, not something being said
    pc.animate(~extent: math.max(0.9, 0.55 * unwrite_pace * extent_for(aside_w.total)),
               ~bend: fun (x): x,
               fun (t): put(with_states, aside_w.frame(1.0 - t), 0.0, 0.0))

  // the page with its title; the code writes itself; a bubble explains a line; the
  // states move in under it; a second bubble names one; a thread is woven through
  // the program from the memory it is handed to its end, and a bubble says that is
  // linear; a copy of the program comes up; it is rewritten; a bubble says it is the
  // same program; the thread is woven through it and splits, one strand frayed at a
  // state nothing reads; a red bubble says how it differs as that strand turns red,
  // and another red one says the e-graph cannot help but hold it; and everything over
  // the program is unwritten, leaving the program alone under its title
  { #'pict: pc.switch(fade_in(canvas, code_layer, ~horiz: #'left, ~vert: #'top),
                      pc.overlay(~horiz: #'left, ~vert: #'top, plain, write(explain_plain))
                        .refocus(plain),
                      moving,
                      press(f_states, f_omega),
                      press(f_omega, f_chain, ~extent: weave_extent),
                      press(f_chain, f_linear),
                      press(f_linear, f_copy),
                      press(f_copy, f_forked),
                      press(f_forked, f_equivalent),
                      press(f_equivalent, f_woven, ~extent: weave_extent),
                      press(f_woven, f_nonlinear),
                      press(f_nonlinear, f_challenge),
                      clearing),
    #'title: title, #'code: code_states, #'parts: parts }

// -------------------------------------------------------------------------------------
// slide_egraph: the chain of `update`s going into the e-graph, one per press, the
// code line it comes from highlighted as it lands. Cross-fades between finished
// pictures, since the highlight moves and a reveal could only add.
fun slide_egraph():
  def parts = code_parts()
  chain_slide(egraph_page(parts, "The Effectful E-Graph", ~tag: "Effectful E-Graph title"),
              egraph_frames(parts))

// The page under the graph, drawn once and never animated: the title and the code.
fun egraph_page(parts :~ Map, title :: String, ~tag: tag :: String) :: pc.Pict:
  put(titled(title, ~tag: tag, ~nudge: [0.0, 0.0]),
      code_pict(parts, ~states: #true), code_x, code_y)

// The presses that build the graph, one line of the program at a time.
fun egraph_frames(parts :~ Map) :: List:
  // Each line of the program goes into the graph in two presses: the line is
  // marked, with a copy of every piece of it that means something sitting exactly
  // on top of that piece; then those copies fly right into the graph, each one
  // turning into the node it stands for as it lands.
  //
  // The copies are keyed by the nodes they become, so a piece of text and the box
  // it becomes are one thing travelling, which is the whole point: `a` in the
  // program *is* the `a` in the graph. Nothing waits in the middle, and no piece is
  // ever wider than the words it copies, so nothing crosses the edge of the slide.
  //
  // One band per line, built once, so the press that marks the next line has only
  // the band to move.
  def bands: for List (k in 0..3): band_of(parts, k) ++ [band_above]

  // Which node each piece of line `k` becomes. Only the pieces that bring a *new*
  // node are listed: by the second line its operands and its incoming state are in
  // the graph already, and the copy of a piece with nowhere to go would be motion
  // that means nothing.
  def line_targets:
    [{ #'value: #'v1, #'state: #'s1, #'op: #'u1,
       #'arg1: #'a, #'wrote: #'x, #'state_in: #'s0 },
     // the second line brings the value it writes, which is a term of its own: the
     // `+` that builds it and the `1` it adds
     { #'value: #'v2, #'state: #'s2, #'op: #'u2, #'wrote: #'xp, #'wrote_one: #'one },
     { #'op: #'ret }]

  // where the box draws line `k`, from the same measurements `code_pict` uses
  fun line_pict(k :: Int) :~ pc.Pict:
    ((parts[#'lines] :~ List)[k] :~ Map)[#'states]
  fun line_x() :: Real: code_x + code_inset + code_indent
  fun line_y(k :: Int) :: Real:
    code_y + code_inset + code_row * (k + 1) + (code_row - (line_pict(k)).height) / 2
  // the copies of line `k`'s pieces, each over the piece it copies
  // `band_flight`, so a copy on its way out of the code box is drawn over the band
  // marking the line it came from rather than behind it.
  // Each copy lies exactly over the piece it copies, so it is marked as already
  // there: written, it would trace letters the room can see.
  fun line_copies(k :: Int) :: Map:
    def targets :~ Map = line_targets[k]
    def segs :~ List = ((parts[#'lines] :~ List)[k] :~ Map)[#'segs]
    for values(m :~ Map = {}) ([role, piece, dx] in segs_pieces(segs)):
      skip_when !targets.has_key(role)
      m ++ { targets[role]: [already(piece), line_x() + dx, line_y(k), band_flight] }

  // The blue down the graph is the first thing to name once the graph is up: the
  // state values and the writes that thread them are one walk through the graph,
  // and "state walk" is the word the rest of the talk turns on. The bubble points
  // at the `return`, where the walk ends, from below it.
  def statewalk_over:
    { #'statewalk: [bubble_at(chain_plain[#'ret], ~spot: chain_spots[#'ret],
                              ~body: (chain_bubbles :~ Map)[#'statewalk],
                              ~color: talk_blue,
                              ~content: prose([["state walk", #'bold],
                                               [" uses memory linearly", #'plain]])),
                    0.0, 0.0, band_callout] }
  // The first write stores a value that the second one throws away. That is worth
  // saying as soon as the graph is up and before any rule is stated, because it is
  // the reason there is a rule at all -- so the part that builds the graph ends on
  // it, beside the bubble naming the walk. It points at the write in the graph
  // and at the line of the program it came from -- at the end of that line, as the
  // other bubbles about a line do, so the spike comes in from the right rather than
  // across the line below -- and stands between the two.
  def redundant_over:
    def first :~ pc.Pict = line_pict(0)
    def line_end = pc.blank(~width: 16.0, ~height: 16.0)
    { #'redundant: [bubble_at(chain_plain[#'u1], ~spot: chain_spots[#'u1],
                              ~also: [[line_end, [line_x() + first.width + 4.0,
                                                  line_y(0) + first.height / 2 - 8.0]]],
                              ~body: (chain_bubbles :~ Map)[#'redundant],
                              ~color: talk_blue,
                              ~content: robot_says(
                                          #'idea,
                                          pc.stack(~sep: 2.0, ~horiz: #'center,
                                                   small_prose("Redundant"),
                                                   small_prose("write")),
                                          ~sep: 6.0, ~above: #true,
                                          ~scale: 0.58)),
                    0.0, 0.0, band_callout] }
  [Frame(),
   & List.append(
       & for List (k in 0..3):
           def mark = { #'mark: bands[k] }
           [Frame(~picts: chain_node_picts(chain_spots_upto(k), []) ++ mark
                            ++ line_copies(k),
                  ~edges: chain_edges(k)),
            Frame(~picts: chain_node_picts(chain_spots_upto(k + 1), []) ++ mark,
                  ~edges: chain_edges(k + 1))]),
   Frame(~picts: chain_node_picts(chain_spots_upto(3), []) ++ statewalk_over,
         ~edges: chain_edges(3)),
   Frame(~picts: chain_node_picts(chain_spots_upto(3), []) ++ statewalk_over ++ redundant_over,
         ~edges: chain_edges(3))]

// The two bubbles the graph part ends on, for the part after it to keep up: they
// stay through the rule and go when extraction is asked for.
fun egraph_bubbles(parts :~ Map) :: Map:
  def frames :~ List = egraph_frames(parts)
  def last :: Frame = frames.last
  for values(m :~ Map = {}) (key in [#'statewalk, #'redundant]):
    m ++ { key: last.picts[key] }

// -------------------------------------------------------------------------------------
// slide_rue: a rule over `update`, and the rule applied.
//
// The second `update(a, x)` writes what the first already wrote: it returns `x`
// and leaves the state alone. A press states that beside the code, as the paper's
// overview figure does -- the two `update`s over a long horizontal line, what they
// make equal under it -- with the two code lines it is about marked; the next one
// does the union in the e-graph.
//
fun slide_rue():
  def parts = code_parts()
  chain_slide(egraph_page(parts, "Dead Store Elimination", ~tag: "Dead Store Elimination title"),
              rue_frames(parts))

// The presses that state the rule and apply it.
fun rue_frames(parts :~ Map) :: List:
  def rule_over = chain_rule_over(parts, ~value: #true)

  // Applying the rule, a movement to a press -- see the block above `rule_box` for
  // what each copy is keyed by, which is what makes each press a move.
  def rule_here = chain_rule_over(parts, ~value: #true)
  // The variables the conclusion uses again -- `a`, `y` and `ω`, the three the write
  // it adds is built from. These are the ones that light up and point at what they
  // matched: the rule binds more, but gold on every variable and every node they
  // stand for is gold on half the graph, and what the match is *about* is these
  // three. They are also the pointers that stay, sliding down to the conclusion.
  def reused:
    def slots :~ Map = (rule_slots(update_rule(~value: #true)) :~ Map)[#'conclusion]
    for List (role in slots.keys()):
      keep_when (chain_pos :~ Map).has_key(role) && chain_matched.contains(role)
      role
  // a chip per one of those, and none for the rest
  def chips_below:
    chain_rule_chips(parts, ~value: #true, ~lit: #true,
                     ~from: #'conclusion, ~only: reused)
  // the variables the conclusion uses again, which are the pointers that have
  // somewhere to go in the next press
  def pointed = reused
  def conclusion = chain_rule_pieces(parts, ~value: #true)
  def conclusion_nodes = chain_rule_pieces(parts, ~value: #true, ~as_nodes: #true)
  def equalities = chain_eq_pieces(parts, ~value: #true)

  def program = chain_node_picts(chain_spots_upto(3), [])
  def lit = chain_node_picts(chain_spots_upto(3), [], ~gold: reused)
  def with_rule = chain_node_picts(chain_spots, [])
  // The matching itself is not shown: the talk does not turn on how a rule finds its
  // match, so the rule is stated and then, in one press, the line it concludes is
  // written with its variables gold and pointing at the nodes they stand for.
  [// the graph the program builds
   Frame(~picts: program, ~edges: chain_edges(3)),
   // the rule, said beside the two lines of the program it is about
   Frame(~picts: program ++ rule_here, ~edges: chain_edges(3)),
   // the line it concludes, its variables gold and pointing at what they matched:
   // the bindings, saying what the rule adds
   Frame(~picts: lit ++ rule_here ++ chips_below ++ conclusion ++ equalities,
         ~edges: chain_edges(3) ++ chain_match_edges(chips_below, ~only: pointed)),
   // the words of that line become the nodes they name, standing where the words
   // stood. The pointers stay up: they go out on the press that brings the blue
   // arrows in, not one before it, so there is never a press with neither.
   Frame(~picts: lit ++ rule_here ++ chips_below ++ conclusion_nodes ++ equalities,
         ~edges: chain_edges(3) ++ chain_match_edges(chips_below, ~only: pointed)),
   // and those nodes move out into the graph, bringing their arrows
   Frame(~picts: with_rule ++ rule_here ++ equalities, ~edges: chain_edges(4)),
   // last, the equalities fly out and become the regions round the classes they
   // make
   Frame(~picts: with_rule ++ rule_here ++ rule_classes_under,
         ~edges: chain_edges(4))]

// -------------------------------------------------------------------------------------
// slide_fork: the same e-graph, a weaker rule, and the extraction that breaks.
//
// The rule now says only that the two states are equal, `ω1 ≡ ω2`, which is all a
// rule about memory can say without also knowing something about the values. So
// nothing says `v2` is `x`, the second `update` has to stay, and the walk -- free
// to take either node out of the state class it reaches -- takes the cheaper one
// for *both* `update`s that read it. What comes out has two `update`s reading one
// state: memory has forked, and that is not a program.
//
// The walk is the same walk, and it is right at every step. Which is the point:
// the fault is not in the search, it is in extracting a term from an e-graph that
// holds effects as if they were values. Everything about the picture is the same
// as the slide before it except the rule, so the two can be read against each
// other.
fun slide_fork():
  def parts = code_parts()
  def canvas = titled("Extraction Goes Wrong", ~tag: "Extraction failure title",
                      ~nudge: [0.0, 0.0])
  chain_slide(put(canvas, code_pict(parts, ~states: #true), code_x, code_y),
              fork_frames(parts))

// The presses that walk the extraction, find it wrong, and walk it again.
fun fork_frames(parts :~ Map) :: List:
  def rule_over = chain_rule_over(parts, ~value: #true)

  // Everything this slide shows is worked out from the one rule: what the walk
  // picks, what survives, and which memory is read twice.
  def graph = chain_graph
  def kept = chain_kept(graph, ~root: chain_root)
  def forks = chain_forks(graph, ~root: chain_root)
  def fork_key = ((forks[0] :~ List)[1])                 // the memory read twice
  def readers: for List (f :~ List in forks): f[0]       // and the writes reading it
  def fork_red = [fork_key] ++ readers

  // The term the walk comes back with, left where the graph has it. An edge stays
  // only if the node it leaves is in the term, and it is redrawn to the node its
  // class settled on -- which is how the `return` ends up pointing at the memory
  // the rule's write left, rather than at the one the program's second write left.
  def class_of:
    for values(m :~ Map = {}) ([key, cls, _] in graph): m ++ { key: cls }
  fun spots_of(keep :~ List) :: Map:
    for values(m :~ Map = {}) (key in keep): m ++ { key: chain_spots[key] }
  // The edges of one answer: an edge stays if the node it leaves is in the answer,
  // and it is aimed at whichever member of its class the answer took -- which is how
  // the `return` comes to point at the memory the rule's write left rather than the
  // one the program's second write left. `~red` names the nodes whose state edges
  // are the ones reading the same memory twice.
  fun edges_among(keep :~ List, ~red: red :~ List = []) :: List:
    def taken:
      for values(m :~ Map = {}) ([key, cls, _] in graph):
        if keep.contains(key) | m ++ { cls: key } | m
    for List (e :~ List in chain_edges(4)):
      keep_when keep.contains(e[1])
      def cls = class_of[e[2]]
      keep_when taken.has_key(cls)
      def kind = if e[0] == #'s && red.contains(e[1]) | #'f | e[0]
      [kind, e[1], taken[cls]]
  // What the walk came back with, on its own: the nodes it picked, in place, with
  // everything it did not pick gone. Nothing is red yet -- the term is worth a beat
  // as an answer before it is an accusation.
  def term:
    Frame(~picts: chain_node_picts(spots_of(kept), kept) ++ rule_over,
          ~edges: edges_among(kept))

  // Then what is wrong with it. The memory the program started with and the two
  // writes that both read it turn red, and the two state edges that read it turn red
  // with them, which is the diamond: one memory, two writes hanging off it.
  def term_edges = edges_among(kept, ~red: readers)
  def reddened:
    Frame(~picts: chain_node_picts(spots_of(kept), kept, ~red: fork_red) ++ rule_over,
          ~edges: term_edges)

  // and then the words for it. The two writes that read the
  // same memory and the memory itself are already red, and that *is* the diamond --
  // one memory with two writes hanging off it -- so there is nothing to relayout;
  // the callout only has to name what the red is saying.
  //
  // The callout points at a write rather than at the memory: the memory sits
  // directly above the two of them, so a spike from anywhere with room for the words
  // would have a write in the way. Of the two, the one nearer the words.
  def blamed_write:
    def [bx, _] = (chain_bubbles :~ Map)[#'fork]
    fun far(key): math.abs((chain_spots[key] :~ List)[0] - bx)
    for values(best = readers[0]) (r in readers): if far(r) < far(best) | r | best
  def fork_over:
    { #'fork: [bubble_at(chain_plain[blamed_write], ~spot: chain_spots[blamed_write],
                         ~body: (chain_bubbles :~ Map)[#'fork], ~color: talk_red,
                         ~content: prose([["non-linear!", #'bold]])),
               0.0, 0.0, band_callout] }
  def blamed:
    Frame(~picts: chain_node_picts(spots_of(kept), kept, ~red: fork_red)
                    ++ rule_over ++ fork_over,
          ~edges: term_edges)

  // Then the walk again, this time not allowed to read a memory twice. Which node
  // it takes out of each class is worked out rather than written down -- see
  // `chain_safe` -- and it comes back with one write where the program had two.
  //
  // The same pointer down the same rows, but a press a row rather than two: the
  // audience has seen the walk, and what is new is where it goes instead.
  def safe = chain_safe(~root: chain_root)
  def safe_edges = edges_among(safe)
  def ret_bow = -0.5
  // Its own body rather than the one in `chain_bubbles`: the face makes it wider
  // than the bubble that asked the question the first time, and where that one sat
  // this one would lie across the `return` it points at.
  fun safe_ask_over(~at: at :~ List = chain_spots[#'ret]) :: Map:
    { #'ask: [bubble_at(chain_plain[#'ret], ~spot: at,
                        ~body: [1010.0, 902.0], ~color: talk_green,
                        ~content: robot_says(
                                    #'smile,
                                    prose_stack([[["extract", #'bold]],
                                                 [["effect-safely", #'bold]]]),
                                    ~sep: 12.0, ~scale: 0.78)),
              0.0, 0.0, band_callout] }
  fun again(~picks: picks :: List = [], ~point: point = #false) :: Frame:
    Frame(~picts: chain_node_picts(chain_spots, picks) ++ rule_over
                    ++ rule_classes_under ++ safe_ask_over()
                    ++ (if point == #false
                        | {}
                        | { #'point: [chain_pointer, & chain_point_at(point)] }),
          ~edges: chain_edges(4))
  def rewalk:
    [// the pickaxe back at the top, on its own press
     again(~point: 0),
     & for List (row in 0..chain_layers):
         again(~point: row,
               ~picks: for List (key in safe): keep_when chain_layer_of[key] <= row; key)]

  // and what it comes back with, which is the program we wanted: one write, no
  // memory read twice, and cheaper than the program we started from
  // Left where the graph had them, the `return` and the value it reads have the
  // memory between them, on the straight line from the one to the other: so that
  // arrow bows down under it. The press after this one straightens it as the nodes
  // move into the term's own shape, where the line is clear.
  fun bowed(es :~ List, bend :: Real) :: List:
    for List (e :~ List in es):
      if e[0] == #'v && e[1] == #'ret && e[2] == #'v3 | [#'vbend, #'ret, #'v3, bend] | e
  def safe_term:
    Frame(~picts: chain_node_picts(spots_of(safe), safe) ++ rule_over ++ safe_ask_over(),
          ~edges: bowed(safe_edges, ret_bow))

  // Then the answer settles into the shape of the term it is. The places the graph
  // gave these nodes were solved for the whole graph, and with two thirds of it
  // gone they are the wrong places: what the write returns is off to one side, so
  // the `return`'s two arrows leave it at almost the same angle and lie over each
  // other. So the write moves under the middle of its own arguments and its results
  // line up beneath it, value on the left, and the `return` sits under the two of
  // them. Nothing arrives or leaves -- every node is in both frames -- so the press
  // is the answer tidying itself, not a new picture.
  // The leaves stay where the graph had them; what moves is everything below. The
  // write comes up a row -- the write it competed with is gone, so the row is free
  // -- and centres under its three arguments; its results line up beneath it, value
  // on the left as the `return` reads them; and the `return` sits under the two of
  // them, so its arrows leave at opposite angles instead of together.
  def answer_spots:
    { #'x: chain_spots[#'x], #'one: chain_spots[#'one],
      #'a: chain_spots[#'a], #'xp: chain_spots[#'xp], #'s0: chain_spots[#'s0],
      #'us: [1256.0, chain_y(2)],
      #'v3: [1256.0, chain_y(3)], #'s3: [1390.0, chain_y(3)],
      #'ret: [1265.0, chain_y(4)] }
  def answer:
    Frame(~picts: chain_node_picts(answer_spots, safe) ++ rule_over
                    ++ safe_ask_over(~at: answer_spots[#'ret]),
          ~edges: bowed(safe_edges, 0.0))

  chain_walk_frames(~graph: graph, ~rule: rule_over, ~kept: kept)
    ++ [term, reddened, blamed] ++ rewalk ++ [safe_term, answer]

// -------------------------------------------------------------------------------------
// slide_update_story: the four slides above as the one slide they are.
//
// The code box never moves and the graph beside it is only ever added to, so the
// story is one slide. Its title changes once: "Update" while the operation is
// explained, and "The Effectful E-Graph" from the moment the graph starts, through
// the rule and the walk -- a title that changed for each part was read as a new
// slide, and a distraction from the picture that had not changed. Each part is
// built exactly as the slide it was, and the joins are presses rather than slide
// changes. Shown as four slides, each join panned the whole page away and brought
// the same page back.
fun slide_update_story():
  def opening = update_opening()
  def parts :~ Map = opening[#'parts]
  def code_states :: pc.Pict = opening[#'code]
  def title_update :: pc.Pict = opening[#'title]
  def title_graph = title_text("The Effectful E-Graph")

  // The join from the opening to the graph: the page and the code stay, and the
  // title goes while the next comes -- the opening has already taken everything
  // else back. It ends on exactly the page the graph presses stand on.
  def bare = put(page_canvas(), code_states, code_x, code_y)
  def old_w = writer(title_update)
  def new_w = writer(title_graph)
  def out_t = unwrite_pace * extent_for(old_w.total)
  def in_t = extent_for(new_w.total)
  def join_extent = math.max(0.8, out_t + in_t)
  def split = out_t / join_extent
  def join:
    pc.animate(~extent: join_extent, ~bend: fun (x): x,
               fun (t):
                 def going = clamp01(1.0 - t / split)
                 def coming = clamp01((t - split) / (1.0 - split))
                 def q1 = put(bare, old_w.frame(going), title_x, title_y)
                 put(q1, new_w.frame(coming), title_x, title_y))

  // The graph presses, on a page with no title: the title is a key in every frame,
  // the one pict throughout, so no press has anything to do to it.
  def page = put(page_canvas(), code_states, code_x, code_y)
  fun entitled(frames :~ List, title :: pc.Pict) :: List:
    for List (f :: Frame in frames):
      Frame(~picts: f.picts ++ { #'title: [title, title_x, title_y, band_callout] },
            ~edges: f.edges)
  def eg = entitled(egraph_frames(parts), title_graph)
  // Each later part opens on the picture the part before ends with, which as its own
  // slide was where it took over: the rule's on the graph, the fork's on the graph
  // with the rule and its classes. In one story those frames are the ones before
  // them, so each part's opening frame is left out. The two bubbles the graph part
  // ends on stay up through the rule's part, and go on the press that asks for the
  // extraction: nothing is taken down until what it says has been used.
  def kept = egraph_bubbles(parts)
  def ru:
    for List (f :: Frame in entitled(rue_frames(parts).rest, title_graph)):
      Frame(~picts: f.picts ++ kept, ~edges: f.edges)
  def fk = entitled(fork_frames(parts).rest, title_graph)
  def frames = eg ++ ru ++ fk
  // The first walk down the graph steps a row a press, but its first four rows are
  // classes of one node each -- there is nothing to choose in them -- so those four
  // presses are one: the pointer runs down the rows and the picks land as it
  // passes, in one quicker go. `chain_walk_frames` puts the row the pointer first
  // picks from three frames into the fork's part -- after the asking and the
  // pickaxe's own arrival -- two with its opening frame gone.
  def walk_start = eg.length() + ru.length() + 2
  def quick = for List (k in 0..4): walk_start + k
  def presses:
    for List (i in 1..frames.length()):
      chain_press(page, frames[i - 1], frames[i],
                  ~extent: if quick.contains(i) | 0.4 | 1.0)
  def grouped:
    recur go(i = 1, acc :~ List = []):
      cond
      | i >= frames.length(): acc
      | i == walk_start:
          go(i + 4, acc ++ [pc.switch(& for List (k in 0..4): presses[i - 1 + k],
                                      ~join: #'splice)])
      | ~else: go(i + 1, acc ++ [presses[i - 1]])
  // no still for the first frame: the join has just drawn it
  pc.switch(opening[#'pict], join, & grouped)
