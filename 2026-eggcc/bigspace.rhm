#lang rhombus/and_meta
// slide_12: rewriting `(a + 1) - 1` by hand and then as an e-graph -- the slide
// that says why the space of rewrites is big and why an e-graph can hold it.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "term.rhm" open
  "codebox.rhm" open
  "egraph.rhm" open
  "rules.rhm" open
  "apply.rhm" open
  "write.rhm".already
  "write.rhm".remains
  pict as pc
  draw

export:
  slide_12

// -------------------------------------------------------------------------------------
// slide_12: Slide 3 through Slide 8, as one animated pict.
//
// These were separate slides, each a copy of the one before plus one more
// element -- so they collapse into one scene and a press per change. It opens on
// the picture the workflow slide before it ends on, and the show cuts to it.
fun slide_12():
  // A node of the e-graph. Keynote drew each as a rounded box with a text box
  // inside; building them from one description keeps the seven of them agreeing,
  // and gives each a pict the `arrow` helper can find and aim at.
  fun node(label :: String, ~color: color :: String = "000000",
           ~fill: fill :: String = node_white):
    graph_node(~width: 100.0, ~height: 100.0, ~adj: "30640",
               ~line: color, ~line_width: 4.0, ~fill: fill,
               ~label: node_label(label, ~size: 69.75))

  def n_a = node("a")
  def n_one = node("1")
  def n_plus = node("+")
  def n_minus = node("−")
  def n_plus_r = node("+", ~color: "0433FF")
  def n_minus_r = node("−", ~color: "0433FF")
  def n_zero = node("0", ~color: "FF9300")
  // The same seven nodes again, filled green: a node extraction picked is that
  // node with a green background, not a ring laid over it and not a wash, which
  // would tint the label along with the box. Built once, so that a press can fade
  // the green one in over the white one and the box turns green where it stands.
  def plain:
    { #'a: n_a, #'one: n_one, #'plus: n_plus, #'minus: n_minus,
      #'plus_r: n_plus_r, #'minus_r: n_minus_r, #'zero: n_zero }
  // and again in gold, for a node a rule has just matched
  def gold:
    { #'a: node("a", ~fill: node_match),
      #'one: node("1", ~fill: node_match),
      #'plus: node("+", ~fill: node_match),
      #'minus: node("−", ~fill: node_match),
      #'plus_r: node("+", ~color: "0433FF", ~fill: node_match),
      #'minus_r: node("−", ~color: "0433FF", ~fill: node_match),
      #'zero: node("0", ~color: "FF9300", ~fill: node_match) }
  def green:
    { #'a: node("a", ~fill: node_green),
      #'one: node("1", ~fill: node_green),
      #'plus: node("+", ~fill: node_green),
      #'minus: node("−", ~fill: node_green),
      #'plus_r: node("+", ~color: "0433FF", ~fill: node_green),
      #'minus_r: node("−", ~color: "0433FF", ~fill: node_green),
      #'zero: node("0", ~color: "FF9300", ~fill: node_green) }
  def nd = 100.0                              // the node size `node` builds

  // Inputs on top, the result underneath, so every edge points the way the data
  // goes. Keynote had it the other way up, with the root above its operands.
  def row_in = 485.051
  def row_mid = 676.242
  def row_out = 867.432
  // The data-flow arrow, left of the graph. It sits out at 620 rather than just
  // off the graph's edge to leave the lane at 706 free: that is where the
  // extraction pointer walks down, and the two of them side by side is the point
  // -- extraction reads the classes the way the data flows.
  def flow_x = 620.0

  // The same title the picture before this one carries, written by the same helper:
  // the press that leaves that picture puts the term and the rules where this slide
  // draws them, and a title set even slightly differently is the one thing on the
  // slide that would move.
  def base_canvas = titled(flow_title, ~tag: "Big space title", ~nudge: [0.0, 0.0])

  // The rules, each under a key of its own rather than all three in one picture:
  // a rule that comes over to what it matched is that key drawn somewhere else, and
  // a press moves it.
  def rule_of = { #'rule1: rule_assoc, #'rule2: rule_zero, #'rule3: rule_ident }
  def rule_home:
    { #'rule1: rules_line_1_at, #'rule2: rules_line_2_at, #'rule3: rules_line_3_at }

  // Where the seven of them sit. Inputs on top, the result underneath, so every
  // edge points the way the data goes -- and a node's operands in order from left
  // to right, since an e-node's children are ordered: `a + 1` is `a` then `1`, and
  // `(a + 1) − 1` is the sum then the `1`. So `a` stands left of `1`, `+` left of
  // `1`, and after the rewrite `a` left of `−`(rewritten), whose two operands are
  // the one `1`.
  //
  // The rest is what the edges and the classes need. `a` stands straight above
  // `+_r`, because the class the third rule makes is drawn as a column up that
  // lane, and `+` stands clear to the right of that lane so the column does not
  // run behind it. `−` sits under `1`, which it reads straight up, and well right
  // of `+_r`: the long edge from `+_r` up to `−`(rewritten) has to pass over the
  // bottom row somewhere, and there it passes fifty clear above `−` instead of
  // through it. `−`(rewritten) is far enough right of `1` that its pair of arrows
  // up to it, spread 18 either side of the middle, come out a clear 20 apart
  // rather than stacked on a near-vertical run.
  def spot:
    { #'a: [860.0, row_in], #'one: [1230.0, row_in],
      #'plus: [1040.0, row_mid], #'minus_r: [1480.0, row_mid],
      #'zero: [1650.0, row_mid],
      #'plus_r: [860.0, row_out], #'minus: [1230.0, row_out] }
  fun middle(key) :: List:
    [(spot[key] :~ List)[0] + nd / 2, (spot[key] :~ List)[1] + nd / 2]
  fun spots_of(keys :~ List, picks :~ List, ~gold: matched :~ List = []) :: Map:
    for values(m :~ Map = {}) (k in keys):
      def pict:
        cond
        | matched.contains(k): gold[k]
        | picks.contains(k): green[k]
        | ~else: plain[k]
      m ++ { k: [pict, & spot[k]] }
  def keys_term = [#'a, #'one, #'plus, #'minus]
  def keys_rewrite = keys_term ++ [#'plus_r, #'minus_r]
  def keys_all = keys_rewrite ++ [#'zero]

  // Two colours, not one: the green belongs to the third rule -- it is the colour
  // that rule is written in, so its dashed equivalence is drawn in it too -- and a
  // picked node needs to be something else, or the mark on a node and the rule
  // that changes which node gets marked read as the same thing.
  def rule_green = draw.Color(79, 143, 0)


  // The edges, by kind. A solid arrow is an operand feeding an operator, and they
  // all point from the operator up to what it is built from: the arrowheads say
  // which term contains which, not which way the values go. A dashed line with no
  // head is an e-class -- those two nodes are the same value, not a flow between
  // them. Blue is what the blue rule put there.
  //
  // The long diagonals thread the gap between the two middle nodes, which is why
  // the columns sit where they do.
  // Where one line of a pair leaves and arrives: it comes up from the right, so
  // the two heads are spread down `1`'s side rather than under it, where the arrow
  // from `−` arrives.
  fun pair_from(from, off :: Real) :: pc.Find:
    pc.Find.left(as_pict(from), ~dx: -4, ~dy: off)
  fun pair_to(to, off :: Real) :: pc.Find:
    pc.Find.right(as_pict(to), ~dx: 4, ~dy: off)
  def pair_offsets = [-18.0, 18.0]
  // Where an edge of a kind with ends of its own leaves and arrives -- one line of a
  // pair, or an arrow stepping aside for a class line (see the wire) -- and
  // `#false` for an edge drawn border to border. The wire draws with these, and a
  // pointer becoming such an edge ends where it will run.
  fun edge_ends(e :~ List, from, to):
    match e[0]
    | #'op_half: values(pair_from(from, e[3]), pair_to(to, e[3]))
    | #'op_aside:
        values(pc.Find.top(as_pict(from), ~dx: -24, ~dy: -4),
               pc.Find.bottom(as_pict(to), ~dx: -24, ~dy: 4))
    | ~else: values(#false, #false)
  fun wire(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
    fun eq(q, x, y, col):
      arrow(~on: q, x, y, ~style: #'line, ~line_style: #'short_dash,
            ~color: col, ~line_width: 4)
    // a rule's pointer at the node it matched, becoming the edge of the node the
    // rule added: `e[1]` is the pointer spec, `e[2]` the edge it becomes, `e[3]`
    // how far along the press is
    fun morph(q, e :~ List):
      def [_, chip, node] = e[1] :~ List
      def new :~ List = e[2]
      // it ends where the edge it becomes will run: one line of a pair, or an
      // arrow standing aside, not the middle either is measured from
      def (from_b, to_b) = edge_ends(new, at[new[1]], at[new[2]])
      arrow_morph(~on: q, ~t: e[3],
                  ~from_a: at[chip], ~to_a: at[node],
                  ~from_b: at[new[1]], ~to_b: at[new[2]],
                  ~color_a: chip_line_color, ~color_b: keynote_blue,
                  ~line_width_a: 3, ~line_width_b: 4, ~gap_a: 4, ~gap_b: 4,
                  ~from_at_a: pc.Find.bottom(as_pict(at[chip]), ~dy: 4),
                  ~from_at_b: from_b, ~to_at_b: to_b)
    fun edge(q, e :~ List):
      // `at` is this frame's own nodes, which is what the layer has ghosts of
      def from = at[e[1]]
      def to = at[e[2]]
      match e[0]
      | #'op: arrow(~on: q, from, to, ~line_width: 4, ~gap: 4)
      | #'op_blue: arrow(~on: q, from, to, ~line_width: 4, ~gap: 4, ~color: keynote_blue)
      // `1 − 1` takes the same node for both of its operands, so it needs two
      // arrows: one arrow would say the operator takes one thing. Each is a spec
      // of its own -- `[#'op_half, from, to, offset]` -- so that the pair exists
      // from the press that brings the node on and each of the rule's two pointers
      // has a line of its own to become. They run side by side, pinned `offset`
      // either side of the border's middle.
      | #'op_half:
          def (from_at, to_at) = edge_ends(e, from, to)
          arrow(~on: q, from, to, ~line_width: 4, ~color: keynote_blue,
                ~from_at: from_at, ~to_at: to_at)
      // the pointers are drawn by the layer under the rule, not this one
      | #'point: q
      | #'eq_blue: eq(q, from, to, keynote_blue)
      | #'eq_orange: eq(q, from, to, draw.Color(255, 147, 0))
      // `+_r` reads `a`, and once the third rule fires `a` is also in `+_r`'s class:
      // this operand arrow and the line that says those two are equal join the same
      // two boxes, one directly above the other, and would run down the same lane.
      // The arrow is the one that steps aside -- the equality is drawn along the
      // middle of the class region it belongs to and cannot leave it.
      //
      // It steps aside along the borders rather than by shifting the whole line
      // sideways, which would leave both of its ends hanging in space. 24 and not
      // 40: a node is 100 wide with its corners rounded by 30, so an end further out
      // than that lands where the box has no edge.
      | #'op_aside:
          def (from_at, to_at) = edge_ends(e, from, to)
          arrow(~on: q, from, to, ~line_width: 4, ~color: keynote_blue,
                ~from_at: from_at, ~to_at: to_at)
    for values(q :~ pc.Pict = layer) (e :~ List in es):
      // not an edge: how far the class the third rule makes has grown, which the
      // press draws for itself. Skipped before the lookups below, which would read
      // a number as a key.
      skip_when e[0] == #'grow
      if e[0] == #'morph | morph(q, e) | edge(q, e)

  def es_plus: [[#'op, #'plus, #'a], [#'op, #'plus, #'one]]
  def es_minus: [[#'op, #'minus, #'plus], [#'op, #'minus, #'one]]
  def es_term = es_plus ++ es_minus
  // the dashed line a rule concluded, once it has fired
  fun eq_of(key) :: Map: rule_arrow(key, ~as_line: #true)

  // The data-flow arrow, left of the graph, on a layer of its own: it arrives with
  // the term and stays put, so no press has anything to do to it. It sits out at
  // 620 rather than just off the graph's edge to leave the lane at 706 free: that
  // is where the extraction pointer walks down, and the two of them side by side is
  // the point -- extraction reads the classes the way the data flows.
  //
  // The line is drawn on a lane just wide enough for it, so that `write` can see
  // its ink, and the words are beside it as a pict of their own: `write` draws the
  // line first, from the top with the head at the nib -- the way the graph's own
  // edges arrive -- and pops the words in after it.
  def flow_over:
    def top = blank(1.0, 1.0)
    def bot = blank(1.0, 1.0)
    def y0 = row_in + 14.0
    def y1 = row_out + 86.0
    def lane_pad = 20.0
    def lane:
      put(put(pc.blank(~width: 2 * lane_pad, ~height: y1 - y0 + 2 * lane_pad),
              top, lane_pad, lane_pad),
          bot, lane_pad, y1 - y0 + lane_pad)
    def line = drawn_arrow(~on: lane, top, bot, ~line_width: 4,
                           ~color: draw.Color(150, 150, 150))
    def word = prose_text("data flow", ~color: draw.Color(0x78, 0x78, 0x78), ~arrive: #'pop)
    // the words sit left of the line, centred on its middle, far enough over to
    // clear it
    def word_cx = flow_x - 120.0
    def word_cy = (y0 + y1) / 2
    def left = word_cx - word.width / 2
    def layer_top = y0 - lane_pad
    def layer:
      put(put(pc.blank(~width: flow_x + lane_pad - left, ~height: y1 - y0 + 2 * lane_pad),
              line, flow_x - lane_pad - left, 0.0),
          word, 0.0, word_cy - word.height / 2 - layer_top)
    { #'flow: [layer, left, layer_top, band_above] }

  // Where a rule stands while it fires: over the graph, in the band between the
  // title and the row of leaves, so that its pointers run down into the picture and
  // a pointer that passes a node goes behind it. It goes back to the list
  // afterwards, so the next rule finds the place free.
  def rule_stage = [800.0, 276.0]
  // The same size it is written at in the list, not a smaller one: a key drawn with
  // the *same* pict in both frames is moved and nothing else, while two sizes of it
  // cross-fade, which reads as the words smearing on the way over.
  def rule_stage_scale = 1.0
  fun rule_box(key, ~staged: staged :: Boolean) :: List:
    def rule :~ Map = rule_of[key]
    def factor = if staged | rule_stage_scale | 1.0
    [(rule[#'pict] :~ pc.Pict).scale(factor), factor,
     & (if staged | rule_stage | rule_home[key])]
  fun rule_over(key, ~staged: staged :: Boolean = #false) :: Map:
    def [pict, _, x, y] = rule_box(key, ~staged: staged)
    { key: [pict, x, y, band_rule] }

  // The term itself, where the slide keeps it, from the press on which a copy of it
  // sets off for the graph. On the picture the slide opens with, the copy *is* the
  // term -- drawn once, exactly where the slide before left it -- and this takes
  // over from it the instant the copy moves, so it is seen the whole way rather than
  // written again under the copy as it goes.
  //
  // Laundered, because it is built from the very glyph picts the copy is made of:
  // left findable, the layer the edges aim their arrows on would hold each glyph
  // twice while a glyph is on its way to being a node, and `Find` refuses to choose.
  def term_home:
    { #'term_home: [remains(input_line.launder()), term_x, term_y, band_nodes] }

  // the list, with one of its rules standing over by the graph instead of in it --
  // and the term above the list, which every frame after the first has
  fun rules_with(staged) :: Map:
    rule_over(#'rule1, ~staged: staged == #'rule1)
      ++ rule_over(#'rule2, ~staged: staged == #'rule2)
      ++ term_home
  def rules_over = rules_with(#false)

  // The pieces of a rule, keyed by what each is about, for the movements of firing
  // it: its variables light up and point at the nodes they matched, those pointers
  // move to the other side of the arrow where the same variables stand, and the
  // operators the right-hand side introduces fly out and become nodes.
  //
  // Only the pieces a match *bound*: the rule's operators are matched too, but that
  // a `+` matched a `+` is not news, and a chip on one is a claim that it is.
  // `~only` keeps a named few of those, for the press where one of them stays behind.
  fun rule_chips(key, ~side: side = #'lhs, ~lit: lit :: Boolean = #true,
                 ~staged: staged :: Boolean = #true,
                 ~only: only :: maybe(List) = #false) :: Map:
    def rule :~ Map = rule_of[key]
    def binds :~ Map = rule[#'binds]
    def [_, factor, x, y] = rule_box(key, ~staged: staged)
    def [segs, dx0] = rule[side]
    def line :~ pc.Pict = rule[#'pict]
    for values(m :~ Map = {}) ([name, piece, dx] in segs_pieces(segs)):
      skip_when !binds.has_key(name)
      skip_when only != #false && !(only :~ List).contains(name)
      // the pieces of a line stand on one baseline, so a shorter piece sits lower
      def dy = line.height - (piece :~ pc.Pict).height
      m ++ { [#'match, name]: chip_at((piece :~ pc.Pict).scale(factor),
                                      x + factor * (dx0 + dx), y + factor * dy,
                                      ~lit: lit, ~band: band_chip) }
  // the nodes a rule matched, which light up while it is matching
  fun rule_matched(key) :: List:
    for List (name in ((rule_of[key] :~ Map)[#'binds] :~ Map).keys()):
      ((rule_of[key] :~ Map)[#'binds] :~ Map)[name]
  fun rule_points(key, ~side: side = #'lhs, ~only: only :: maybe(List) = #false) :: List:
    def rule :~ Map = rule_of[key]
    def binds :~ Map = rule[#'binds]
    def [segs, _] = rule[side]
    for List ([name, _, _] in segs_pieces(segs)):
      keep_when binds.has_key(name)
                  && (only == #false || (only :~ List).contains(name))
      [#'point, [#'match, name], binds[name]]
  // What each rule concludes, as the dashed line that says it: the two nodes it
  // makes equal, and -- for the third rule, whose two classes become one -- the very
  // curve the region round them is drawn along, so the line and the wash agree from
  // end to end by construction.
  fun rule_eq_line(key) :: List:
    def color = (rule_of[key] :~ Map)[#'color]
    fun straight(a, b) :: List:
      def p = border_toward(a, b)
      def q = border_toward(b, a)
      eq_line(p, p, q, q, ~dash: color)
    match key
    | #'rule1: straight(#'minus, #'plus_r)
    | #'rule2: straight(#'minus_r, #'zero)
    // Between the sum the rule matched and the `a` it concluded is the same as it,
    // which is what the rule says. Not between `−` and `a`: that those two are one
    // class as well is the *first* rule's doing, carried across by the class the sum
    // was already in.
    | ~else: straight(#'plus_r, #'a)
  // where a line between two nodes leaves the first of them
  fun border_toward(from, to) :: List:
    def [fx, fy] = middle(from)
    def [tx, ty] = middle(to)
    def dx = tx - fx
    def dy = ty - fy
    def far = 1.0e9
    def t:
      math.min(if math.abs(dx) > 1.0e-9 | (nd / 2) / math.abs(dx) | far,
               if math.abs(dy) > 1.0e-9 | (nd / 2) / math.abs(dy) | far)
    [fx + dx * t, fy + dy * t]

  // The `→` of a rule, keyed by the equality it becomes. `~as_line` is the far end
  // of that: the dashed line, where it belongs in the picture. The glyph is padded
  // out to the line's own size so the two share a top left corner, which is what
  // puts the words in the middle of the line they turn into rather than at its end.
  //
  // The copy lies exactly over the `→` the rule itself draws, so it is marked as
  // already there: written, it would trace a glyph the room can see. `~ghost` puts
  // an invisible copy in its place, for the frame before the rule comes over -- the
  // key then exists on both sides of that press and travels with the rule, instead
  // of appearing at the far end before the rule has arrived.
  fun rule_arrow(key, ~as_line: as_line :: Boolean = #false,
                 ~staged: staged :: Boolean = #true,
                 ~ghost: ghost :: Boolean = #false) :: Map:
    def rule :~ Map = rule_of[key]
    def line :~ List = rule_eq_line(key)
    def [line_pict, lx, ly] = line
    cond
    | as_line: { [#'same, key]: [line_pict, lx, ly, band_wires] }
    | ~else:
        def [_, factor, x, y] = rule_box(key, ~staged: staged)
        def [glyph, dx] = rule[#'arrow]
        def small = (glyph :~ pc.Pict).scale(factor)
        def whole :~ pc.Pict = rule[#'pict]
        def dy = whole.height - (glyph :~ pc.Pict).height
        def padded:
          pc.overlay(pc.blank(~width: (line_pict :~ pc.Pict).width,
                              ~height: (line_pict :~ pc.Pict).height),
                     small)
        { [#'same, key]: [(if ghost | padded.ghost() | already(padded)),
                          x + factor * dx - (padded.width - small.width) / 2,
                          y + factor * dy - (padded.height - small.height) / 2,
                          band_wires] }

  // The right-hand side of a rule, as the term it stands for: a node per piece, and
  // the arrows between them. A piece that names a variable is drawn as the node that
  // variable matched, in gold; a piece the rule adds is drawn as the node it becomes.
  //
  // `~home` puts each of them where it belongs in the graph instead of under the
  // rule -- the added ones at their own places, and each gold one on top of the node
  // it matched. So the press between the two is the whole right-hand side moving
  // into the picture at once, arrows and all, with the gold boxes landing on the
  // nodes they stand for. Two variables that matched one node land either side of
  // its middle, which is where the pair of arrows the graph draws for them arrives.
  fun rule_term(key, ~home: home :: Boolean = #false) :: Map:
    def rule :~ Map = rule_of[key]
    def adds :~ List = rule[#'adds]
    def [_, factor, x, y] = rule_box(key, ~staged: #true)
    def [segs, dx0] = rule[#'rhs]
    def line :~ pc.Pict = rule[#'pict]
    // The pieces of that side the rule *adds*. Its variables are not among them: a
    // variable stands for a node that is already in the picture, and a second copy
    // of that node laid over it is a lie about what the rule builds. The arrows
    // reach down to the real one instead -- see `rule_term_edges`.
    for values(m :~ Map = {}) ([name, piece, dx] in segs_pieces(segs)):
      skip_when !adds.contains(name)
      def small = (piece :~ pc.Pict).scale(factor)
      def dy = line.height - (piece :~ pc.Pict).height
      def node :~ pc.Pict = as_pict(plain[name])
      // the size of the word it grows out of, not of the node it becomes: a node
      // dropped into the rule at full size is bigger than the line it is written in
      def shrunk = node.scale(small.height / node.height)
      def spot:
        if home
        | spot_of(name)
        // The box grows around the word it replaces, where that word is written in
        // the rule -- the same movement the rule on the dead-store slide makes when
        // the line it concludes becomes nodes. A row of boxes assembled somewhere
        // else says the rule produced them; a box grown around the operator says
        // which piece of the rule each one is.
        | [x + factor * (dx0 + dx) - (shrunk.width - small.width) / 2,
           y + factor * dy - (shrunk.height - small.height) / 2]
      m ++ { name: [(if home | plain[name] | shrunk), & spot, band_flight] }

  // The arrows of that term. An operand the rule adds is one of its own boxes; an
  // operand that is a variable is the node that variable matched, where it already
  // stands -- so the arrow is drawn to the graph from the first press, and the press
  // that sends the term home moves only the end that is moving.
  //
  // Two operands that are one node -- `1 − 1` -- are the pair of lines the graph
  // draws for them, one spec per line, from the first press: drawn as two edges to
  // the one node they would lie on top of each other and read as one, and the
  // pair would turn up later, when the graph's own edges took over.
  fun rule_term_edges(key) :: List:
    def rule :~ Map = rule_of[key]
    def adds :~ List = rule[#'adds]
    def binds :~ Map = rule[#'binds]
    fun node(name): if adds.contains(name) | name | binds[name]
    List.append(
      & for List ([parent, kids] in rule[#'builds] :~ List):
          def from = node(parent)
          def targets = for List (kid in kids :~ List): node(kid)
          List.append(
            & for List (kid in kids :~ List, i in 0..):
                def to = node(kid)
                def twins = for List (t in targets): keep_when t == to; t
                if twins.length() > 1
                | // its place among the operands that share the node picks its line
                  def rank = (for List (k in (kids :~ List).take(i)): keep_when node(k) == to; k).length()
                  [[#'op_half, from, to, pair_offsets[rank]]]
                | [[#'op_blue, from, to]]))
  // The operand arrows of the graph once the first rule has fired *are* that rule's
  // term's, so that nothing is redrawn when the graph's own edges take over from the
  // rule's. The equalities are not here: each one is the dashed line a rule's `→`
  // turned into, laid by `eq_of` as a pict of its own.
  def es_rewrite = rule_term_edges(#'rule1)
  def es_graph = es_term ++ es_rewrite
  // Once the third rule has fired, `a` is in the sum's class and the dashed line
  // that says so runs down the lane between the two -- the lane the operand arrow
  // from the sum to `a` runs down. So on that press the arrow steps aside
  // (`#'op_aside`), and not before: until then it is an arrow like the others.
  fun es_graph_when(merged :: Boolean) :: List:
    if merged
    | for List (e :~ List in es_graph):
        if e[0] == #'op_blue && e[1] == #'plus_r && e[2] == #'a
        | [#'op_aside, #'plus_r, #'a]
        | e
    | es_graph

  fun rule_flight(key) :: Map:
    def rule :~ Map = rule_of[key]
    def [_, factor, x, y] = rule_box(key, ~staged: #true)
    def [segs, dx0] = rule[#'rhs]
    def line :~ pc.Pict = rule[#'pict]
    for values(m :~ Map = {}) ([name, piece, dx] in segs_pieces(segs)):
      skip_when !(rule[#'adds] :~ List).contains(name)
      def dy = line.height - (piece :~ pc.Pict).height
      m ++ { name: [(piece :~ pc.Pict).scale(factor),
                    x + factor * (dx0 + dx), y + factor * dy, band_flight] }
  // The third rule is held back: it is the one that makes the difference to what
  // extraction can find, so the slide extracts a term without it first and only
  // then puts it up.
  def third_over = rule_over(#'rule3)

  // A class, drawn as the region round the nodes it holds -- the box its members
  // span, grown a little. The two classes with two members each have both of them
  // side by side in a row, which is what lets a rectangle say it. Each is built
  // once: the three the merge leaves alone are then the same layer before and
  // after it, and a press has only the two it changes to draw.
  fun region(x :: Real, y :: Real, w :: Real, h :: Real,
             ~fill: fill = eclass_grey) :: List:
    [pc.rectangle(~width: w + 2 * eclass_pad, ~height: h + 2 * eclass_pad,
                  ~fill: fill, ~line: #false, ~rounded: -0.35),
     x - eclass_pad, y - eclass_pad, band_below]
  fun spot_of(key) :: List: spot[key] :~ List
  // the box round two members of a class, whichever order they are named in
  fun region_of(from, to, ~fill: fill = eclass_grey) :: List:
    def [fx, fy] = spot[from] :~ List
    def [tx, ty] = spot[to] :~ List
    def x0 = math.min(fx, tx)
    def y0 = math.min(fy, ty)
    region(x0, y0, math.max(fx, tx) + nd - x0, math.max(fy, ty) + nd - y0, ~fill: fill)
  def r_one = region_of(#'one, #'one)
  def r_plus = region_of(#'plus, #'plus)
  def r_row = region_of(#'minus_r, #'zero)
  def r_a = region_of(#'a, #'a)
  def r_out = region_of(#'minus, #'plus_r)
  // The class the third rule makes: `a`, and the two roots that are now equal to
  // it. The two classes it is made of keep the rectangles they already had, and a
  // tube drawn along the very line that says they are equal joins them -- so the
  // region and the dashed line agree from end to end by construction, instead of
  // being two shapes that have to be lined up by hand.
  //
  // It is drawn the way the extractable sets on the algorithm slide are: one flat
  // colour, faded once at the end, so that the pieces it is made of do not show
  // where they overlap. The pieces are a lobe on each of the three nodes and a neck
  // running from one to the next, both stroked with a round cap and a round join --
  // so the blob has no corner anywhere, and the turn under `+_r` is a curve rather
  // than the square elbow a projecting cap left there.
  // The class the third rule makes, drawn by the press rather than by either frame:
  // what has to happen when it fires is that the class the sum was already in
  // *grows* to take in the `a`, and a second shape that arrives can only dissolve
  // over the first. `u` is how far it has grown -- 0 is the class as it was, which
  // is the band along the bottom row, and 1 is that band carried up `a`'s column.
  //
  // The corner the band turns at is the sum's own middle, so at `u = 0` the curve is
  // the straight run the old region was and nothing has to be special-cased.
  //
  // It is drawn as the two regions it is made of, in the shape every other class on
  // the slide has: the band along the bottom row that the class already was, and a
  // column up `a`'s lane from the sum to the `a`, grown as far as `u` says. Both in
  // one flat colour faded once, so where they overlap under the sum is no darker.
  // `u` is also how much of it there is: at 0 there is none, which is what the
  // press that leaves the graph behind ends on.
  fun merged_layer(u :: Real) :: pc.Pict:
    def [mx, my] = spot_of(#'minus)
    def [px, py] = spot_of(#'plus_r)
    def [ax, ay] = spot_of(#'a)
    def pad = eclass_pad
    def top = (py :~ Real) + ((ay :~ Real) - (py :~ Real)) * u
    // the band along the bottom row, from whichever of the two is left to the other
    def left = math.min(mx :~ Real, px :~ Real)
    def right = math.max(mx :~ Real, px :~ Real)
    def row = [left - pad, (my :~ Real) - pad, right + nd + pad - (left - pad), nd + 2 * pad]
    def col = [(ax :~ Real) - pad, top - pad, nd + 2 * pad,
               (py :~ Real) + nd + pad - (top - pad)]
    def flat:
      pc.dc(fun (target :: draw.DC, dx, dy):
              target.save()
              target.brush := draw.Brush(~color: eclass_solid)
              target.pen := draw.Pen.none
              for (r :~ List in [row, col]):
                def [x, y, w, h] = r
                def p = draw.Path()
                p.rounded_rectangle([dx + x, dy + y, w, h], 0.35 * math.min(w, h))
                target.path(p)
              target.restore(),
            ~width: slide_width, ~height: slide_height)
    flat.alpha(eclass_alpha * u, ~composite: #true)
  // how far grown each frame says it is, and the layer between two of them
  fun merged_marks(u :: Real) :: List: [[#'grow, u]]
  fun grow_of(f :: Frame) :: Real:
    for values(u :~ Real = 0.0) (e :~ List in f.edges):
      if e[0] == #'grow | (e[1] :~ Real) | u
  fun any_grow(f :: Frame) :: Boolean:
    for values(any = #false) (e :~ List in f.edges): any || e[0] == #'grow
  fun merged_stage(layer :: pc.Pict, a :: Frame, b :: Frame, t :: Real) :: pc.Pict:
    cond
    | !any_grow(a) && !any_grow(b): layer
    | ~else:
        def ua = grow_of(a)
        def ub = grow_of(b)
        put(layer, merged_layer(ua + (ub - ua) * t), 0.0, 0.0)

  def classes_under:
    { #'r_one: r_one, #'r_plus: r_plus, #'r_row: r_row,
      #'r_a: r_a, #'r_out: r_out }
  // The three the merge leaves alone. The one it makes is the grown layer above,
  // which the press draws rather than the frame.
  def merged_under:
    { #'r_one: r_one, #'r_plus: r_plus, #'r_row: r_row }

  // The bubble extraction speaks through: it names the job while the walk runs, and
  // it points at the *class* the answer is to come out of, not at a node in it.
  // That is what extraction is asked for: a term out of a class, with which of its
  // nodes to use still to be decided. So the class the root sits in is the target,
  // which is the bottom row until the last rule fires and the blob after it.
  //
  // The bottom row is that class in both states: once the rule fires the blob's
  // lower lobe covers the same ground, so the spike lands on the grey either way
  // and the bubble does not have to jump when the classes merge. The blob's own
  // bounding box is no use for aiming -- it is a thin snake in a tall box, and a
  // spike stopping at that box lands in empty space beside another class.
  //
  // It is built once, as a layer of its own, and the same layer is handed to every
  // press that shows it -- a bubble rebuilt per press is a new pict each time and
  // would blink. What it points at is a laundered ghost of the region, placed where
  // the region goes: the callout needs something to aim at, and a second copy of
  // the region itself would be a second thing to find.
  def task_over:
    // two short lines: what is left of the slide right of the bottom row's class is
    // 400 wide, and the sentence on one line runs off it
    def content:
      prose_stack([[["extract", #'bold], [" a", #'plain]],
                   [["resulting term", #'plain]]])
    { #'task: [bubble_at(r_out[0], ~spot: [r_out[1], r_out[2]],
                         // right of the bottom row's class, level with it
                         ~body: [1400.0, 860.0], ~color: talk_blue,
                         ~content: content),
               0.0, 0.0, band_above] }

  // The pointer walks a row of classes per press, down its own lane. It is one
  // pict under one key, so it travels down the rows rather than jumping.
  // Its tip stops 10 short of the left column's boxes, which start at 780; at 706
  // the 80-wide arrow ran into the `1`.
  def pointer = as_pict(walk_arrow())
  fun point_at(row_y :: Real) :: List: [690.0, row_y + nd / 2 - 17.0]

  // The graph being built: the rules, the term, the rewrite of it, and the 0 the
  // second rule makes. Each press brings its nodes and their edges and leaves
  // everything already on the slide exactly as it was.
  // ---------------------------------------------------------------- the input term
  //
  // The term goes into the graph the way a rule's right-hand side does: a copy of it
  // comes over to the place above the graph where the rules will stand to fire, and
  // then, two beats apiece, its operators become nodes where they are written and go
  // in -- `+` with the two it is built from and the arrows between them, and then
  // `−`, born with its two arrows down into the graph. The boxes are wider than the
  // words, so the words spread as they become boxes and the rest of the line steps
  // right to make room. What is left of the copy -- brackets, and a `1` that is a
  // node already -- fades where it stands. Nothing is matched, so nothing lights up.
  //
  // The copy is one pict per glyph, keyed by the node each becomes; the brackets
  // are keyed to themselves so they can fade, and the second `1` by a name of its
  // own, since a key is drawn once and the first `1` is the node.
  def term_stage = rule_stage
  def term_pieces:
    [[#'open, 0], [#'a, 1], [#'plus, 3], [#'one, 5], [#'close, 6], [#'minus, 8], [#'one2, 10]]
  // `~shift` moves named glyphs along the line, for the ones that step aside
  fun term_copy(x :: Real, y :: Real, ~only: only :: maybe(List) = #false,
                ~shift: shift :~ Map = {}) :: Map:
    for values(m :~ Map = {}) ([key, i] in term_pieces):
      skip_when only && !(only :~ List).contains(key)
      def dx = if shift.has_key(key) | shift[key] | 0.0
      m ++ { key: [term_glyphs[i], x + term_offs[i] + dx, y, band_flight] }
  fun piece_index(key) :: Int:
    for values(found = 0) ([k, j] in term_pieces): if k == key | j | found
  fun glyph_centre(i :: Int) :: Real:
    term_offs[i] + (term_glyphs[i] :~ pc.Pict).width / 2
  // A glyph of the copy become the node it names, where it is written: the box
  // grows around the glyph, at the glyph's own height, the way `rule_term` grows a
  // rule's operators into nodes under the rule -- so the node is born where the
  // word was, with its arrows already there, and the press after sends it home with
  // the arrows following. `~dx` moves it along the line.
  fun term_node_in_place(key, ~dx: dx :: Real = 0.0) :: Map:
    def i = piece_index(key)
    def glyph :~ pc.Pict = term_glyphs[i]
    def whole :~ pc.Pict = as_pict(plain[key])
    def shrunk = whole.scale(glyph.height / whole.height)
    { key: [shrunk,
            term_stage[0] + term_offs[i] + dx - (shrunk.width - glyph.width) / 2,
            term_stage[1] - (shrunk.height - glyph.height) / 2,
            band_flight] }
  // How the line spreads when `a`, `+` and `1` become boxes: the boxes stand
  // `node_pitch` apart, centred on the `+`, far enough for the sum's two arrows to
  // be seen between them, and the `−` and its `1` step right to clear the last box.
  def node_pitch = 90.0
  def box_w = (term_glyphs[3] :~ pc.Pict).height       // a box is as wide as it is tall
  def sum_centre = glyph_centre(3)
  def spread:
    def right_edge = sum_centre + node_pitch + box_w / 2 + 24.0
    { #'a: sum_centre - node_pitch - glyph_centre(1),
      #'plus: 0.0,
      #'one: sum_centre + node_pitch - glyph_centre(5),
      #'minus: right_edge - term_offs[8],
      #'one2: right_edge - term_offs[8] }

  def build:
    // The rules are on the slide from the start, because the press that leaves the
    // workflow picture before this one has just put them there: opening without
    // them would take them away and give them back.
    [// The picture this slide opens on is the one the slide before it ends on -- the
     // term and the rules, where this slide draws them -- and the show cuts to it.
     // The term is the copy's own glyphs here, drawn once; the term at home takes
     // over from them the moment the copy sets off.
     Frame(~picts: rule_over(#'rule1) ++ rule_over(#'rule2) ++ term_copy(term_x, term_y)),
     // a copy of the term comes over to where the rules will stand
     Frame(~picts: rules_over ++ term_copy(term_stage[0], term_stage[1])),
     // `a`, `+` and `1` become nodes where they are written, with the sum's two
     // arrows between them; the boxes spread to make room for the arrows, the rest
     // of the line steps right, and the brackets go
     Frame(~picts: rules_over
                     ++ term_copy(term_stage[0], term_stage[1],
                                  ~only: [#'minus, #'one2], ~shift: spread)
                     ++ term_node_in_place(#'a, ~dx: spread[#'a])
                     ++ term_node_in_place(#'plus)
                     ++ term_node_in_place(#'one, ~dx: spread[#'one]),
           ~edges: es_plus),
     // and go in, the arrows following, as the data-flow arrow draws down beside
     // the graph
     Frame(~picts: rules_over ++ flow_over
                     ++ term_copy(term_stage[0], term_stage[1],
                                  ~only: [#'minus, #'one2], ~shift: spread)
                     ++ spots_of([#'a, #'one, #'plus], []),
           ~edges: es_plus),
     // then `−` the same way: a node where it is written, born with its two arrows
     // down into the graph -- to the `+` and the `1` that are nodes already, which
     // is why its own `1` fades here: the arrow says what the glyph said
     Frame(~picts: rules_over ++ flow_over
                     ++ term_node_in_place(#'minus, ~dx: spread[#'minus])
                     ++ spots_of([#'a, #'one, #'plus], []),
           ~edges: es_term),
     // The `→` of the first rule is already on the slide, where the rule stands in
     // the list: it is a pict of its own because it becomes the dashed line later,
     // and put on the press that brings the rule over it would fade in while the
     // rule moved.
     Frame(~picts: rules_over ++ flow_over ++ spots_of(keys_term, [])
                     ++ rule_arrow(#'rule1, ~staged: #false),
           ~edges: es_term),
     // ------------------------------------------------------ and then the rewrites
     // Applying a rule is four movements, and each gets a press:
     //
     //   it comes over to what it matched;
     //   its variables light up and point at the nodes they stand for;
     //   its right-hand side turns into the term it stands for, as nodes with the
     //     arrows between them, under the rule that spells it;
     //   and that term moves into the graph -- the nodes it adds to their own
     //     places, each gold variable onto the node it matched, the arrows following
     //     their ends the whole way -- while the `→` becomes the dashed line that
     //     says the two sides are one value.
     //
     // The gold does not go out when the nodes come in: a variable of the rule and
     // the node it matched are the same thing by the end, so the box that stands for
     // it lands on that node and is still gold when it gets there.
     //
     // `β` and `γ` both pointing at the `1` is worth the second of those presses on
     // its own: one node, matched twice.
     Frame(~picts: spots_of(keys_term, []) ++ rules_with(#'rule1) ++ flow_over
                     ++ rule_arrow(#'rule1),
           ~edges: es_term),
     Frame(~picts: spots_of(keys_term, [], ~gold: rule_matched(#'rule1))
                     ++ rules_with(#'rule1) ++ flow_over ++ rule_chips(#'rule1)
                     ++ rule_arrow(#'rule1),
           ~edges: es_term ++ rule_points(#'rule1)),
     // the pointers slide across to the other side of the arrow, where the same
     // variables stand: the same bindings, now saying what the rule builds. This is
     // the movement the rule on the dead-store slide makes down to the line it
     // concludes.
     Frame(~picts: spots_of(keys_term, [], ~gold: rule_matched(#'rule1))
                     ++ rules_with(#'rule1) ++ flow_over
                     ++ rule_chips(#'rule1, ~side: #'rhs) ++ rule_arrow(#'rule1),
           ~edges: es_term ++ rule_points(#'rule1, ~side: #'rhs)),
     // and the operators that side adds become nodes where they are written
     Frame(~picts: spots_of(keys_term, [], ~gold: rule_matched(#'rule1))
                     ++ rules_with(#'rule1) ++ flow_over
                     ++ rule_chips(#'rule1, ~side: #'rhs)
                     ++ rule_term(#'rule1) ++ rule_arrow(#'rule1),
           ~edges: es_term ++ rule_points(#'rule1, ~side: #'rhs)),
     // and the term moves into the graph, with the rule staying where it is. The
     // gold pointers go out on this press and the blue arrows come in on it: one
     // press, one set of arrows.
     Frame(~picts: spots_of(keys_rewrite, [], ~gold: rule_matched(#'rule1))
                     ++ rules_with(#'rule1) ++ flow_over
                     ++ rule_chips(#'rule1, ~side: #'rhs)
                     ++ rule_term(#'rule1, ~home: #true) ++ rule_arrow(#'rule1),
           ~edges: es_term ++ rule_term_edges(#'rule1)),
     // and then what the rule concluded: it goes back to the list and its `→` travels
     // into the graph as the dashed line. A press of its own, because adding a term
     // and saying two things are one value are two things.
     //
     // The chips go home with the rule rather than fading where they stood -- unlit,
     // at the places in the line they were cut from, which is where the rule's own
     // words are, so what is left of them is the rule.
     Frame(~picts: spots_of(keys_rewrite, [], ~gold: rule_matched(#'rule1))
                     ++ rules_over ++ flow_over
                     ++ rule_chips(#'rule1, ~side: #'rhs, ~staged: #false,
                                   ~lit: #false)
                     ++ rule_term(#'rule1, ~home: #true) ++ eq_of(#'rule1)
                     ++ rule_arrow(#'rule2, ~staged: #false),
           ~edges: es_term ++ rule_term_edges(#'rule1)),
     // The second rule the same way. Its right-hand side is a constant, so the term
     // it turns into is one node and there is no variable in it to send home.
     Frame(~picts: spots_of(keys_rewrite, []) ++ rules_with(#'rule2) ++ flow_over
                     ++ eq_of(#'rule1) ++ rule_arrow(#'rule2),
           ~edges: es_term ++ es_rewrite),
     Frame(~picts: spots_of(keys_rewrite, [], ~gold: rule_matched(#'rule2))
                     ++ rules_with(#'rule2) ++ flow_over ++ rule_chips(#'rule2)
                     ++ eq_of(#'rule1) ++ rule_arrow(#'rule2),
           ~edges: es_term ++ es_rewrite ++ rule_points(#'rule2)),
     Frame(~picts: spots_of(keys_rewrite, [], ~gold: rule_matched(#'rule2))
                     ++ rules_with(#'rule2) ++ flow_over ++ rule_chips(#'rule2)
                     ++ rule_term(#'rule2) ++ eq_of(#'rule1) ++ rule_arrow(#'rule2),
           ~edges: es_term ++ es_rewrite ++ rule_points(#'rule2)),
     // the same two: the node goes in, and then the rule concludes
     Frame(~picts: spots_of(keys_all, [], ~gold: rule_matched(#'rule2))
                     ++ rules_with(#'rule2) ++ flow_over ++ rule_chips(#'rule2)
                     ++ rule_term(#'rule2, ~home: #true)
                     ++ eq_of(#'rule1) ++ rule_arrow(#'rule2),
           ~edges: es_graph),
     Frame(~picts: spots_of(keys_all, [], ~gold: rule_matched(#'rule2))
                     ++ rules_over ++ flow_over
                     ++ rule_chips(#'rule2, ~staged: #false, ~lit: #false)
                     ++ rule_term(#'rule2, ~home: #true)
                     ++ eq_of(#'rule1) ++ eq_of(#'rule2),
           ~edges: es_graph)]

  // The third rule concludes nothing new: its right-hand side is one variable, so
  // the press that moves to it has nothing to move and a rule that adds no node has
  // nothing to fly out. What it does is make two nodes equal, and the press that
  // matches it says that already: its variables point at the sum and at the `a`, and
  // the `→` between them is the thing that becomes the line joining the two.

  // Then what extraction does with it: the classes drawn, the job named, and the
  // walk down the rows.
  fun frame(~picks: picks :: List = [], ~point: point = #false,
            ~task: task = #false, ~third: third = #false,
            ~merged: merged = #false,
            // the third rule over by the graph, matching, with its pointers out
            ~matching: matching = #false,
            // and its right-hand side as the term it stands for: `#'inline` under
            // the rule, `#'home` on the node it matched
            ~term: term = #false) :: Frame:
    // The third rule stands over by the graph while it matches and while its
    // right-hand side is a term under it, and goes back to the list once that term
    // has gone home.
    fun third_picts() :: Map:
      cond
      | !third: {}
      | term == #'home: third_over ++ rule_term(#'rule3, ~home: #true)
      // Before the rule fires, an invisible copy of its `→` waits at its home so the
      // key exists on both sides of the press that brings the rule over. Once it
      // has fired, that `→` *is* the dashed line in the graph -- the same key -- and
      // putting the ghost back here would send the line home with it and lose it.
      | matching == #false && term == #false:
          third_over ++ (if merged | {} | rule_arrow(#'rule3, ~staged: #false, ~ghost: #true))
      | ~else:
          rule_over(#'rule3, ~staged: #true)
            ++ (if matching == #false
                | {}
                | rule_chips(#'rule3, ~side: matching))
            // The `→` stays up alongside the term, the way it does for the other
            // two rules. It is keyed by the equality it becomes, so a press that
            // takes it away is a press the equality has to fade in on instead of
            // being moved into place -- which is what went wrong here.
            ++ rule_arrow(#'rule3)
            ++ (if term == #'inline | rule_term(#'rule3) | {})
    // The nodes the rule matched light up on the press that matches them -- the
    // one that puts its variables' pointers out -- and stay lit while its term is
    // under it and goes home. Not on the press that only brings the rule over: it
    // has matched nothing yet.
    def lit = matching != #false || term == #'inline || term == #'home
    Frame(~picts: spots_of(keys_all, picks,
                           ~gold: (if lit | rule_matched(#'rule3) | []))
                    ++ (if point == #false
                        | {}
                        | { #'point: [pointer, & point_at(point)] })
                    ++ (if merged | merged_under | classes_under)
                    // Every equality on the slide is the dashed line one rule's `→`
                    // turned into, and none of them stops being true. The third rule
                    // adds one to the class; it does not replace the one the first
                    // rule put there, which is still what says `−` and the sum are
                    // the same value.
                    ++ eq_of(#'rule1) ++ eq_of(#'rule2)
                    ++ (if merged | eq_of(#'rule3) | {})
                    ++ rules_over ++ flow_over
                    ++ third_picts()
                    ++ (if task | task_over | {}),
          ~edges: es_graph_when(merged)
                    ++ (if merged | merged_marks(1.0) | [])
                    ++ (if matching == #false
                        | []
                        | rule_points(#'rule3, ~side: matching))
                    ++ (if term == #'inline || term == #'home
                        | rule_term_edges(#'rule3)
                        | []))
  fun walking(~picks: picks :: List = [], ~point: point = #false,
              ~third: third = #false, ~merged: merged = #false) :: Frame:
    frame(~task: #true, ~picks: picks, ~point: point, ~third: third, ~merged: merged)

  // The walk picks a node out of *every* class, not only the classes the answer
  // turns out to need -- that is what extraction does, since which classes the
  // answer needs is not known until the root is reached. Then the choices that
  // nothing reaches fade, and what is left is one term.
  def all_picks = [#'a, #'one, #'plus, #'zero, #'plus_r]
  def reached = [#'a, #'zero, #'plus_r]

  // The term the walk found, with the e-graph gone: the same green nodes, in the
  // shape of the term they spell out, with the graph and the regions and the rest
  // of the nodes faded off around them. What is left standing is everything that
  // was never part of the e-graph -- the title, the input term and the rules.
  //
  // `a + 0`, as a term: the `+` under the two it is built from, which is the way
  // round this slide draws everything else. Its edge to `a` is written the way the
  // graph writes it at this point -- before the third rule, so not yet aside -- so
  // that it is the same edge in both and travels with its ends instead of being
  // swapped for another; its edge to `0` is new, since in the graph that operand is
  // the class `0` is the cheapest node of.
  def term_1:
    Frame(~picts: { #'a: [green[#'a], 1020.0, 520.0],
                    #'zero: [green[#'zero], 1260.0, 520.0],
                    #'plus_r: [green[#'plus_r], 1140.0, 730.0] } ++ rules_over,
          ~edges: [[#'op_blue, #'plus_r, #'a], [#'op_blue, #'plus_r, #'zero]])
  // and then just `a`
  def term_2:
    Frame(~picts: { #'a: [green[#'a], 1140.0, 620.0] } ++ rules_over ++ third_over)

  // the page every press draws over: the canvas and the title. The term is a key
  // (`term_home`), since on the opening picture it is the copy about to leave.
  def page: as_pict(base_canvas)

  // The rewrites -- a rule coming over, matching, its right-hand side becoming
  // nodes and going in, and going back -- move at half again the pace of the rest:
  // they are bookkeeping the room has seen before. The term's own descent into the
  // graph, and the extraction after, keep the pace.
  fun pace(i :: Int) :: Real: if i >= 6 && i <= 16 | 0.67 | 1.0
  // A rule pointing at what one of its variables matched: thin, gold and dashed,
  // so it reads as something laid over the picture for a moment rather than as
  // something the e-graph contains. Under the rule box, so it leaves the box at
  // its edge rather than crossing what is written in it.
  //
  // It leaves the bottom of the chip rather than whichever side the node it names
  // happens to lie on. A chip is one glyph wide and its neighbours are up against
  // it, so a line leaving its left edge starts against the glyph next door and
  // reads as coming out of that one -- which is what `γ`'s pointer looked like it
  // was doing, leaving the `−` beside it.
  fun under_wire(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
    for values(q :~ pc.Pict = layer) (e :~ List in es):
      skip_when e[0] != #'point
      arrow(~on: q, at[e[1]], at[e[2]], ~line_width: 3,
            ~color: chip_line_color, ~gap: 4, ~line_style: #'short_dash,
            ~from_at: pc.Find.bottom(as_pict(at[e[1]]), ~dy: 4))
  // one press between two frames, with everything a press on this slide needs
  fun press(a :: Frame, b :: Frame, ~extent: extent :: Real) :: pc.Pict:
    magic_press(page, a, b, ~extent: extent,
                ~wire: wire, ~edge_band: band_wires,
                ~under_wire: under_wire, ~under_band: band_point,
                // the class the third rule makes, drawn as far grown as the press has got
                ~stage: merged_stage, ~stage_band: band_below)
  // a press to each frame in turn, from the frame before the first
  fun presses(frames :~ List, ~from: from :: Frame, ~extent_of: extent_of) :: List:
    for List (i in 0..frames.length()):
      press(if i == 0 | from | frames[i - 1], frames[i], ~extent: extent_of(i))

  def story:
    build
      ++ [// the classes, and then the job, each on its own press
          frame(),
          walking(),
          // down the graph, a row of classes at a time. Two presses per row: the
          // pointer arrives, and then the nodes are picked out of the classes in
          // that row. Both halves are worth a beat -- which classes we are looking
          // at is a step of the algorithm, and which node wins is the decision.
          walking(~point: row_in),
          walking(~point: row_in, ~picks: [#'a, #'one]),
          walking(~point: row_mid, ~picks: [#'a, #'one]),
          walking(~point: row_mid, ~picks: [#'a, #'one, #'plus, #'zero]),
          walking(~point: row_out, ~picks: [#'a, #'one, #'plus, #'zero]),
          walking(~point: row_out, ~picks: all_picks),
          // the choices nothing reaches fade, and what is left moves out into the term
          walking(~picks: reached),
          term_1,
          // then back into the graph, as it was
          walking(~picks: reached),
          // the rule that changes the answer goes up, on a press of its own: it is
          // the reason the answer changes, so it is worth a beat before it fires
          walking(~picks: reached, ~third: #true),
          // it comes over, and then matches, the same as the other two
          frame(~picks: reached, ~third: #true, ~term: #'over),
          // Its variables point at what they matched, which for this rule is the
          // whole of the story: the sum and the `a` are both pointed at, and what it
          // concludes is that those two are one class.
          frame(~picks: reached, ~third: #true, ~matching: #'lhs),
          // the pointers slide across to what it concludes, which for this rule is
          // the one variable -- so the `a` and the sum are pointed at from the two
          // sides of the arrow, which is the union it is about to make
          frame(~picks: reached, ~third: #true, ~matching: #'rhs),
          // and it fires. This rule adds no operator, so there is no term to send
          // home -- all that happens is that the `→` becomes the dashed line down
          // the middle of the class, and the two regions are one.
          frame(~third: #true, ~merged: #true, ~term: #'home)]
  // The same walk again, down the same rows -- but the room has seen this walk, so
  // it is one press: the same frames, each at half the pace, spliced into one go.
  // The root class holds `a` itself now, so its own cheapest node is one we already
  // have and the last row adds no pick, only the pointer.
  def second_walk:
    [walking(~third: #true, ~merged: #true, ~point: row_in),
     walking(~third: #true, ~merged: #true, ~point: row_in, ~picks: [#'a, #'one]),
     walking(~third: #true, ~merged: #true, ~point: row_mid, ~picks: [#'a, #'one]),
     walking(~third: #true, ~merged: #true, ~point: row_mid,
             ~picks: [#'a, #'one, #'plus, #'zero]),
     walking(~third: #true, ~merged: #true, ~point: row_out,
             ~picks: [#'a, #'one, #'plus, #'zero])]
  // and this time nothing else is reached at all, and the term is one node
  def ending = [frame(~third: #true, ~merged: #true, ~picks: [#'a]), term_2]

  pc.switch(magic_still(page, story[0], ~wire: wire, ~edge_band: band_wires,
                        ~under_wire: under_wire, ~under_band: band_point,
                        ~stage: merged_stage, ~stage_band: band_below),
            & presses(story.rest, ~from: story[0], ~extent_of: fun (i): pace(i + 1)),
            pc.switch(& presses(second_walk, ~from: story.last, ~extent_of: fun (i): 0.5),
                      ~join: #'splice),
            & presses(ending, ~from: second_walk.last, ~extent_of: fun (i): 1.0))
