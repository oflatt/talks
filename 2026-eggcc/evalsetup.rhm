#lang rhombus/and_meta
// What the evaluation actually runs on, walked through on one program.
//
// The program is the paper's Fenwick example (Section 8.3): the naive way to find
// the lowest set bit of `a`, which is a loop that halves `a` while it stays even.
// eggcc is given the Bril on the left, builds the e-graph in the middle, and the
// rules put the loop's result in the same e-class as `a & -a` -- Hacker's Delight's
// one-liner -- so extraction can take the closed form and the loop goes away.
//
// The Bril is `eggcc/tests/passing/small/lowbit_naive_br.bril` verbatim. The term in
// the middle is the one eggcc's front end builds for it (`--run-mode pretty-print`):
//
//   Print( loop[1], loop[0] )
//   loop = DoWhile( (σ, 1, 2, a), body )
//
// -- one loop, no `If` round it. eggcc later rotates the loop into an `If` wrapping
// a `DoWhile`, which is the shape its Hacker's Delight rules are written against;
// the slide draws the loop the way the source reads and lets the rule speak of it.
// Two simplifications, both said here so they are not mistaken for eggcc: the body
// really decides `a/2` and `lb·2` under an `If` inside itself, drawn here as the
// five values it hands to the next iteration with the test first; and eggcc's
// output guards the state on `a = 0`, where the loop would not terminate, which
// the slide leaves out -- so the program on the right is the three lines
// `neg`, `bitand`, `print`, which is what eggcc emits for `lowbit_br.bril` and what
// this one emits up to that guard.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "egraph.rhm" open
  "write.rhm".written_stroke
  "write.rhm".written_shape
  pict as pc
  draw

export:
  slide_eval_setup
  eval_title

// the title, named once: the divider before this slide writes it as its outline goes up
def eval_title = "Case Study: eggcc"

// ------------------------------------------------------------------ the panels
// the captions over the three panels: labels, so they pop rather than write
fun panel_title(s :: String) :: pc.Pict:
  prose_text(s, ~size: 38.0, ~bold: #true, ~arrive: #'pop)
// code pops in, a line at a time; the labels on the CFG's edges are labels too
fun ev_code(s :: String) :: pc.Pict: code_text(s, ~size: 22.0, ~arrive: #'pop)
fun ev_label(s :: String) :: pc.Pict: code_text(s, ~size: 22.0, ~italic: #true, ~arrive: #'pop)

// A basic block: its label, then its instructions, in a box.
def block_pad = 16.0
fun bril_block(label :: String, lines :: List) :: pc.Pict:
  def body:
    pc.stack(~sep: 4.0, ~horiz: #'left,
             ev_label(label), & for List (s in lines): ev_code("  " +& s))
  put(frame_box(body.width + 2 * block_pad, body.height + 2 * block_pad, ~rounded: 6000,
                ~arrive: #'fade),
      body, block_pad, block_pad)

// The control-flow graph of the program as Bril has it: the loop test, the body
// that halves `a` and doubles `lb`, and the exit. The blocks are stacked in the
// order they are written and the two edges that are not a fall-through are routed
// round the outside -- the back edge down the left, the exit down the right -- so
// neither of them crosses a block.
def cfg_top = 306.0
def cfg_left = 150.0
def cfg_gap = 44.0
def cfg_lane = 40.0
def cfg_ink = draw.Color(40, 40, 40)
def cfg_blocks:
  [["@main(a)", ["lb: int = const 1;", "two: int = const 2;"]],
   [".loop", ["t0: int = div a two;", "t1: int = mul t0 two;",
              "cond: bool = eq t1 a;", "br cond .cont .end;"]],
   [".cont", ["a: int = div a two;", "lb: int = mul lb two;", "jmp .loop;"]],
   [".end", ["print lb;"]]]

def cfg_block_picts:
  for List ([label, lines] in cfg_blocks): bril_block(label, lines)
// each block under the one before it, by its own height: [x, y, w, h]
def cfg_boxes:
  def values(out, _):
    for values(acc :~ List = [], y :~ Real = cfg_top) (p :~ pc.Pict in cfg_block_picts):
      values(acc ++ [[cfg_left, y, p.width, p.height]], y + p.height + cfg_gap)
  out
def cfg_widest:
  for values(m :~ Real = 0.0) (b :~ List in cfg_boxes): math.max(m, b[2] :~ Real)
def cfg_right_lane = cfg_left + cfg_widest + cfg_lane
def cfg_left_lane = cfg_left - cfg_lane

// An edge of the graph, as a pen stroke along its corners that a press can write:
// the pict is just big enough for the line, and goes at `[x, y]`.
fun cfg_stroke(pts :: List) :: List:
  def pad = 4.0
  def x0 = (for values(m :~ Real = (pts[0] :~ List)[0]) ([x, y] in pts): math.min(m, x)) - pad
  def y0 = (for values(m :~ Real = (pts[0] :~ List)[1]) ([x, y] in pts): math.min(m, y)) - pad
  def x1 = (for values(m :~ Real = (pts[0] :~ List)[0]) ([x, y] in pts): math.max(m, x)) + pad
  def y1 = (for values(m :~ Real = (pts[0] :~ List)[1]) ([x, y] in pts): math.max(m, y)) + pad
  def path = draw.Path()
  path.move_to([(pts[0] :~ List)[0] - x0, (pts[0] :~ List)[1] - y0])
  for ([x, y] in pts.rest):
    path.line_to([x - x0, y - y0])
  [written_stroke(path, ~width: x1 - x0, ~height: y1 - y0,
                  ~pen: draw.Pen(~color: cfg_ink, ~width: 3.0, ~cap: #'round, ~join: #'round),
                  ~weight: 0.5),
   x0, y0]
// a filled triangle at the end of an edge, pointing where it goes
fun cfg_head(x :: Real, y :: Real, ~facing: facing) :: List:
  def [ax, ay, bx, by]:
    match facing
    | #'down: [-9.0, -16.0, 9.0, -16.0]
    | #'right: [-16.0, -9.0, -16.0, 9.0]
    | ~else: [16.0, -9.0, 16.0, 9.0]
  def x0 = math.min(x, math.min(x + ax, x + bx))
  def y0 = math.min(y, math.min(y + ay, y + by))
  def x1 = math.max(x, math.max(x + ax, x + bx))
  def y1 = math.max(y, math.max(y + ay, y + by))
  def path = draw.Path()
  path.polygon([[x - x0, y - y0], [x + ax - x0, y + ay - y0], [x + bx - x0, y + by - y0]])
  [written_shape(path, ~width: x1 - x0, ~height: y1 - y0, ~fill: cfg_ink), x0, y0]

// The edges: the two fall-throughs, the branch out of the loop down the right
// lane, and the back edge down the left lane and up again -- so neither of the
// two that are not fall-throughs crosses a block.
def cfg_wires:
  def main :~ List = cfg_boxes[0]
  def lp :~ List = cfg_boxes[1]
  def ct :~ List = cfg_boxes[2]
  def en :~ List = cfg_boxes[3]
  fun bottom(b :~ List) :: Real: (b[1] :~ Real) + (b[3] :~ Real)
  fun right(b :~ List) :: Real: (b[0] :~ Real) + (b[2] :~ Real)
  fun mid_x(b :~ List) :: Real: (b[0] :~ Real) + (b[2] :~ Real) / 2
  def ly = bottom(lp) - 26.0
  def ey = (en[1] :~ Real) + (en[3] :~ Real) / 2
  def cy = bottom(ct) - 26.0
  def ty = (lp[1] :~ Real) + 30.0
  [cfg_stroke([[mid_x(main), bottom(main)], [mid_x(main), lp[1]]]),
   cfg_head(mid_x(main), lp[1], ~facing: #'down),
   cfg_stroke([[mid_x(lp), bottom(lp)], [mid_x(lp), ct[1]]]),
   cfg_head(mid_x(lp), ct[1], ~facing: #'down),
   cfg_stroke([[right(lp), ly], [cfg_right_lane, ly], [cfg_right_lane, ey], [right(en), ey]]),
   cfg_head(right(en), ey, ~facing: #'left),
   cfg_stroke([[ct[0], cy], [cfg_left_lane, cy], [cfg_left_lane, ty], [lp[0], ty]]),
   cfg_head(lp[0], ty, ~facing: #'right)]

// Which way is which, each beside the run of edge it names: `true` beside the
// fall-through into the loop body, `false` beside the lane out of the loop.
def cfg_marks:
  def lp :~ List = cfg_boxes[1]
  def ct :~ List = cfg_boxes[2]
  def en :~ List = cfg_boxes[3]
  def yes = ev_label("true")
  def no = ev_label("false")
  def lp_bottom = (lp[1] :~ Real) + (lp[3] :~ Real)
  def ly = lp_bottom - 26.0
  def ey = (en[1] :~ Real) + (en[3] :~ Real) / 2
  [[yes, (lp[0] :~ Real) + (lp[2] :~ Real) / 2 + 12.0,
    (lp_bottom + (ct[1] :~ Real)) / 2 - yes.height / 2],
   [no, cfg_right_lane + 8.0, (ly + ey) / 2 - no.height / 2]]

fun cfg_pict() :: pc.Pict:
  def placed:
    for values(q :~ pc.Pict = blank_slide) (p :~ pc.Pict in cfg_block_picts, b :~ List in cfg_boxes):
      put(q, p, b[0], b[1])
  for values(q :~ pc.Pict = placed) ([p, x, y] in cfg_wires ++ cfg_marks):
    put(q, p, x, y)

// What eggcc emits for it, which is the closed form and no loop at all.
def opt_pict:
  def body:
    pc.stack(~sep: 4.0, ~horiz: #'left,
             ev_label("@main(a)"),
             ev_code("  t: int = neg a;"),
             ev_code("  lb: int = bitand a t;"),
             ev_code("  print lb;"))
  put(frame_box(body.width + 2 * block_pad, body.height + 2 * block_pad, ~rounded: 6000,
                ~arrive: #'fade),
      body, block_pad, block_pad)

// ------------------------------------------------------------------ the e-graph
// The term eggcc builds, in the paper's own syntax (Figure 4a: operators `f(e, ...)`,
// tuples `(e, ...)`, projections `e[n]`, the region argument `Γ`, and effectful
// operators drawn with a bold border):
//
//   Print( loop[1], loop[0] )
//   loop = DoWhile( (σ, 1, 2, a), ( IsEven(Γ[3]), Γ[0], Γ[1]·Γ[2], Γ[2], Γ[3]/Γ[2] ) )
//
// `[1]` is the accumulator `lb` coming out of the loop, `[0]` the state it threaded
// through. Tuples are nodes of their own with a port per element, each port
// pointing at the element, so the loop points at one tuple of inputs and at one
// tuple that is its body; the body is a region of its own -- a term with a
// statewalk of its own, from `Γ` through `Γ[0]` to the tuple -- drawn like the rest
// of the term, above the loop that takes it, and boxed to say it is a region. Its
// operators point at projections of `Γ`, the region's argument, which is the loop's
// inputs one iteration on. `IsEven` is the parity test the paper's first rule names
// (`Eq(Mul(Div(a, 2), 2), a)`), drawn as one node.
//
// The rule then says `loop[1] ≊ Bitand(a, Neg(a))`, and the state that comes out of
// the loop is the state that went in.
//
//   [key, what is written in it, its colour, its width, centre x, top y, its kind]
//   -- a node, a tuple (a wide box with parentheses), or a port (a dot in a tuple)
def ev_h = 64.0
def ev_tuple_h = 56.0
def ev_port = 14.0
fun ev_height(kind) :: Real:
  match kind
  | #'tuple: ev_tuple_h
  | #'port: ev_port
  | ~else: ev_h
def ev_nodes:
  [// the loop's inputs, across the top on the right, and the tuple they make
   [[#'s], "σ", stateful_hex, 64.0, 1140.0, 300.0, #'node],
   [[#'one], "1", "000000", 64.0, 1230.0, 300.0, #'node],
   [[#'two], "2", "000000", 64.0, 1310.0, 300.0, #'node],
   [[#'a], "a", "000000", 64.0, 1390.0, 300.0, #'node],
   [[#'inputs], "", "000000", 200.0, 1290.0, 440.0, #'tuple],
   [[#'it0], "", stateful_hex, ev_port, 1215.0, 461.0, #'port],
   [[#'it1], "", "000000", ev_port, 1265.0, 461.0, #'port],
   [[#'it2], "", "000000", ev_port, 1315.0, 461.0, #'port],
   [[#'it3], "", "000000", ev_port, 1365.0, 461.0, #'port],
   // the body, across the top on the left: the region's argument, its projections,
   // what the iteration computes from them, and the tuple it hands back
   [[#'arg], "Arg", stateful_hex, 96.0, 860.0, 336.0, #'node],
   [[#'p0], "[0]", stateful_hex, 64.0, 725.0, 426.0, #'node],
   [[#'p1], "[1]", "000000", 64.0, 805.0, 426.0, #'node],
   [[#'p2], "[2]", "000000", 64.0, 885.0, 426.0, #'node],
   [[#'p3], "[3]", "000000", 64.0, 965.0, 426.0, #'node],
   [[#'b_mul], "×", "000000", 64.0, 815.0, 516.0, #'node],
   [[#'b_div], "/", "000000", 56.0, 905.0, 516.0, #'node],
   [[#'pred], "IsEven", "000000", 120.0, 1000.0, 516.0, #'node],
   [[#'body_tuple], "", "000000", 300.0, 800.0, 612.0, #'tuple],
   [[#'bt0], "", "000000", ev_port, 675.0, 633.0, #'port],
   [[#'bt1], "", stateful_hex, ev_port, 737.0, 633.0, #'port],
   [[#'bt2], "", "000000", ev_port, 800.0, 633.0, #'port],
   [[#'bt3], "", "000000", ev_port, 862.0, 633.0, #'port],
   [[#'bt4], "", "000000", ev_port, 925.0, 633.0, #'port],
   // the loop, under both, and what comes out of it
   [[#'loop], "DoWhile", stateful_hex, 160.0, 1290.0, 700.0, #'node],
   [[#'neg], "Neg", "000000", 90.0, 1490.0, 540.0, #'node],
   [[#'g0], "[0]", stateful_hex, 64.0, 1130.0, 820.0, #'node],
   [[#'g1], "[1]", "000000", 64.0, 1240.0, 820.0, #'node],
   [[#'and], "Bitand", "000000", 140.0, 1460.0, 820.0, #'node],
   [[#'print], "Print", stateful_hex, 130.0, 1220.0, 930.0, #'node]]

// the loop's body, a region of its own: the box it lives in, and what is in it
def ev_region_box = [580.0, 296.0, 500.0, 390.0]
def ev_body_keys:
  [[#'arg], [#'p0], [#'p1], [#'p2], [#'p3], [#'b_mul], [#'b_div], [#'pred],
   [#'body_tuple], [#'bt0], [#'bt1], [#'bt2], [#'bt3], [#'bt4]]
def ev_input_keys = [[#'inputs], [#'it0], [#'it1], [#'it2], [#'it3]]
// Its own colour, and not the grey the e-classes are washed in: a region is a
// different kind of thing from a class, and the two are on the slide together.
def region_line = draw.Color(60, 150, 140)
def region_fill = draw.Color(230, 246, 243)

// what each node is built from: `#'v` a value, `#'s` a state, blue and thick
def ev_edges:
  [// the loop takes a tuple of inputs, whose ports point at them, and its body
   [#'s, [#'loop], [#'inputs]], [#'v, [#'loop], [#'body_tuple]],
   [#'s, [#'it0], [#'s]], [#'v, [#'it1], [#'one]], [#'v, [#'it2], [#'two]],
   [#'v, [#'it3], [#'a]],
   // inside the body: projections of the argument, operators over them, and the
   // tuple's ports pointing at what each element is
   [#'s, [#'p0], [#'arg]], [#'v, [#'p1], [#'arg]], [#'v, [#'p2], [#'arg]],
   [#'v, [#'p3], [#'arg]],
   [#'v, [#'b_mul], [#'p1]], [#'v, [#'b_mul], [#'p2]],
   [#'v, [#'b_div], [#'p2]], [#'v, [#'b_div], [#'p3]],
   [#'v, [#'pred], [#'p3]],
   [#'v, [#'bt0], [#'pred]], [#'s, [#'bt1], [#'p0]], [#'v, [#'bt2], [#'b_mul]],
   [#'v, [#'bt3], [#'p2]], [#'v, [#'bt4], [#'b_div]],
   // what comes out
   [#'s, [#'g0], [#'loop]], [#'v, [#'g1], [#'loop]],
   [#'v, [#'neg], [#'a]],
   [#'v, [#'and], [#'a]], [#'v, [#'and], [#'neg]],
   [#'v, [#'print], [#'g1]], [#'s, [#'print], [#'g0]]]
// once the rules have fired, the `print` may take either member of each class, and
// extraction takes the value without a loop in it and the state that skips it
def ev_picked_edges = [[#'v, [#'print], [#'and]], [#'s, [#'print], [#'s]]]
def ev_picked_from = [[#'v, [#'print], [#'g1]], [#'s, [#'print], [#'g0]]]
def ev_program_edges:
  for List (e :~ List in ev_edges): keep_when !ev_picked_from.contains(e); e
// and what the term it takes is made of, which is everything but the loop
def ev_extracted = [[#'a], [#'s], [#'neg], [#'and], [#'print]]

def ev_at:
  for values(m :~ Map = {}) ([key, _, _, w, x, y, kind] in ev_nodes):
    m ++ { key: [(x :~ Real) - (w :~ Real) / 2, y, w, ev_height(kind)] }
fun ev_middle(key) :: List:
  def [x, y, w, h] = ev_at[key]
  [(x :~ Real) + (w :~ Real) / 2, (y :~ Real) + (h :~ Real) / 2]
// The point a class tube should run to so that its round end covers a wide node:
// past the middle towards the far side, by what the node has over the tube's width.
fun ev_reach(key, dir :: Real) :: List:
  def [x, y, w, h] = ev_at[key]
  def [mx, my] = ev_middle(key)
  def tube = 64.0 + 2 * eclass_pad
  [mx + dir * math.max(0.0, (w :~ Real) / 2 - tube / 2 + 6.0), my]

// A tuple: a wide box with a parenthesis at each end, and its ports laid over it as
// nodes of their own, so that an edge can leave from the port of the element it is.
fun tuple_node(w :: Real) :: pc.Pict:
  def box = written_shape(rounded_path(w, ev_tuple_h, 12.0), ~width: w, ~height: ev_tuple_h,
                          ~fill: "white", ~line: "black", ~line_width: 3.0)
  def lp = node_label("(", ~size: 44.0)
  def rp = node_label(")", ~size: 44.0)
  put(put(box, lp, 10.0, (ev_tuple_h - lp.height) / 2),
      rp, w - 10.0 - rp.width, (ev_tuple_h - rp.height) / 2)
fun port_node(color :: String) :: pc.Pict:
  pc.circle(~size: ev_port, ~fill: hex_color(color), ~line: hex_color(color))

// ------------------------------------------------------------------- the slide
fun slide_eval_setup():
  def page = titled(eval_title, ~tag: "Eval setup title",
                    ~nudge: [0.0, 0.0])
  fun node(color :: String, w :: Real, text :: String, kind, ~fill: fill :: String):
    match kind
    | #'tuple: tuple_node(w)
    | #'port: port_node(color)
    | ~else:
        // the long names a size down: in the code's face a word of six letters
        // is wider than the box a shorter one fits
        graph_node(~width: w, ~height: ev_h, ~adj: "33878",
                   ~line: color, ~line_width: if color == stateful_hex | 4.0 | 3.0,
                   ~fill: fill, ~label: node_label(text, ~size: (if text.length() > 5 | 30.0 | 40.0)))
  fun drawings(~fill: fill :: String) :: Map:
    for values(m :~ Map = {}) ([key, text, color, w, _, _, kind] in ev_nodes):
      m ++ { key: node(color, w, text, kind, ~fill: fill) }
  def plain = drawings(~fill: node_white)
  def green = drawings(~fill: node_green)
  // the ports go over the tuples they sit in, and over the edges that leave them
  fun spots(keys :~ List, ~picked: picked :~ List = []) :: Map:
    for values(m :~ Map = {}) ([key, _, _, _, _, _, kind] in ev_nodes):
      skip_when !keys.contains(key)
      def [x, y, _, _] = ev_at[key]
      def drawn = (if picked.contains(key) | green | plain)[key]
      m ++ { key: (if kind == #'port | [drawn, x, y, band_point] | [drawn, x, y]) }
  fun wires(keys :~ List, ~picked: picked :: Boolean) :: List:
    def es = if picked | ev_program_edges ++ ev_picked_edges | ev_edges
    for List (e :~ List in es):
      keep_when keys.contains(e[1]) && keys.contains(e[2])
      e

  def program_keys:
    [[#'s], [#'one], [#'two], [#'a], & ev_input_keys, [#'loop], & ev_body_keys,
     [#'g0], [#'g1], [#'print]]
  def all_keys = program_keys ++ [[#'neg], [#'and]]
  // the body's region: a box round its term, its argument named in the corner
  def region:
    def [bx, by, bw, bh] = ev_region_box
    def box = written_shape(rounded_path(bw, bh, 14.0), ~width: bw, ~height: bh,
                            ~fill: region_fill, ~line: region_line,
                            ~line_width: 2.0, ~style: #'long_dash)
    def cap = math_text("loop body:  Arg = (σ, lb, 2, a)", ~size: 24.0,
                        ~color: region_line)
    // the header in the nodes' band: two things in one band have no order between
    // them, and in the box's band the box was drawn over it
    { [#'body]: [box, bx, by, band_below],
      [#'body_cap]: [cap, bx + 12.0, by + 6.0, band_nodes] }
  // the equalities the rules add: the loop's result and Hacker's Delight's one-liner
  // are the same value, which is the whole reason the loop can go, and the state
  // that comes out of the loop is the one that went in
  def equality:
    { [#'cls]: eclass_region(ev_middle([#'g1]), ev_reach([#'and], 1.0),
                             ~dash: value_class) ++ [band_below],
      [#'cls_s]: eclass_region(ev_middle([#'g0]), ev_middle([#'s]),
                               ~dash: state_class) ++ [band_below] }

  fun caption(s :: String, x :: Real) :: List: [panel_title(s), x, 236.0, band_callout]
  def cfg = { [#'cfg]: [cfg_pict(), 0.0, 0.0] }
  // what the program is for, said beside its last block, under the graph's rows
  def says:
    def en :~ List = cfg_boxes[3]
    def target = pc.blank(~width: en[2], ~height: en[3])
    { [#'says]: [bubble_at(target, ~spot: [en[0], en[1]], ~body: [400.0, 905.0],
                           ~color: talk_blue,
                           ~content: prose_stack([[["finds the ", #'plain],
                                                   ["lowest set bit", #'bold]],
                                                  [["of ", #'plain], ["a", #'bold_italic]]])),
                 0.0, 0.0, band_callout] }
  // the program eggcc emits, right of the graph and clear of the one-liner's nodes
  def opt:
    { [#'opt]: [opt_pict, 1560.0, 452.0],
      [#'opt_cap]: caption("optimized program", 1560.0) }
  // the pickaxe, left of the root class -- the `print` -- which is what extraction
  // takes its term out of
  def pick_size = 72.0
  def pick:
    def [px, py, _, ph] = ev_at[[#'print]]
    { [#'pick]: [as_pict(pickaxe(~size: pick_size)), px - pick_size - 16.0,
                 py + ph / 2 - pick_size / 2, band_above] }
  fun frame(~says: said :: Boolean = #false,
            ~graph: graph :: Boolean = #false,
            ~rule: rule :: Boolean = #false,
            ~pick: picking :: Boolean = #false,
            ~picked: picked :: Boolean = #false,
            ~opt: emitted :: Boolean = #false) :: Frame:
    def keys = if rule | all_keys | (if graph | program_keys | [])
    Frame(~picts: cfg
                    ++ { [#'cfg_cap]: caption("a Bril CFG", 140.0) }
                    ++ (if said | says | {})
                    ++ (if graph | region | {})
                    ++ (if picking | pick | {})
                    ++ spots(keys, ~picked: if picked | ev_extracted | [])
                    ++ (if graph | { [#'eg_cap]: caption("its e-graph", 760.0) } | {})
                    ++ (if rule | equality | {})
                    ++ (if emitted | opt | {}),
          ~edges: wires(keys, ~picked: picked))
  magic_slide(
    page,
    [// nothing yet, so that the program is written on a press
     Frame(),
     // the program as Bril has it: a loop that halves `a` while it stays even
     frame(),
     // and what that is for
     frame(~says: #true),
     // the same program as an e-graph -- the loop's result is what `print` takes
     frame(~says: #true, ~graph: #true),
     // the rules fire: `a & -a` is the same value, so it joins that e-class
     frame(~says: #true, ~graph: #true, ~rule: #true),
     // the pickaxe, on the root class
     frame(~says: #true, ~graph: #true, ~rule: #true, ~pick: #true),
     // extraction takes the member without a loop in it: those nodes turn green
     frame(~says: #true, ~graph: #true, ~rule: #true, ~pick: #true, ~picked: #true),
     // and that term, as Bril again, is the program eggcc emits
     frame(~says: #true, ~graph: #true, ~rule: #true, ~pick: #true, ~picked: #true,
           ~opt: #true)],
    ~wire: ev_wire_specs, ~edge_band: band_wires, ~extent: 1.3)

// values black and thin, the state edge blue and thick, as everywhere else
fun ev_wire_specs(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
  for values(q :~ pc.Pict = layer) (e :~ List in es):
    if e[0] == #'s
    | chain_wire(q, at, [e.rest], ~line_width: 6, ~color: keynote_blue)
    | chain_wire(q, at, [e.rest], ~line_width: 4)
