#lang rhombus/and_meta
// The slides the talk opens with: the title, the grid of tools built on e-graphs,
// and that same grid again with the ones that need effects marked.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "theme.rhm" open
  "write.rhm".ink_bounds
  pict as pc

export:
  slide_1
  slide_2
  slide_20
  slide_questions

