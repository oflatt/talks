// -------------------------------------------------------------------------------------
// slide_2: Keynote's 10-stage build of Slide 2, as one animated pict.
//
// The generator gave each build stage its own slide; every object was a superset of
// the stage before, so they collapse back into one. One `fade_in` per stage, so the
// deck takes the same number of clicks it did -- and each stage now writes itself:
// the logo fades up and its label is written beside it.
//
// The labels were Keynote's text boxes, and are text now. Each sits where its box put
// its ink -- `box_dx`, `box_dy` past the box's corner -- and Keynote's groups, which
// put a logo and its label under one corner, are folded into the numbers.

// A label of the grid, in Keynote's 48pt, and where its text box was.
fun label(s :: String, x :: Real, y :: Real) :: List:
  [prose_text(s, ~size: 48.0), x + box_dx, y + box_dy]
fun logo(file :: String, w :: Real, h :: Real, x :: Real, y :: Real,
         ~crop: crop = #false) :: List:
  [image_pict(media(file), w, h, ~crop: crop), x, y]
// A label centred over its logo -- over the logo's ink, since the pictures carry
// very different margins of transparent padding -- at the height its box had.
fun label_over(s :: String, piece :: List, y :: Real) :: List:
  def [img, lx, ly] = piece
  def p = as_pict(img)
  def box = ink_bounds(p) || [0.0, 0.0, p.width, p.height]
  def cx = lx + ((box[0] :~ Real) + (box[2] :~ Real)) / 2
  def word = prose_text(s, ~size: 48.0)
  [word, cx - word.width / 2, y + box_dy]
// A stage: its pieces on a transparent layer, each at its place on the slide.
fun layer(pieces :: List) :: pc.Pict:
  for values(p :~ pc.Pict = blank_slide) ([q, x, y] in pieces): put(p, q, x, y)

fun slide_2():
  // the picture before the first reveal
  def base_canvas:
    titled("E-Graphs are Super Useful!", ~tag: "E-Graphs are Super Useful!")
  // Labels sit on one line per row. Keynote left each label at its own group's top,
  // and the groups sit at different heights, so the labels stepped up and down
  // across the row and every one of them ran into its logo. These offsets put each
  // row's labels on a common bottom edge, 8pt clear of the highest logo *ink* in
  // that row -- ink, not bounding box, because the logos carry very different
  // amounts of transparent padding. The logos have not moved.
  def l_float = logo("image17.png", 558.478, 250.198, 35.955, 236.25 + 42.089)
  def l_numba = logo("image13.png", 280.727, 280.727, 620.266 + 70.107, 236.144 + 40.268)
  def l_intel = logo("image19.png", 371.484, 246.071, 1099.052, 247.464 + 23.789)
  def l_luminal = logo("image18.png", 264.568, 264.568, 1571.646, 211.913 + 45.622)
  def l_sql = logo("image15.png", 276.435, 285.65, 39.033 + 35.938, 623.282 + 59.801)
  def l_cad = logo("image14.png", 375.394, 295.819, 391.284, 662.932 + 40.848,
                   ~crop: [0.0, 0.0, 0.1, 0.0])
  def l_wasm = logo("image16.png", 404.626, 232.136, 806.567 + 2.627, 630.163 + 68.882)
  def l_mlir = logo("image20.png", 633.867, 253.547, 1256.336, 640.14 + 58.176)
  def stages:
    [layer([l_float, label_over("Floating point", l_float, 236.25 - 51.323)]),
     layer([l_numba, label_over("Python Simulations", l_numba, 236.144 - 51.217)]),
     layer([l_intel, label_over("RTL Optimization", l_intel, 247.464 - 62.537)]),
     layer([l_luminal, label_over("ML Kernels", l_luminal, 211.913 - 26.986),
            label_over("Luminal", l_luminal, 211.913 + 337.154)]),
     layer([l_sql, label_over("SQL", l_sql, 623.282 - 12.807)]),
     layer([l_cad, label_over("CAD", l_cad, 662.932 - 52.457)]),
     layer([l_wasm, label_over("WASM", l_wasm, 630.163 - 19.688)]),
     layer([l_mlir, label_over("User DSL Optimizations", l_mlir, 640.14 - 29.665)]),
     // ...and more!
     layer([label("…and more!", 1625.216, 967.946)])]
  staged(base_canvas, stages)

// -------------------------------------------------------------------------------------
// slide_20: slide_2 again, marking which of those tools need effects.
//
// This *is* slide_2: it starts from slide_2's own settled frame rather than
// repeating the grid. Editing slide_2 moves this slide with it. The two had been
// written out separately and had drifted -- to different logo positions and
// different logo scales -- which is exactly what deriving one from the other stops.
fun slide_20():
  // slide_2 as it stands once every application has appeared. It is a function
  // now -- a slide is built when it is shown -- so it is called, once, rather
  // than named twice.
  def grid = slide_2()
  def shown = grid.snapshot(grid.duration - 1, 1.0)

  // Which of these need effectful e-graphs. Each sits just under its logo's ink,
  // the way slide_2's own "Luminal" sits under the ML Kernels logo -- ink rather
  // than bounding box, because the logos carry very different bottom padding.
  def notes:
    layer([label("(Herbie)", 228.358, 522.666),
           label("(Cranelift)", 905.804, 943.181),
           label("(Szalinski)", 489.157, 1011.599)])

  // the notes are part of the picture from the moment the slide arrives; the
  // bubble is the one thing revealed on a click
  def base:
    pc.overlay(~horiz: #'left, ~vert: #'top, shown, notes)

  def stage_1:
    // The body goes in the band between the two rows, right of centre: the left of
    // that band is taken by "(Herbie)" and the right by the "Luminal" note, and this
    // is the clear stretch between them. Sitting between the rows it points into is
    // what lets two spikes leave upwards and two downwards, rather than four of them
    // crossing the picture from one side.
    def slot = pc.blank(~width: 1.0, ~height: 1.0)
    // Each marker is one logo's ink. Two of these images have no alpha channel and
    // are opaque white to their edges, so the extent has to come from where the
    // drawing stops being white -- MLIR's artwork is 507pt of its 634pt box, and
    // aiming at the box would leave the spike short of the logo by 60pt.
    def m_numba = pc.blank(~width: 256.0, ~height: 250.4)
    def m_luminal = pc.blank(~width: 264.6, ~height: 264.6)
    def m_cranelift = pc.blank(~width: 404.6, ~height: 232.1)
    def m_mlir = pc.blank(~width: 507.1, ~height: 169.5)
    def placed:
      layer([[slot, 950.0, 530.0], [m_numba, 702.7, 288.8], [m_luminal, 1571.6, 257.5],
             [m_cranelift, 809.2, 699.1], [m_mlir, 1319.7, 740.3]])
    multi_callout(~on: placed, ~place: slot,
                  ~at: [m_numba, m_luminal, m_cranelift, m_mlir],
                  ~color: talk_red, ~padding: 14.0,
                  robot_says(#'teeth, prose_text("need side effects!", ~size: 48.0, ~bold: #true),
                             ~sep: 12.0))

  staged(base, [stage_1])


// -------------------------------------------------------------------------------------
// slide_questions: the title slide again, at the end, with the robot asking for them.
//
// It calls `slide_1` rather than repeating it, so the deck cannot end on a title that
// has drifted from the one it opened with, and the whole slide is one `fade_in`: the
// room has seen this picture already, and the only new thing on it is the question.
fun slide_questions():
  staged(slide_1(),
         [put(blank_slide,
              make_bubble(~color: talk_green,
                          robot_says(#'smile, prose([["Questions?", #'bold]])))
                .scale(1.3),
              // the one empty corner: clear of the title, the faces and the logos
              1280.0, 130.0)])
