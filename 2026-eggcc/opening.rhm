#lang rhombus/and_meta
// The slides the talk opens with: the title, the grid of tools built on e-graphs,
// and that same grid again with the ones that need effects marked.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "theme.rhm" open
  pict as pc

export:
  slide_1
  slide_2
  slide_20

// -------------------------------------------------------------------------------------
// slide_1
fun slide_1(): slide_canvas(
  ~width: slide_width, ~height: slide_height,
  ~background: hex("FFFFFF"),
  // unknown.png (id 88)
  at(204.846, -334.58, ~rotate: 90.0, ~tag: "unknown.png",
     image_pict(media("image1.png"), 1510.306, 1925.056, ~crop: [0.0, 0.013, 0.514, 0.0],
                ~opacity: 0.351)),
  // Oliver Flatt, Anjali Pal, Yihong Zhang, Ryan Tjoa, Kirsten Graham, Alex Fischman,… (id 89)
  at(26.843, 896.485,
     ~tag: "Oliver Flatt, Anjali Pal, Yihong Zhang, Ryan Tjoa, Kirsten Graham, Alex Fischman,…",
     textbox(~width: 1833.914, ~height: 101.563, ~autofit: #'shrink,
             ~insets: insets(3.6, 3.6, 3.6, 3.6),
             para(
                  run(
                      "Oliver Flatt, Anjali Pal, Yihong Zhang, Ryan Tjoa, Kirsten Graham, Alex Fischman,",
                      ~font: prose_font, ~size: 39.0)),
             para(
                  run("Chandrakana Nandi, Eli Rosenthal, Zachary Tatlock, Haobin Ni",
                      ~font: prose_font, ~size: 39.0)))),
  // Efficient Extraction from Effectful E-Graphs (id 90)
  at(95.0, 202.755, ~tag: "Efficient Extraction from Effectful E-Graphs",
     textbox(~width: 1730.0, ~height: 366.0, ~anchor: #'bottom, ~autofit: #'shrink,
             ~insets: insets(4.0, 4.0, 4.0, 4.0),
             para(~line_spacing: pair(#'percent, 0.8),
                  run("Efficient Extraction from Effectful E-Graphs",
                      ~font: prose_font, ~size: 116.0, ~bold: #true,
                      ~spacing: -3.0)))),
  // unknown.png (2) (id 91)
  at(-4.619, 984.406, ~tag: "unknown.png (2)",
     image_pict(media("image2.png"), 616.548, 101.578,
                ~crop: [0.121, 0.318, 0.135, 0.37])),
  // unknown.png (3) (id 92)
  at(172.867, 743.613, ~tag: "unknown.png (3)",
     image_pict(media("image3.png"), 115.0, 115.0)),
  // unknown.png (4) (id 93)
  at(809.334, 743.633, ~tag: "unknown.png (4)",
     image_pict(media("image4.png"), 115.0, 115.0, ~crop: [0.0, 0.02, 0.0, 0.02])),
  // unknown.png (5) (id 94)
  at(1127.567, 743.662, ~tag: "unknown.png (5)",
