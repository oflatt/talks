#lang rhombus/and_meta
// slide_dp: the statewalk DP algorithm run on the `update` example.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "codebox.rhm" open
  "egraph.rhm" open
  "chain.rhm" open
  "apply.rhm" open
  "chaos.rhm" open
  "write.rhm".Arrival
  "write.rhm".arriving
  "write.rhm".write
  "write.rhm".writer
  pict as pc
  draw

export:
  collapse_title
  give_up_title
  slide_give_up
  slide_collapse
  slide_dp
  dp_title

// The two branches out of the argument state, as colours. Two hues and not two
// strengths of one: they are two different walks, not more and less of the same
// thing. The lighter is also the shorter, and the gap in lightness is what makes
// them two colours under any colour vision -- and in a handout printed grey.
def branch_a_fill = "BFE4E0"                  // through the write the rule added
def branch_b_fill = "9C82C8"                  // through both of the program's writes
def branch_seed_fill = "DCDCE4"               // and the walk that is only the state
// A walk's extractable set is laid in the walk's own colour at half strength, each
// set one flat layer: where two sets overlap the two colours mix, and where only one
// reaches, its colour shows alone -- so which set is drawn first does not matter,
// and a press that grows one under the other lands on the picture the frame after
// it draws.
def blob_alpha = 0.5
// and the walk itself, which is a line laid over its own mass and so has to be the
// strong end of the same hue rather than the pale one
def walk_a_line = "17786E"
def walk_b_line = "553C93"
def walk_seed_line = "6E6E82"

// ---------------------------------------------------------------------------
// The picture the two slides in this section share: where the graph goes once
// the code box has gone, which walks the table holds, and the mass each one can
// build. Both slides draw the same graph in the same place, so they are written
// against one description of it rather than two.
def dp_rows :~ List = chain_statewalks()

// ------------------------------------------------------------ where the graph goes
// The same graph, moved into the middle of the slide once the code box has gone,
// and grown by as much as the height allows. Not stretched: the columns keep the
// spacing the layout solved for, the picture just takes the room the code had.
fun node_size(key) :: List:
  def w = (chain_box :~ Map)[key] :~ Real
  [w, if w > 100 | 64.0 | 63.486]
def home_box:
  for values(b :~ List = [1.0e9, 1.0e9, -1.0e9, -1.0e9]) (key in chain_spots.keys()):
    def [x, y] = (chain_spots :~ Map)[key] :~ List
    def [w, h] = node_size(key)
    [math.min(b[0], x), math.min(b[1], y),
     math.max(b[2], x + w), math.max(b[3], y + h)]
def dp_top = 216.0
def dp_bottom = 1032.0
def dp_scale:
  math.min(1.25, (dp_bottom - dp_top) / ((home_box[3] :~ Real) - (home_box[1] :~ Real)))
def dp_left:
  (slide_width - ((home_box[2] :~ Real) - (home_box[0] :~ Real)) * dp_scale) / 2
fun moved(spots :~ Map) :: Map:
  for values(m :~ Map = {}) (key in spots.keys()):
    def [x, y] = spots[key] :~ List
    m ++ { key: [dp_left + (x - (home_box[0] :~ Real)) * dp_scale,
                 dp_top + (y - (home_box[1] :~ Real)) * dp_scale] }
def away :~ Map = moved(chain_spots)
fun middle(spots :~ Map, key) :: List:
  def [x, y] = spots[key] :~ List
  def [w, h] = node_size(key)
  [x + w * dp_scale / 2, y + h * dp_scale / 2]

// The classes the rule made, drawn wherever the graph is: `v1 ≡ v3` and `ω2 ≡ ω3`
// are the reason any of this is hard, and a slide about which class holds which
// walk cannot be one that has stopped drawing the classes.
fun regions_at(spots :~ Map) :: Map:
  fun tube(from, to, dash):
    def r :~ List = eclass_region(middle(spots, from), middle(spots, to), ~dash: dash)
    [r[0], r[1], r[2], band_below]
  { #'old_class: tube(#'v1, #'v3, value_class),
    #'memory_class: tube(#'s3, #'s2, state_class) }

fun picts_at(spots :~ Map, fills :~ Map, ~scale: k :: Real = dp_scale) :: Map:
  def nodes :~ Map = chain_nodes(~fills: fills)
  for values(m :~ Map = {}) (key in spots.keys()):
    def [x, y] = spots[key] :~ List
    m ++ { key: [as_pict(nodes[key]).scale(k), x, y] }
fun green_at(spots :~ Map, term :~ List) :: Map:
  def nodes :~ Map = chain_nodes(~picked: term)
  for values(m :~ Map = {}) (key in term):
    def [x, y] = spots[key] :~ List
    m ++ { key: [as_pict(nodes[key]).scale(dp_scale), x, y] }

// ------------------------------------------------------------------ the two walks
// Which way out of the argument state a walk went. That is what the colours are
// about, so it is one function and everything else reads it.
fun branch(walk :~ List):
  cond
  | walk.length() < 2: #'seed
  | walk[1] == #'us: #'a
  | ~else: #'b
fun branch_fill(b) :: String:
  match b
  | #'a: branch_a_fill
  | #'b: branch_b_fill
  | ~else: branch_seed_fill
fun branch_blob(b) :: String: branch_fill(b)
fun branch_line(b) :: String:
  match b
  | #'a: walk_a_line
  | #'b: walk_b_line
  | ~else: walk_seed_line

fun row_where(cls, b) :: List:
  for values(found :~ List = []) (row :~ List in dp_rows):
    if row[0] == cls && branch(row[2] :~ List) == b | row | found
def r_seed = dp_rows[0]
def r_a = row_where(chain_class_of[#'s3], #'a)      // the state the two writes meet in
def r_b = row_where(chain_class_of[#'s3], #'b)
def r_root_a = row_where(chain_root, #'a)
def r_root_b = row_where(chain_root, #'b)
def r_best = chain_dp_best()

// every row the table has written by the time a walk has been followed: the walks
// that are a prefix of it are the ones it was built out of
fun rows_along(walk :~ List) :: List:
  for List (row :~ List in dp_rows):
    def w :~ List = row[2]
    keep_when w.length() <= walk.length()
      && (for values(all = #true) (i in 0..w.length()): all && w[i] == walk[i])
    row
fun fills_of(shown :~ List) :: Map:
  def by_class:
    for values(m :~ Map = {}) (row :~ List in shown):
      def c = row[0]
      def col = branch_fill(branch(row[2] :~ List))
      def had :~ List = if m.has_key(c) | m[c] | []
      if had.contains(col) | m | m ++ { c: had ++ [col] }
  for values(m :~ Map = {}) ([key, c, _] in chain_graph :~ List):
    if by_class.has_key(c) | m ++ { key: by_class[c] } | m
// the walk of one row, as edges, in its branch's colour
fun walk_edges(row :~ List) :: List:
  def walk :~ List = row[2]
  def hue = branch_line(branch(walk))
  for List (j in 0..walk.length() - 1): [#'walk, walk[j + 1], walk[j], hue]

// ---------------------------------------------------------- what a walk can build
// The extractable set, as one mass: every *pure* node of every class the walk puts
// within reach. Not the walk's own nodes -- the writes it performs and the memories
// they leave are how it got there, not what it can build once there -- and that is
// what makes two walks comparable at a glance: what they reach differs only in the
// values, and where it does not differ at all, either of them will do.
//
// Classes and not representatives, because the set *is* a set of classes. They are
// joined by the graph's own edges between covered nodes, and by a neck between
// members of one class. The layout keeps an edge from passing behind a box it does
// not end at, so a neck along one cannot swallow a node not in the set.
def blob_pad = 18.0
def blob_neck = 34.0
// how much of a press a set laid over another takes to come up
def cover_span = 0.6
fun blob_nodes(row :~ List) :: List:
  for values(acc :~ List = []) ([key, c, _] in chain_graph :~ List):
    if (row[1] :~ List).contains(c) && !chain_eff_class(c) && !acc.contains(key)
    | acc ++ [key]
    | acc
fun blob_links(row :~ List) :: List:
  def covered :~ List = blob_nodes(row)
  def args :~ Map = chain_args_of(chain_graph)
  def down:
    for values(acc :~ List = []) (key in covered):
      for values(acc :~ List = acc) (a in args[key] :~ List):
        for values(acc :~ List = acc) ([k2, c2, _] in chain_graph :~ List):
          if c2 == a && covered.contains(k2) | acc ++ [[key, k2]] | acc
  // and the members of one class to each other, which is the one join the graph
  // has no edge for
  for values(acc :~ List = down) ([k1, c1, _] in chain_graph :~ List):
    for values(acc :~ List = acc) ([k2, c2, _] in chain_graph :~ List):
      if c1 == c2 && k1 != k2 && covered.contains(k1) && covered.contains(k2)
      | acc ++ [[k1, k2]]
      | acc
// A mass carries its own colour, so that one press can show two of them: the set
// the table already had and the set the walk that just arrived reaches. The two
// are nested, and each is laid at half strength, so where both reach the colours
// mix and where only the bigger does its own colour shows -- which is the whole
// difference between the two entries, and the reason both are kept.
fun blob_marks(row :~ List) :: List:
  def hue = branch_blob(branch(row[2] :~ List))
  (for List (k in blob_nodes(row)): [#'blob, k, hue])
    ++ (for List ([f, t] in blob_links(row)): [#'blink, f, t, hue])

fun marks_of(f :: Frame, tag) :: List:
  for List (e :~ List in f.edges): keep_when e[0] == tag; e.rest
// the masses a frame shows, in the order they are to be drawn
fun hues_of(f :: Frame) :: List:
  for values(acc :~ List = []) (m :~ List in marks_of(f, #'blob)):
    if acc.contains(m[1]) | acc | acc ++ [m[1]]

// The mass is drawn by the press rather than by either frame, because what has to
// happen between two presses is that it *grows*: a shape that arrives as a second
// pict can only dissolve into place. Each piece new to this press swells from
// nothing, and the ones further from the mass that is already there start later, so
// it runs outwards from the walk instead of blinking on all at once.
//
// Except where there is a mass there already: a set that arrives over another one
// is the same set and more, and what a reader should see is the second colour
// laid over the first -- so the pieces it has in common with what is there come at
// full size and the whole fades up over them, and only what is new to it grows.
fun blob_stage(layer :: pc.Pict, a :: Frame, b :: Frame, t :: Real) :: pc.Pict:
  // a piece of a mass is a colour and a node, so that two masses can be in flight
  // at once without either one's growth being confused for the other's
  def was :~ List = for List (m :~ List in marks_of(a, #'blob)): [m[1], m[0]]
  def now :~ List = for List (m :~ List in marks_of(b, #'blob)): [m[1], m[0]]
  def links :~ List = marks_of(a, #'blink) ++ marks_of(b, #'blink)
  fun reach_dist(item :~ List) :: Real:
    def [cx, cy] = middle(away, item[1])
    for values(d :~ Real = 1.0e9) (o :~ List in was):
      def [ox, oy] = middle(away, o[1])
      math.min(d, math.sqrt((cx - ox) * (cx - ox) + (cy - oy) * (cy - oy)))
  def coming :~ List: for List (k in now): keep_when !was.contains(k); k
  // the pieces of an arriving set that lie over one already drawn, and the sets
  // that have any: those are laid over what is there rather than grown
  def covered :~ List = for List (o :~ List in was): o[1]
  def covering :~ List = for List (k :~ List in coming): keep_when covered.contains(k[1]); k
  def taking_over :~ List:
    for values(acc :~ List = []) (k :~ List in covering):
      if acc.contains(k[0]) | acc | acc ++ [k[0]]
  // A set that is being let go goes as a whole, and a whole set fades out where it
  // lies rather than contracting: shrunk piece by piece it plays its own arrival
  // backwards, and whatever is under it comes out from behind it as it goes -- which
  // reads as the set that stays growing all over again.
  def leaving :~ List:
    for List (h in hues_of(a)): keep_when !hues_of(b).contains(h); h
  def far: for values(m :~ Real = 1.0) (k in coming): math.max(m, reach_dist(k))
  def size :~ Map:
    for values(m :~ Map = {}) (item in now ++ was):
      def f:
        cond
        | was.contains(item) && now.contains(item): 1.0
        | covering.contains(item): 1.0
        | now.contains(item):
            def start = 0.5 * (if far > 0.0 | reach_dist(item :~ List) / far | 0.0)
            smooth((t - start) / math.max(0.05, 1.0 - start))
        | leaving.contains((item :~ List)[0]): 1.0
        | ~else: smooth(1.0 - t)
      m ++ { item: f }
  fun at(hue, key) :: Real:
    if size.has_key([hue, key]) | (size[[hue, key]] :~ Real) | 0.0
  // the frame this press lands on says the order, so the press ends on the picture
  // the still after it draws; a set on its way out goes after them
  def order :~ List:
    for values(acc :~ List = hues_of(b)) (h in hues_of(a)):
      if acc.contains(h) | acc | acc ++ [h]
  // one set, as a flat mass in its own colour: its pieces drawn opaque, so that
  // where they overlap each other is no darker, and the whole faded once
  fun mass_of(hue) :: pc.Pict:
    pc.dc(fun (target :: draw.DC, dx, dy):
            target.save()
            target.brush := draw.Brush(~color: hex_color(hue))
            // the necks first, so a node's own blob is drawn over where they meet
            target.pen := draw.Pen(~color: hex_color(hue),
                                   ~width: blob_neck * dp_scale,
                                   ~cap: #'round, ~join: #'round)
            for ([f, tk, h] in links):
              skip_when h != hue
              def anchor = if at(hue, f) >= at(hue, tk) | f | tk
              def other = if anchor == f | tk | f
              def u = math.min(at(hue, f), at(hue, tk))
              skip_when u <= 0.02
              def [ax, ay] = middle(away, anchor)
              def [ox, oy] = middle(away, other)
              def path = draw.Path()
              path.move_to([dx + ax, dy + ay])
              path.line_to([dx + ax + (ox - ax) * u, dy + ay + (oy - ay) * u])
              target.path(path)
            target.pen := draw.Pen(~color: hex_color(hue), ~width: 0, ~cap: #'round)
            for (item :~ List in size.keys()):
              skip_when item[0] != hue
              def f = (size[item] :~ Real)
              skip_when f <= 0.02
              def [cx, cy] = middle(away, item[1])
              def [w, h] = node_size(item[1])
              def bw = (w + 2 * blob_pad) * dp_scale * f
              def bh = (h + 2 * blob_pad) * dp_scale * f
              def path = draw.Path()
              path.rounded_rectangle([dx + cx - bw / 2, dy + cy - bh / 2, bw, bh],
                                     math.min(bw, bh) * 0.45)
              target.path(path)
            target.restore(),
          ~width: slide_width, ~height: slide_height)
  for values(q :~ pc.Pict = layer) (hue in order):
    def fade:
      cond
      | leaving.contains(hue): smooth(1.0 - t)
      | taking_over.contains(hue): smooth(math.min(1.0, t / cover_span))
      | ~else: 1.0
    skip_when fade <= 0.0
    put(q, mass_of(hue).alpha(blob_alpha * fade, ~composite: #true), 0.0, 0.0)

// One press per term the walk grows by, in the order a reader would try them:
// everything the first write opens up, and then everything the second does, so
// that the two arrive at the same class one after the other rather than
// interleaved. The last of them is the point of the slide.
def order:
  [[#'s0],
   [#'s0, #'us], [#'s0, #'us, #'s3],
   [#'s0, #'u1], [#'s0, #'u1, #'s1],
   [#'s0, #'u1, #'s1, #'u2], [#'s0, #'u1, #'s1, #'u2, #'s2]]
fun row_for(walk :~ List) :: List:
  for values(found :~ List = []) (row :~ List in dp_rows):
    if (row[2] :~ List) == walk | row | found
// what the table holds once the first `n` of those have been taken
fun stored(n :: Int) :: List:
  for values(acc :~ List = []) (i in 0..n):
    for values(acc :~ List = acc) (row :~ List in rows_along((order :~ List)[i] :~ List)):
      if acc.contains(row) | acc | acc ++ [row]


def w_root_a = [#'s0, #'us, #'s3, #'ret]
def w_root_b = [#'s0, #'u1, #'s1, #'u2, #'s2, #'ret]
def all_stored:
  def more = rows_along(w_root_a) ++ rows_along(w_root_b)
  for values(acc :~ List = stored((order :~ List).length())) (row :~ List in more):
    if acc.contains(row) | acc | acc ++ [row]

// ------------------------------------------------------------------- the words
// What the whole slide is an instance of, said first: in the margin left of the
// graph, where the code box was, and up for the whole of the stepping, which is
// read against it.
def idea_at = [100.0, 168.0]
def key_idea:
  def words:
    // Short lines rather than small ones: the margin is 500 wide.
    prose_stack([[["Key idea:", #'bold]],
                 [["keep ", #'plain], ["multiple", #'bold]],
                 [["statewalks", #'plain]],
                 [["per e-class", #'plain]]])
  // the face over the words, not beside them: the margin is taller than it is wide
  def content: robot_says(#'idea, words, ~sep: 10.0, ~above: #true, ~scale: 0.7)
  { #'idea: [make_bubble(~color: talk_green, ~padding: 24.0, content),
             idea_at[0], idea_at[1], band_callout] }
def idea_bubble :: pc.Pict = (key_idea[#'idea] :~ List)[0]

// What the algorithm's cost comes to. The good news: the time is bounded by how
// many walks the table holds (paper, Section 6) -- which on this graph is two, for
// the class the two writes meet in, so the bubble points at that class, the one
// filled in both colours. The bad news, in red under it: in general that number is
// exponential. Both in the margin right of the graph, which is the empty side; what
// keeps the number small in practice is the slide after this one.
def good_news:
  def words:
    prose_stack([[["Good news:", #'bold]],
                 [["time bounded by", #'plain]],
                 [["number of statewalks!", #'plain]]])
  def [region, rx, ry, _] = (regions_at(away) :~ Map)[#'memory_class]
  { #'good: [bubble_at(region, ~spot: [rx, ry], ~body: [1440.0, 190.0],
                       ~color: talk_green,
                       // the face over the words: the margin is taller than wide
                       ~content: robot_says(#'smile, words, ~sep: 12.0, ~above: #true,
                                            ~scale: 0.85)),
             0.0, 0.0, band_callout] }
def bad_news:
  def words:
    prose_stack([[["Bad news:", #'bold]],
                 [["exponential number", #'plain]],
                 [["of statewalks", #'plain]]])
  { #'bad: [make_bubble(~color: talk_red, ~padding: 24.0,
                        robot_says(#'frown, words, ~sep: 12.0, ~above: #true, ~scale: 0.85)),
            1440.0, 590.0, band_callout] }

// The last word of all, at the end of the collapsing: the kind of answer this is. A
// hard problem with a parameter that stays small in practice is what a parameterized
// algorithm is for, and this one is one. In the margin left of the graph, the wand
// beside its words so that it fits under the bubble about the optimization and over
// the one about the two sets.
def parameterized:
  def words:
    prose_stack([[["parameterized", #'bold_italic]],
                 [["algorithms", #'bold_italic]],
                 [["provide practical", #'plain]],
                 [["solutions to", #'plain]],
                 [["NP-hard problems", #'plain]]])
  // written out rather than popped: the last word of the section, said slowly
  { #'wand: [make_bubble(~color: talk_green, ~padding: 24.0, ~text: #'write,
                         pc.beside(~sep: 16.0, ~vert: #'center, wand(~size: 100.0), words)),
             100.0, 470.0, band_callout] }


// The example's graph, in the middle of the slide with nothing else on it. The
// slide before the algorithm's carries it here and the algorithm's opens on it.
def dp_graph_frame:
  Frame(~picts: picts_at(away, {}) ++ regions_at(away), ~edges: chain_edges(4))
// where that graph's own ink sits on the page, for a slide that has to move it
def dp_graph_box :~ List:
  for values(b :~ List = [1.0e9, 1.0e9, -1.0e9, -1.0e9]) (key in away.keys()):
    def [x, y] = (away :~ Map)[key] :~ List
    def [w, h] = node_size(key)
    [math.min(b[0], x), math.min(b[1], y),
     math.max(b[2], x + w * dp_scale), math.max(b[3], y + h * dp_scale)]

// the term the algorithm comes back with, which is also the one extraction should
// have found on the example: what the slide before the algorithm's lights up
def dp_answer :~ List = chain_dp_term(r_best)

// The title, as a piece of the slide rather than of the page: a slide after this one
// opens on its last picture and changes the words, which it can only do if they are
// drawn like everything else. Each title is keyed by its own words, so a press that
// changes them has one thing to take away and another to bring; the old fades out
// over the press and the new waits until it is most of the way gone before it comes
// up, so the two are never both legible at once.
def dp_page = as_pict(page_canvas())
fun dp_titled(t :: String) :: Map:
  def words = pc.text(t, ~font: title_face)
  def coming:
    arriving(words,
             Arrival(fun (n :: Real):
                       def u = clamp01((n - 0.55) / 0.45)
                       cond
                       | u >= 1.0: words
                       | u <= 0.0: words.ghost()
                       | ~else: words.alpha(smooth(u)),
                     0.6, ~kind: #'fade))
  { [#'title, t]: [coming, title_x, title_y, band_callout] }
fun entitled(frames :~ List, over :~ Map) :: List:
  for List (f :: Frame in frames): Frame(~picts: f.picts ++ over, ~edges: f.edges)

// -------------------------------------------------------------------------------------
// The algorithm, on the example the section before this one was about.
//
// The slide is organised around the question the table asks, not around the order it
// fills in: point at an e-class, and ask what statewalks reach it and what each of
// them puts within reach. Most classes have one answer. The class where the two
// writes meet has two, and the two are not the same, which is why the table cannot
// keep just one of them -- and that is the whole slide.
// the title, named once: the divider before this slide writes it as its outline
// goes up, and reads it from here
def dp_title = "The Statewalk DP Algorithm"
fun slide_dp():

  // What the whole slide is after, said at the return as soon as the graph is up: a
  // term out of the root class that one state walk reaches the whole of. It stays
  // up to the end, pointing at the return wherever the return stands -- which, for
  // the press that lays the answer out as a tree, is somewhere else.
  // The body stands in the corner left of the graph's last row, three short lines
  // so that it fits under the bubble about the width and left of the row's first
  // state, clear of the slide's bottom edge and of the bubbles on the right. It
  // stands there for the whole slide; only its spike follows the return.
  def want_body = [440.0, 820.0]
  fun want_at(spots :~ Map) :: Map:
    def [rx, ry] = spots[#'ret] :~ List
    { #'want: [bubble_at(as_pict(chain_plain[#'ret]).scale(dp_scale), ~spot: [rx, ry],
                         ~body: want_body, ~color: talk_blue,
                         ~content: prose_stack([[["Want:", #'bold]],
                                                [["extraction using", #'plain]],
                                                [["a single state walk", #'plain]]])),
               0.0, 0.0, band_callout] }
  def want = want_at(away)
  // the three of them, for every frame after all are up
  // the key idea stays to the end; what was wanted goes once it has been found
  def said = key_idea

  // --------------------------------------------------------------------- the presses
  // The pointer the other extractions use, on the class being considered. It stands
  // to the left of it, which is clear on this graph for every class a walk ends in
  // except two, and those two say where they want it.
  def point_w = 80.0
  def point_h = 80.0
  def dp_point_right = as_pict(pickaxe(~size: point_w))
  def dp_point_left = as_pict(pickaxe(~size: point_w, ~facing: #'left))
  // It stands to the left of the class it names, which is clear on this graph for
  // every one a walk ends in except the argument state -- `x+1` is in that lane, so
  // that one is pointed at from the other side.
  def point_side = { #'s0: #'right }
  // and the state the second walk ends in has the first walk's state right beside
  // it, in the one class, so the pickaxe stands left of that class as a whole
  def point_stand = { #'s2: #'s3 }
  fun pointer_at(key_in) :: Map:
    def key = if point_stand.has_key(key_in) | point_stand[key_in] | key_in
    def [x, y] = (away :~ Map)[key] :~ List
    def [w, h] = node_size(key)
    def right = point_side.has_key(key)
    // over the bubbles: the pickaxe is what the press is about, and a bubble that
    // reaches across the class it stands at would otherwise hide it
    { #'point: [(if right | dp_point_left | dp_point_right),
                (if right | x + w * dp_scale + 20.0 | x - point_w - 20.0),
                y + (h * dp_scale - point_h) / 2, band_callout + 1] }

  // `~walks` are the dp_rows whose walks are drawn along the graph's edges, and `~sets`
  // the dp_rows whose extractable sets are drawn, in that order -- listed later is drawn
  // later. The stepping shows walks and the classes they fill; the sets come only
  // once there are two walks in one class to compare.
  fun beat(shown :~ List,
           ~walks: walks :~ List = [], ~sets: sets :~ List = [],
           ~point: point = #false,
           ~idea: idea :: Boolean = #false) :: Frame:
    Frame(~picts: picts_at(away, fills_of(shown)) ++ regions_at(away) ++ want
                    ++ (if point == #false | {} | pointer_at(point))
                    ++ (if idea | key_idea | {}),
          ~edges: chain_edges(4)
                    ++ List.append(& for List (row :~ List in walks): walk_edges(row))
                    ++ List.append(& for List (row :~ List in sets): blob_marks(row)))
  fun step(i :: Int) :: Frame:
    def walk :~ List = (order :~ List)[i]
    beat(stored(i + 1), ~walks: [row_for(walk)], ~idea: #true,
         ~point: walk[walk.length() - 1])


  // Where the answer goes once it is on its own. Placed by hand: the graph puts the
  // two members of the value class at opposite ends of a row, and an answer that
  // takes the far one has its `return` reaching back across the state it also takes,
  // straight through that node's label. Nine nodes on their own can be a tree.
  // a little right of centre, so that its return is clear of the bubble that
  // points at it from the left
  def term_spots:
    { #'x: [1005.0, 250.0], #'one: [1165.0, 250.0],
      #'a: [820.0, 400.0], #'xp: [1030.0, 400.0], #'s0: [1270.0, 400.0],
      #'us: [965.0, 560.0],
      #'v3: [890.0, 720.0], #'s3: [1130.0, 720.0],
      #'ret: [965.0, 880.0] }
  fun term_edges(term :~ List) :: List:
    def taken:
      for values(m :~ Map = {}) ([key, c, _] in chain_graph :~ List):
        if term.contains(key) | m ++ { c: key } | m
    for List (e :~ List in chain_edges(4)):
      keep_when term.contains(e[1])
      def c = chain_class_of[e[2]]
      keep_when taken.has_key(c)
      [e[0], e[1], taken[c]]
  def answer = chain_dp_term(r_best)

  chain_slide(
    dp_page,
    entitled(
      [// the graph in the middle of the slide, where the slide before this one
       // carried it: the show cuts to it
       dp_graph_frame,
       // what is wanted of it, at the return
       Frame(~picts: picts_at(away, {}) ++ regions_at(away) ++ want, ~edges: chain_edges(4)),
       // the idea, to read the stepping against
       beat([], ~idea: #true),
       // the pickaxe, on the class the first walk ends in: extraction is what the
       // stepping is for
       beat([], ~idea: #true, ~point: #'us),
       // then the walks, one press per term the table grows by, each filling the
       // class it reaches in its colour: the write the rule added and the state it
       // leaves -- not the walk that is the argument state alone, a puzzle before it
       // is an example, though that row is in the table all the same -- then the
       // program's own first write, the state it leaves, its second write and the
       // state that leaves
       step(1), step(2), step(3), step(4), step(5), step(6),
       // That last state is a class the table already had a walk for, and it is filled
       // in both colours to say so. What the two of them reach, and when one of them
       // can be let go, is the slide after this. The root is reached both ways too, so
       // there are two answers to choose between.
       beat(all_stored, ~point: #'ret, ~idea: #true),
       // The cheaper of them, and the term it stands for. The value the `return` takes
       // is the one this walk's write returned -- on this walk there is no other.
       Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away)
                       ++ green_at(away, answer) ++ said,
             ~edges: chain_edges(4) ++ walk_edges(r_best)),
       // and then just that term, laid out as the tree it is, the bubble at the return
       // following it there
       Frame(~picts: green_at(term_spots, answer) ++ key_idea,
             ~edges: term_edges(answer)),
       // and back to the graph as the table left it, every class filled by the walks
       // that reach it: the term's nodes go back to their places and take their
       // colours, and the rest writes in around them
       Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away) ++ said,
             ~edges: chain_edges(4)),
       // and what finding the term cost, which is the section's whole claim, said of
       // the class that holds two walks -- the one place on this graph the width is
       // more than one
       Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away) ++ said
                       ++ good_news,
             ~edges: chain_edges(4)),
       // and what kind of answer that makes this
       Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away) ++ said
                       ++ good_news ++ bad_news,
             ~edges: chain_edges(4))],
      dp_titled(dp_title)),
    ~stage: blob_stage, ~stage_band: band_below)

// -------------------------------------------------------------------------------------
// slide_collapse: when two walks at one class can be one.
//
// The slide before this keeps a walk per extractable set and leaves it at that. This
// one says what the table is really keeping them apart for. The two walks that meet
// at the memory class reach sets that differ by exactly one node: the value the
// program's second write returns, which nothing reads. Take that away -- make the
// write a write, and not an operation that hands a value back -- and the two sets are
// the same set. One walk will do, and the class goes back to one colour.
def collapse_title = "Collapsing Statewalks"
fun slide_collapse():
  // the value the program's second write returns, and nobody reads
  def dead = #'v2
  // that write once it returns nothing: an `update` hands back a value and a memory,
  // and one that hands back only the memory is a `write`
  fun write_node(fill :: String) :: pc.Pict:
    graph_node(~width: (chain_box :~ Map)[#'u2] :~ Real, ~height: 64.0, ~adj: "33349",
               ~line: stateful_hex, ~line_width: 4.0, ~fill: fill,
               ~label: node_label("write"))
  // the graph, with that change made or not
  fun picts_of(~fills: fills :~ Map, ~written: written :: Boolean) :: Map:
    def base :~ Map = picts_at(away, fills)
    for values(m :~ Map = {}) (key in base.keys()):
      skip_when written && key == dead
      cond
      | written && key == #'u2:
          def [_, x, y] = base[key] :~ List
          def fill :: String = if fills.has_key(#'u2) | (fills[#'u2] :~ List)[0] | node_white
          m ++ { key: [write_node(fill).scale(dp_scale), x, y] }
      | ~else: m ++ { key: base[key] }
  fun edges_of(written :: Boolean) :: List:
    if !written
    | chain_edges(4)
    | for List (e :~ List in chain_edges(4)): skip_when e[1] == dead || e[2] == dead; e
  fun set_marks(row :~ List, ~written: written :: Boolean) :: List:
    for List (m :~ List in blob_marks(row)):
      skip_when written && (m[1] == dead || (m[0] == #'blink && m[2] == dead))
      m

  // What the table holds at the end of the slide before, and the same with the two
  // walks at the memory class down to one: a class with only one walk left is drawn
  // in that walk's colour alone.
  def stored_fills :~ Map = fills_of(all_stored)
  def one_fills :~ Map:
    for values(m :~ Map = {}) (k in stored_fills.keys()):
      def v :~ List = stored_fills[k]
      m ++ { k: (if v.length() > 1 | [branch_a_fill] | v) }
  // the two walks that meet at the memory class
  def w_a = r_a
  def w_b = r_b

  // ------------------------------------------------------------------- the words
  // What the slide is for, in the margin left of the graph, and up throughout.
  def optimization:
    def words:
      prose_stack([[["Optimization:", #'bold]],
                   [["collapse by unique", #'plain]],
                   [["extractable set", #'plain]]])
    { #'optimization: [make_bubble(~color: talk_green, ~padding: 24.0, words),
                       100.0, 200.0, band_callout] }
  // and what an extractable set is, right of the graph: said once the word has been
  // used and before the first one is drawn
  def definition:
    def words:
      prose_stack([[["extractable set", #'bold_italic], [":", #'plain]],
                   [["e-classes we could extract", #'plain]],
                   [["for a given ", #'plain], ["state walk", #'bold]]])
    { #'definition: [make_bubble(~color: talk_blue, ~padding: 24.0, words),
                     1370.0, 240.0, band_callout] }
  // and what the two sets come to, said of the class they are both stored at: the
  // same bubble before the change and after it. Low in the left margin, so that its
  // spike runs in under `v3` to the class rather than across it.
  fun verdict(head :: String, rest :: String) :: Map:
    def [region, rx, ry, _] = (regions_at(away) :~ Map)[#'memory_class] :~ List
    { #'verdict: [bubble_at(region, ~spot: [rx, ry], ~body: [150.0, 830.0],
                            ~color: talk_blue,
                            ~content: prose_stack([[[head, #'bold]], [[rest, #'plain]]])),
                  0.0, 0.0, band_callout] }
  def differ = verdict("different", "extractable sets")
  def same = verdict("same", "extractable set")
  // and the answer to the bad news the slide before ended on, said of the class that
  // was just collapsed: the number of walks stays small where it matters
  def few:
    def [region, rx, ry, _] = (regions_at(away) :~ Map)[#'memory_class] :~ List
    { #'few: [bubble_at(region, ~spot: [rx, ry], ~body: [1440.0, 820.0], ~color: talk_green,
                        ~content: prose([["few in practice", #'bold]])),
              0.0, 0.0, band_callout] }

  // --------------------------------------------------------------------- the presses
  fun beat(~fills: fills :~ Map = stored_fills, ~written: written :: Boolean = #false,
           ~walks: walks :~ List = [], ~sets: sets :~ List = [],
           ~over: over :~ Map = {}) :: Frame:
    Frame(~picts: picts_of(~fills: fills, ~written: written) ++ regions_at(away) ++ over,
          ~edges: edges_of(written)
                    ++ List.append(& for List (row :~ List in walks): walk_edges(row))
                    ++ List.append(& for List (row :~ List in sets): set_marks(row, ~written: written)))

  chain_slide(
    dp_page,
    // It opens on the picture the slide before it ends with, which is where it takes
    // over: the show cuts, and the first press changes the words at the top and takes
    // the last slide's remarks away.
    [Frame(~picts: picts_of(~fills: stored_fills, ~written: #false) ++ regions_at(away)
                     ++ key_idea ++ good_news ++ bad_news ++ dp_titled(dp_title),
           ~edges: chain_edges(4)),
     & entitled(
         [// the graph on its own again, under the title this slide is about
          beat(),
          // what the table could do about a class with two walks in it
          beat(~over: optimization),
          // and what the sets it would compare are
          beat(~over: optimization ++ definition),
          // the walk the rule's write opens up, and every pure node it can build
          beat(~over: optimization ++ definition, ~walks: [w_a], ~sets: [w_a]),
          // and the walk through both of the program's writes, which reaches all of
          // that and one node more: the value the second write returns
          beat(~over: optimization ++ definition, ~walks: [w_a, w_b], ~sets: [w_a, w_b]),
          // which is why the table keeps both
          beat(~over: optimization ++ definition ++ differ,
               ~walks: [w_a, w_b], ~sets: [w_a, w_b]),
          // Then the one change that settles it: nothing reads that value, so the
          // write need not return it -- and with it gone the two sets are one set.
          beat(~written: #true, ~over: optimization ++ definition ++ differ,
               ~walks: [w_a, w_b], ~sets: [w_a, w_b]),
          beat(~written: #true, ~over: optimization ++ definition ++ same,
               ~walks: [w_a, w_b], ~sets: [w_a, w_b]),
          // so one walk will do, and the classes both of them reached -- the memory
          // the writes leave, and the root that reads it -- are one colour again
          beat(~fills: one_fills, ~written: #true,
               ~over: optimization ++ definition ++ same, ~walks: [w_a], ~sets: [w_a]),
          // and, of that class, the answer to the bad news: the number stays small
          beat(~fills: one_fills, ~written: #true,
               ~over: optimization ++ definition ++ same ++ few,
               ~walks: [w_a], ~sets: [w_a]),
          // which is what kind of answer this whole section is
          beat(~fills: one_fills, ~written: #true,
               ~over: optimization ++ definition ++ same ++ few ++ parameterized,
               ~walks: [w_a], ~sets: [w_a])],
         dp_titled(collapse_title))],
    ~stage: blob_stage, ~stage_band: band_below)


// -------------------------------------------------------------------------------------
// slide_give_up: the worst case beside the graph a compiler sees.
//
// The section before this one ends on the bad news, and the answer to it is that the
// graphs the hardness lives in are not the graphs anyone compiles. On the left, a
// tangle: state walks that fork and meet, fork and meet, all the way down, through a
// crowd of writes reaching back up to the inputs. On the right, the graph the last
// section actually built -- and the term that should come out of it, lit up to say
// that it is not hard to see. Then the left goes and the right moves into the middle
// of the slide, which is where the algorithm's slide has it: that slide is cut to from
// this one.
def give_up_title = "Give Up?"

fun slide_give_up():
  def here = dp_titled(give_up_title)
  def there = dp_titled(dp_title)
  // Where the two of them stand. The graph keeps the size it has on the slide after
  // this one and only moves, so the press between the two slides is a move and not a
  // second drawing of the same picture.
  def split_x = 900.0
  def said_y = 986.0
  def right_shift = [332.0, -70.0]
  def right_spots :~ Map:
    for values(m :~ Map = {}) (key in (away :~ Map).keys()):
      def [x, y] = (away :~ Map)[key] :~ List
      m ++ { key: [x + (right_shift[0] :~ Real), y + (right_shift[1] :~ Real)] }
  def right_graph = picts_at(right_spots, {}) ++ regions_at(right_spots)
  def right_cx:
    def [x0, _, x1, _] = dp_graph_box
    ((x0 :~ Real) + (x1 :~ Real)) / 2 + (right_shift[0] :~ Real)

  fun verdict(s :: String, color) :: pc.Pict:
    prose_text(s, ~size: 46.0, ~bold: #true, ~color: color, ~arrive: #'pop)
  def said_left = verdict("Worst Case E-Graph", talk_red)
  def said_right = verdict("Realistic E-Graph", talk_green)
  // The tangle, as pieces rather than as one finished drawing: every node of it
  // writes on the press that brings it and every arrow draws itself, the way the
  // graph beside it does.
  def [proof_picts :: Map, proof_edges :: List]:
    chaos_parts(~at: [40.0, 200.0], ~width: split_x - 80.0, ~height: 740.0)
  // the term extraction should find, lit on the graph where it stands
  def right_lit = right_graph ++ green_at(right_spots, dp_answer)
  def sat = { #'sat: [said_left, (split_x - said_left.width) / 2, said_y, band_above] }
  def real = { #'real: [said_right, right_cx - said_right.width / 2, said_y, band_above] }
  def rule:
    { #'rule: [pc.rectangle(~width: 3.0, ~height: 800.0,
                            ~fill: draw.Color(190, 190, 190), ~line: #false),
               split_x, 190.0, band_below] }

  // one wire for both halves: the tangle's own arrows, and the graph's
  fun wire(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
    def rest = for List (e :~ List in es): skip_when e[0] == #'chaos_edge; e
    chain_wire_specs(chaos_wire(layer, es, at), rest, at)
  magic_slide(
    dp_page,
    [// the title, and nothing else yet
     Frame(~picts: here),
     // the tangle
     Frame(~picts: here ++ proof_picts, ~edges: proof_edges),
     // which is what that graph is, said in red under it
     Frame(~picts: here ++ proof_picts ++ sat, ~edges: proof_edges),
     // and beside it, the graph the section before this one built
     Frame(~picts: here ++ proof_picts ++ sat ++ rule ++ right_graph,
           ~edges: proof_edges ++ chain_edges(4)),
     // which is what *that* graph is
     Frame(~picts: here ++ proof_picts ++ sat ++ rule ++ right_graph ++ real,
           ~edges: proof_edges ++ chain_edges(4)),
     // and the term that should come out of it, lit along with the walk that finds
     // it: not hard to see. Then the light goes, so that what moves is the graph.
     Frame(~picts: here ++ proof_picts ++ sat ++ rule ++ right_lit ++ real,
           ~edges: proof_edges ++ chain_edges(4) ++ walk_edges(r_best)),
     Frame(~picts: here ++ proof_picts ++ sat ++ rule ++ right_graph ++ real,
           ~edges: proof_edges ++ chain_edges(4)),
     // and then the left goes and the right moves into the middle, under the title the
     // slide after this one carries
     Frame(~picts: there ++ dp_graph_frame.picts, ~edges: dp_graph_frame.edges)],
    ~wire: wire, ~edge_band: band_wires)
