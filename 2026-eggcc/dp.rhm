#lang rhombus/and_meta
// slide_dp: the statewalk DP algorithm run on the `update` example.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "codebox.rhm" open
  "egraph.rhm" open
  "chain.rhm" open
  "apply.rhm" open
  pict as pc
  draw

export:
  slide_dp

// The two branches out of the argument state, as colours. Two hues and not two
// strengths of one: they are two different walks, not more and less of the same
// thing. The lighter is also the shorter, and the gap in lightness is what makes
// them two colours under any colour vision -- and in a handout printed grey.
def branch_a_fill = "BFE4E0"                  // through the write the rule added
def branch_b_fill = "9C82C8"                  // through both of the program's writes
def branch_seed_fill = "DCDCE4"               // and the walk that is only the state
def blob_a = "D7EEEB"
def blob_b = "CFC2E8"
def blob_seed = "EAEAF0"
// and the walk itself, which is a line laid over its own mass and so has to be the
// strong end of the same hue rather than the pale one
def walk_a_line = "17786E"
def walk_b_line = "553C93"
def walk_seed_line = "6E6E82"

// -------------------------------------------------------------------------------------
// The algorithm, on the example the section before this one was about.
//
// The slide is organised around the question the table asks, not around the order it
// fills in: point at an e-class, and ask what statewalks reach it and what each of
// them puts within reach. Most classes have one answer. The class where the two
// writes meet has two, and the two are not the same, which is why the table cannot
// keep just one of them -- and that is the whole slide.
fun slide_dp():
  def canvas = titled("The Statewalk DP Algorithm")
  def parts = code_parts()
  def rows :~ List = chain_statewalks()

  // ------------------------------------------------------------ where the graph goes
  // The same graph, moved into the middle of the slide once the code box has gone,
  // and grown by as much as the height allows. Not stretched: the columns keep the
  // spacing the layout solved for, the picture just takes the room the code had.
  fun node_size(key) :: List:
    def w = (chain_box :~ Map)[key] :~ Real
    [w, if w > 100 | 64.0 | 63.486]
  def home_box:
    for values(b :~ List = [1.0e9, 1.0e9, -1.0e9, -1.0e9]) (key in chain_spots.keys()):
      def [x, y] = (chain_spots :~ Map)[key] :~ List
      def [w, h] = node_size(key)
      [math.min(b[0], x), math.min(b[1], y),
       math.max(b[2], x + w), math.max(b[3], y + h)]
  def dp_top = 216.0
  def dp_bottom = 1032.0
  def dp_scale:
    math.min(1.25, (dp_bottom - dp_top) / ((home_box[3] :~ Real) - (home_box[1] :~ Real)))
  def dp_left:
    (slide_width - ((home_box[2] :~ Real) - (home_box[0] :~ Real)) * dp_scale) / 2
  fun moved(spots :~ Map) :: Map:
    for values(m :~ Map = {}) (key in spots.keys()):
      def [x, y] = spots[key] :~ List
      m ++ { key: [dp_left + (x - (home_box[0] :~ Real)) * dp_scale,
                   dp_top + (y - (home_box[1] :~ Real)) * dp_scale] }
  def away :~ Map = moved(chain_spots)
  fun middle(spots :~ Map, key) :: List:
    def [x, y] = spots[key] :~ List
    def [w, h] = node_size(key)
    [x + w * dp_scale / 2, y + h * dp_scale / 2]

  // The classes the rule made, drawn wherever the graph is: `v1 ≡ v3` and `ω2 ≡ ω3`
  // are the reason any of this is hard, and a slide about which class holds which
  // walk cannot be one that has stopped drawing the classes.
  fun regions_at(spots :~ Map) :: Map:
    fun tube(from, to, dash):
      def r :~ List = eclass_region(middle(spots, from), middle(spots, to), ~dash: dash)
      [r[0], r[1], r[2], band_below]
    { #'old_class: tube(#'v1, #'v3, value_class),
      #'memory_class: tube(#'s3, #'s2, state_class) }

  fun picts_at(spots :~ Map, fills :~ Map, ~scale: k :: Real = dp_scale) :: Map:
    def nodes :~ Map = chain_nodes(~fills: fills)
    for values(m :~ Map = {}) (key in spots.keys()):
      def [x, y] = spots[key] :~ List
      m ++ { key: [as_pict(nodes[key]).scale(k), x, y] }
  fun green_at(spots :~ Map, term :~ List) :: Map:
    def nodes :~ Map = chain_nodes(~picked: term)
    for values(m :~ Map = {}) (key in term):
      def [x, y] = spots[key] :~ List
      m ++ { key: [as_pict(nodes[key]).scale(dp_scale), x, y] }

  // ------------------------------------------------------------------ the two walks
  // Which way out of the argument state a walk went. That is what the colours are
  // about, so it is one function and everything else reads it.
  fun branch(walk :~ List):
    cond
    | walk.length() < 2: #'seed
    | walk[1] == #'us: #'a
    | ~else: #'b
  fun branch_fill(b) :: String:
    match b
    | #'a: branch_a_fill
    | #'b: branch_b_fill
    | ~else: branch_seed_fill
  fun branch_blob(b) :: String:
    match b
    | #'a: blob_a
    | #'b: blob_b
    | ~else: blob_seed
  fun branch_line(b) :: String:
    match b
    | #'a: walk_a_line
    | #'b: walk_b_line
    | ~else: walk_seed_line

  fun row_where(cls, b) :: List:
    for values(found :~ List = []) (row :~ List in rows):
      if row[0] == cls && branch(row[2] :~ List) == b | row | found
  def r_seed = rows[0]
  def r_a = row_where(chain_class_of[#'s3], #'a)      // the state the two writes meet in
  def r_b = row_where(chain_class_of[#'s3], #'b)
  def r_root_a = row_where(chain_root, #'a)
  def r_root_b = row_where(chain_root, #'b)
  def r_best = chain_dp_best()

  // every row the table has written by the time a walk has been followed: the walks
  // that are a prefix of it are the ones it was built out of
  fun rows_along(walk :~ List) :: List:
    for List (row :~ List in rows):
      def w :~ List = row[2]
      keep_when w.length() <= walk.length()
        && (for values(all = #true) (i in 0..w.length()): all && w[i] == walk[i])
      row
  fun fills_of(shown :~ List) :: Map:
    def by_class:
      for values(m :~ Map = {}) (row :~ List in shown):
        def c = row[0]
        def col = branch_fill(branch(row[2] :~ List))
        def had :~ List = if m.has_key(c) | m[c] | []
        if had.contains(col) | m | m ++ { c: had ++ [col] }
    for values(m :~ Map = {}) ([key, c, _] in chain_graph :~ List):
      if by_class.has_key(c) | m ++ { key: by_class[c] } | m
  // the walk of one row, as edges, in its branch's colour
  fun walk_edges(row :~ List) :: List:
    def walk :~ List = row[2]
    def hue = branch_line(branch(walk))
    for List (j in 0..walk.length() - 1): [#'walk, walk[j + 1], walk[j], hue]

  // ---------------------------------------------------------- what a walk can build
  // The extractable set, as one mass: the walk's own terms, and every node of every
  // class the walk puts within reach. Classes and not representatives, because the
  // set *is* a set of classes -- which is also what makes the point of the slide
  // visible, since the two walks that meet reach the same classes but for one, and
  // two masses that differ by one lobe say that where two masses of different shapes
  // would not.
  //
  // They are joined by the graph's own edges between covered nodes, and by a neck
  // between members of one class. The layout keeps an edge from passing behind a box
  // it does not end at, so a neck along one cannot swallow a node not in the set.
  def blob_pad = 18.0
  def blob_neck = 34.0
  fun blob_nodes(row :~ List) :: List:
    def walk :~ List = row[2]
    for values(acc :~ List = walk) ([key, c, _] in chain_graph :~ List):
      if (row[1] :~ List).contains(c) && !acc.contains(key) | acc ++ [key] | acc
  fun blob_links(row :~ List) :: List:
    def covered :~ List = blob_nodes(row)
    def args :~ Map = chain_args_of(chain_graph)
    def down:
      for values(acc :~ List = []) (key in covered):
        for values(acc :~ List = acc) (a in args[key] :~ List):
          for values(acc :~ List = acc) ([k2, c2, _] in chain_graph :~ List):
            if c2 == a && covered.contains(k2) | acc ++ [[key, k2]] | acc
    // and the members of one class to each other, which is the one join the graph
    // has no edge for
    for values(acc :~ List = down) ([k1, c1, _] in chain_graph :~ List):
      for values(acc :~ List = acc) ([k2, c2, _] in chain_graph :~ List):
        if c1 == c2 && k1 != k2 && covered.contains(k1) && covered.contains(k2)
        | acc ++ [[k1, k2]]
        | acc
  fun blob_marks(row :~ List) :: List:
    [[#'bhue, branch_blob(branch(row[2] :~ List))]]
      ++ (for List (k in blob_nodes(row)): [#'blob, k])
      ++ (for List ([f, t] in blob_links(row)): [#'blink, f, t])

  fun smooth(u :: Real) :: Real:
    def v = math.max(0.0, math.min(1.0, u))
    v * v * (3.0 - 2.0 * v)
  fun marks_of(f :: Frame, tag) :: List:
    for List (e :~ List in f.edges): keep_when e[0] == tag; e.rest
  fun hue_of(f :: Frame, fallback :: String) :: String:
    for values(h :: String = fallback) (e :~ List in f.edges):
      if e[0] == #'bhue | (e[1] :~ String) | h

  // The mass is drawn by the press rather than by either frame, because what has to
  // happen between two presses is that it *grows*: a shape that arrives as a second
  // pict can only dissolve into place. Each piece new to this press swells from
  // nothing, and the ones further from the mass that is already there start later, so
  // it runs outwards from the walk instead of blinking on all at once.
  fun blob_stage(layer :: pc.Pict, a :: Frame, b :: Frame, t :: Real) :: pc.Pict:
    def was :~ List = for List (m :~ List in marks_of(a, #'blob)): m[0]
    def now :~ List = for List (m :~ List in marks_of(b, #'blob)): m[0]
    def links :~ List = if now == [] | marks_of(a, #'blink) | marks_of(b, #'blink)
    def hue = hue_of(b, hue_of(a, blob_seed))
    fun reach_dist(key) :: Real:
      def [cx, cy] = middle(away, key)
      for values(d :~ Real = 1.0e9) (o in was):
        def [ox, oy] = middle(away, o)
        math.min(d, math.sqrt((cx - ox) * (cx - ox) + (cy - oy) * (cy - oy)))
    def coming :~ List: for List (k in now): keep_when !was.contains(k); k
    def far: for values(m :~ Real = 1.0) (k in coming): math.max(m, reach_dist(k))
    def size :~ Map:
      for values(m :~ Map = {}) (key in now ++ was):
        def f:
          cond
          | was.contains(key) && now.contains(key): 1.0
          | now.contains(key):
              def start = 0.5 * (if far > 0.0 | reach_dist(key) / far | 0.0)
              smooth((t - start) / math.max(0.05, 1.0 - start))
          | ~else: smooth(1.0 - t)
        m ++ { key: f }
    fun at(key) :: Real: if size.has_key(key) | (size[key] :~ Real) | 0.0
    pc.dc(fun (target :: draw.DC, dx, dy):
            target.save()
            target.brush := draw.Brush(~color: hex_color(hue))
            // the necks first, so a node's own blob is drawn over where they meet it
            target.pen := draw.Pen(~color: hex_color(hue), ~width: blob_neck * dp_scale,
                                   ~cap: #'round, ~join: #'round)
            for ([f, tk] in links):
              def anchor = if at(f) >= at(tk) | f | tk
              def other = if anchor == f | tk | f
              def u = math.min(at(f), at(tk))
              skip_when u <= 0.02
              def [ax, ay] = middle(away, anchor)
              def [ox, oy] = middle(away, other)
              def path = draw.Path()
              path.move_to([dx + ax, dy + ay])
              path.line_to([dx + ax + (ox - ax) * u, dy + ay + (oy - ay) * u])
              target.path(path)
            target.pen := draw.Pen(~color: hex_color(hue), ~width: 0, ~cap: #'round)
            for (key in size.keys()):
              def f = (size[key] :~ Real)
              skip_when f <= 0.02
              def [cx, cy] = middle(away, key)
              def [w, h] = node_size(key)
              def bw = (w + 2 * blob_pad) * dp_scale * f
              def bh = (h + 2 * blob_pad) * dp_scale * f
              def path = draw.Path()
              path.rounded_rectangle([dx + cx - bw / 2, dy + cy - bh / 2, bw, bh],
                                     math.min(bw, bh) * 0.45)
              target.path(path)
            target.restore(),
          ~width: slide_width, ~height: slide_height)

  // ------------------------------------------------------------------- naming it
  fun reach_bubble(row :~ List) :: Map:
    def box:
      for values(b :~ List = [1.0e9, 1.0e9, -1.0e9, -1.0e9]) (key in blob_nodes(row)):
        def [x, y] = (away :~ Map)[key] :~ List
        def [w, h] = node_size(key)
        [math.min(b[0], x - blob_pad * dp_scale),
         math.min(b[1], y - blob_pad * dp_scale),
         math.max(b[2], x + (w + blob_pad) * dp_scale),
         math.max(b[3], y + (h + blob_pad) * dp_scale)]
    def ghost:
      pc.blank(~width: (box[2] :~ Real) - (box[0] :~ Real),
               ~height: (box[3] :~ Real) - (box[1] :~ Real))
    { #'reach: [bubble_at(ghost, ~spot: [box[0], box[1]],
                          ~body: [120.0, 286.0], ~color: talk_blue,
                          ~content: prose([["extractable set", #'bold]])),
                0.0, 0.0, band_callout] }

  // --------------------------------------------------------------------- the presses
  // A beat is: what the table has stored so far, and which walk we are pointing at.
  fun beat(shown :~ List, ~walk: walk = #false, ~name: name :: Boolean = #false) :: Frame:
    Frame(~picts: picts_at(away, fills_of(shown)) ++ regions_at(away)
                    ++ (if name | reach_bubble(walk :~ List) | {}),
          ~edges: chain_edges(4)
                    ++ (if walk == #false
                        | []
                        | walk_edges(walk :~ List) ++ blob_marks(walk :~ List)))
  def after_a = rows_along(r_a[2] :~ List)
  def after_b = after_a ++ rows_along(r_b[2] :~ List)
  def after_root = after_b ++ rows_along(r_root_a[2] :~ List)
                     ++ rows_along(r_root_b[2] :~ List)

  // Where the answer goes once it is on its own. Placed by hand: the graph puts the
  // two members of the value class at opposite ends of a row, and an answer that
  // takes the far one has its `return` reaching back across the state it also takes,
  // straight through that node's label. Nine nodes on their own can be a tree.
  def term_spots:
    { #'x: [905.0, 250.0], #'one: [1065.0, 250.0],
      #'a: [720.0, 400.0], #'xp: [930.0, 400.0], #'s0: [1170.0, 400.0],
      #'us: [865.0, 560.0],
      #'v3: [790.0, 720.0], #'s3: [1030.0, 720.0],
      #'ret: [865.0, 880.0] }
  fun term_edges(term :~ List) :: List:
    def taken:
      for values(m :~ Map = {}) ([key, c, _] in chain_graph :~ List):
        if term.contains(key) | m ++ { c: key } | m
    for List (e :~ List in chain_edges(4)):
      keep_when term.contains(e[1])
      def c = chain_class_of[e[2]]
      keep_when taken.has_key(c)
      [e[0], e[1], taken[c]]
  def answer = chain_dp_term(r_best)

  chain_slide(
    as_pict(canvas),
    [// where the last slide left it: the program, the rule, and the graph
     Frame(~picts: picts_at(chain_spots, {}, ~scale: 1.0) ++ regions_at(chain_spots)
                     ++ { #'code: [code_pict(parts, ~states: #true),
                                   code_x, code_y, band_below] }
                     ++ chain_rule_over(parts, ~value: #true),
           ~edges: chain_edges(4)),
     // and then the graph has the slide to itself
     Frame(~picts: picts_at(away, {}) ++ regions_at(away), ~edges: chain_edges(4)),
     // The walk that is nothing but the argument state, and what it puts within
     // reach -- which is the idea the rest of the slide is made of, so it gets a
     // press of its own and a name.
     beat([r_seed], ~walk: r_seed, ~name: #true),
     // The class where the two writes meet, by way of the write the rule added...
     beat(after_a, ~walk: r_a),
     // ...and by way of both of the program's own writes. Same class, longer walk,
     // and one more thing within reach: the value the second write returns, which
     // only a walk that performs that write can have.
     beat(after_b, ~walk: r_b),
     // So the table keeps both. Half one colour and half the other is a class it
     // could not merge.
     beat(after_b),
     // The root is the same story, and it is the one that matters: two walks reach
     // it, so there are two answers to choose between.
     beat(after_root),
     // The cheaper of them, and the term it stands for. The value the `return` takes
     // is the one this walk's write returned -- on this walk there is no other.
     Frame(~picts: picts_at(away, fills_of(after_root)) ++ regions_at(away)
                     ++ green_at(away, answer),
           ~edges: chain_edges(4) ++ walk_edges(r_best)),
     // and then just that term, laid out as the tree it is
     Frame(~picts: green_at(term_spots, answer), ~edges: term_edges(answer))],
    ~stage: blob_stage, ~stage_band: band_below)
