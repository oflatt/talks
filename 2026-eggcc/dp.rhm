#lang rhombus/and_meta
// slide_dp: the statewalk DP algorithm run on the `update` example.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "codebox.rhm" open
  "egraph.rhm" open
  "chain.rhm" open
  "apply.rhm" open
  pict as pc
  draw

export:
  slide_dp
  dp_title

// The two branches out of the argument state, as colours. Two hues and not two
// strengths of one: they are two different walks, not more and less of the same
// thing. The lighter is also the shorter, and the gap in lightness is what makes
// them two colours under any colour vision -- and in a handout printed grey.
def branch_a_fill = "BFE4E0"                  // through the write the rule added
def branch_b_fill = "9C82C8"                  // through both of the program's writes
def branch_seed_fill = "DCDCE4"               // and the walk that is only the state
// A walk's extractable set is laid in the walk's own colour at half strength, each
// set one flat layer: where two sets overlap the two colours mix, and where only one
// reaches, its colour shows alone -- so which set is drawn first does not matter,
// and a press that grows one under the other lands on the picture the frame after
// it draws.
def blob_alpha = 0.5
// and the walk itself, which is a line laid over its own mass and so has to be the
// strong end of the same hue rather than the pale one
def walk_a_line = "17786E"
def walk_b_line = "553C93"
def walk_seed_line = "6E6E82"

// -------------------------------------------------------------------------------------
// The algorithm, on the example the section before this one was about.
//
// The slide is organised around the question the table asks, not around the order it
// fills in: point at an e-class, and ask what statewalks reach it and what each of
// them puts within reach. Most classes have one answer. The class where the two
// writes meet has two, and the two are not the same, which is why the table cannot
// keep just one of them -- and that is the whole slide.
// the title, named once: the divider before this slide writes it as its outline
// goes up, and reads it from here
def dp_title = "The Statewalk DP Algorithm"
fun slide_dp():
  def canvas = titled(dp_title, ~tag: "Statewalk DP title", ~nudge: [0.0, 0.0])
  def rows :~ List = chain_statewalks()

  // ------------------------------------------------------------ where the graph goes
  // The same graph, moved into the middle of the slide once the code box has gone,
  // and grown by as much as the height allows. Not stretched: the columns keep the
  // spacing the layout solved for, the picture just takes the room the code had.
  fun node_size(key) :: List:
    def w = (chain_box :~ Map)[key] :~ Real
    [w, if w > 100 | 64.0 | 63.486]
  def home_box:
    for values(b :~ List = [1.0e9, 1.0e9, -1.0e9, -1.0e9]) (key in chain_spots.keys()):
      def [x, y] = (chain_spots :~ Map)[key] :~ List
      def [w, h] = node_size(key)
      [math.min(b[0], x), math.min(b[1], y),
       math.max(b[2], x + w), math.max(b[3], y + h)]
  def dp_top = 216.0
  def dp_bottom = 1032.0
  def dp_scale:
    math.min(1.25, (dp_bottom - dp_top) / ((home_box[3] :~ Real) - (home_box[1] :~ Real)))
  def dp_left:
    (slide_width - ((home_box[2] :~ Real) - (home_box[0] :~ Real)) * dp_scale) / 2
  fun moved(spots :~ Map) :: Map:
    for values(m :~ Map = {}) (key in spots.keys()):
      def [x, y] = spots[key] :~ List
      m ++ { key: [dp_left + (x - (home_box[0] :~ Real)) * dp_scale,
                   dp_top + (y - (home_box[1] :~ Real)) * dp_scale] }
  def away :~ Map = moved(chain_spots)
  fun middle(spots :~ Map, key) :: List:
    def [x, y] = spots[key] :~ List
    def [w, h] = node_size(key)
    [x + w * dp_scale / 2, y + h * dp_scale / 2]

  // The classes the rule made, drawn wherever the graph is: `v1 ≡ v3` and `ω2 ≡ ω3`
  // are the reason any of this is hard, and a slide about which class holds which
  // walk cannot be one that has stopped drawing the classes.
  fun regions_at(spots :~ Map) :: Map:
    fun tube(from, to, dash):
      def r :~ List = eclass_region(middle(spots, from), middle(spots, to), ~dash: dash)
      [r[0], r[1], r[2], band_below]
    { #'old_class: tube(#'v1, #'v3, value_class),
      #'memory_class: tube(#'s3, #'s2, state_class) }

  fun picts_at(spots :~ Map, fills :~ Map, ~scale: k :: Real = dp_scale) :: Map:
    def nodes :~ Map = chain_nodes(~fills: fills)
    for values(m :~ Map = {}) (key in spots.keys()):
      def [x, y] = spots[key] :~ List
      m ++ { key: [as_pict(nodes[key]).scale(k), x, y] }
  fun green_at(spots :~ Map, term :~ List) :: Map:
    def nodes :~ Map = chain_nodes(~picked: term)
    for values(m :~ Map = {}) (key in term):
      def [x, y] = spots[key] :~ List
      m ++ { key: [as_pict(nodes[key]).scale(dp_scale), x, y] }

  // ------------------------------------------------------------------ the two walks
  // Which way out of the argument state a walk went. That is what the colours are
  // about, so it is one function and everything else reads it.
  fun branch(walk :~ List):
    cond
    | walk.length() < 2: #'seed
    | walk[1] == #'us: #'a
    | ~else: #'b
  fun branch_fill(b) :: String:
    match b
    | #'a: branch_a_fill
    | #'b: branch_b_fill
    | ~else: branch_seed_fill
  fun branch_blob(b) :: String: branch_fill(b)
  fun branch_line(b) :: String:
    match b
    | #'a: walk_a_line
    | #'b: walk_b_line
    | ~else: walk_seed_line

  fun row_where(cls, b) :: List:
    for values(found :~ List = []) (row :~ List in rows):
      if row[0] == cls && branch(row[2] :~ List) == b | row | found
  def r_seed = rows[0]
  def r_a = row_where(chain_class_of[#'s3], #'a)      // the state the two writes meet in
  def r_b = row_where(chain_class_of[#'s3], #'b)
  def r_root_a = row_where(chain_root, #'a)
  def r_root_b = row_where(chain_root, #'b)
  def r_best = chain_dp_best()

  // every row the table has written by the time a walk has been followed: the walks
  // that are a prefix of it are the ones it was built out of
  fun rows_along(walk :~ List) :: List:
    for List (row :~ List in rows):
      def w :~ List = row[2]
      keep_when w.length() <= walk.length()
        && (for values(all = #true) (i in 0..w.length()): all && w[i] == walk[i])
      row
  fun fills_of(shown :~ List) :: Map:
    def by_class:
      for values(m :~ Map = {}) (row :~ List in shown):
        def c = row[0]
        def col = branch_fill(branch(row[2] :~ List))
        def had :~ List = if m.has_key(c) | m[c] | []
        if had.contains(col) | m | m ++ { c: had ++ [col] }
    for values(m :~ Map = {}) ([key, c, _] in chain_graph :~ List):
      if by_class.has_key(c) | m ++ { key: by_class[c] } | m
  // the walk of one row, as edges, in its branch's colour
  fun walk_edges(row :~ List) :: List:
    def walk :~ List = row[2]
    def hue = branch_line(branch(walk))
    for List (j in 0..walk.length() - 1): [#'walk, walk[j + 1], walk[j], hue]

  // ---------------------------------------------------------- what a walk can build
  // The extractable set, as one mass: the walk's own terms, and every node of every
  // class the walk puts within reach. Classes and not representatives, because the
  // set *is* a set of classes -- which is also what makes the point of the slide
  // visible, since the two walks that meet reach the same classes but for one, and
  // two masses that differ by one lobe say that where two masses of different shapes
  // would not.
  //
  // They are joined by the graph's own edges between covered nodes, and by a neck
  // between members of one class. The layout keeps an edge from passing behind a box
  // it does not end at, so a neck along one cannot swallow a node not in the set.
  def blob_pad = 18.0
  def blob_neck = 34.0
  fun blob_nodes(row :~ List) :: List:
    def walk :~ List = row[2]
    for values(acc :~ List = walk) ([key, c, _] in chain_graph :~ List):
      if (row[1] :~ List).contains(c) && !acc.contains(key) | acc ++ [key] | acc
  fun blob_links(row :~ List) :: List:
    def covered :~ List = blob_nodes(row)
    def args :~ Map = chain_args_of(chain_graph)
    def down:
      for values(acc :~ List = []) (key in covered):
        for values(acc :~ List = acc) (a in args[key] :~ List):
          for values(acc :~ List = acc) ([k2, c2, _] in chain_graph :~ List):
            if c2 == a && covered.contains(k2) | acc ++ [[key, k2]] | acc
    // and the members of one class to each other, which is the one join the graph
    // has no edge for
    for values(acc :~ List = down) ([k1, c1, _] in chain_graph :~ List):
      for values(acc :~ List = acc) ([k2, c2, _] in chain_graph :~ List):
        if c1 == c2 && k1 != k2 && covered.contains(k1) && covered.contains(k2)
        | acc ++ [[k1, k2]]
        | acc
  // A mass carries its own colour, so that one press can show two of them: the set
  // the table already had and the set the walk that just arrived reaches. The two
  // are nested, and each is laid at half strength, so where both reach the colours
  // mix and where only the bigger does its own colour shows -- which is the whole
  // difference between the two entries, and the reason both are kept.
  fun blob_marks(row :~ List) :: List:
    def hue = branch_blob(branch(row[2] :~ List))
    (for List (k in blob_nodes(row)): [#'blob, k, hue])
      ++ (for List ([f, t] in blob_links(row)): [#'blink, f, t, hue])

  fun smooth(u :: Real) :: Real:
    def v = math.max(0.0, math.min(1.0, u))
    v * v * (3.0 - 2.0 * v)
  fun marks_of(f :: Frame, tag) :: List:
    for List (e :~ List in f.edges): keep_when e[0] == tag; e.rest
  // the masses a frame shows, in the order they are to be drawn
  fun hues_of(f :: Frame) :: List:
    for values(acc :~ List = []) (m :~ List in marks_of(f, #'blob)):
      if acc.contains(m[1]) | acc | acc ++ [m[1]]

  // The mass is drawn by the press rather than by either frame, because what has to
  // happen between two presses is that it *grows*: a shape that arrives as a second
  // pict can only dissolve into place. Each piece new to this press swells from
  // nothing, and the ones further from the mass that is already there start later, so
  // it runs outwards from the walk instead of blinking on all at once.
  fun blob_stage(layer :: pc.Pict, a :: Frame, b :: Frame, t :: Real) :: pc.Pict:
    // a piece of a mass is a colour and a node, so that two masses can be in flight
    // at once without either one's growth being confused for the other's
    def was :~ List = for List (m :~ List in marks_of(a, #'blob)): [m[1], m[0]]
    def now :~ List = for List (m :~ List in marks_of(b, #'blob)): [m[1], m[0]]
    def links :~ List = marks_of(a, #'blink) ++ marks_of(b, #'blink)
    fun reach_dist(item :~ List) :: Real:
      def [cx, cy] = middle(away, item[1])
      for values(d :~ Real = 1.0e9) (o :~ List in was):
        def [ox, oy] = middle(away, o[1])
        math.min(d, math.sqrt((cx - ox) * (cx - ox) + (cy - oy) * (cy - oy)))
    def coming :~ List: for List (k in now): keep_when !was.contains(k); k
    def far: for values(m :~ Real = 1.0) (k in coming): math.max(m, reach_dist(k))
    def size :~ Map:
      for values(m :~ Map = {}) (item in now ++ was):
        def f:
          cond
          | was.contains(item) && now.contains(item): 1.0
          | now.contains(item):
              def start = 0.5 * (if far > 0.0 | reach_dist(item :~ List) / far | 0.0)
              smooth((t - start) / math.max(0.05, 1.0 - start))
          | ~else: smooth(1.0 - t)
        m ++ { item: f }
    fun at(hue, key) :: Real:
      if size.has_key([hue, key]) | (size[[hue, key]] :~ Real) | 0.0
    // the frame this press lands on says the order, so the press ends on the picture
    // the still after it draws; a set on its way out goes after them
    def order :~ List:
      for values(acc :~ List = hues_of(b)) (h in hues_of(a)):
        if acc.contains(h) | acc | acc ++ [h]
    // one set, as a flat mass in its own colour: its pieces drawn opaque, so that
    // where they overlap each other is no darker, and the whole faded once
    fun mass_of(hue) :: pc.Pict:
      pc.dc(fun (target :: draw.DC, dx, dy):
              target.save()
              target.brush := draw.Brush(~color: hex_color(hue))
              // the necks first, so a node's own blob is drawn over where they meet
              target.pen := draw.Pen(~color: hex_color(hue),
                                     ~width: blob_neck * dp_scale,
                                     ~cap: #'round, ~join: #'round)
              for ([f, tk, h] in links):
                skip_when h != hue
                def anchor = if at(hue, f) >= at(hue, tk) | f | tk
                def other = if anchor == f | tk | f
                def u = math.min(at(hue, f), at(hue, tk))
                skip_when u <= 0.02
                def [ax, ay] = middle(away, anchor)
                def [ox, oy] = middle(away, other)
                def path = draw.Path()
                path.move_to([dx + ax, dy + ay])
                path.line_to([dx + ax + (ox - ax) * u, dy + ay + (oy - ay) * u])
                target.path(path)
              target.pen := draw.Pen(~color: hex_color(hue), ~width: 0, ~cap: #'round)
              for (item :~ List in size.keys()):
                skip_when item[0] != hue
                def f = (size[item] :~ Real)
                skip_when f <= 0.02
                def [cx, cy] = middle(away, item[1])
                def [w, h] = node_size(item[1])
                def bw = (w + 2 * blob_pad) * dp_scale * f
                def bh = (h + 2 * blob_pad) * dp_scale * f
                def path = draw.Path()
                path.rounded_rectangle([dx + cx - bw / 2, dy + cy - bh / 2, bw, bh],
                                       math.min(bw, bh) * 0.45)
                target.path(path)
              target.restore(),
            ~width: slide_width, ~height: slide_height)
    for values(q :~ pc.Pict = layer) (hue in order):
      put(q, mass_of(hue).alpha(blob_alpha, ~composite: #true), 0.0, 0.0)

  // ------------------------------------------------------------------- the words
  // What the whole slide is an instance of, said first: in the margin left of the
  // graph, where the code box was, and up for the whole of the stepping, which is
  // read against it.
  def idea_at = [100.0, 300.0]
  def key_idea:
    def words:
      // Short lines rather than small ones: the margin is 500 wide.
      prose_stack([[["Key idea:", #'bold]],
                   [["keep ", #'plain], ["multiple", #'bold]],
                   [["statewalks", #'plain]],
                   [["per e-class", #'plain]]])
    // the face over the words, not beside them: the margin is taller than it is wide
    def content: robot_says(#'idea, words, ~sep: 12.0, ~above: #true, ~scale: 0.85)
    { #'idea: [make_bubble(~color: talk_green, ~padding: 24.0, content),
               idea_at[0], idea_at[1], band_callout] }
  // And the optimization on the key idea, said once the class that holds two walks
  // is up and before their sets are shown: not every walk that reaches a class is
  // worth keeping, only one per set. Right of the graph, level with the key idea,
  // and up for the rest of the slide like it.
  def distinct:
    def words:
      prose_stack([[["Optimization:", #'bold]],
                   [["collapse by unique", #'plain]],
                   [["extractable set", #'plain]]])
    { #'distinct: [make_bubble(~color: talk_green, ~padding: 24.0, words),
                   1440.0, 300.0, band_callout] }
  // What the whole slide is after, said at the return as soon as the graph is up: a
  // term out of the root class that one state walk reaches the whole of. It stays
  // up to the end, pointing at the return wherever the return stands -- which, for
  // the press that lays the answer out as a tree, is somewhere else.
  // The body stands in the corner left of the graph's last row, three short lines
  // so that it fits between the bubble about the width and the row's first state,
  // clear of the slide's bottom edge and of the bubbles on the right; for the tree,
  // whose return is over there, it stands on the right instead, in two lines.
  fun want_at(spots :~ Map, ~body: body :~ List = [530.0, 890.0],
              ~lines: lines :~ List = [[["Want:", #'bold]],
                                       [["extraction using", #'plain]],
                                       [["a single state walk", #'plain]]]) :: Map:
    def [rx, ry] = spots[#'ret] :~ List
    { #'want: [bubble_at(as_pict(chain_plain[#'ret]).scale(dp_scale), ~spot: [rx, ry],
                         ~body: body, ~color: talk_blue, ~content: prose_stack(lines)),
               0.0, 0.0, band_callout] }
  def want = want_at(away)
  // the three of them, for every frame after all are up
  def said = key_idea ++ distinct ++ want

  // The last word. The algorithm's cost is in the statewalk width `k` (paper,
  // Section 6): how many walks a class ends up holding, which on this graph is two,
  // for the class the two writes meet in -- so the bubble points at that class, the
  // one filled in both colours. The measured mean width across the benchmarks is
  // 33.15, which is the claim: the parameter the bound is in stays small. The bound
  // itself is left to the paper. It stands in the margin left of the graph, where
  // the key idea stood, and reaches across to the class.
  def in_practice:
    def words:
      prose_stack([[["statewalk width ", #'bold_italic], ["(", #'bold],
                    ["k", #'bold_italic], [")", #'bold]],
                   [["is low in practice!", #'bold]]])
    def [region, rx, ry, _] = (regions_at(away) :~ Map)[#'memory_class]
    { #'practice: [bubble_at(region, ~spot: [rx, ry], ~body: [120.0, 760.0],
                             ~color: talk_green,
                             ~content: robot_says(#'smile, words, ~sep: 12.0, ~above: #true,
                                                  ~scale: 0.85)),
                   0.0, 0.0, band_callout] }

  // --------------------------------------------------------------------- the presses
  // The pointer the other extractions use, on the class being considered. It stands
  // to the left of it, which is clear on this graph for every class a walk ends in
  // except two, and those two say where they want it.
  def point_w = 80.0
  def point_h = 80.0
  def dp_point_right = as_pict(pickaxe(~size: point_w))
  def dp_point_left = as_pict(pickaxe(~size: point_w, ~facing: #'left))
  // It stands to the left of the class it names, which is clear on this graph for
  // every one a walk ends in except the argument state -- `x+1` is in that lane, so
  // that one is pointed at from the other side.
  def point_side = { #'s0: #'right }
  // and the state the second walk ends in has the first walk's state right beside
  // it, in the one class, so the pickaxe stands left of that class as a whole
  def point_stand = { #'s2: #'s3 }
  fun pointer_at(key_in) :: Map:
    def key = if point_stand.has_key(key_in) | point_stand[key_in] | key_in
    def [x, y] = (away :~ Map)[key] :~ List
    def [w, h] = node_size(key)
    def right = point_side.has_key(key)
    { #'point: [(if right | dp_point_left | dp_point_right),
                (if right | x + w * dp_scale + 20.0 | x - point_w - 20.0),
                y + (h * dp_scale - point_h) / 2, band_above] }

  // One press per term the walk grows by, in the order a reader would try them:
  // everything the first write opens up, and then everything the second does, so
  // that the two arrive at the same class one after the other rather than
  // interleaved. The last of them is the point of the slide.
  def order:
    [[#'s0],
     [#'s0, #'us], [#'s0, #'us, #'s3],
     [#'s0, #'u1], [#'s0, #'u1, #'s1],
     [#'s0, #'u1, #'s1, #'u2], [#'s0, #'u1, #'s1, #'u2, #'s2]]
  fun row_for(walk :~ List) :: List:
    for values(found :~ List = []) (row :~ List in rows):
      if (row[2] :~ List) == walk | row | found
  // what the table holds once the first `n` of those have been taken
  fun stored(n :: Int) :: List:
    for values(acc :~ List = []) (i in 0..n):
      for values(acc :~ List = acc) (row :~ List in rows_along((order :~ List)[i] :~ List)):
        if acc.contains(row) | acc | acc ++ [row]

  // `~walks` are the rows whose walks are drawn along the graph's edges, and `~sets`
  // the rows whose extractable sets are drawn, in that order -- listed later is drawn
  // later. The stepping shows walks and the classes they fill; the sets come only
  // once there are two walks in one class to compare.
  fun beat(shown :~ List,
           ~walks: walks :~ List = [], ~sets: sets :~ List = [],
           ~point: point = #false,
           ~idea: idea :: Boolean = #false, ~distinct: told :: Boolean = #false) :: Frame:
    Frame(~picts: picts_at(away, fills_of(shown)) ++ regions_at(away) ++ want
                    ++ (if point == #false | {} | pointer_at(point))
                    ++ (if idea | key_idea | {})
                    ++ (if told | distinct | {}),
          ~edges: chain_edges(4)
                    ++ List.append(& for List (row :~ List in walks): walk_edges(row))
                    ++ List.append(& for List (row :~ List in sets): blob_marks(row)))
  fun step(i :: Int) :: Frame:
    def walk :~ List = (order :~ List)[i]
    beat(stored(i + 1), ~walks: [row_for(walk)], ~idea: #true,
         ~point: walk[walk.length() - 1])

  def w_root_a = [#'s0, #'us, #'s3, #'ret]
  def w_root_b = [#'s0, #'u1, #'s1, #'u2, #'s2, #'ret]
  def all_stored:
    def more = rows_along(w_root_a) ++ rows_along(w_root_b)
    for values(acc :~ List = stored((order :~ List).length())) (row :~ List in more):
      if acc.contains(row) | acc | acc ++ [row]

  // Where the answer goes once it is on its own. Placed by hand: the graph puts the
  // two members of the value class at opposite ends of a row, and an answer that
  // takes the far one has its `return` reaching back across the state it also takes,
  // straight through that node's label. Nine nodes on their own can be a tree.
  def term_spots:
    { #'x: [905.0, 250.0], #'one: [1065.0, 250.0],
      #'a: [720.0, 400.0], #'xp: [930.0, 400.0], #'s0: [1170.0, 400.0],
      #'us: [865.0, 560.0],
      #'v3: [790.0, 720.0], #'s3: [1030.0, 720.0],
      #'ret: [865.0, 880.0] }
  fun term_edges(term :~ List) :: List:
    def taken:
      for values(m :~ Map = {}) ([key, c, _] in chain_graph :~ List):
        if term.contains(key) | m ++ { c: key } | m
    for List (e :~ List in chain_edges(4)):
      keep_when term.contains(e[1])
      def c = chain_class_of[e[2]]
      keep_when taken.has_key(c)
      [e[0], e[1], taken[c]]
  def answer = chain_dp_term(r_best)

  // The last word of all: the kind of answer this is. A hard problem with a
  // parameter that stays small in practice is what a parameterized algorithm is for,
  // and this one is one. Right of the graph, under the bubble about distinct sets.
  def parameterized:
    def words:
      prose_stack([[["parameterized", #'bold_italic]],
                   [["algorithms", #'bold_italic]],
                   [["provide practical", #'plain]],
                   [["solutions to", #'plain]],
                   [["NP-hard problems", #'plain]]])
    // written out rather than popped: the last word of the section, said slowly
    { #'wand: [make_bubble(~color: talk_green, ~padding: 24.0, ~text: #'write,
                           pc.stack(~sep: 12.0, ~horiz: #'center, wand(~size: 110.0), words)),
               1440.0, 560.0, band_callout] }

  chain_slide(
    as_pict(canvas),
    [// the title the divider wrote, and nothing else yet: the show cuts to it
     Frame(),
     // the example's graph, written out in the middle of the slide with nothing
     // else on it: the program and the rule that made it were the section before
     Frame(~picts: picts_at(away, {}) ++ regions_at(away), ~edges: chain_edges(4)),
     // what is wanted of it, at the return
     Frame(~picts: picts_at(away, {}) ++ regions_at(away) ++ want, ~edges: chain_edges(4)),
     // the idea, to read the stepping against
     beat([], ~idea: #true),
     // the pickaxe, on the class the first walk ends in: extraction is what the
     // stepping is for
     beat([], ~idea: #true, ~point: #'us),
     // then the walks, one press per term the table grows by, each filling the
     // class it reaches in its colour: the write the rule added and the state it
     // leaves -- not the walk that is the argument state alone, a puzzle before it
     // is an example, though that row is in the table all the same -- then the
     // program's own first write, the state it leaves, its second write and the
     // state that leaves
     step(1), step(2), step(3), step(4), step(5), step(6),
     // That last state is a class the table already had a walk for, and the class is
     // now filled in both colours. The refinement of the idea, then; then the first
     // walk to reach that class again, with the set it reaches; then the set the
     // second reaches, drawn over it: the same, but for the one lobe, so the two are
     // not interchangeable and both are kept.
     beat(stored((order :~ List).length()),
          ~walks: [row_for((order :~ List)[6] :~ List)],
          ~point: #'s2, ~idea: #true, ~distinct: #true),
     beat(stored((order :~ List).length()),
          ~walks: [row_for((order :~ List)[6] :~ List), row_for((order :~ List)[2] :~ List)],
          ~sets: [row_for((order :~ List)[2] :~ List)],
          ~point: #'s3, ~idea: #true, ~distinct: #true),
     beat(stored((order :~ List).length()),
          ~walks: [row_for((order :~ List)[6] :~ List), row_for((order :~ List)[2] :~ List)],
          ~sets: [row_for((order :~ List)[6] :~ List), row_for((order :~ List)[2] :~ List)],
          ~point: #'s2, ~idea: #true, ~distinct: #true),
     // The root is reached both ways too, for the same reason, so there are two
     // answers to choose between. The two bubbles stay up from here to the end.
     beat(all_stored, ~point: #'ret, ~idea: #true, ~distinct: #true),
     // The cheaper of them, and the term it stands for. The value the `return` takes
     // is the one this walk's write returned -- on this walk there is no other.
     Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away)
                     ++ green_at(away, answer) ++ said,
           ~edges: chain_edges(4) ++ walk_edges(r_best)),
     // and then just that term, laid out as the tree it is, the bubble at the return
     // following it there
     Frame(~picts: green_at(term_spots, answer) ++ key_idea ++ distinct
                     ++ want_at(term_spots, ~body: [1300.0, 880.0],
                                ~lines: [[["Want: ", #'bold], ["extraction using", #'plain]],
                                         [["a single state walk", #'plain]]]),
           ~edges: term_edges(answer)),
     // and back to the graph as the table left it, every class filled by the walks
     // that reach it: the term's nodes go back to their places and take their
     // colours, and the rest writes in around them
     Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away) ++ said,
           ~edges: chain_edges(4)),
     // and what finding the term cost, which is the section's whole claim, said of
     // the class that holds two walks -- the one place on this graph the width is
     // more than one
     Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away) ++ said
                     ++ in_practice,
           ~edges: chain_edges(4)),
     // and what kind of answer that makes this
     Frame(~picts: picts_at(away, fills_of(all_stored)) ++ regions_at(away) ++ said
                     ++ in_practice ++ parameterized,
           ~edges: chain_edges(4))],
    ~stage: blob_stage, ~stage_band: band_below)
