                               run("Is this optimization safe?", ~font: "Helvetica Neue", ~size: 75.0,
                                   ~bold: #true)))))

  // The code block, in the three states it is rewritten through.
  // state 1: 'x = update(a, v)', 'y = update(a, v)'
  def code_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(703.648, 298.572, ~tag: "x = update(a, v)…",
                  shape_pict(~width: 512.703, ~height: 210.571, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("x = update(a, v)", ~size: 50.0)),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("y = update(a, v)", ~size: 50.0))),
                             ~shadow: make_shadow(hex("000000"), ~blur: 15.0, ~distance: 1.0,
                                                  ~direction: 90.0))))

  // state 2: 'x = update(a, v)', 'y = update(a, v)'
  def code_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(703.648, 298.572, ~tag: "x = update(a, v)…",
                  shape_pict(~width: 512.703, ~height: 210.571, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("x = update(a, v)", ~size: 50.0)),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("y = update(a, v)", ~size: 50.0, ~strike: #true))),
                             ~shadow: make_shadow(hex("000000"), ~blur: 15.0, ~distance: 1.0,
                                                  ~direction: 90.0))))

  // state 3: 'x = update(a, v)', 'y=v'
  def code_3:
    group_pict(~width: slide_width, ~height: slide_height,
               at(703.648, 298.572, ~tag: "x = update(a, v)…",
                  shape_pict(~width: 512.703, ~height: 210.571, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("x = update(a, v)", ~size: 50.0)),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("y=v", ~size: 50.0))),
                             ~shadow: make_shadow(hex("000000"), ~blur: 15.0, ~distance: 1.0,
                                                  ~direction: 90.0))))

  // Keynote drew each edge as a connector between two centres and clipped it
  // at the boxes; these are the same edges as `arrow`s, from border to border.
  // Stage `k` brings the edges of the nodes it adds; stage 0 is `base_canvas`.
  fun wire(p, k):
    match k
    | 0:
        let p = value_edges(p, [[n_x, n_update], [n_update, n_a], [n_update, n_v],
                                [n_y, n_update2], [n_update2, n_a], [n_update2, n_v]])
        let p = state_edges(p, [[n_sigma_p, n_update], [n_update, n_sigma],
                                [n_sigma_pp, n_update2], [n_update2, n_sigma_p]])
        p
    | 1:
        let p = arrows(~on: p, [[n_sigma_p, n_sigma_pp], [n_y, n_v]],
                       ~style: #'line, ~line_style: #'short_dash, ~line_width: 4)
        p
    | ~else: p

  // Both tracks are three epochs long, so click k plays the k'th reveal and the
  // k'th rewrite together -- exactly what the three separate slides did.
  pc.overlay(~horiz: #'left, ~vert: #'top,
             staged(base_canvas, [stage_1, stage_2], ~wire: wire),
             pc.switch(as_pict(code_1),
                       // `cross_fade`, not `fade_through`: the latter holds the two
                       // apart (`~overlap` 0.15), so at the midpoint both sit at 13%
                       // alpha and the code box drops out and comes back -- a flash,
                       // the box being opaque white with a border and a shadow.
                       pc.cross_fade(as_pict(code_1), as_pict(code_2), ~extent: 1.0),
                       pc.cross_fade(as_pict(code_2), as_pict(code_3), ~extent: 1.0)))

// -------------------------------------------------------------------------------------
// slide_29: Slide 18 through Slide 19, as one animated pict.
//
// These were separate slides, each a copy of the one before plus one more
// element -- so they collapse into a base picture and 1 reveals.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_29():
  // The nodes of the e-graph, bound by name so that the edges can be drawn
  // between them below; the canvas and the stages only place them.
  def n_box1 = shape_pict(~width: 23.528, ~height: 23.528,
