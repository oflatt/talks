     image_pict(media("image7.png"), 115.0, 115.065, ~crop: [0.0, 0.123, 0.0, 0.123])),
  // unknown.png (8) (id 97)
  at(491.1, 743.662, ~tag: "unknown.png (8)",
     image_pict(media("image8.png"), 115.0, 115.0, ~crop: [0.0, 0.0, 0.0, 0.093])),
  // pasted-movie.png (id 98)
  at(1286.684, 743.584, ~tag: "pasted-movie.png",
     image_pict(media("image9.png"), 115.0, 115.0)),
  // unknown.png (9) (id 99)
