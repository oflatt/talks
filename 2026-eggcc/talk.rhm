                       ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center,
                                   ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("x", ~size: 40.0))))
  def n_update = shape_pict(~width: 180.242, ~height: 64.0,
