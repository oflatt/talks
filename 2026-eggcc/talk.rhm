                            ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                            ~body: body(~anchor: #'center,
                                        ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                        para(~align: #'center,
                                             run("update", ~size: 40.0))))
  def n_sigma1 = shape_pict(~width: 64.0, ~height: 63.486,
                            ~geom: preset_geom(
                                     "roundRect", [pair("adj", "val 33878")]),
                            ~fill: hex("FFFFFF"),
                            ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                            ~body: body(~anchor: #'center,
                                        ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                        para(~align: #'center, run("σ", ~size: 40.0),
                                             run("1", ~size: 40.0, ~baseline: -0.06))))
  def n_v1 = shape_pict(~width: 64.0, ~height: 63.486,
                        ~geom: preset_geom(
                                 "roundRect", [pair("adj", "val 33878")]),
                        ~fill: hex("FFFFFF"),
                        ~line: make_stroke(hex("000000"), ~width: 3.0),
