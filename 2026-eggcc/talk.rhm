     image_pict(media("image12.png"), 115.0, 115.0))
)

// -------------------------------------------------------------------------------------
// slide_2: Keynote's 10-stage build of Slide 2, as one animated pict.
//
// The generator gives each build stage its own slide; every object was a
// superset of the stage before, so they collapse back into one.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
//
// The application labels are 64.608 tall, which is what a single line of 48pt
// Helvetica Neue Medium measures in this deck -- the height Keynote gave the
// labels it exported as real text boxes (SQL, WASM, …and more!). The ones it
// exported as `line` shapes carried a placeholder 100x100 instead, and since
// `~anchor: #'center` centres the text in its box, that sat them 17.7pt lower
// than their neighbours and pushed them down onto the logos.
fun slide_2():
  // Labels sit on one line per row. Keynote left each label at its own group's
  // top, and the groups sit at different heights, so the labels stepped up and
  // down across the row and every one of them ran into its logo. These offsets
  // put each row's labels on a common bottom edge, 8pt clear of the highest
  // logo *ink* in that row -- ink, not bounding box, because the logos carry
  // very different amounts of transparent padding. The logos have not moved.
  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(52.084, 64.475, ~tag: "E-Graphs are Super Useful!",
         textbox(~width: 1730.0, ~height: 112.848, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("E-Graphs are Super Useful!", ~font: "Helvetica Neue", ~size: 85.0,
                          ~bold: #true, ~spacing: -2.01)))),
      at(1890.408, 1044.894, ~tag: "Slide Number",
         shape_pict(~width: 19.008, ~height: 29.496)))

  // adds 'Floating point'
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(35.955, 236.25, ~tag: "Group (5)",
                  group_pict(~width: 558.478, ~height: 292.287,
                             at(0.0, 42.089, ~tag: "pasted-movie.png (5)",
                                image_pict(media("image17.png"), 558.478, 250.198)),
                             at(31.222, -51.323, ~tag: "Floating point",
                                textbox(~width: 100.0, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "Floating point",
                                               ~font: "Helvetica Neue Medium",
                                               ~size: 48.0)))))))

  // adds 'Python Simulations'
  def stage_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(620.266, 236.144, ~tag: "Group",
                  group_pict(~width: 350.833, ~height: 320.995,
                             at(70.107, 40.268, ~tag: "pasted-movie.png",
                                image_pict(media("image13.png"), 280.727, 280.727)),
                             at(0.0, -51.217, ~tag: "Python Simulations",
                                textbox(~width: 100.0, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "Python Simulations",
                                               ~font: "Helvetica Neue Medium",
                                               ~size: 48.0)))))))

  // adds 'RTL Optimization'
  def stage_3:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1099.052, 247.464, ~tag: "Group (7)",
                  group_pict(~width: 371.484, ~height: 269.86,
                             at(7.51, -62.537, ~tag: "RTL Optimization",
                                textbox(~width: 100.0, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "RTL Optimization",
                                               ~font: "Helvetica Neue Medium",
                                               ~size: 48.0)))),
                             at(0.0, 23.789, ~tag: "pasted-movie.png (7)",
                                image_pict(media("image19.png"), 371.484, 246.071)))))

  // adds 'ML Kernels', 'Luminal'
  def stage_4:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1571.646, 211.913, ~tag: "Group (6)",
                  group_pict(~width: 264.568, ~height: 437.154,
                             at(0.0, 45.622, ~tag: "pasted-movie.png (6)",
                                image_pict(media("image18.png"), 264.568, 264.568)),
                             at(1.976, -26.986, ~tag: "ML Kernels",
                                textbox(~width: 100.0, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "ML Kernels",
                                               ~font: "Helvetica Neue Medium",
                                               ~size: 48.0)))),
                             at(40.664, 337.154, ~tag: "(Luminal)",
                                textbox(~width: 100.0, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "Luminal",
                                               ~font: "Helvetica Neue Medium",
                                               ~size: 48.0)))))))

  // adds 'SQL'
  def stage_5:
    group_pict(~width: slide_width, ~height: slide_height,
               at(39.033, 623.282, ~tag: "Group (3)",
                  group_pict(~width: 312.321, ~height: 345.402,
                             at(35.938, 59.801, ~tag: "pasted-movie.png (3)",
                                image_pict(media("image15.png"), 276.435, 285.65)),
                             at(0.0, -12.807, ~tag: "SQL",
                                textbox(~width: 104.136, ~height: 64.608, ~anchor: #'center,
                                        ~wrap: #false, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                                             run("SQL", ~font: "Helvetica Neue Medium", ~size: 48.0)))))))

  // adds 'CAD'
  def stage_6:
    group_pict(~width: slide_width, ~height: slide_height,
               at(391.284, 662.932, ~tag: "Group (2)",
                  group_pict(~width: 375.394, ~height: 336.667,
                             at(0.0, 40.848, ~tag: "pasted-movie.png (2)",
                                image_pict(media("image14.png"), 375.394, 295.819,
                                           ~crop: [0.0, 0.0, 0.1, 0.0])),
                             at(5.164, -52.457, ~tag: "CAD",
                                textbox(~width: 100.0, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "CAD", ~font: "Helvetica Neue Medium",
                                               ~size: 48.0)))))))

  // adds 'WASM'
  def stage_7:
    group_pict(~width: slide_width, ~height: slide_height,
               at(806.567, 630.163, ~tag: "Group (4)",
                  group_pict(~width: 407.253, ~height: 301.018,
                             at(2.627, 68.882, ~tag: "pasted-movie.png (4)",
                                image_pict(media("image16.png"), 404.626, 232.136)),
                             at(0.0, -19.688, ~tag: "WASM",
                                textbox(~width: 158.904, ~height: 64.608, ~anchor: #'center,
                                        ~wrap: #false, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                                             run("WASM", ~font: "Helvetica Neue Medium", ~size: 48.0)))))))

  // adds 'User DSL Optimizations'
  def stage_8:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1256.336, 640.14, ~tag: "Group (8)",
                  group_pict(~width: 633.867, ~height: 311.723,
                             at(61.05, -29.665, ~tag: "WASM (2)",
                                textbox(~width: 538.008, ~height: 64.608, ~anchor: #'center,
                                        ~wrap: #false, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                                             run("User DSL Optimizations",
                                                 ~font: "Helvetica Neue Medium", ~size: 48.0)))),
                             at(0.0, 58.176, ~tag: "pasted-movie.png (8)",
                                image_pict(media("image20.png"), 633.867, 253.547)))))

  // adds '…and more!'
  def stage_9:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1625.217, 967.946, ~tag: "…and more!",
                  textbox(~width: 280.2, ~height: 64.608, ~anchor: #'center, ~wrap: #false,
                          ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                               run("…and more!", ~font: "Helvetica Neue Medium", ~size: 48.0)))))

  staged(base_canvas, [stage_1, stage_2, stage_3, stage_4, stage_5, stage_6, stage_7, stage_8, stage_9])

// -------------------------------------------------------------------------------------
// slide_12: Slide 3 through Slide 8, as one animated pict.
//
// These were separate slides, each a copy of the one before plus one more
// element -- so they collapse into a base picture and 5 reveals.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_12():
  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(1890.004, 1045.0, ~tag: "Slide Number", shape_pict(~width: 19.008, ~height: 29.496)),
      at(95.0, 249.26, ~tag: "Input term: (a + 1) - 1",
         textbox(~width: 371.37, ~height: 228.28, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("Input term:", ~font: "Helvetica Neue", ~size: 60.0,
                          ~spacing: -2.01)),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("", ~font: "Arial", ~size: 60.0, ~spacing: -2.0)),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("  (a + 1) - 1", ~font: "Helvetica Neue", ~size: 60.0,
                          ~spacing: -2.01)))),
      at(95.0, 85.0, ~tag: "Equivalence Graph (E-Graph)",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("E-Graphs Explore a Big Space", ~font: "Helvetica Neue",
                          ~size: 85.0, ~bold: #true, ~spacing: -2.01)))))

  // adds '(α + β) − γ ⇝ α + (β − γ)', 'α − α ⇝ 0', 'Rules:', 'α + 0 ⇝ α'
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1170.567, 252.964, ~tag: "Group",
                  group_pict(~width: 669.288, ~height: 412.157,
                             at(81.989, 105.232, ~tag: "(α + β) − γ ⇝ α + (β − γ)",
                                textbox(~width: 587.35, ~height: 78.0, ~anchor: #'center,
                                        ~wrap: #false, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(
                                             run("(α + β) − γ ⇝ α + (β − γ)",
                                                 ~font: "Times New Roman", ~size: 60.0,
                                                 ~color: hex("0433FF"))))),
                             at(90.294, 219.714, ~tag: "α − α ⇝ 0",
                                textbox(~width: 231.832, ~height: 78.0, ~anchor: #'center,
                                        ~wrap: #false, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(
                                             run("α − α ⇝ 0", ~font: "Times New Roman", ~size: 60.0,
                                                 ~color: hex("FF9300"))))),
                             at(0.0, 0.0, ~tag: "Input term: (a + 1) - 1 (2)",
                                textbox(~width: 371.37, ~height: 164.752, ~autofit: #'shrink,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.8),
                                             run("Rules:", ~font: "Helvetica Neue", ~size: 60.0,
                                                 ~spacing: -2.0)))),
                             at(90.294, 334.196, ~tag: "α + 0 ⇝ α",
                                textbox(~width: 231.832, ~height: 78.0, ~anchor: #'center,
                                        ~wrap: #false, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(
                                             run("α + 0 ⇝ α", ~font: "Times New Roman", ~size: 60.0,
                                                 ~color: hex("4F8F00"))))))))

  // adds '+', 'a', '1', '−'
  def stage_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(806.429, 676.242, ~tag: "+",
                  group_pict(~width: 100.0, ~height: 100.0,
                             at(0.0, 0.0, ~tag: "Rounded Rectangle",
                                shape_pict(~width: 100.0, ~height: 100.0,
                                           ~geom: preset_geom(
                                                    "roundRect", [pair("adj", "val 30640")]),
                                           ~fill: hex("FFFFFF"),
                                           ~line: make_stroke(hex("000000"), ~width: 4.0))),
                             at(10.974, 10.974, ~tag: "+ (2)",
                                textbox(~width: 78.052, ~height: 78.052, ~anchor: #'center,
                                        ~autofit: #'shrink, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                        para(~align: #'center,
                                             run("+", ~font: "Times New Roman", ~size: 69.75)))))),
               at(806.429, 867.432, ~tag: "a",
                  group_pict(~width: 100.0, ~height: 100.0,
