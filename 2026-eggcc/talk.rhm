                                    "roundRect", [pair("adj", "val 33878")]),
                           ~fill: hex("FFFFFF"),
                           ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                           ~body: body(~anchor: #'center,
                                       ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                       para(~align: #'center, run("σ", ~size: 40.0))))
  def n_a = shape_pict(~width: 64.0, ~height: 63.486,
