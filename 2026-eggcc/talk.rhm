  // Efficient Extraction from Effectful E-Graphs (id 90)
  at(95.0, 202.755, ~tag: "Efficient Extraction from Effectful E-Graphs",
     textbox(~width: 1730.0, ~height: 366.0, ~anchor: #'bottom, ~autofit: #'shrink,
             ~insets: insets(4.0, 4.0, 4.0, 4.0),
             para(~line_spacing: pair(#'percent, 0.8),
                  run("Efficient Extraction from Effectful E-Graphs",
                      ~font: prose_font, ~size: 116.0, ~bold: #true,
                      ~spacing: -3.0)))),
  // unknown.png (2) (id 91)
  at(-4.619, 984.406, ~tag: "unknown.png (2)",
     image_pict(media("image2.png"), 616.548, 101.578,
                ~crop: [0.121, 0.318, 0.135, 0.37])),
  // unknown.png (3) (id 92)
  at(172.867, 743.613, ~tag: "unknown.png (3)",
     image_pict(media("image3.png"), 115.0, 115.0)),
