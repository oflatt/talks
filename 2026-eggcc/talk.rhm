// -------------------------------------------------------------------------------------
// slide_26: Slides 15 through 17, as one animated pict.
//
// Not purely additive, so this is two tracks overlaid rather than one `staged`
// chain. The e-graph nodes fade in additively, but the code block on the left is
// *rewritten* twice -- `y = update(a, v)`, then struck through, then `y=v` -- and a
// reveal can only add, never replace. So the code gets a track of its own that
// cross-fades between its three states, concurrent with the reveals.
//
// Two exporter artifacts are dropped rather than animated:
//   - `Connection Line (3)` is 4.0pt on Slide 15 but 2.0pt on 16 and 17. Every
//     other black connector in the deck is 4.0, so the thinning is a stray edit
//     rather than the animation; it stays 4.0 throughout.
//   - the shapes inside `Group` are only renumbered ("Shape" -> "Shape (3)") from
//     slide to slide, which is the exporter naming them afresh. They draw the same.
fun slide_26():
  // The nodes of the e-graph, bound by name so that the edges can be drawn
  // between them below; the canvas and the stages only place them.
  def n_update = shape_pict(~width: 135.0, ~height: 61.581,
                            ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                            ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                            ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                        para(~align: #'center, run("update", ~size: 30.0))))
  def n_a = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("a", ~size: 30.0))))
  def n_v = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("v", ~size: 30.0))))
  def n_sigma = shape_pict(~width: 62.079, ~height: 61.581,
                           ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                           ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                           ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                       para(~align: #'center, run("σ", ~size: 30.0))))
  def n_x = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("x", ~size: 30.0))))
  def n_sigma_p = shape_pict(~width: 62.079, ~height: 61.581,
                             ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                             ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                             ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                         para(~align: #'center, run("σ", ~size: 30.0),
                                              run("ʹ", ~font: "Times New Roman", ~size: 30.0))))
  def n_update2 = shape_pict(~width: 135.0, ~height: 61.581,
                             ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                             ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                             ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                         para(~align: #'center, run("update", ~size: 30.0))))
  def n_y = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("y", ~size: 30.0))))
  def n_sigma_pp = shape_pict(~width: 62.079, ~height: 61.581,
                              ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
