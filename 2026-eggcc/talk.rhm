  ~background: hex("FFFFFF"),
  // unknown.png (id 88)
  at(204.846, -334.58, ~rotate: 90.0, ~tag: "unknown.png",
     image_pict(media("image1.png"), 1510.306, 1925.056, ~crop: [0.0, 0.013, 0.514, 0.0],
                ~opacity: 0.351)),
  // Oliver Flatt, Anjali Pal, Yihong Zhang, Ryan Tjoa, Kirsten Graham, Alex Fischman,… (id 89)
  at(26.843, 896.485,
     ~tag: "Oliver Flatt, Anjali Pal, Yihong Zhang, Ryan Tjoa, Kirsten Graham, Alex Fischman,…",
     textbox(~width: 1833.914, ~height: 101.563, ~autofit: #'shrink,
