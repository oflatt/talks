// -------------------------------------------------------------------------------------
// slide_39: Keynote's 2-stage build of Slide 27, as one animated pict.
//
// The generator gives each build stage its own slide; every object was a
// superset of the stage before, so they collapse back into one.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_39():
  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(95.0, 85.0, ~tag: "Fast Effect-safe Extraction in Practice",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("Fast Effect-safe Extraction in Practice", ~font: "Helvetica Neue",
                          ~size: 85.0, ~bold: #true, ~spacing: -2.01)))),
      at(1885.0, 1045.0, ~tag: "Slide Number", shape_pict(~width: 29.016, ~height: 29.496)),
      at(4.551, 202.379, ~tag: "g0.pdf", image_pict(media("image22.png"), 986.874, 822.395)),
      at(4.788, 202.577, ~tag: "g1.pdf", image_pict(media("image23.png"), 986.4, 822.0)),
      at(4.788, 202.577, ~tag: "g2.pdf", image_pict(media("image24.png"), 986.4, 822.0)),
      at(4.788, 202.577, ~tag: "g3.pdf", image_pict(media("image25.png"), 986.4, 822.0)),
      at(956.952, 892.972, ~tag: "LLVM-O0-O0",
         textbox(~width: 304.6, ~height: 66.6, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("LLVM-O0-O0", ~font: "Helvetica Neue", ~size: 50.0)))),
      at(956.952, 745.812, ~tag: "eggcc",
         textbox(~width: 146.95, ~height: 66.6, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("eggcc", ~font: "Helvetica Neue", ~size: 50.0)))),
      at(956.952, 499.126, ~tag: "LLVM-O3-O0",
         textbox(~width: 304.6, ~height: 66.6, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("LLVM-O3-O0", ~font: "Helvetica Neue", ~size: 50.0)))),
      at(956.952, 231.703, ~tag: "Solver Approaches",
         textbox(~width: 433.1, ~height: 66.6, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Solver Approaches", ~font: "Helvetica Neue", ~size: 50.0)))),
      at(295.659, 993.037, ~tag: "Polybench Benchmark Suite",
         textbox(~width: 515.8, ~height: 54.88, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Polybench Benchmark Suite", ~font: "Helvetica Neue", ~size: 40.0)))))

  // adds 'Non-trivial', 'e-graphs!'
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1160.467, 643.531, ~tag: "Non-trivial…",
                  group_pict(~width: 715.088, ~height: 228.658,
                             at(0.0, 0.0, ~tag: "Rounded Rectangle",
                                shape_pict(~width: 715.088, ~height: 228.658,
                                           ~geom: preset_geom("roundRect", [pair("adj", "val 6560")]),
                                           ~fill: hex("D9EAD3"))),
                             at(4.393, 14.417, ~tag: "Non-trivial… (2)",
                                textbox(~width: 706.302, ~height: 199.825, ~anchor: #'center,
                                        ~autofit: #'grow, ~insets: insets(10.0, 10.0, 10.0, 10.0),
                                        para(~align: #'center, ~level: 1, ~indent: 36.0,
                                             run("Non-trivial", ~font: "Helvetica Neue", ~size: 75.0,
                                                 ~bold: #true)),
                                        para(~align: #'center, ~level: 1, ~indent: 36.0,
                                             run("e-graphs!", ~font: "Helvetica Neue", ~size: 75.0,
                                                 ~bold: #true)))))))

  staged(base_canvas, [stage_1])

def all_slides = [held(slide_1), held(slide_2), held(slide_12), held(slide_18), held(slide_19), held(slide_20), held(slide_23), held(slide_26), held(slide_29), held(slide_31), held(slide_32), held(slide_34), held(slide_36), held(slide_37), held(slide_38), held(slide_39)]

module main:
  // `show_slides` shows each slide through `staged_slide`, the same one the
  // ICFP talk uses: a slide number in the corner for `--skip`, a reveal that
  // fades the slide up, and a pan to the next one. `set_reveal`, `set_transitions`,
  // `set_start_from` and the rest come through here too.
  import: lib("glide-pptx/show.rhm") open
  show_slides(all_slides, ~width: slide_width, ~height: slide_height)

// The backup PDF, without opening a window:
//   racket -l racket/base -e '(require (submod (file "talk.rhm") pdf))'
module pdf:
  // An animated slide is one page per advance, which is the slides it was made
  // from -- `deck_to_pdf` does that itself now.
  deck_to_pdf(all_slides, "talk.pdf", ~width: slide_width, ~height: slide_height)
  println("wrote " +& "talk.pdf")
