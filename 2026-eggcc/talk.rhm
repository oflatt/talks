#lang rhombus/and_meta
// Efficient Extraction from Effectful E-Graphs -- the deck.
//
// This file is the running order and nothing else: every slide is built in one of
// the files beside it, and `all_slides` says which ones the talk shows and in what
// order. The pieces, bottom to top:
//
//   theme.rhm      the faces, the page, the prose, the drawing bands
//   backdrop.rhm   the abstract e-graph behind the title
//   term.rhm       `(a + 1) - 1`, the term the talk keeps coming back to
//   codebox.rhm    the `update` program, as a box of code
//   egraph.rhm     how a node, a class and an edge are drawn
//   rules.rhm      the rewrite rules, as picts that can be taken apart
//   chain.rhm      the `update` example's e-graph, and what extraction does to it
//   apply.rhm      a rule applied to that graph, in five movements
//
//   opening.rhm    the title and the grid of tools
//   bigspace.rhm   rewriting `(a + 1) - 1`, by hand and as an e-graph
//   updates.rhm    the `update` example, as one story
//   reduction.rhm  effect-safe extraction is NP-hard
//   dp.rhm         the statewalk DP algorithm, run on the example
//   results.rhm    the plots
//   workflow.rhm   the compiler workflow, before effects and after
//
// Every slide that Keynote generated still carries its `at(x, y, ~name: ...)`
// positions. Glide derives opaque editor identities from those call sites while
// keeping the old Keynote labels readable in the editor.

import:
  lib("glide-pptx/runtime.rhm") open
  "theme.rhm" open
  "opening.rhm" open
  "bigspace.rhm" open
  "updates.rhm" open
  "reduction.rhm" open
  "evalsetup.rhm" open
  "results.rhm" open
  "workflow.rhm" open
  "dp.rhm" open
  "shots.rhm" open
  "summary.rhm" open
  "backup.rhm" open

export:
  slide_width
  slide_height
  all_slides
  // and the slides themselves, in the order the talk shows them, so that a script
  // can render or measure one of them without going through the whole deck
  slide_1
  slide_2
  slide_40
  slide_12
  slide_20
  slide_update
  slide_egraph
  slide_rue
  slide_fork
  slide_update_story
  slide_41
  slide_nphard
  slide_dp
  slide_collapse
  slide_eval_setup
  slide_cdf
  slide_perf
  slide_summary
  slide_raytracer
  slide_compile_times
  slide_made

// The macro keeps this as an ordinary list for the show and snapshot script,
// while recording the undecorated source slide behind each section wrapper for
// Glide. It rejects an entry whose source owner is ambiguous at compile time.
glide_slides all_slides:
  [slide_1,
   // 1 -- why effects belong in an e-graph at all
   // Each divider is told the title of the slide after it, and writes it as the
   // outline goes up -- one press, which is also the press that moves on.
   divider(0, ~shots: section_shots, ~next: useful_title),
   in_section(0, slide_2),
   // the workflow's last press is the camera going into the e-graph, and it hands
   // the term and the rules to exactly where the next slide draws them; the show
   // sees that, and the two meet on a cut
   in_section(0, slide_40), in_section(0, slide_12),
   in_section(0, slide_20),
   // 2 -- what makes extraction hard once there are effects
   // the `update` example is one slide: the code stays put while the graph, the
   // rule and the extraction happen beside it, and only the title changes
   divider(1, ~shots: section_shots, ~next: update_title),
   in_section(1, slide_update_story),
   in_section(1, slide_41),
   // 3 -- the algorithm, on the example the section before this one was about. The
   // NP-hardness proof is among the backups: the workflow slide before this ends on
   // the bad news, and the proof is for whoever asks.
   divider(2, ~shots: section_shots, ~next: dp_title),
   in_section(2, slide_dp),
   // and when the table can keep one walk where it kept two
   in_section(2, slide_collapse),
   // 4 -- the numbers. Every plot is in this section, `slide_34` included: it is a
   // measurement rather than a step of the algorithm, and it was reading as the end
   // of the section before this one.
   divider(3, ~shots: section_shots, ~next: eval_title),
   // what the evaluation runs on, walked through on one program, before the numbers
   in_section(3, slide_eval_setup),
   in_section(3, slide_cdf), in_section(3, slide_perf),
   // the three pictures the talk turned on, brought back side by side, and then
   // the picture the talk opened on, with the question
   slide_summary,
   // the backup slides, for the questions that ask for them
   slide_nphard, slide_raytracer, slide_compile_times, slide_made]

module main:
  // `show_slides` shows each slide through `staged_slide`, the same one the
  // ICFP talk uses: a slide number in the corner for `--skip`, a reveal that
  // fades the slide up, and a pan to the next one. `set_reveal`, `set_transitions`,
  // `set_start_from` and the rest come through here too.
  //
  // It also holds an animated slide's last frame for one more press, which this
  // file used to do for itself with a `held` wrapper around every slide in
  // `all_slides`. A slide's final epoch plays as the transition *off* it, so
  // without the hold whatever that epoch adds is never seen at rest.
  import: lib("glide-pptx/show.rhm") open
  // The logical number in the corner, the one `--skip` counts by. Keynote's own
  // "Slide Number" fields came through empty, so this is the only number drawn.
  set_slide_numbers(#true)
  // The pages move, as the ICFP talk's did: down from one slide to the next
  // within a section, and sideways when a divider brings the outline back --
  // each divider says so for itself, in `theme.rhm`.
  set_transitions(#'down)
  show_slides(all_slides, ~width: slide_width, ~height: slide_height)

// The backup PDF is slideshow's own printer, one page per press -- `make`, or
//   raco slideshow --widescreen --pdf -c -e -o talk.pdf talk.rhm
// and `racket talk.rhm --skip 20` rehearses from slide 21 without building the
// twenty before it.
