  // adds the second `update` node and its two edges
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(243.099, 377.773, ~tag: "Shape",
                  shape_pict(~width: 162.263, ~height: 506.564, ~flip_h: #true,
                             ~geom: custom_geom(
                                                [[[#'move, pair(941, 2072)], [#'curve, pair(991, 2770), pair(1849, 3375), pair(3711, 3645)], [#'curve, pair(5530, 3908), pair(7816, 3696), pair(9530, 4050)], [#'curve, pair(11330, 4421), pair(11609, 5177), pair(12096, 5850)], [#'curve, pair(13191, 7363), pair(15847, 8811), pair(15997, 10409)], [#'curve, pair(16173, 12275), pair(13047, 13933), pair(11664, 15607)], [#'curve, pair(11080, 16314), pair(10600, 17025), pair(8532, 17388)], [#'curve, pair(6852, 17683), pair(4783, 17516), pair(3014, 17739)], [#'curve, pair(1355, 17948), pair(251, 18461), pair(47, 19017)], [#'curve, pair(-293, 19942), pair(1248, 20745), pair(3853, 21070)], [#'curve, pair(6603, 21413), pair(9739, 21106), pair(11787, 20361)], [#'curve, pair(13999, 19557), pair(14481, 18509), pair(15205, 17474)], [#'curve, pair(16572, 15522), pair(19121, 13605), pair(20299, 11570)], [#'curve, pair(21307, 9829), pair(21252, 8010), pair(19067, 6397)], [#'curve, pair(17376, 5149), pair(14421, 4070), pair(13183, 2780)], [#'curve, pair(12463, 2029), pair(12282, 1215), pair(10632, 614)], [#'curve, pair(8820, -47), pair(5890, -187), pair(3675, 258)], [#'curve, pair(1793, 635), pair(890, 1346), pair(941, 2072)], [#'close]]],
                                                20930, 21209), ~fill: hex("929292", ~alpha: 0.4))),
               at(407.265, 375.236, ~tag: "Shape (2)",
                  shape_pict(~width: 126.68, ~height: 300.004,
                             ~geom: custom_geom(
                                                [[[#'move, pair(80, 3510)], [#'curve, pair(302, 4815), pair(2062, 5815), pair(4912, 6141)], [#'curve, pair(7366, 6422), pair(10144, 6041), pair(12337, 6597)], [#'curve, pair(15681, 7443), pair(15529, 9183), pair(15161, 10687)], [#'curve, pair(14820, 12077), pair(14397, 13739), pair(10894, 14508)], [#'curve, pair(8739, 14980), pair(6110, 14723), pair(3852, 15089)], [#'curve, pair(1735, 15433), pair(336, 16291), pair(66, 17205)], [#'curve, pair(-390, 18751), pair(1555, 20096), pair(4923, 20605)], [#'curve, pair(8131, 21089), pair(12103, 20671), pair(15048, 19431)], [#'curve, pair(20600, 17094), pair(20662, 13704), pair(20798, 10655)], [#'curve, pair(20934, 7594), pair(21210, 4191), pair(15993, 1694)], [#'curve, pair(12600, 70), pair(7429, -511), pair(3569, 504)], [#'curve, pair(1152, 1140), pair(-126, 2301), pair(80, 3510)], [#'close]]],
                                                20852, 20801), ~fill: hex("929292", ~alpha: 0.4))))

  // adds 'Is this optimization safe?'
  def stage_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(751.007, 652.254, ~tag: "Is this optimization safe?",
                  textbox(~width: 900.225, ~height: 96.825, ~anchor: #'center, ~wrap: #false,
                          ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
