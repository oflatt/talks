  let p = state_edges(p, [[n_update, n_sigma], [n_sigma1, n_update], [n_update2, n_sigma1],
                          [n_sigma2, n_update2]])
  let p = value_edges(p, [[n_update, n_x], [n_update, n_a], [n_v1, n_update], [n_update2, n_x],
                          [n_update2, n_a], [n_v2, n_update2]])
  p

