#lang rhombus/and_meta
// Efficient Extraction from Effectful E-Graphs -- the deck.
//
// This file is the running order and nothing else: every slide is built in one of
// the files beside it, and `all_slides` says which ones the talk shows and in what
// order. The pieces, bottom to top:
//
//   theme.rhm      the faces, the page, the prose, the drawing bands
//   term.rhm       `(a + 1) - 1`, the term the talk keeps coming back to
//   codebox.rhm    the `update` program, as a box of code
//   egraph.rhm     how a node, a class and an edge are drawn
//   rules.rhm      the rewrite rules, as picts that can be taken apart
//   chain.rhm      the `update` example's e-graph, and what extraction does to it
//   apply.rhm      a rule applied to that graph, in five movements
//
//   opening.rhm    the title and the grid of tools
//   bigspace.rhm   rewriting `(a + 1) - 1`, by hand and as an e-graph
//   updates.rhm    the `update` example, as one story
//   reduction.rhm  effect-safe extraction is NP-hard
//   dp.rhm         the statewalk DP algorithm, run on the example
//   results.rhm    the plots
//   workflow.rhm   the compiler workflow, before effects and after
//
// Every slide that Keynote generated still carries its `at(x, y, ~tag: ...)`
// positions, so `raco glide` can open the file the slide lives in and write back
// what is dragged.

import:
  lib("glide-pptx/runtime.rhm") open
  "theme.rhm" open
  "opening.rhm" open
  "bigspace.rhm" open
  "updates.rhm" open
  "reduction.rhm" open
  "results.rhm" open
  "workflow.rhm" open
  "dp.rhm" open
  "shots.rhm" open

export:
  slide_width
  slide_height
  all_slides
  // and the slides themselves, in the order the talk shows them, so that a script
  // can render or measure one of them without going through the whole deck
  slide_1
  slide_2
  slide_40
  slide_12
  slide_20
  slide_update
  slide_egraph
  slide_rue
  slide_fork
  slide_41
  slide_nphard
  slide_dp
  slide_34
  slide_36
  slide_37
  slide_38
  slide_39

def all_slides:
  [slide_1,
   // 1 -- why effects belong in an e-graph at all
   divider(0, ~shots: section_shots),
   in_section(0, slide_2), in_section(0, slide_40), in_section(0, slide_12),
   in_section(0, slide_20),
   // 2 -- what makes extraction hard once there are effects
   divider(1, ~shots: section_shots), in_section(1, slide_update), in_section(1, slide_egraph),
   in_section(1, slide_rue), in_section(1, slide_fork), in_section(1, slide_41),
   // 3 -- what makes it hard, and the algorithm
   divider(2, ~shots: section_shots),
   in_section(2, slide_nphard),
   // and then what the algorithm does instead, on the example the section before
   // this one was about
   in_section(2, slide_dp),
   in_section(2, slide_34),
   // 4 -- the numbers
   divider(3, ~shots: section_shots),
   in_section(3, slide_36), in_section(3, slide_37),
   in_section(3, slide_38), in_section(3, slide_39)]

module main:
  // `show_slides` shows each slide through `staged_slide`, the same one the
  // ICFP talk uses: a slide number in the corner for `--skip`, a reveal that
  // fades the slide up, and a pan to the next one. `set_reveal`, `set_transitions`,
  // `set_start_from` and the rest come through here too.
  //
  // It also holds an animated slide's last frame for one more press, which this
  // file used to do for itself with a `held` wrapper around every slide in
  // `all_slides`. A slide's final epoch plays as the transition *off* it, so
  // without the hold whatever that epoch adds is never seen at rest.
  import: lib("glide-pptx/show.rhm") open
  // The logical number in the corner, the one `--skip` counts by. Keynote's own
  // "Slide Number" fields came through empty, so this is the only number drawn.
  set_slide_numbers(#true)
  show_slides(all_slides, ~width: slide_width, ~height: slide_height)

// The backup PDF, without opening a window:
//   racket -l racket/base -e '(require (submod (file "talk.rhm") pdf))'
module pdf:
  // An animated slide is one page per advance, which is the slides it was made
  // from -- `deck_to_pdf` does that itself now.
  deck_to_pdf(all_slides, "talk.pdf", ~width: slide_width, ~height: slide_height)
  println("wrote " +& "talk.pdf")
