      at(856.839, 978.552, ~tag: "x", n_x),
      at(1007.675, 880.99, ~tag: "update", n_update),
      at(1007.675, 686.381, ~tag: "update (2)", n_update2),
      at(1139.847, 783.942, ~tag: "σ1", n_sigma1),
      at(985.757, 775.192, ~tag: "v1", n_v1),
      at(1007.675, 491.771, ~tag: "update (3)", n_update3),
      at(1139.847, 589.333, ~tag: "σ2", n_sigma2),
      at(985.757, 587.333, ~tag: "v2", n_v2),
      at(1139.847, 394.723, ~tag: "σ3", n_sigma3),
      at(985.757, 399.473, ~tag: "v3", n_v3),
      at(942.05, 978.552, ~tag: "y", n_y))

  // adds 'c', 'update', 'σ', '4', 'v'
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(771.627, 978.552, ~tag: "c", n_c),
               at(1007.675, 297.161, ~tag: "update (4)", n_update4),
               at(1139.847, 200.627, ~tag: "σ4", n_sigma4),
               at(985.757, 200.627, ~tag: "v4", n_v4))

  // Keynote drew each edge as a connector between two centres and clipped it
  // at the boxes; these are the same edges as `arrow`s, from border to border.
  // Stage `k` brings the edges of the nodes it adds; stage 0 is `base_canvas`.
  fun wire(p, k):
    match k
    | 0:
        let p = arrows(~on: p, [[n_box2, n_box1], [n_box2, n_box3], [n_box5, n_box3],
                                [n_box5, n_box6], [n_box7, n_box4], [n_box4, n_box1],
                                [n_box4, n_box2], [n_box4, n_box5]], ~line_width: 2)
        let p = state_edges(p, [[n_update, n_sigma], [n_sigma1, n_update],
                                [n_update2, n_sigma1], [n_sigma2, n_update2],
                                [n_update3, n_sigma2], [n_sigma3, n_update3]])
        let p = value_edges(p, [[n_update, n_x], [n_update, n_a], [n_v1, n_update],
                                [n_update2, n_x], [n_update2, n_a], [n_v2, n_update2],
                                [n_v3, n_update3], [n_update3, n_b], [n_update3, n_y]])
        p
    | 1:
        let p = state_edges(p, [[n_sigma4, n_update4], [n_update4, n_sigma3]])
        let p = value_edges(p, [[n_v4, n_update4], [n_update4, n_v2], [n_update4, n_c]])
        p
    | ~else: p

  // The highlight moves from the third line to the fourth as the fourth `update`
  // arrives, and `staged` can only add to a picture -- so this one is a cross-fade
  // between the two finished pictures, which for everything they share looks like
  // nothing happening. One click, as before.
  def base = wire(as_pict(base_canvas), 0)
  def before = mark_line(base, 2)
  def after:
    mark_line(wire(pc.overlay(~horiz: #'left, ~vert: #'top, base, as_pict(stage_1)), 1), 3)
  pc.switch(before, pc.cross_fade(before, after))

