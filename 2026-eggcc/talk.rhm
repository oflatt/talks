// -------------------------------------------------------------------------------------
// slide_2: Keynote's 10-stage build of Slide 2, as one animated pict.
//
// The generator gives each build stage its own slide; every object was a
// superset of the stage before, so they collapse back into one.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
//
// The application labels are 64.608 tall, which is what a single line of 48pt
// Helvetica Neue Medium measures in this deck -- the height Keynote gave the
// labels it exported as real text boxes (SQL, WASM, …and more!). The ones it
// exported as `line` shapes carried a placeholder 100x100 instead, and since
// `~anchor: #'center` centres the text in its box, that sat them 17.7pt lower
// than their neighbours and pushed them down onto the logos.
fun slide_2():
  // Labels sit on one line per row. Keynote left each label at its own group's
  // top, and the groups sit at different heights, so the labels stepped up and
  // down across the row and every one of them ran into its logo. These offsets
  // put each row's labels on a common bottom edge, 8pt clear of the highest
  // logo *ink* in that row -- ink, not bounding box, because the logos carry
  // very different amounts of transparent padding. The logos have not moved.
  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(52.084, 64.475, ~tag: "E-Graphs are Super Useful!",
         textbox(~width: 1730.0, ~height: 112.848, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("E-Graphs are Super Useful!", ~font: prose_font, ~size: 85.0,
                          ~bold: #true, ~spacing: -2.01)))),
      at(1890.408, 1044.894, ~tag: "Slide Number",
         shape_pict(~width: 19.008, ~height: 29.496)))

  // adds 'Floating point'
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(35.955, 236.25, ~tag: "Group (5)",
                  group_pict(~width: 558.478, ~height: 292.287,
                             at(0.0, 42.089, ~tag: "pasted-movie.png (5)",
                                image_pict(media("image17.png"), 558.478, 250.198)),
                             at(31.222, -51.323, ~tag: "Floating point",
                                linebox(~width: 100.0, ~height: 64.608,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "Floating point",
                                               ~font: prose_font,
                                               ~size: 48.0)))))))

  // adds 'Python Simulations'
  def stage_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(620.266, 236.144, ~tag: "Group",
                  group_pict(~width: 350.833, ~height: 320.995,
                             at(70.107, 40.268, ~tag: "pasted-movie.png",
                                image_pict(media("image13.png"), 280.727, 280.727)),
                             at(0.0, -51.217, ~tag: "Python Simulations",
                                linebox(~width: 100.0, ~height: 64.608,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "Python Simulations",
                                               ~font: prose_font,
                                               ~size: 48.0)))))))

  // adds 'RTL Optimization'
  def stage_3:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1099.052, 247.464, ~tag: "Group (7)",
                  group_pict(~width: 371.484, ~height: 269.86,
                             at(7.51, -62.537, ~tag: "RTL Optimization",
                                linebox(~width: 100.0, ~height: 64.608,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "RTL Optimization",
                                               ~font: prose_font,
                                               ~size: 48.0)))),
                             at(0.0, 23.789, ~tag: "pasted-movie.png (7)",
                                image_pict(media("image19.png"), 371.484, 246.071)))))

  // adds 'ML Kernels', 'Luminal'
  def stage_4:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1571.646, 211.913, ~tag: "Group (6)",
                  group_pict(~width: 264.568, ~height: 437.154,
                             at(0.0, 45.622, ~tag: "pasted-movie.png (6)",
                                image_pict(media("image18.png"), 264.568, 264.568)),
                             at(1.976, -26.986, ~tag: "ML Kernels",
                                linebox(~width: 100.0, ~height: 64.608,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "ML Kernels",
                                               ~font: prose_font,
                                               ~size: 48.0)))),
                             at(40.664, 337.154, ~tag: "(Luminal)",
                                linebox(~width: 100.0, ~height: 64.608,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "Luminal",
                                               ~font: prose_font,
                                               ~size: 48.0)))))))

  // adds 'SQL'
  def stage_5:
    group_pict(~width: slide_width, ~height: slide_height,
               at(39.033, 623.282, ~tag: "Group (3)",
                  group_pict(~width: 312.321, ~height: 345.402,
                             at(35.938, 59.801, ~tag: "pasted-movie.png (3)",
                                image_pict(media("image15.png"), 276.435, 285.65)),
                             at(0.0, -12.807, ~tag: "SQL",
                                linebox(~width: 104.136, ~height: 64.608, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                                             run("SQL", ~font: prose_font, ~size: 48.0)))))))

  // adds 'CAD'
  def stage_6:
    group_pict(~width: slide_width, ~height: slide_height,
               at(391.284, 662.932, ~tag: "Group (2)",
                  group_pict(~width: 375.394, ~height: 336.667,
                             at(0.0, 40.848, ~tag: "pasted-movie.png (2)",
                                image_pict(media("image14.png"), 375.394, 295.819,
                                           ~crop: [0.0, 0.0, 0.1, 0.0])),
                             at(5.164, -52.457, ~tag: "CAD",
                                linebox(~width: 100.0, ~height: 64.608,
                                        ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9),
                                             ~space_before: 45.0,
                                             run(
                                               "CAD", ~font: prose_font,
                                               ~size: 48.0)))))))

  // adds 'WASM'
  def stage_7:
    group_pict(~width: slide_width, ~height: slide_height,
               at(806.567, 630.163, ~tag: "Group (4)",
                  group_pict(~width: 407.253, ~height: 301.018,
                             at(2.627, 68.882, ~tag: "pasted-movie.png (4)",
                                image_pict(media("image16.png"), 404.626, 232.136)),
                             at(0.0, -19.688, ~tag: "WASM",
                                linebox(~width: 158.904, ~height: 64.608, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                                             run("WASM", ~font: prose_font, ~size: 48.0)))))))

  // adds 'User DSL Optimizations'
  def stage_8:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1256.336, 640.14, ~tag: "Group (8)",
                  group_pict(~width: 633.867, ~height: 311.723,
                             at(61.05, -29.665, ~tag: "WASM (2)",
                                linebox(~width: 538.008, ~height: 64.608, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                                             run("User DSL Optimizations",
                                                 ~font: prose_font, ~size: 48.0)))),
                             at(0.0, 58.176, ~tag: "pasted-movie.png (8)",
                                image_pict(media("image20.png"), 633.867, 253.547)))))

  // adds '…and more!'
  def stage_9:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1625.216, 967.946, ~tag: "…and more!",
                  linebox(~width: 280.2, ~height: 64.608,
                          ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                               run("…and more!", ~font: prose_font, ~size: 48.0)))))

  staged(base_canvas, [stage_1, stage_2, stage_3, stage_4, stage_5, stage_6, stage_7, stage_8, stage_9])

// -------------------------------------------------------------------------------------
// slide_12: Slide 3 through Slide 8, as one animated pict.
//
// These were separate slides, each a copy of the one before plus one more
// element -- so they collapse into a base picture and 5 reveals.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_12():
  // A node of the e-graph. Keynote drew each as a rounded box with a text box
  // inside; building them from one description keeps the seven of them agreeing,
  // and gives each a pict the `arrow` helper can find and aim at.
  fun node(label :: String, ~color: color :: String = "000000",
           ~fill: fill :: String = node_white):
    graph_node(~width: 100.0, ~height: 100.0, ~adj: "30640",
               ~line: color, ~line_width: 4.0, ~fill: fill,
               run(label, ~font: node_font, ~size: 69.75))

  def n_a = node("a")
  def n_one = node("1")
  def n_plus = node("+")
  def n_minus = node("−")
  def n_plus_r = node("+", ~color: "0433FF")
  def n_minus_r = node("−", ~color: "0433FF")
  def n_zero = node("0", ~color: "FF9300")
  // The same seven nodes again, filled green: a node extraction picked is that
  // node with a green background, not a ring laid over it and not a wash, which
  // would tint the label along with the box. Built once, so that a press can fade
  // the green one in over the white one and the box turns green where it stands.
  def plain:
    { #'a: n_a, #'one: n_one, #'plus: n_plus, #'minus: n_minus,
      #'plus_r: n_plus_r, #'minus_r: n_minus_r, #'zero: n_zero }
  def green:
    { #'a: node("a", ~fill: node_green),
      #'one: node("1", ~fill: node_green),
      #'plus: node("+", ~fill: node_green),
      #'minus: node("−", ~fill: node_green),
      #'plus_r: node("+", ~color: "0433FF", ~fill: node_green),
      #'minus_r: node("−", ~color: "0433FF", ~fill: node_green),
      #'zero: node("0", ~color: "FF9300", ~fill: node_green) }
  def nd = 100.0                              // the node size `node` builds

  // Inputs on top, the result underneath, so every edge points the way the data
  // goes. Keynote had it the other way up, with the root above its operands.
  def row_in = 485.051
  def row_mid = 676.242
  def row_out = 867.432
  def col_l = 806.429
  def col_r = 1029.766
  def col_far = 1190.919
  // The data-flow arrow, left of the graph. It sits out at 620 rather than just
  // off the graph's edge to leave the lane at 706 free: that is where the
  // extraction pointer walks down, and the two of them side by side is the point
  // -- extraction reads the classes the way the data flows.
  def flow_x = 620.0

  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(1890.004, 1045.0, ~tag: "Slide Number", shape_pict(~width: 19.008, ~height: 29.496)),
      at(95.0, 85.0, ~tag: "Equivalence Graph (E-Graph)",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("E-Graphs Explore a Big Space", ~font: prose_font,
                          ~size: 85.0, ~bold: #true, ~spacing: -2.01)))))

  // adds '(α + β) − γ → α + (β − γ)', 'α − α → 0', 'Rules:', 'α + 0 → α'
  def rules_group:
    group_pict(~width: slide_width, ~height: slide_height,
               at(1170.567, 252.964, ~tag: "Group",
                  group_pict(~width: 669.288, ~height: 412.157,
                             at(81.989, 105.232, ~tag: "(α + β) − γ → α + (β − γ)",
                                linebox(~width: 587.35, ~height: 78.0, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(
                                             run("(α + β) − γ → α + (β − γ)",
                                                 ~font: math_font, ~size: 60.0,
                                                 ~color: hex("0433FF"))))),
                             at(90.294, 219.714, ~tag: "α − α → 0",
                                linebox(~width: 231.832, ~height: 78.0, ~autofit: #'grow,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(
                                             run("α − α → 0", ~font: math_font, ~size: 60.0,
                                                 ~color: hex("FF9300"))))),
                             at(0.0, 0.0, ~tag: "Input term: (a + 1) - 1 (2)",
                                textbox(~width: 371.37, ~height: 164.752, ~autofit: #'shrink,
                                        ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                        para(~line_spacing: pair(#'percent, 0.8),
                                             run("Rules:", ~font: prose_font, ~size: 60.0,
                                                 ~spacing: -2.0)))))))

  // The third rule is held back: it is the one that makes the difference to what
  // extraction can find, so the slide extracts a term without it first and only
  // then puts it up. Its place in the list is where it sat inside the group.
  def third_rule:
    linebox(~width: 231.832, ~height: 78.0, ~autofit: #'grow,
            ~insets: insets(4.0, 4.0, 4.0, 4.0),
            para(run("α + 0 → α", ~font: math_font, ~size: 60.0,
                     ~color: hex("4F8F00"))))
  def third_rule_x = 1170.567 + 90.294
  def third_rule_y = 252.964 + 334.196

  // Where the seven of them sit. Inputs on top, the result underneath, so every
  // edge points the way the data goes.
  def spot:
    { #'a: [col_l, row_in], #'one: [col_r, row_in],
      #'plus: [col_l, row_mid], #'minus_r: [col_r, row_mid],
      #'zero: [col_far, row_mid],
      #'minus: [col_l, row_out], #'plus_r: [col_r, row_out] }
  fun spots_of(keys :~ List, picks :~ List) :: Map:
    for values(m :~ Map = {}) (k in keys):
      m ++ { k: [(if picks.contains(k) | green[k] | plain[k]), & spot[k]] }
  def keys_term = [#'a, #'one, #'plus, #'minus]
  def keys_rewrite = keys_term ++ [#'plus_r, #'minus_r]
  def keys_all = keys_rewrite ++ [#'zero]

  // Two colours, not one: the green belongs to the third rule -- it is the colour
  // that rule is written in, so its dashed equivalence is drawn in it too -- and a
  // picked node needs to be something else, or the mark on a node and the rule
  // that changes which node gets marked read as the same thing.
  def rule_green = draw.Color(79, 143, 0)

  // The edges, by kind. A solid arrow is an operand feeding an operator, and they
  // all point from the operator up to what it is built from: the arrowheads say
  // which term contains which, not which way the values go. A dashed line with no
  // head is an e-class -- those two nodes are the same value, not a flow between
  // them. Blue is what the blue rule put there.
  //
  // The long diagonals thread the gap between the two middle nodes, which is why
  // the columns sit where they do.
  fun wire(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
    fun eq(q, x, y, col):
      arrow(~on: q, x, y, ~style: #'line, ~line_style: #'short_dash,
            ~color: col, ~line_width: 4)
    for values(q :~ pc.Pict = layer) (e :~ List in es):
      // `at` is this frame's own nodes, which is what the layer has ghosts of
      def from = at[e[1]]
      def to = at[e[2]]
      match e[0]
      | #'op: arrow(~on: q, from, to, ~line_width: 4, ~gap: 4)
      | #'op_blue: arrow(~on: q, from, to, ~line_width: 4, ~gap: 4, ~color: keynote_blue)
      // `1 - 1` takes the same node for both of its operands, so it needs two
      // arrows: one arrow would say the operator takes one thing. The two run side
      // by side, pinned 18 either side of the border's middle -- the two boxes are
      // in one column, so this is a pair of parallel lines.
      | #'op_pair:
          for values(p :~ pc.Pict = q) (dx in [-18.0, 18.0]):
            arrow(~on: p, from, to, ~line_width: 4, ~color: keynote_blue,
                  ~from_at: pc.Find.top(as_pict(from), ~dx: dx, ~dy: -4),
                  ~to_at: pc.Find.bottom(as_pict(to), ~dx: dx, ~dy: 4))
      | #'eq_blue: eq(q, from, to, keynote_blue)
      | #'eq_orange: eq(q, from, to, draw.Color(255, 147, 0))
      // The third rule's own equivalence, drawn with the merge it makes. `a` is both
      // an operand of this `+` and, once that rule fires, in its e-class, so this
      // line and that operand arrow join the same two boxes and would lie on top of
      // each other. This is the one that steps aside, and the arrow keeps the route
      // the helper gives it: an arrow has a head, and a head is a claim about which
      // box it points at, so an arrow is the wrong thing to nudge off centre.
      //
      // It steps aside along the borders rather than by shifting the whole line
      // sideways, which would leave both of its ends hanging in space. 19 and not
      // 40: a node's corners are rounded by 30, so an end out at the corner lands
      // where the box has no edge, and both ends stay on the straight run of their
      // border. That also keeps it on the blob, which is what says the two nodes are
      // one class.
      | ~else:
          arrow(~on: q, from, to, ~style: #'line, ~line_style: #'short_dash,
                ~color: rule_green, ~line_width: 4,
                ~from_at: pc.Find.top(as_pict(from), ~dx: -19, ~dy: -4),
                ~to_at: pc.Find.bottom(as_pict(to), ~dx: -19, ~dy: 4))

  def es_plus: [[#'op, #'plus, #'a], [#'op, #'plus, #'one]]
  def es_minus: [[#'op, #'minus, #'plus], [#'op, #'minus, #'one]]
  def es_term = es_plus ++ es_minus
  def es_rewrite:
    [[#'op_blue, #'plus_r, #'minus_r], [#'op_pair, #'minus_r, #'one],
     [#'op_blue, #'plus_r, #'a], [#'eq_blue, #'minus, #'plus_r]]
  def es_zero: [[#'eq_orange, #'minus_r, #'zero]]
  def es_merged: [[#'eq_green, #'plus_r, #'a]]
  def es_graph = es_term ++ es_rewrite ++ es_zero

  // The data-flow arrow, left of the graph, on a layer of its own: it arrives with
  // the term and stays put, so no press has anything to do to it. It sits out at
  // 620 rather than just off the graph's edge to leave the lane at 706 free: that
  // is where the extraction pointer walks down, and the two of them side by side is
  // the point -- extraction reads the classes the way the data flows.
  def flow_over:
    def top = blank(1.0, 1.0)
    def bot = blank(1.0, 1.0)
    def probe:
      put(put(blank_slide, top, flow_x, row_in + 14.0), bot, flow_x, row_out + 86.0)
    { #'flow: [arrow(~on: probe, top, bot, ~line_width: 4,
                     ~color: draw.Color(150, 150, 150),
                     // `t` is slideshow's; this file has the runtime's textbox instead
                     ~label: as_pict(linebox(~width: 220.0, ~height: 52.0, ~autofit: #'grow,
                                             ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                             para(~align: #'center,
                                                  run("data flow", ~font: prose_font,
                                                      ~size: 40.0, ~color: hex("787878"))))),
                     // far enough left that the label clears the line it names
                     ~label_dx: -120, ~label_dy: 0),
               0.0, 0.0, band_above] }

  def rules_over = { #'rules: [rules_group, 0.0, 0.0, band_above] }
  def third_over = { #'third: [third_rule, third_rule_x, third_rule_y, band_above] }

  // The class `a` joins when the third rule fires. No rectangle around its three
  // members can draw it: `+` is a class of its own sitting between `a` and the
  // root in the same column, and this shape threads between `+` and the `1 - 1`
  // class to get past it. It is Keynote's own freehand blob, kept for that reason
  // and recoloured to match the rest.
  def root_region:
    shape_pict(~width: 367.991, ~height: 524.05, ~flip_v: #true,
               ~geom: custom_geom(
                                 [[[#'move, pair(1897, 196)], [#'curve, pair(3336, -282), pair(4709, 236), pair(6155, 481)], [#'curve, pair(6884, 605), pair(7647, 652), pair(8380, 751)], [#'curve, pair(9135, 853), pair(9858, 1007), pair(10575, 1115)], [#'curve, pair(11465, 1249), pair(12411, 1336), pair(13337, 1153)], [#'curve, pair(14189, 984), pair(14929, 587), pair(15761, 398)], [#'curve, pair(16611, 204), pair(17463, 208), pair(18256, 301)], [#'curve, pair(19039, 392), pair(19830, 578), pair(20511, 1046)], [#'curve, pair(21355, 1628), pair(21563, 2431), pair(21400, 3196)], [#'curve, pair(21231, 3986), pair(20673, 4792), pair(19596, 5279)], [#'curve, pair(18734, 5668), pair(17667, 5755), pair(16731, 6057)], [#'curve, pair(15503, 6453), pair(14591, 7173), pair(13870, 7953)], [#'curve, pair(12906, 8995), pair(12203, 10178), pair(11414, 11327)], [#'curve, pair(10870, 12120), pair(10279, 12897), pair(9558, 13608)], [#'curve, pair(8707, 14447), pair(7632, 15256), pair(7572, 16263)], [#'curve, pair(7537, 16873), pair(7881, 17451), pair(8040, 18050)], [#'curve, pair(8237, 18790), pair(8157, 19537), pair(7561, 20109)], [#'curve, pair(7004, 20644), pair(6076, 20940), pair(5058, 21072)], [#'curve, pair(3154, 21318), pair(1245, 20975), pair(410, 19876)], [#'curve, pair(24, 19368), pair(-22, 18777), pair(7, 18198)], [#'curve, pair(36, 17621), pair(128, 17011), pair(580, 16463)], [#'curve, pair(1273, 15622), pair(2563, 15165), pair(3744, 14653)], [#'curve, pair(4936, 14136), pair(6056, 13531), pair(6859, 12730)], [#'curve, pair(7671, 11917), pair(8205, 11006), pair(8786, 10107)], [#'curve, pair(9676, 8730), pair(10242, 6974), pair(11999, 6156)], [#'curve, pair(12608, 5872), pair(13280, 5659), pair(13632, 5289)], [#'curve, pair(14021, 4879), pair(13994, 4383), pair(13461, 3932)], [#'curve, pair(12555, 3165), pair(10957, 3388), pair(9549, 3825)], [#'curve, pair(9054, 3979), pair(8547, 4138), pair(8075, 4325)], [#'curve, pair(6983, 4758), pair(6087, 5468), pair(4855, 5666)], [#'curve, pair(3978, 5807), pair(3062, 5672), pair(2270, 5371)], [#'curve, pair(1563, 5102), pair(980, 4723), pair(586, 4232)], [#'curve, pair(-10, 3487), pair(-37, 2631), pair(184, 1899)], [#'curve, pair(401, 1184), pair(903, 527), pair(1897, 196)], [#'close]]],
                                 21451, 21147),
               ~fill: hex("929292", ~alpha: 0.3))

  // A class, drawn as the region round the nodes it holds -- the box its members
  // span, grown a little. The two classes with two members each have both of them
  // side by side in a row, which is what lets a rectangle say it. Each is built
  // once: the three the merge leaves alone are then the same layer before and
  // after it, and a press has only the two it changes to draw.
  fun region(x :: Real, y :: Real, w :: Real, h :: Real) :: List:
    [pc.rectangle(~width: w + 2 * eclass_pad, ~height: h + 2 * eclass_pad,
                  ~fill: eclass_grey, ~line: #false, ~rounded: -0.35),
     x - eclass_pad, y - eclass_pad, band_below]
  def r_one = region(col_r, row_in, nd, nd)
  def r_plus = region(col_l, row_mid, nd, nd)
  def r_row = region(col_r, row_mid, col_far + nd - col_r, nd)
  def r_a = region(col_l, row_in, nd, nd)
  def r_out = region(col_l, row_out, col_r + nd - col_l, nd)
  def r_blob = [root_region, 783.351, 463.479, band_below]
  def classes_under:
    { #'r_one: r_one, #'r_plus: r_plus, #'r_row: r_row,
      #'r_a: r_a, #'r_out: r_out }
  def merged_under:
    { #'r_one: r_one, #'r_plus: r_plus, #'r_row: r_row, #'blob: r_blob }

  // The bubble extraction speaks through: it names the job while the walk runs, and
  // it points at the *class* the answer is to come out of, not at a node in it.
  // That is what extraction is asked for: a term out of a class, with which of its
  // nodes to use still to be decided. So the class the root sits in is the target,
  // which is the bottom row until the last rule fires and the blob after it.
  //
  // The bottom row is that class in both states: once the rule fires the blob's
  // lower lobe covers the same ground, so the spike lands on the grey either way
  // and the bubble does not have to jump when the classes merge. The blob's own
  // bounding box is no use for aiming -- it is a thin snake in a tall box, and a
  // spike stopping at that box lands in empty space beside another class.
  //
  // It is built once, as a layer of its own, and the same layer is handed to every
  // press that shows it -- a bubble rebuilt per press is a new pict each time and
  // would blink. What it points at is a laundered ghost of the region, placed where
  // the region goes: the callout needs something to aim at, and a second copy of
  // the region itself would be a second thing to find.
  def task_over:
    def content:
      as_pict(textbox(~width: 436.0, ~height: 126.0, ~anchor: #'center, ~autofit: #'grow,
                      ~insets: insets(0.0, 0.0, 0.0, 0.0),
                      para(~align: #'center,
                           run("extract", ~font: prose_font, ~size: 48.0, ~bold: #true),
                           run(" a resulting term", ~font: prose_font, ~size: 48.0))))
    { #'task: [bubble_at(r_out[0], ~spot: [r_out[1], r_out[2]],
                         ~body: [1370.0, 800.0], ~color: talk_blue,
                         ~content: content),
               0.0, 0.0, band_above] }

  // The pointer walks a row of classes per press, down its own lane. It is one
  // pict under one key, so it travels down the rows rather than jumping.
  def pointer = as_pict(walk_arrow())
  fun point_at(row_y :: Real) :: List: [706.0, row_y + nd / 2 - 17.0]

  // The graph being built: the rules, the term, the rewrite of it, and the 0 the
  // second rule makes. Each press brings its nodes and their edges and leaves
  // everything already on the slide exactly as it was.
  // ---------------------------------------------------------------- the input term
  //
  // Drawn as one pict per glyph, laid out here rather than by a text box, so that a
  // subterm can be marked, copied, and walked out into the graph. Keynote's box
  // shrank 60pt text to fit itself; 45pt with a point and a half taken out between
  // the glyphs is what that came to, measured off the old rendering.
  //
  // The pieces that become nodes are keyed by the *node* they become. Turning text
  // into graph is then one press: the glyph travels to where its node goes and turns
  // into it on the way, which is what says that this box in the picture is that
  // piece of the term.
  def term_font = draw.Font(~name: prose_font, ~size: 45.0)
  def term_strs = ["(", "a", " ", "+", " ", "1", ")", " ", "-", " ", "1"]
  def term_glyphs = for List (s in term_strs): pc.text(s, ~font: term_font)
  def values(term_offs, term_w):
    for values(acc :~ List = [], dx :~ Real = 0.0) (g :~ pc.Pict in term_glyphs, i in 0..):
      values(acc ++ [dx - 1.5 * i], dx + g.width)
  fun term_run(i :: Int, j :: Int) :: pc.Pict:
    for values(q :~ pc.Pict = pc.blank(~width: 0.0, ~height: 0.0)) (k in i..j):
      pc.overlay(~horiz: #'left, ~vert: #'top, ~dx: term_offs[k] - term_offs[i], ~dy: 0.0,
                 q, term_glyphs[k])
  // where the label and the line go, so that their ink lands where the box put it
  def label_x = 99.0
  def label_y = 255.0
  def term_x = 129.0
  def term_y = 370.0
  // and where a copy of a subterm goes to be looked at: the empty band over the
  // graph, between the term it came from and the rules
  def copy_x = 760.0
  def copy_y = 320.0
  def input_label = pc.text("Input term:", ~font: term_font)
  def input_line = term_run(0, term_strs.length())

  // a band behind the glyphs `i` up to `j`, as the code slides mark a line
  fun term_mark(i :: Int, j :: Int) :: List:
    def w = term_offs[j - 1] - term_offs[i] + (term_glyphs[j - 1] :~ pc.Pict).width
    [pc.rectangle(~width: w + 16.0, ~height: (term_glyphs[i] :~ pc.Pict).height,
                  ~fill: highlight, ~line: #false, ~rounded: -0.3),
     term_x + term_offs[i] - 8.0, term_y]
  // the copy of `(a + 1)`, glyph by glyph, at `x`: the three that become nodes are
  // keyed by their nodes, and the brackets are keyed to themselves so they can fade
  fun sub_picts(x :: Real, y :: Real) :: Map:
    for values(m :~ Map = {}) ([key, i] in [[#'open, 0], [#'a, 1], [#'plus, 3],
                                            [#'one, 5], [#'close, 6]]):
      m ++ { key: [term_glyphs[i], x + term_offs[i], y] }
  // and the copy of the whole term: the subterm that is a node already, the operator
  // that is about to become one, and the `1` that is a node already
  def whole_left = term_run(0, 7)
  fun whole_picts(x :: Real, y :: Real) :: Map:
    { #'whole_left: [whole_left, x + term_offs[0], y],
      #'minus: [term_glyphs[8], x + term_offs[8], y],
      #'whole_right: [term_glyphs[10], x + term_offs[10], y] }

  def sub_mark = { #'mark: term_mark(0, 7) }
  def whole_mark = { #'mark: term_mark(0, term_strs.length()) }
  def term_nodes = spots_of([#'a, #'one, #'plus], [])

  def build:
    [Frame(),
     Frame(~picts: rules_over),
     // `(a + 1)`: marked in the term, then a copy of it out into the open, then the
     // glyphs turning into the nodes they name, with the arrows arriving
     Frame(~picts: rules_over ++ sub_mark ++ sub_picts(term_x, term_y)),
     Frame(~picts: rules_over ++ sub_mark ++ sub_picts(copy_x, copy_y)),
     Frame(~picts: rules_over ++ sub_mark ++ flow_over ++ term_nodes,
           ~edges: es_plus),
     // then the whole term, the same way, which adds the `−` and its two arrows.
     // Its other two pieces are already in the graph, so they have nowhere to go and
     // fade where they stand.
     Frame(~picts: rules_over ++ whole_mark ++ flow_over ++ term_nodes
                     ++ whole_picts(term_x, term_y),
           ~edges: es_plus),
     Frame(~picts: rules_over ++ whole_mark ++ flow_over ++ term_nodes
                     ++ whole_picts(copy_x, copy_y),
           ~edges: es_plus),
     Frame(~picts: rules_over ++ flow_over ++ spots_of(keys_term, []),
           ~edges: es_term),
     // and then the rewrites, as before
     Frame(~picts: spots_of(keys_rewrite, []) ++ rules_over ++ flow_over,
           ~edges: es_term ++ es_rewrite),
     Frame(~picts: spots_of(keys_all, []) ++ rules_over ++ flow_over,
           ~edges: es_graph)]

  // Then what extraction does with it: the classes drawn, the job named, and the
  // walk down the rows.
  fun frame(~picks: picks :: List = [], ~point: point = #false,
            ~task: task = #false, ~third: third = #false,
            ~merged: merged = #false) :: Frame:
    Frame(~picts: spots_of(keys_all, picks)
                    ++ (if point == #false
                        | {}
                        | { #'point: [pointer, & point_at(point)] })
                    ++ (if merged | merged_under | classes_under)
                    ++ rules_over ++ flow_over
                    ++ (if third | third_over | {})
                    ++ (if task | task_over | {}),
          ~edges: es_graph ++ (if merged | es_merged | []))
  fun walking(~picks: picks :: List = [], ~point: point = #false,
              ~third: third = #false, ~merged: merged = #false) :: Frame:
    frame(~task: #true, ~picks: picks, ~point: point, ~third: third, ~merged: merged)

  // The walk picks a node out of *every* class, not only the classes the answer
  // turns out to need -- that is what extraction does, since which classes the
  // answer needs is not known until the root is reached. Then the choices that
  // nothing reaches fade, and what is left is one term.
  def all_picks = [#'a, #'one, #'plus, #'zero, #'plus_r]
  def reached = [#'a, #'zero, #'plus_r]

  // The term the walk found, with the e-graph gone: the same green nodes, in the
  // shape of the term they spell out, with the graph and the regions and the rest
  // of the nodes faded off around them. What is left standing is everything that
  // was never part of the e-graph -- the title, the input term and the rules.
  //
  // `a + 0`, as a term: the `+` under the two it is built from, which is the way
  // round this slide draws everything else. Its edge to `a` is written the way the
  // graph writes it, so that it is the same edge in both and travels with its ends
  // instead of being swapped for another; its edge to `0` is new, since in the
  // graph that operand is the class `0` is the cheapest node of.
  def term_1:
    Frame(~picts: { #'a: [green[#'a], 880.0, 520.0],
                    #'zero: [green[#'zero], 1120.0, 520.0],
                    #'plus_r: [green[#'plus_r], 1000.0, 730.0] } ++ rules_over,
          ~edges: [[#'op_blue, #'plus_r, #'a], [#'op_blue, #'plus_r, #'zero]])
  // and then just `a`
  def term_2:
    Frame(~picts: { #'a: [green[#'a], 1000.0, 620.0] } ++ rules_over ++ third_over)

  // the page every press draws over: the canvas, the label, and the term itself
  def page:
    put(put(as_pict(base_canvas), input_label, label_x, label_y),
        input_line, term_x, term_y)

  magic_slide(
    page,
    build
      ++ [// the classes, and then the job, each on its own press
          frame(),
          walking(),
          // down the graph, a row of classes at a time. Two presses per row: the
          // pointer arrives, and then the nodes are picked out of the classes in
          // that row. Both halves are worth a beat -- which classes we are looking
          // at is a step of the algorithm, and which node wins is the decision.
          walking(~point: row_in),
          walking(~point: row_in, ~picks: [#'a, #'one]),
          walking(~point: row_mid, ~picks: [#'a, #'one]),
          walking(~point: row_mid, ~picks: [#'a, #'one, #'plus, #'zero]),
          walking(~point: row_out, ~picks: [#'a, #'one, #'plus, #'zero]),
          walking(~point: row_out, ~picks: all_picks),
          // the choices nothing reaches fade, and what is left moves out into the term
          walking(~picks: reached),
          term_1,
          // then back into the graph, as it was
          walking(~picks: reached),
          // the rule that changes the answer goes up, on a press of its own: it is
          // the reason the answer changes, so it is worth a beat before it fires
          walking(~picks: reached, ~third: #true),
          // and fires: `a` is now in the root class, and the two regions are one
          frame(~third: #true, ~merged: #true),
          // the same walk again, down the same rows
          walking(~third: #true, ~merged: #true, ~point: row_in),
          walking(~third: #true, ~merged: #true, ~point: row_in, ~picks: [#'a, #'one]),
          walking(~third: #true, ~merged: #true, ~point: row_mid, ~picks: [#'a, #'one]),
          walking(~third: #true, ~merged: #true, ~point: row_mid,
                  ~picks: [#'a, #'one, #'plus, #'zero]),
          // the root class holds `a` itself now, so its own cheapest node is one we
          // already have and this press adds no pick, only the pointer
          walking(~third: #true, ~merged: #true, ~point: row_out,
                  ~picks: [#'a, #'one, #'plus, #'zero]),
          // and this time nothing else is reached at all, and the term is one node
          frame(~third: #true, ~merged: #true, ~picks: [#'a]),
          term_2],
    ~wire: wire)

// -------------------------------------------------------------------------------------
// slide_20: slide_2 again, marking which of those tools need effects.
//
// This *is* slide_2: it starts from slide_2's own settled frame rather than
// repeating the grid. Editing slide_2 moves this slide with it. The two had been
// written out separately and had drifted -- to different logo positions and
// different logo scales -- which is exactly what deriving one from the other stops.
fun slide_20():
  // slide_2 as it stands once every application has appeared. It is a function
  // now -- a slide is built when it is shown -- so it is called, once, rather
  // than named twice.
  def grid = slide_2()
  def shown = grid.snapshot(grid.duration - 1, 1.0)

  // Which of these need effectful e-graphs. Each sits just under its logo's ink,
  // the way slide_2's own "Luminal" sits under the ML Kernels logo -- ink rather
  // than bounding box, because the logos carry very different bottom padding.
  def notes:
    group_pict(~width: slide_width, ~height: slide_height,
               at(228.358, 522.666, ~tag: "(Herbie)",
                  linebox(~width: 181.512, ~height: 64.608, ~autofit: #'grow,
                          ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                               run("(Herbie)", ~font: prose_font,
                                   ~size: 48.0)))),
               at(905.804, 943.181, ~tag: "(Cranelift)",
                  linebox(~width: 222.408, ~height: 64.608, ~autofit: #'grow,
                          ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                               run("(Cranelift)", ~font: prose_font,
                                   ~size: 48.0)))),
               at(489.157, 1011.599, ~tag: "(Szalinski)",
                  linebox(~width: 230.424, ~height: 64.608, ~autofit: #'grow,
                          ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                               run("(Szalinski)", ~font: prose_font,
                                   ~size: 48.0)))))

  // the notes are part of the picture from the moment the slide arrives; the
  // bubble is the one thing revealed on a click
  def base:
    pc.overlay(~horiz: #'left, ~vert: #'top, shown, as_pict(notes))

  def stage_1:
    // The body goes in the band between the two rows, right of centre: the left of
    // that band is taken by "(Herbie)" and the right by the "Luminal" note, and this
    // is the clear stretch between them. Sitting between the rows it points into is
    // what lets two spikes leave upwards and two downwards, rather than four of them
    // crossing the picture from one side.
    def slot = pc.blank(~width: 1.0, ~height: 1.0)
    // Each marker is one logo's ink. Two of these images have no alpha channel and
    // are opaque white to their edges, so the extent has to come from where the
    // drawing stops being white -- MLIR's artwork is 507pt of its 634pt box, and
    // aiming at the box would leave the spike short of the logo by 60pt.
    def m_numba = pc.blank(~width: 256.0, ~height: 250.4)
    def m_luminal = pc.blank(~width: 264.6, ~height: 264.6)
    def m_cranelift = pc.blank(~width: 404.6, ~height: 232.1)
    def m_mlir = pc.blank(~width: 507.1, ~height: 169.5)
    fun place(base, p, x, y):
      pc.overlay(~horiz: #'left, ~vert: #'top, ~dx: x, ~dy: y, base, p)
    def placed:
      place(place(place(place(place(pc.blank(~width: slide_width, ~height: slide_height),
                                    slot, 950.0, 530.0),
                              m_numba, 702.7, 288.8),
                        m_luminal, 1571.6, 257.5),
                  m_cranelift, 809.2, 699.1),
            m_mlir, 1319.7, 740.3)
    multi_callout(~on: placed, ~place: slot,
                  ~at: [m_numba, m_luminal, m_cranelift, m_mlir],
                  ~color: talk_red, ~padding: 10.0,
                  as_pict(linebox(~width: 404.2, ~height: 57.6, ~autofit: #'grow,
                                  ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                  para(~align: #'center,
                                       run("need side effects!", ~font: prose_font,
                                           ~size: 48.0, ~bold: #true)))))

  staged(base, [stage_1])

// -------------------------------------------------------------------------------------
// slide_update, slide_egraph, slide_rue: the `update` example, as one story.
//
// Straight-line code first, as anyone would write it; what one `update` does;
// the state values, magic-moved into the code; the e-graph built up one `update`
// per press; a rule over `update`; and the rule applied, as a union. The code
// box sits in one place on all three slides, so it stays put across the cuts.
//
// The code is picts rather than a text box, so that its pieces can move: the
// `(`, `, ω`, `)` and the state argument of the state form are new picts that
// fade in, while `v`, its subscript, `= update(a, x` and the closing paren are
// the *same* picts in both forms and slide to make room. `code_parts` builds
// every piece once, for both layouts, which is what `magic_move` matches on.
//
// The signature moves with them. It is what says which names come from outside:
// the plain form takes `a`, `x`, `b`, `y` and `c`, and the state form grows a
// `, ω`, because making the state an argument like any other is the whole point
// of the slide. The parameters are in the order the graph's input row uses them,
// so the row above the graph reads the same as the line above the code.
def code_face = draw.Font(~name: code_font, ~size: code_size)
def math_face = draw.Font(~name: math_font, ~size: code_size)
fun code(s :: String) :: pc.Pict: pc.text(s, ~font: code_face)
fun code_sub(s :: String) :: pc.Pict: code(s).scale(0.6)
// the Greek is set in the notation face, as everywhere else in the deck: PT Mono
// has none
fun greek(s :: String) :: pc.Pict: pc.text(s, ~font: math_face)
def code_indent = code("  ").width    // the body, inside the signature

// A bordered box. The runtime's shape rather than pict's `rectangle`: a pict
// outline borrows the pen *style* of the surface it lands on, and the canvas
// leaves a transparent pen behind it, so a pict's border drawn straight onto a
// slide comes out invisible. The runtime's shapes set their own pen.
fun frame_box(w :: Real, h :: Real, ~rounded: r = #false) :: pc.Pict:
  as_pict(shape_pict(~width: w, ~height: h,
                     ~geom: if r | preset_geom("roundRect", [pair("adj", "val " +& r)]) | #false,
                     ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 1.0)))

// A line built from its pieces, in the order they are written. A piece with a role
// is one that stands for a node in the graph; `#false` is punctuation.
fun segs_pict(segs :~ List) :: pc.Pict:
  pc.beside(~vert: #'bottom,
            & List.append(& for List ([role, ps] in segs): ps))

// The named pieces of a line, as [role, pict, x offset from the line's left].
fun segs_pieces(segs :~ List) :: List:
  def values(out, _):
    for values(acc :~ List = [], dx :~ Real = 0.0) ([role, ps] in segs):
      def w: for values(t :~ Real = 0.0) (p :~ pc.Pict in ps): t + (p :~ pc.Pict).width
      values((if role == #false
              | acc
              | acc ++ [[role, pc.beside(~vert: #'bottom, & ps), dx]]),
             dx + w)
  out

fun code_parts() :: Map:
  // The signature. `fun foo(a, x` and `):` are the same picts in both forms, so
  // they are what the move slides along; the `, ω` between them belongs to the
  // state form alone and fades in.
  def sig_head = code("fun foo(a, x")
  def sig_close = code("):")
  def header:
    {#'plain: pc.beside(~vert: #'bottom, sig_head, sig_close),
     #'states: pc.beside(~vert: #'bottom, sig_head, code(", "), greek("ω"), sig_close)}
  // Two writes to one address: the first stores `x`, the second overwrites it with
  // `x + 1`. The program still needs what `a` held before, and it needs the memory
  // it ends with, so it returns both.
  //
  // Every piece of a line that stands for something in the graph is its own pict,
  // so that `slide_egraph` can lift it out and turn it into that node. The pieces
  // both forms of a line have in common are built once and used twice, which is
  // what `slide_update`'s move slides along.
  def updates:
    for List (i in 1..3):
      def v = code("v")
      def v_sub = code_sub(to_string(i))
      def omega_out = greek("ω")
      def omega_out_sub = code_sub(to_string(i))
      def op = code(" = update(")
      def arg1 = code("a")
      def arg_comma = code(", ")
      // the first write stores the variable; the second stores one more than it,
      // which is what makes the two writes cost different amounts to perform
      def wrote:
        if i == 1 | [code("x")] | [code("x"), code("+"), code("1")]
      def omega_in = greek("ω")
      def omega_in_sub = if i == 1 | [] | [code_sub(to_string(i - 1))]
      def close = code(")")
      def segs:
        [[#false, [code("(")]],
         [#'value, [v, v_sub]],
         [#false, [code(", ")]],
         [#'state, [omega_out, omega_out_sub]],
         [#false, [code(")")]],
         [#'op, [op]],
         [#'arg1, [arg1]],
         [#false, [arg_comma]],
         [#'wrote, wrote],
         [#false, [code(", ")]],
         [#'state_in, [omega_in] ++ omega_in_sub],
         [#false, [close]]]
      {#'plain: pc.beside(~vert: #'bottom, v, v_sub, op, arg1, arg_comma,
                          & wrote, close),
       #'states: segs_pict(segs),
       #'omega: omega_out,
       #'segs: segs}
  // What the program hands back, and so what extraction is asked for: what `a` held
  // before the first write, and the memory the second one leaves.
  def ret_head = code("return ")
  def ret_v = code("v")
  def ret_sub = code_sub("1")
  def ret:
    def segs:
      [[#'op, [ret_head]],
       [#false, [code("(")]],
       [#'value, [ret_v, ret_sub]],
       [#false, [code(", ")]],
       [#'state, [greek("ω"), code_sub("2")]],
       [#false, [code(")")]]]
    {#'plain: pc.beside(~vert: #'bottom, ret_head, ret_v, ret_sub),
     #'states: segs_pict(segs),
     #'segs: segs}
  def lines = updates ++ [ret]
  // The frame is measured, and measured against the *state* form: a box sized to
  // the plain form would have to grow as the code moves into the state form, and
  // one sized by hand is how the code came to overflow its own border.
  def body_w:
    for values(m :~ Real = 0.0) (l :~ Map in lines):
      math.max(m, (l[#'states] :~ pc.Pict).width)
  def content_w = math.max((header[#'states] :~ pc.Pict).width, code_indent + body_w)
  def frame = frame_box(content_w + 2 * code_inset,
                        (1 + lines.length()) * code_row + 2 * code_inset)
  {#'frame: frame, #'header: header, #'lines: lines}

// The box with its five lines -- the signature, then one per `update` -- in one
// form or the other.
fun code_pict(parts :~ Map, ~states: states :: Boolean) :: pc.Pict:
  fun pick(m :~ Map) :~ pc.Pict: if states | m[#'states] | m[#'plain]
  def rows :~ List = [pick(parts[#'header]), & for List (l in parts[#'lines]): pick(l)]
  for values(p :~ pc.Pict = parts[#'frame]) (q :~ pc.Pict in rows, k in 0..):
    pc.overlay(~horiz: #'left, ~vert: #'top,
               ~dx: code_inset + (if k == 0 | 0.0 | code_indent),
               ~dy: code_inset + code_row * k + (code_row - q.height) / 2,
               p, q)

// A pict at (x, y) on `base`, top-left corner; `p` may be one of the runtime's picts.
fun put(base :: pc.Pict, p, x :: Real, y :: Real) :: pc.Pict:
  pc.overlay(~horiz: #'left, ~vert: #'top, ~dx: x, ~dy: y, base, as_pict(p))

// The line of the code box naming the `update` just put into the e-graph, marked
// as with a highlighter: a translucent band over it. `k` counts the `update`
// lines from 0, so the signature above them is not one of them. The band comes
// back as a pict and where to put it, not drawn onto anything, so that the same
// band can be handed to press after press: a scene fades in what it has and the
// press before it has not, and a band rebuilt for each press is a new thing every
// time and would blink.
def highlight = draw.Color(38, 132, 235, 0.25)
fun band_of(parts :~ Map, k :: Int) :: List:
  def frame :~ pc.Pict = parts[#'frame]
  def band = pc.rectangle(~width: frame.width - 2 * code_inset, ~height: code_row - 12.0,
                          ~fill: highlight, ~line: #false, ~rounded: -0.3)
  [band, code_x + code_inset, code_y + code_inset + code_row * (k + 1) + 6.0]

// A pict scaled to exactly the width it is given, up or down.
fun fill_width(p :: pc.Pict, w :: Real) :: pc.Pict: p.scale(w / p.width)

// A bubble pointing at a node, on a transparent layer of its own.
//
// Built once and handed to every press that shows it: a bubble rebuilt per press is
// a new pict each time, and a new pict fades in over the old one instead of staying
// put. What it points at is a laundered ghost of the node placed where that node
// goes -- the callout needs something to aim at, and a second copy of the node
// itself would be a second thing to find. `~body` is where the bubble's own corner
// lands; the spike is worked out from there.
fun bubble_at(node, ~spot: spot :~ List, ~body: body :~ List,
              ~color: color, ~content: content :: pc.Pict) :: pc.Pict:
  def marker = pc.blank(~width: 1.0, ~height: 1.0)
  def target = as_pict(node).launder().ghost()
  def probe:
    put(put(blank_slide, marker, body[0], body[1]), target, spot[0], spot[1])
  multi_callout(~on: probe, ~place: marker, ~at: [target],
                ~color: color, ~padding: 18.0, content)

// A word for a bubble that has to fit somewhere narrow.
def small_face = draw.Font(~name: prose_font, ~size: 32.0, ~weight: #'bold)
fun small_prose(s :: String) :: pc.Pict: pc.text(s, ~font: small_face)

// A sentence for a bubble, in the deck's Helvetica Neue: each item is a string
// and how it is set, `#'plain`, `#'bold` or `#'sub`.
def prose_face = draw.Font(~name: prose_font, ~size: 40.0)
def prose_bold = prose_face with (weight = #'bold)
fun prose(items :: List) :: pc.Pict:
  pc.beside(~vert: #'bottom,
            & for List ([s, style] in items):
                match style
                | #'bold: pc.text(s, ~font: prose_bold)
                | #'sub: pc.text(s, ~font: prose_face).scale(0.6)
                | ~else: pc.text(s, ~font: prose_face))

// Several of those, stacked. A bubble beside the code box has the slide's right
// half to live in, and a sentence long enough to need more than that is broken
// across lines here rather than left to run off the edge.
fun prose_stack(rows :: List) :: pc.Pict:
  pc.stack(~sep: 4.0, ~horiz: #'left, & for List (r in rows): prose(r))

// A slide with the deck's title at the deck's place, and nothing else yet.
fun titled(title :: String) :: pc.Pict:
  as_pict(slide_canvas(
            ~width: slide_width, ~height: slide_height,
            ~background: hex("FFFFFF"),
            at(95.0, 85.0, ~tag: title,
               textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                       ~insets: insets(4.0, 4.0, 4.0, 4.0),
                       para(~line_spacing: pair(#'percent, 0.8),
                            run(title, ~font: prose_font, ~size: 85.0, ~bold: #true,
                                ~spacing: -1.7))))))

// Keynote's little "program becomes a tree" icon in the top-right corner.
fun with_icon(canvas :: pc.Pict) :: pc.Pict:
  fun box():
    shape_pict(~width: 23.528, ~height: 23.528,
               ~geom: preset_geom("roundRect", [pair("adj", "val 30640")]),
               ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0))
  def [b1, b2, b3, b4, b5, b6, b7] = for List (i in 0..7): box()
  fun bar(x, y, w):
    at(x, y, ~tag: "Rectangle", shape_pict(~width: w, ~height: 5.15, ~fill: hex("929292")))
  def icon:
    group_pict(~width: 327.683, ~height: 182.827,
               at(0.0, 62.869, ~tag: "Group (2)",
                  group_pict(~width: 106.985, ~height: 66.994,
                             at(0.0, 0.0, ~tag: "Rectangle",
                                shape_pict(~width: 106.985, ~height: 66.994, ~fill: hex("FFFFFF"),
                                           ~line: make_stroke(hex("000000"), ~width: 1.0))),
                             bar(4.646, 4.397, 60.549), bar(11.612, 11.976, 64.295),
                             bar(11.612, 19.555, 79.846), bar(19.007, 27.133, 34.404),
                             bar(11.612, 34.712, 49.795), bar(19.007, 42.29, 56.852),
                             bar(11.612, 49.869, 47.325), bar(11.612, 57.447, 90.727))),
               at(193.792, 0.0, ~tag: "Group (3)",
                  group_pict(~width: 133.891, ~height: 182.827,
                             at(110.363, 159.299, ~tag: "Rounded Rectangle", b1),
                             at(82.772, 107.433, ~tag: "Rounded Rectangle (2)", b2),
                             at(55.182, 159.299, ~tag: "Rounded Rectangle (3)", b3),
                             at(55.182, 53.717, ~tag: "Rounded Rectangle (4)", b4),
                             at(32.239, 107.433, ~tag: "Rounded Rectangle (5)", b5),
                             at(0.0, 159.299, ~tag: "Rounded Rectangle (6)", b6),
                             at(55.182, 0.0, ~tag: "Rounded Rectangle (7)", b7))),
               at(150.474, 85.484, ~tag: "Arrow",
                  shape_pict(~width: 37.732, ~height: 21.764,
                             ~geom: preset_geom("rightArrow",
                                                [pair("adj1", "val 34890"), pair("adj2", "val 56320")]),
                             ~fill: hex("000000"))))
  arrows(~on: put(canvas, icon, 1476.341, 50.118),
         [[b2, b1], [b2, b3], [b5, b3], [b5, b6], [b7, b4], [b4, b1], [b4, b2], [b4, b5]],
         ~line_width: 2)

// The nodes of the `update` chain. Values black, states blue, as Keynote had them.
// The nodes of the `update` chain, values black and states blue. `picked` names
// the ones extraction has chosen, which are built with a green background instead
// of a white one -- the same node, drawn as picked, rather than a mark over it.
fun chain_nodes(~picked: picked :: List = [],
                ~forked: forked :: List = []) :: Map:
  fun label(s): run(s, ~font: node_font, ~size: 40.0)
  fun sub(i): run(to_string(i), ~font: node_font, ~size: 40.0, ~baseline: -0.06)
  fun node(key, w, color, lw, runs):
    graph_node(~width: w, ~height: if w > 100 | 64.0 | 63.486,
               ~adj: if w > 100 | "33349" | "33878",
               ~line: color, ~line_width: lw,
               ~fill: (cond
                       | forked.contains(key): node_fork
                       | picked.contains(key): node_green
                       | ~else: node_white),
               & runs)
  fun leaf(key, s): node(key, 64.0, "000000", 3.0, [label(s)])
  fun value(key, i): node(key, 64.0, "000000", 3.0, [label("v"), sub(i)])
  fun state(key, i):
    node(key, 64.0, stateful_hex, 4.0,
         if i == 0 | [label("ω")] | [label("ω"), sub(i)])
  fun op(key): node(key, 180.242, stateful_hex, 4.0, [label("update")])
  // `return` takes a state as well as a value, so it is one of the stateful ones
  {#'ret: node(#'ret, 180.242, stateful_hex, 4.0, [label("return")]),
   #'a: leaf(#'a, "a"), #'x: leaf(#'x, "x"), #'one: leaf(#'one, "1"),
   // the value the second write stores, and the reason the two writes cost
   // different amounts to perform
   #'xp: node(#'xp, 116.0, "000000", 3.0, [label("x+1")]),
   #'s0: state(#'s0, 0), #'s1: state(#'s1, 1),
   #'s2: state(#'s2, 2), #'s3: state(#'s3, 3),
   #'v1: value(#'v1, 1), #'v2: value(#'v2, 2), #'v3: value(#'v3, 3),
   #'u1: op(#'u1), #'u2: op(#'u2), #'us: op(#'us)}

// What each `update` brings with it: its own box, the inputs it is the first to
// use, and the value and state it returns, each at [key, x, y, tag].
// `chain_spots_upto` reads the first `upto` of these groups, so the picture grows
// one `update` per press, downwards, and nothing already on screen moves.
//
// The inputs all arrive with the first `update` that uses them, since they go in
// the row along the top rather than beside the `update` that reads them.
// The graph as data, so that an extraction over it can be worked out rather than
// written down: each node's class, the classes its arguments come from, and which
// layer it sits on. The rule's unions are here and nowhere else, so what follows
// from them follows automatically.
//
// One rule, stated once: the first write is overwritten, so the memory after both
// writes is the memory after the second alone, and what the first write returned is
// what that single write returns. The rule *adds* a node, `us`, and that is what
// makes extraction have a choice it can get wrong: `us` and `u1` both read the
// memory the program started with.
//
//   [key, class, argument classes, layer]
def chain_graph:
  [[#'a, #'k_a, [], 0], [#'x, #'k_x, [], 0], [#'one, #'k_one, [], 0],
   [#'s0, #'k_s0, [], 0],
   // `x + 1` is drawn in the row of inputs, so it shares their layer: its own
   // operands are listed before it, which is all the cost pass needs
   [#'xp, #'k_xp, [#'k_x, #'k_one], 0],
   [#'u1, #'k_u1, [#'k_a, #'k_x, #'k_s0], 1],                 // the write the program has
   [#'us, #'k_us, [#'k_a, #'k_xp, #'k_s0], 1],                // the write the rule adds
   [#'v1, #'k_old, [#'k_u1], 2], [#'s1, #'k_s1, [#'k_u1], 2],
   [#'v3, #'k_old, [#'k_us], 2], [#'s3, #'k_fin, [#'k_us], 2],
   [#'u2, #'k_u2, [#'k_a, #'k_xp, #'k_s1], 3],                // the overwrite
   [#'v2, #'k_v2, [#'k_u2], 4], [#'s2, #'k_fin, [#'k_u2], 4],
   [#'ret, #'k_ret, [#'k_old, #'k_fin], 5]]

// The nodes that carry memory, which are the ones that must not be shared: a value
// can be read twice, a state cannot.
def chain_states = [#'s0, #'s1, #'s2, #'s3]
def chain_layers = 6

// The cheapest node in each class. A node costs one plus the cost of the classes
// it takes, and a class costs what its cheapest node does; the nodes are listed in
// the order the data flows, so one pass down the list settles all of them.
fun chain_best(g :~ List) :: Map:
  for values(best :~ Map = {}) ([key, cls, args, _] in g):
    def cost:
      for values(c = 1) (a in args):
        c + ((best[a] :~ List)[1] :~ Int)
    if !best.has_key(cls) || cost < ((best[cls] :~ List)[1] :~ Int)
    | best ++ { cls: [key, cost] }
    | best

// What each node takes, by key, and -- the same under either rule, since a node's
// row does not move -- which layer each one sits on.
fun chain_args_of(g :~ List) :: Map:
  for values(m :~ Map = {}) ([key, _, args, _] in g): m ++ { key: args }
def chain_layer_of:
  for values(m :~ Map = {}) ([key, _, _, layer] in chain_graph): m ++ { key: layer }

// The classes the root reaches, following the cheapest node out of each.
fun chain_reached(g :~ List, ~root: root) :: List:
  def best = chain_best(g)
  def args = chain_args_of(g)
  recur walk(cls = root, seen :~ List = []):
    if seen.contains(cls)
    | seen
    | block:
        def key = ((best[cls] :~ List)[0])
        for values(acc :~ List = seen ++ [cls]) (a in args[key]):
          walk(a, acc)

// The picks an extraction makes, as the walk reaches them: everything chosen on
// layer `layer` or above. A layer whose classes were all decided higher up adds
// nothing, which is what the redundant `update` looks like from here.
fun chain_picks(g :~ List, ~upto: upto :: Int) :: List:
  def best = chain_best(g)
  for List (cls in best.keys()):
    def key = ((best[cls] :~ List)[0])
    keep_when chain_layer_of[key] <= upto
    key

// and the ones that survive, which is the program the root asked for
fun chain_kept(g :~ List, ~root: root) :: List:
  def best = chain_best(g)
  for List (cls in chain_reached(g, ~root: root)): ((best[cls] :~ List)[0])

// A state read by more than one of the nodes that survive: the extraction's own
// answer to what each `update` reads, and the reason that answer is not a program.
// Sharing a value is what an e-graph is for; sharing a state means two copies of
// memory. Comes back as [reader, the state node it reads].
fun chain_forks(g :~ List, ~root: root) :: List:
  def best = chain_best(g)
  def args = chain_args_of(g)
  def kept = chain_kept(g, ~root: root)
  def readers:
    for values(m :~ Map = {}) (key in kept):
      for values(m :~ Map = m) (a in args[key]):
        m ++ { a: (if m.has_key(a) | (m[a] :~ List) ++ [key] | [key]) }
  List.append(
    & for List (cls in readers.keys()):
        def rs :~ List = readers[cls]
        def key = ((best[cls] :~ List)[0])
        keep_when rs.length() > 1 && chain_states.contains(key)
        for List (r in rs): [r, key])

// What each press of `slide_egraph` brings, in the order the program is read, and
// then what the rule adds. Each entry is [key, x, y, tag].
//
// The two writes that read the memory the program starts with are drawn side by
// side under it, which is what makes the fork legible when extraction takes both:
// two boxes reaching up to one `ω`.
// What each press of `slide_egraph` brings, in the order the program is read, and
// then what the rule adds. Each entry is [key, x, y, tag].
//
// The memory is the last of an `update`'s arguments, as it is in the paper, so it
// is the last thing in the row of inputs -- rightmost, with the two writes that read
// it below and the state chain running down that side. The address sits next to it,
// above the corridor between the two writes, because all three writes reach it and
// from there none of those edges has a box to cross. `x + 1` goes up in the row of inputs rather than under
// it: every operand edge climbs through the rows above, and a box sitting in that
// band is a box those edges have to cross. The corridor between the two writes is
// left clear for the same reason -- the overwrite reaches its operands up through
// it -- and each write's own results sit under it, value inwards, so that the two
// values the rule equates face each other across the corridor.
def chain_steps:
  [[[#'x, 1120.0, chain_y(0), "x"], [#'a, 1450.0, chain_y(0), "a"],
    [#'s0, 1620.0, chain_y(0), "ω"],
    [#'u1, 1120.0, chain_y(1), "update"],
    [#'s1, 1120.0, chain_y(2), "ω1"], [#'v1, 1210.0, chain_y(2), "v1"]],
   [[#'one, 1210.0, chain_y(0), "1"], [#'xp, 1300.0, chain_y(0), "x+1"],
    [#'u2, 1300.0, chain_y(3), "update (2)"],
    [#'v2, 1300.0, chain_y(4), "v2"], [#'s2, 1690.0, chain_y(4), "ω2"]],
   [[#'ret, 1210.0, chain_y(5), "return"]],
   // what the rule adds
   [[#'us, 1600.0, chain_y(1), "update (3)"],
    [#'v3, 1600.0, chain_y(2), "v3"], [#'s3, 1690.0, chain_y(2), "ω3"]]]

// An edge runs from a node to the ones it is built from: an `update` points at its
// arguments, and the value and state it returns point back at it. Data still flows
// down the picture; the arrowheads say what contains what.
//
// `#'up` aims the arrowhead at a node's bottom edge rather than at the point on its
// border facing the source, so the edge stays under the row it passes beneath. A
// number bows the edge instead -- see `chain_wire`. The overwrite reaches the state
// it reads with a bow, since that state's own sibling value sits between them.
def chain_value_edges:
  [[[#'u1, #'x], [#'u1, #'a], [#'v1, #'u1]],
   [[#'xp, #'x, #'up, -14.0], [#'xp, #'one, #'up, 14.0],
    [#'u2, #'a], [#'u2, #'xp], [#'v2, #'u2]],
   [[#'ret, #'v1]],
   [[#'us, #'a], [#'us, #'xp], [#'v3, #'us]]]
def chain_state_edges:
  [[[#'u1, #'s0], [#'s1, #'u1]],
   [[#'u2, #'s1, 0.28, 0.0], [#'s2, #'u2]],
   [[#'ret, #'s2]],
   [[#'us, #'s0], [#'s3, #'us]]]

// A transparent slide, for a layer that goes over the page.
def blank_slide = pc.blank(~width: slide_width, ~height: slide_height)

// Three kinds of edge. A plain one runs border to border. `#'up` comes up under
// the variable it points at, so it passes below the row rather than clipping the
// boxes along it. A number bows the edge out into the empty band below the row and
// left of the column, for the runs a straight line cannot make without crossing an
// `update` on the way -- the number is how far it bows. The fourth element pulls an
// end apart from its neighbour: two `update`s reaching the same variable arrive at
// the same point from almost the same angle, and two bows leaving the same border
// at the same place run down each other for most of their length.
fun chain_wire(q :: pc.Pict, n :~ Map, es :~ List,
               ~color: color = "black", ~line_width: lw :: Real = 4) :~ pc.Pict:
  for values(acc :~ pc.Pict = q) (e :~ List in es):
    def mode = if e.length() > 2 | e[2] | #false
    def off = if e.length() > 3 | e[3] | 0.0
    cond
    | mode == #'up:
        arrow(~on: acc, n[e[0]], n[e[1]], ~color: color, ~line_width: lw, ~gap: 4,
              // `~dy: 1`, not 5: these edges arrive at a shallow angle, and a tip
              // stopped short of a rounded corner reads as an arrow that missed
              ~to_at: pc.Find.bottom(as_pict(n[e[1]]), ~dx: off, ~dy: 1))
    | mode is_a Real:
        pc.connect(~on: acc,
                   pc.Find.left(as_pict(n[e[0]]), ~dy: off),
                   pc.Find.bottom(as_pict(n[e[1]]), ~dy: 1),
                   ~style: #'arrow, ~line: color, ~line_width: lw,
                   ~arrow_size: 4 * lw,
                   ~start_angle: math.pi, ~end_angle: math.pi / 2,
                   ~start_pull: mode, ~end_pull: mode)
    | ~else:
        arrow(~on: acc, n[e[0]], n[e[1]], ~color: color, ~line_width: lw, ~gap: 4)

// -------------------------------------------------------------------------------------
// slide_update: the three `update`s, what one does, and where the states come in.
//
// A press explains the operation. The next one magic-moves each line into its
// `(v, ω) = update(...)` form: the pieces already on screen slide right to make
// room, the parentheses and the ωs fade in around them, the first bubble goes
// and one naming the state value arrives.
fun slide_update():
  def canvas = titled("Update")
  def parts = code_parts()
  def plain = put(canvas, code_pict(parts, ~states: #false), code_x, code_y)
  def with_states = put(canvas, code_pict(parts, ~states: #true), code_x, code_y)
  // The bubbles are a layer of their own over the code, pinned at measured
  // points: `magic_move` rebuilds its two pictures piece by piece, and a balloon
  // pinned by a finder does not survive that. Kept apart, the layer can fade out
  // as the move runs and the next one fade in, which is what should happen anyway.
  def blank_layer = pc.blank(~width: slide_width, ~height: slide_height)
  // Both bubbles reach in from the right, at the height of the first line and off
  // the box's own edge -- not off the end of the line's text, which is inside the
  // box, and not from above, where the signature now is. The second replaces the
  // first in place, so the eye stays on the line they are both about.
  def (fx, _) = pc.Find.right(parts[#'frame]).in(plain)
  def first_line_y = code_y + code_inset + code_row * 1.5
  def at_first_line = pc.Find.abs(fx, first_line_y)
  def explain:
    callout(~on: blank_layer, ~at: at_first_line, ~spike: #'w,
            prose_stack([[["Write ", #'plain], ["x", #'bold], [" to address ", #'plain],
                          ["a", #'bold], [",", #'plain]],
                         [["return the previous value at ", #'plain], ["a", #'bold]]]))
  def name_state:
    callout(~on: blank_layer, ~at: at_first_line, ~spike: #'w,
            prose_stack([[["ω", #'plain], ["1", #'sub], [" is the state of memory", #'plain]],
                         [["after the update", #'plain]]]))
  def explained = put(plain, explain, 0.0, 0.0)
  def extent = 1.2
  // One bubble out, then the other in -- not both at once. They are two different
  // sentences in the same place, and crossing them leaves the middle of the move
  // showing the two of them printed over each other at half strength.
  def moving:
    pc.overlay(~horiz: #'left, ~vert: #'top,
               pc.magic_move(plain, with_states, ~other: #'fade, ~extent: extent)
                 .time_pad(~after: -1),
               pc.animate(~extent: extent, fun (t): explain.alpha(clamp01(1.0 - 2.0 * t))),
               pc.animate(~extent: extent, fun (t): name_state.alpha(clamp01(2.0 * t - 1.0))))
  pc.switch(plain, pc.cross_fade(plain, explained), moving)

// -------------------------------------------------------------------------------------
// slide_egraph: the chain of `update`s going into the e-graph, one per press, the
// code line it comes from highlighted as it lands. Cross-fades between finished
// pictures, since the highlight moves and a reveal could only add.
fun slide_egraph():
  def canvas = with_icon(titled("The Effectful E-Graph"))
  def parts = code_parts()
  def page = put(canvas, code_pict(parts, ~states: #true), code_x, code_y)

  // Each line of the program goes into the graph in two presses: the line is
  // marked, with a copy of every piece of it that means something sitting exactly
  // on top of that piece; then those copies fly right into the graph, each one
  // turning into the node it stands for as it lands.
  //
  // The copies are keyed by the nodes they become, so a piece of text and the box
  // it becomes are one thing travelling, which is the whole point: `a` in the
  // program *is* the `a` in the graph. Nothing waits in the middle, and no piece is
  // ever wider than the words it copies, so nothing crosses the edge of the slide.
  //
  // One band per line, built once, so the press that marks the next line has only
  // the band to move.
  def bands: for List (k in 0..3): band_of(parts, k) ++ [band_above]

  // Which node each piece of line `k` becomes. Only the pieces that bring a *new*
  // node are listed: by the second line its operands and its incoming state are in
  // the graph already, and the copy of a piece with nowhere to go would be motion
  // that means nothing.
  def line_targets:
    [{ #'value: #'v1, #'state: #'s1, #'op: #'u1,
       #'arg1: #'a, #'wrote: #'x, #'state_in: #'s0 },
     // the second line brings the value it writes, which is a term of its own
     { #'value: #'v2, #'state: #'s2, #'op: #'u2, #'wrote: #'xp },
     { #'op: #'ret }]

  // where the box draws line `k`, from the same measurements `code_pict` uses
  fun line_pict(k :: Int) :~ pc.Pict:
    ((parts[#'lines] :~ List)[k] :~ Map)[#'states]
  fun line_x() :: Real: code_x + code_inset + code_indent
  fun line_y(k :: Int) :: Real:
    code_y + code_inset + code_row * (k + 1) + (code_row - (line_pict(k)).height) / 2
  // the copies of line `k`'s pieces, each over the piece it copies
  fun line_copies(k :: Int) :: Map:
    def targets :~ Map = line_targets[k]
    def segs :~ List = ((parts[#'lines] :~ List)[k] :~ Map)[#'segs]
    for values(m :~ Map = {}) ([role, piece, dx] in segs_pieces(segs)):
      skip_when !targets.has_key(role)
      m ++ { targets[role]: [piece, line_x() + dx, line_y(k)] }

  chain_slide(
    page,
    [Frame(),
     & List.append(
         & for List (k in 0..3):
             def mark = { #'mark: bands[k] }
             [Frame(~picts: chain_node_picts(chain_spots_upto(k), []) ++ mark
                              ++ line_copies(k),
                    ~edges: chain_edges(k)),
              Frame(~picts: chain_node_picts(chain_spots_upto(k + 1), []) ++ mark,
                    ~edges: chain_edges(k + 1))])])

// -------------------------------------------------------------------------------------
// slide_rue: a rule over `update`, and the rule applied.
//
// The second `update(a, x)` writes what the first already wrote: it returns `x`
// and leaves the state alone. A press states that beside the code, as the paper's
// overview figure does -- the two `update`s over a long horizontal line, what they
// make equal under it -- with the two code lines it is about marked; the next one
// does the union in the e-graph.
//
// A node of an e-graph: a rounded box with a label in the middle. Both graphs in
// the deck draw their nodes with this, which is what lets a node picked by
// extraction be drawn as *the same node with a green background* -- a ring is a
// second thing laid on top, and a translucent wash over the box tints the label
// along with it.
//
// Blue is what says a thing is stateful, as the original deck had it: the state
// values and the `update`s that thread them carry a blue border, the edges between
// them are blue, and everything pure is black.
def node_white = "FFFFFF"
def node_green = "B7E3A6"                     // what extraction picked
def node_fork = "F9C4C4"                      // and what it picked twice
def stateful_hex = "0433FF"
fun graph_node(~width: w :: Real, ~height: h :: Real, ~adj: adj :: String,
               ~line: line :: String, ~line_width: lw :: Real,
               ~fill: fill :: String = node_white, & runs):
  shape_pict(~width: w, ~height: h,
             ~geom: preset_geom("roundRect", [pair("adj", "val " +& adj)]),
             ~fill: hex(fill), ~line: make_stroke(hex(line), ~width: lw),
             ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                         para(~align: #'center, & runs)))

// The pointer that walks an extraction down a graph, a press per class, in the
// blue the bubbles are drawn in. Both extraction walks use it, so a press means
// the same thing on either slide; each says where to put it, since the two graphs
// leave the room for it in different places.
def walk_hex = "2684EB"                       // `talk_blue`, as the runtime spells it
fun walk_arrow(~facing: facing :: String = "rightArrow",
               ~width: w :: Real = 80.0, ~height: h :: Real = 34.0):
  shape_pict(~width: w, ~height: h,
             ~geom: preset_geom(facing,
                                [pair("adj1", "val 45000"), pair("adj2", "val 60000")]),
             ~fill: hex(walk_hex))


def state_class = draw.Color(79, 143, 0)      // ω1 ≡ ω2
def value_class = draw.Color(255, 147, 0)     // v2 ≡ x
def rule_font = code_face with (size = 36.0)
fun rule_code(s :: String) :: pc.Pict: pc.text(s, ~font: rule_font)
fun rule_greek(s :: String) :: pc.Pict: pc.text(s, ~font: math_face with (size = 36.0))
fun rule_sub(s :: String) :: pc.Pict: rule_code(s).scale(0.6)
fun rule_line(& pieces) :: pc.Pict: pc.beside(~vert: #'bottom, & pieces)

fun update_rule(~value: value :: Boolean = #true) :: Map:
  // Dead store elimination, over the two lines of the program: the first write is
  // overwritten, so the memory after both is the memory after the second alone, and
  // what the first write returned is what that single write returns.
  //
  // Premises above the line, and what the rule concludes below it -- including the
  // write it adds, which is the whole reason extraction has a choice to get wrong.
  def premise1 = rule_line(rule_code("(v"), rule_sub("1"), rule_code(", "), rule_greek("ω"),
                           rule_sub("1"), rule_code(") = update(a, x, "), rule_greek("ω"),
                           rule_code(")"))
  def premise2 = rule_line(rule_code("(v"), rule_sub("2"), rule_code(", "), rule_greek("ω"),
                           rule_sub("2"), rule_code(") = update(a, x+1, "),
                           rule_greek("ω"), rule_sub("1"), rule_code(")"))
  // The line the rule adds, in pieces, named by the node each becomes: the value it
  // returns, the memory it leaves, and the write itself.
  def introduced_segs:
    [[#false, [rule_code("(")]],
     [#'value, [rule_code("v"), rule_sub("3")]],
     [#false, [rule_code(", ")]],
     [#'state, [rule_greek("ω"), rule_sub("3")]],
     [#false, [rule_code(")")]],
     [#'op, [rule_code(" = update(a, x+1, "), rule_greek("ω"), rule_code(")")]]]
  def introduced = segs_pict(introduced_segs)
  fun same(): pc.text(" ≡ ", ~font: prose_face with (size = 36.0))
  // Each equality in the colour of the class it makes, which is what ties the two
  // statements to the two regions in the graph.
  def equalities:
    pc.beside(~sep: 72.0, ~vert: #'bottom,
              rule_line(rule_code("v"), rule_sub("1"), same(), rule_code("v"),
                        rule_sub("3")).colorize(value_class),
              rule_line(rule_greek("ω"), rule_sub("2"), same(), rule_greek("ω"),
                        rule_sub("3")).colorize(state_class))
  def below:
    if value
    | pc.stack(~sep: 10.0, ~horiz: #'center, introduced, equalities)
    | introduced
  def w:
    math.max(premise1.width, math.max(premise2.width, below.width))
  def bar = pc.rectangle(~width: w, ~height: 3.0, ~fill: "black", ~line: #false)
  def body:
    pc.stack(~sep: 14.0, ~horiz: #'center, premise1, premise2, bar, below)
  def box:
    as_pict(shape_pict(~width: body.width + 40.0, ~height: body.height + 40.0,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 6000")]),
                       ~fill: hex("E2E2E2"), ~line: make_stroke(hex("000000"), ~width: 1.0)))
  // The pict, and where inside it the line it introduces is drawn, so that a copy
  // of that line's pieces can be lifted off the rule and flown into the graph. The
  // body is centred in the box, and each row is centred in the body.
  { #'pict: pc.overlay(box, body),
    #'segs: introduced_segs,
    #'at: [20.0 + (body.width - introduced.width) / 2,
           20.0 + premise1.height + 14.0 + premise2.height + 14.0 + bar.height + 14.0] }

// Nodes marked as sharing an e-class: a ring around each, in the class's own
// colour, drawn over the picture.
//
// A ring rather than a filled capsule, and over rather than under. Under is
// invisible: a slide carries its own white background, so anything behind it is
// behind that too. Over, a translucent fill would tint the node's border and
// label -- the state boxes are already blue -- while a ring outside the box
// leaves both alone and still reads as one thing enclosing another, which is what
// an e-class is.
// An e-class whose members are apart, drawn the way the background slide draws
// one: a translucent grey region round the nodes it holds, with a dashed line
// between them saying they are the same value.
//
// The region is a tube: one wide round-capped stroke along the very curve the
// dashed line runs down, so the two agree from end to end by construction. Drawn
// instead as two padded boxes joined by a bar, they do not: the dashed line
// between two nodes that are neither in a column nor in a row has to bend round
// whatever stands between them, and a bar does not bend, so the line leaves the
// region at the corner. One stroke also means the region is an even wash rather
// than darker where two translucent pieces of it overlap.
def eclass_pad = 12.0
def eclass_grey = draw.Color(146, 146, 146, 0.3)
def eclass_width = 64.0 + 2 * eclass_pad     // a node, plus its padding
fun eclass_tube(p :: pc.Pict, from :: List, c1 :: List, c2 :: List, to :: List,
                ~dash: dash_color) :: pc.Pict:
  def path = draw.Path()
  path.move_to(from)
  path.curve_to(c1, c2, to)
  fun stroked(pen :: draw.Pen) :: pc.Pict:
    pc.dc(fun (target :: draw.DC, dx, dy):
            target.save()
            target.pen := pen
            target.brush := draw.Brush.none
            target.path(path, ~dx: dx, ~dy: dy)
            target.restore(),
          ~width: slide_width, ~height: slide_height)
  let p = put(p, stroked(draw.Pen(~color: eclass_grey, ~width: eclass_width)), 0.0, 0.0)
  // `#'show_dash` is this enum's spelling of the short dash the other equivalence
  // lines are drawn with; there is no `#'short_dash` in it.
  put(p, stroked(draw.Pen(~color: dash_color, ~width: 4, ~style: #'show_dash)), 0.0, 0.0)

// The middle of a node placed at (x, y), which is where a tube through it runs.
fun node_middle(node, x :: Real, y :: Real) :: List:
  def q :~ pc.Pict = as_pict(node)
  [x + q.width / 2, y + q.height / 2]

// The chain as a frame's worth of data. Every node in two drawings, plain and
// picked, each built once: a pick is the same box with a green fill, so a frame
// that picks a node names its green twin and the box turns green in place.
def chain_keys: for List ([key, _, _, _] in chain_graph): key
def chain_plain = chain_nodes()
def chain_green = chain_nodes(~picked: chain_keys)
def chain_red = chain_nodes(~forked: chain_keys)
// Smaller than the one on the background slide: it stands in the margin right of
// the state column, so it has to be narrow enough to sit clear of both the class
// region beside it and the edge of the slide.
def chain_pointer:
  as_pict(walk_arrow(~facing: "leftArrow", ~width: 56.0, ~height: 24.0))
// where it goes for a layer: level with the middle of that row's nodes
fun chain_point_at(layer :: Int) :: List:
  [chain_point_x, chain_y(layer) + 32.0 - (chain_pointer :~ pc.Pict).height / 2]

// The nodes of a frame: where each one goes, and which of its three drawings to
// use -- plain, picked, or picked by two things at once.
fun chain_node_picts(spots :~ Map, picks :~ List, ~red: red :~ List = []) :: Map:
  for values(m :~ Map = {}) (key in spots.keys()):
    def [x, y] = spots[key]
    def pict:
      cond
      | red.contains(key): chain_red[key]
      | picks.contains(key): chain_green[key]
      | ~else: chain_plain[key]
    m ++ { key: [pict, x, y] }

// Where the nodes of the first `upto` steps sit, from the tables the presses are
// built from.
fun chain_spots_upto(upto :: Int) :: Map:
  for values(m :~ Map = {}) (k in 0..upto):
    for values(m :~ Map = m) ([key, x, y, _] in chain_steps[k]): m ++ { key: [x, y] }
def chain_spots :~ Map = chain_spots_upto(chain_steps.length())

// The edges of the first `upto` steps, each tagged with what kind it is: `#'v` for
// a value edge, thin and black, `#'s` for a state edge, thick and in Keynote's
// blue. One list, because a scene's edges are compared with the next scene's, and
// an edge either is or is not still there.
fun chain_edges(upto :: Int) :: List:
  List.append(
    & for List (k in 0..upto):
        (for List (e :~ List in chain_value_edges[k]): [#'v] ++ e)
          ++ (for List (e :~ List in chain_state_edges[k]): [#'s] ++ e))

// `at` is the frame's own nodes, which is what the ghosts on the layer are and so
// what an edge can be found and aimed at.
fun chain_wire_specs(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
  for values(q :~ pc.Pict = layer) (e :~ List in es):
    cond
    | e[0] == #'v: chain_wire(q, at, [e.rest], ~line_width: 4)
    // `#'f` is a state edge that should not be there: two of them arriving at one
    // node is memory read twice
    | e[0] == #'f: chain_wire(q, at, [e.rest], ~line_width: 6, ~color: talk_red)
    | ~else: chain_wire(q, at, [e.rest], ~line_width: 6, ~color: keynote_blue)

// A chain slide: its frames, over a page that no press touches.
fun chain_slide(page :: pc.Pict, frames :~ List) :: pc.Pict:
  magic_slide(page, frames, ~wire: chain_wire_specs)

// The class the extraction starts from: `return` is what groups the value and the
// state the program hands back.
def chain_root = #'k_ret

// The two classes the rule makes, each on a layer of its own under the nodes it
// holds. Both are straight tubes, because the layout puts the members of each
// class in a line: the two values that are what `a` held before sit side by side in
// one row, and the two memories that are the memory the program ends with sit one
// above the other in one column.
def old_class_under:
  def v1_mid = node_middle(chain_plain[#'v1], & chain_spots[#'v1])
  def v3_mid = node_middle(chain_plain[#'v3], & chain_spots[#'v3])
  { #'old_class: [eclass_tube(blank_slide, v1_mid, v1_mid, v3_mid, v3_mid,
                              ~dash: value_class),
                  0.0, 0.0, band_below] }
def memory_class_under:
  def s2_mid = node_middle(chain_plain[#'s2], & chain_spots[#'s2])
  def s3_mid = node_middle(chain_plain[#'s3], & chain_spots[#'s3])
  { #'memory_class: [eclass_tube(blank_slide, s3_mid, s3_mid, s2_mid, s2_mid,
                                 ~dash: state_class),
                     0.0, 0.0, band_below] }
def rule_classes_under = old_class_under ++ memory_class_under

// What the extraction is asked for, said where it is asked: a bubble on the
// `return`, which is the class the walk starts from.
def chain_ask_over:
  { #'ask: [bubble_at(chain_plain[#'ret], ~spot: chain_spots[#'ret],
                      ~body: [1150.0, 850.0], ~color: talk_blue,
                      ~content: prose([["extract", #'bold]])),
            0.0, 0.0, band_above] }

// The rule, beside the code it is about, with a band over each of the two lines it
// speaks for. It is scaled to the code box's own measured width, so the two of them
// share a right edge.
//
// Bind the result once per slide and hand that around: these are picts, and a frame
// naming a rebuilt one is naming a different thing, which fades out and in over
// itself instead of staying where it is.
fun chain_rule_over(parts :~ Map, ~value: value :: Boolean) :: Map:
  { #'rule: [fill_width((update_rule(~value: value) :~ Map)[#'pict],
                        (parts[#'frame] :~ pc.Pict).width),
             rule_x, rule_y, band_above],
    #'band0: band_of(parts, 0) ++ [band_above],
    #'band1: band_of(parts, 1) ++ [band_above] }

// A copy of every piece of the line the rule adds, sitting exactly where the rule
// box draws it, keyed by the node it becomes. The rule box is scaled to the width of
// the code box, so the pieces are scaled and placed by the same factor.
fun chain_rule_pieces(parts :~ Map, ~value: value :: Boolean) :: Map:
  def rule :~ Map = update_rule(~value: value)
  def natural :~ pc.Pict = rule[#'pict]
  def factor = (parts[#'frame] :~ pc.Pict).width / natural.width
  def [line_dx, line_dy] :~ List = rule[#'at]
  def becomes = { #'value: #'v3, #'state: #'s3, #'op: #'us }
  for values(m :~ Map = {}) ([role, piece, dx] in segs_pieces(rule[#'segs])):
    skip_when !becomes.has_key(role)
    m ++ { becomes[role]: [(piece :~ pc.Pict).scale(factor),
                           rule_x + factor * (line_dx + dx),
                           rule_y + factor * line_dy] }

// The presses both extraction slides share, in order: the graph, the rule, the
// classes the rule makes, the asking, then the walk -- two presses a layer, the
// pointer arriving and then the picks landing -- and last the choices nothing
// reaches fading, which leaves what the root asked for.
//
// The two slides differ in the rule they state, and so in the graph the walk runs
// over and the answer it arrives at. Each of them adds its own last press, which is
// where that answer goes: one gets a program, the other gets two copies of memory.
fun chain_walk_frames(~graph: graph :~ List,
                      ~rule: rule_over :~ Map,
                      ~classes: classes :~ Map = rule_classes_under,
                      ~kept: kept :~ List,
                      ~ask: ask_over :~ Map = chain_ask_over) :: List:
  // The pointer visits every layer, so it passes nothing without stopping at it.
  // It is one pict under one key, so it travels between the layers rather than
  // being taken away and put back one row down.
  fun scene(~rule: rule = #false, ~union: union = #false, ~ask: ask = #false,
            ~picks: picks :: List = [], ~point: point = #false) :: Frame:
    Frame(~picts: chain_node_picts(chain_spots, picks)
                    ++ (if point == #false
                        | {}
                        | { #'point: [chain_pointer, & chain_point_at(point)] })
                    ++ (if union | classes | {})
                    ++ (if rule | rule_over | {})
                    ++ (if ask | ask_over | {}),
          ~edges: chain_edges(4))
  [scene(),
   scene(~rule: #true),
   scene(~rule: #true, ~union: #true),
   scene(~rule: #true, ~union: #true, ~ask: #true),
   & List.append(
       & for List (layer in 0..chain_layers):
           [scene(~rule: #true, ~union: #true, ~ask: #true, ~point: layer,
                  ~picks: chain_picks(graph, ~upto: layer - 1)),
            scene(~rule: #true, ~union: #true, ~ask: #true, ~point: layer,
                  ~picks: chain_picks(graph, ~upto: layer))]),
   scene(~rule: #true, ~union: #true, ~ask: #true, ~picks: kept)]

fun slide_rue():
  // The page under the graph, drawn once and never animated: the title, the icon
  // and the code.
  def canvas = with_icon(titled("Dead Store Elimination"))
  def parts = code_parts()
  def page = put(canvas, code_pict(parts, ~states: #true), code_x, code_y)
  def rule_over = chain_rule_over(parts, ~value: #true)

  // The first write stores a value that the second one throws away, so the rule
  // says so: a bubble on that write, once the rule has been stated and the write it
  // adds is in the graph. It comes up from below, since the two boxes right under
  // that write are its own results.
  def redundant_over:
    { #'redundant: [bubble_at(chain_plain[#'u1], ~spot: chain_spots[#'u1],
                              // in the corridor between the two writes, where it
                              // can point straight at the one it is about. Smaller
                              // than the deck's other bubbles, because that
                              // corridor is only as wide as the gap between them.
                              ~body: [1330.0, 350.0], ~color: talk_red,
                              ~content: pc.stack(~sep: 2.0, ~horiz: #'center,
                                                 small_prose("Redundant"),
                                                 small_prose("update"))),
                    0.0, 0.0, band_above] }

  // The write the rule adds arrives the way the program's own terms did: a copy of
  // the line that states it lifts off the rule box and flies into the graph, each
  // piece turning into the node it names. The copies are keyed by those nodes, so
  // the press that puts the write in the graph is one move.
  def flying = chain_rule_pieces(parts, ~value: #true)

  // The graph the program builds, then the rule with the copy sitting on the line
  // it states, then that copy in the graph as a write of its own with the two
  // classes it makes, and last a word about the write it makes redundant.
  def program = chain_node_picts(chain_spots_upto(3), [])
  def with_rule = chain_node_picts(chain_spots, [])
  chain_slide(
    page,
    [Frame(~picts: program, ~edges: chain_edges(3)),
     Frame(~picts: program ++ rule_over ++ flying, ~edges: chain_edges(3)),
     Frame(~picts: with_rule ++ rule_over ++ rule_classes_under,
           ~edges: chain_edges(4)),
     Frame(~picts: with_rule ++ rule_over ++ rule_classes_under ++ redundant_over,
           ~edges: chain_edges(4))])

// -------------------------------------------------------------------------------------
// slide_fork: the same e-graph, a weaker rule, and the extraction that breaks.
//
// The rule now says only that the two states are equal, `ω1 ≡ ω2`, which is all a
// rule about memory can say without also knowing something about the values. So
// nothing says `v2` is `x`, the second `update` has to stay, and the walk -- free
// to take either node out of the state class it reaches -- takes the cheaper one
// for *both* `update`s that read it. What comes out has two `update`s reading one
// state: memory has forked, and that is not a program.
//
// The walk is the same walk, and it is right at every step. Which is the point:
// the fault is not in the search, it is in extracting a term from an e-graph that
// holds effects as if they were values. Everything about the picture is the same
// as the slide before it except the rule, so the two can be read against each
// other.
fun slide_fork():
  def canvas = titled("Extraction Goes Wrong")
  def parts = code_parts()
  def page = put(canvas, code_pict(parts, ~states: #true), code_x, code_y)
  def rule_over = chain_rule_over(parts, ~value: #true)

  // Everything this slide shows is worked out from the one rule: what the walk
  // picks, what survives, and which memory is read twice.
  def graph = chain_graph
  def kept = chain_kept(graph, ~root: chain_root)
  def forks = chain_forks(graph, ~root: chain_root)
  def fork_key = ((forks[0] :~ List)[1])                 // the memory read twice
  def readers: for List (f :~ List in forks): f[0]       // and the writes reading it
  def fork_red = [fork_key] ++ readers

  // The term the walk comes back with, left where the graph has it. An edge stays
  // only if the node it leaves is in the term, and it is redrawn to the node its
  // class settled on -- which is how the `return` ends up pointing at the memory
  // the rule's write left, rather than at the one the program's second write left.
  def class_of:
    for values(m :~ Map = {}) ([key, cls, _, _] in graph): m ++ { key: cls }
  fun spots_of(keep :~ List) :: Map:
    for values(m :~ Map = {}) (key in keep): m ++ { key: chain_spots[key] }
  // The edges of one answer: an edge stays if the node it leaves is in the answer,
  // and it is aimed at whichever member of its class the answer took -- which is how
  // the `return` comes to point at the memory the rule's write left rather than the
  // one the program's second write left. `~red` names the nodes whose state edges
  // are the ones reading the same memory twice.
  fun edges_among(keep :~ List, ~red: red :~ List = []) :: List:
    def taken:
      for values(m :~ Map = {}) ([key, cls, _, _] in graph):
        if keep.contains(key) | m ++ { cls: key } | m
    for List (e :~ List in chain_edges(4)):
      keep_when keep.contains(e[1])
      def cls = class_of[e[2]]
      keep_when taken.has_key(cls)
      def kind = if e[0] == #'s && red.contains(e[1]) | #'f | e[0]
      [kind, e[1], taken[cls]] ++ (for List (i in 3..e.length()): e[i])
  def term_edges = edges_among(kept, ~red: readers)
  def term:
    Frame(~picts: chain_node_picts(spots_of(kept), kept, ~red: fork_red) ++ rule_over,
          ~edges: term_edges)

  // And the same term laid out as the shape it is: the memory the program started
  // with at the apex, the two writes that both read it hanging off it, what each
  // returns below them, and the `return` where the two paths meet. Every node is in
  // both frames, so the press is the term falling into the shape it always had.
  def diamond_spots:
    { #'a: [1113.0, chain_y(0)], #'x: [1189.0, chain_y(0)],
      #'one: [1265.0, chain_y(0)], #'xp: [1180.0, chain_y(1)],
      #'s0: [1670.0, chain_y(0)],                               // the apex
      #'u1: [1450.0, chain_y(2)], #'us: [1740.0, chain_y(2)],   // the two writes
      #'v1: [1516.0, chain_y(3)], #'s3: [1806.0, chain_y(3)],
      #'ret: [1570.0, chain_y(4)] }                             // where they meet
  def diamond_fork_over:
    // pointing at the left-hand write rather than at the memory itself: the apex
    // has the two writes right under it, so a spike from anywhere below crosses one
    // of them, and from the side there is no room beside the row of inputs
    { #'fork: [bubble_at(chain_plain[#'u1], ~spot: diamond_spots[#'u1],
                         ~body: [1113.0, 700.0], ~color: talk_red,
                         ~content: prose_stack([[["two copies", #'bold]],
                                                [["of memory!", #'bold]]])),
               0.0, 0.0, band_above] }
  def diamond:
    Frame(~picts: chain_node_picts(diamond_spots, kept, ~red: fork_red)
                    ++ rule_over ++ diamond_fork_over,
          ~edges: term_edges)

  // What we would take if we knew: the write the rule added, and both the value and
  // the memory read off that one write. One write where the program had two, and no
  // memory read twice -- an effect-safe program, and a better one than we started
  // with.
  def safe = [#'ret, #'us, #'v3, #'s3, #'a, #'x, #'one, #'xp, #'s0]
  def safe_edges = edges_among(safe)
  def safe_term:
    Frame(~picts: chain_node_picts(spots_of(safe), safe) ++ rule_over,
          ~edges: safe_edges)
  // and what the rest of the talk is for
  def idea_over:
    def body:
      make_bubble(~color: talk_green,
                  as_pict(linebox(~width: 620.0, ~height: 150.0,
                                  ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                  para(~align: #'center,
                                       run("we want to extract an", ~font: prose_font,
                                           ~size: 52.0, ~bold: #true)),
                                  para(~align: #'center,
                                       run("effect-safe program!", ~font: prose_font,
                                           ~size: 52.0, ~bold: #true)))))
    // along the bottom, under everything the answer left standing
    { #'idea: [body, 1150.0, 820.0, band_above] }
  def wanted:
    Frame(~picts: chain_node_picts(spots_of(safe), safe) ++ rule_over ++ idea_over,
          ~edges: safe_edges)

  chain_slide(
    page,
    chain_walk_frames(~graph: graph, ~rule: rule_over, ~kept: kept)
      ++ [term, diamond, safe_term, wanted])

// -------------------------------------------------------------------------------------
// slide_34: Keynote's 2-stage build of Slide 23, as one animated pict.
//
// The generator gives each build stage its own slide; every object was a
// superset of the stage before, so they collapse back into one.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_34():
  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(275.784, 211.919, ~tag: "extraction-time-cdf.pdf",
         image_pict(media("image21.png"), 1340.0, 804.0)),
      at(95.0, 85.0, ~tag: "Fast Effect-safe Extraction in Practice",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("Fast Effect-safe Extraction in Practice", ~font: prose_font,
                          ~size: 85.0, ~bold: #true, ~spacing: -2.01)))),
      at(1885.0, 1045.0, ~tag: "Slide Number", shape_pict(~width: 29.016, ~height: 29.496)),
      at(653.508, 743.56, ~tag: "Our Approach",
         linebox(~width: 260.2, ~height: 54.88,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Our Approach", ~font: prose_font, ~size: 40.0)))),
      at(1105.508, 625.56, ~tag: "Solver-Based Techniques",
         linebox(~width: 462.4, ~height: 54.88,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Solver-Based Techniques", ~font: prose_font, ~size: 40.0)))),
      at(634.714, 603.919, ~tag: "Line",
         shape_pict(~width: 87.399, ~height: 136.567, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("000000"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(1153.523, 969.288, ~tag: "Line (2)",
         shape_pict(~width: 327.822, ~height: 68.816, ~flip_v: #true, ~shape: "line",
                    ~line: make_stroke(hex("EE230C"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(1033.796, 529.382, ~tag: "Line (3)",
         shape_pict(~width: 203.618, ~height: 99.197, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("000000"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(1589.003, 296.697, ~tag: "Line (4)",
         shape_pict(~width: 100.896, ~height: 28.431, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("000000"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(1600.242, 325.027, ~tag: "Solver Timeouts",
         linebox(~width: 297.92, ~height: 54.88,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Solver Timeouts", ~font: prose_font, ~size: 40.0)))),
      at(929.123, 1000.48, ~tag: "Log scale",
         linebox(~width: 216.12, ~height: 63.656,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Log scale", ~font: prose_font, ~size: 48.0,
                          ~color: hex("EE230C"))))),
      at(1163.714, 504.919, ~tag: "Line (5)",
         shape_pict(~width: 87.399, ~height: 136.567, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("000000"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(601.853, 969.579, ~tag: "Line (6)",
         shape_pict(~width: 318.99, ~height: 68.525, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("EE230C"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))))

  // Keynote's green box, as one of our bubbles, centred where the box was.
  def stage_1:
    def bubble:
      make_bubble(~color: talk_green,
                  as_pict(linebox(~width: 486.0, ~height: 73.0,
                                  ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                  para(~align: #'center,
                                       run("Extraction is fast", ~font: prose_font, ~size: 60.0, ~bold: #true)))))
    pc.overlay(~horiz: #'left, ~vert: #'top,
               ~dx: 1494.06 - bubble.width / 2, ~dy: 787.93 - bubble.height / 2,
               pc.blank(~width: slide_width, ~height: slide_height), bubble)

  staged(base_canvas, [stage_1])

