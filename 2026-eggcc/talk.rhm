         shape_pict(~width: 100.896, ~height: 28.431, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("000000"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(1600.242, 325.027, ~tag: "Solver Timeouts",
         textbox(~width: 297.92, ~height: 54.88, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Solver Timeouts", ~font: "Helvetica Neue", ~size: 40.0)))),
      at(929.123, 1000.48, ~tag: "Log scale",
         textbox(~width: 216.12, ~height: 63.656, ~anchor: #'center, ~wrap: #false,
                 ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                      run("Log scale", ~font: "Helvetica Neue", ~size: 48.0,
                          ~color: hex("EE230C"))))),
      at(1163.714, 504.919, ~tag: "Line (5)",
         shape_pict(~width: 87.399, ~height: 136.567, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("000000"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))),
      at(601.853, 969.579, ~tag: "Line (6)",
         shape_pict(~width: 318.99, ~height: 68.525, ~flip_h: #true, ~flip_v: #true,
                    ~shape: "line",
                    ~line: make_stroke(hex("EE230C"), ~width: 6.0,
                                       ~tail: line_end(#'triangle, "med", "med")))))

  // Keynote's green box, as one of our bubbles, centred where the box was.
  def stage_1:
    def bubble:
      make_bubble(~color: talk_green,
                  as_pict(textbox(~width: 486.0, ~height: 73.0, ~anchor: #'center, ~wrap: #false,
                                  ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                  para(~align: #'center,
                                       run("Extraction is fast", ~font: "Helvetica Neue", ~size: 60.0, ~bold: #true)))))
    pc.overlay(~horiz: #'left, ~vert: #'top,
               ~dx: 1494.06 - bubble.width / 2, ~dy: 787.93 - bubble.height / 2,
               pc.blank(~width: slide_width, ~height: slide_height), bubble)

  staged(base_canvas, [stage_1])

