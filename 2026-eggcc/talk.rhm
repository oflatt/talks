                                     run("1", ~size: 50.0, ~baseline: -0.06),
                                     run(") = update(a, x)", ~size: 50.0)),
                                para(~line_spacing: pair(#'percent, 1.5),
                                     run("(v", ~size: 50.0),
                                     run("2", ~size: 50.0, ~baseline: -0.06),
                                     run(", σ", ~size: 50.0),
                                     run("2", ~size: 50.0, ~baseline: -0.06),
