// -------------------------------------------------------------------------------------
// slide_20: slide_2 again, marking which of those tools need effects.
//
// This *is* slide_2: it starts from slide_2's own settled frame rather than
// repeating the grid. Editing slide_2 moves this slide with it. The two had been
// written out separately and had drifted -- to different logo positions and
// different logo scales -- which is exactly what deriving one from the other stops.
fun slide_20():
  // slide_2 as it stands once every application has appeared. It is a function
  // now -- a slide is built when it is shown -- so it is called, once, rather
  // than named twice.
  def grid = slide_2()
  def shown = grid.snapshot(grid.duration - 1, 1.0)

  // Which of these need effectful e-graphs. Each sits just under its logo's ink,
  // the way slide_2's own "Luminal" sits under the ML Kernels logo -- ink rather
  // than bounding box, because the logos carry very different bottom padding.
  def notes:
    group_pict(~width: slide_width, ~height: slide_height,
               at(228.358, 522.666, ~tag: "(Herbie)",
                  textbox(~width: 181.512, ~height: 64.608, ~anchor: #'center,
                          ~wrap: #false, ~autofit: #'grow,
                          ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                               run("(Herbie)", ~font: "Helvetica Neue Medium",
                                   ~size: 48.0)))),
               at(905.804, 943.181, ~tag: "(Cranelift)",
                  textbox(~width: 222.408, ~height: 64.608, ~anchor: #'center,
                          ~wrap: #false, ~autofit: #'grow,
                          ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                               run("(Cranelift)", ~font: "Helvetica Neue Medium",
                                   ~size: 48.0)))),
               at(489.157, 1011.599, ~tag: "(Szalinski)",
                  textbox(~width: 230.424, ~height: 64.608, ~anchor: #'center,
                          ~wrap: #false, ~autofit: #'grow,
                          ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.0,
                               run("(Szalinski)", ~font: "Helvetica Neue Medium",
                                   ~size: 48.0)))))

  // the notes are part of the picture from the moment the slide arrives; the
  // bubble is the one thing revealed on a click
  def base:
    pc.overlay(~horiz: #'left, ~vert: #'top, shown, as_pict(notes))

  def stage_1:
    // The body goes in the band between the two rows, right of centre: the left of
    // that band is taken by "(Herbie)" and the right by the "Luminal" note, and this
    // is the clear stretch between them. Sitting between the rows it points into is
    // what lets two spikes leave upwards and two downwards, rather than four of them
    // crossing the picture from one side.
    def slot = pc.blank(~width: 1.0, ~height: 1.0)
    // Each marker is one logo's ink. Two of these images have no alpha channel and
    // are opaque white to their edges, so the extent has to come from where the
    // drawing stops being white -- MLIR's artwork is 507pt of its 634pt box, and
    // aiming at the box would leave the spike short of the logo by 60pt.
    def m_numba = pc.blank(~width: 256.0, ~height: 250.4)
    def m_luminal = pc.blank(~width: 264.6, ~height: 264.6)
    def m_cranelift = pc.blank(~width: 404.6, ~height: 232.1)
    def m_mlir = pc.blank(~width: 507.1, ~height: 169.5)
    fun place(base, p, x, y):
      pc.overlay(~horiz: #'left, ~vert: #'top, ~dx: x, ~dy: y, base, p)
    def placed:
      place(place(place(place(place(pc.blank(~width: slide_width, ~height: slide_height),
                                    slot, 950.0, 530.0),
                              m_numba, 702.7, 288.8),
                        m_luminal, 1571.6, 257.5),
                  m_cranelift, 809.2, 699.1),
            m_mlir, 1319.7, 740.3)
    multi_callout(~on: placed, ~place: slot,
                  ~at: [m_numba, m_luminal, m_cranelift, m_mlir],
                  ~color: talk_red, ~padding: 10.0,
                  as_pict(textbox(~width: 404.2, ~height: 57.6, ~anchor: #'center,
                                  ~wrap: #false, ~autofit: #'grow,
                                  ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                  para(~align: #'center,
                                       run("need side effects!", ~font: "Helvetica Neue",
                                           ~size: 48.0, ~bold: #true)))))

  staged(base, [stage_1])

// -------------------------------------------------------------------------------------
// slide_23: Slide 12 through Slide 14, as one animated pict.
//
// These were separate slides, each a copy of the one before plus one more
// element -- so they collapse into a base picture and 2 reveals.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_23():
  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(95.0, 85.0, ~tag: "Update",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("Update", ~font: "Helvetica Neue", ~size: 85.0, ~bold: #true,
                          ~spacing: -1.7)))),
      at(1885.0, 1045.0, ~tag: "Slide Number", shape_pict(~width: 29.016, ~height: 29.496)))

  // adds 'v', '1', '= update(a, x)', '2', '3', '= update(b, y)', '4', '= update(c, v', ')'
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(56.715, 244.514, ~tag: "v1 = update(a, x)…",
                  shape_pict(~width: 768.0, ~height: 380.0, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(16.0, 4.0, 16.0, 4.0),
                                         para(~line_spacing: pair(#'percent, 1.5),
                                              run("v", ~size: 50.0),
                                              run("1", ~size: 50.0, ~baseline: -0.06),
                                              run(" = update(a, x)", ~size: 50.0)),
                                         para(~line_spacing: pair(#'percent, 1.5),
                                              run("v", ~size: 50.0),
                                              run("2", ~size: 50.0, ~baseline: -0.06),
                                              run(" = update(a, x)", ~size: 50.0)),
                                         para(~line_spacing: pair(#'percent, 1.5),
                                              run("v", ~size: 50.0),
                                              run("3", ~size: 50.0, ~baseline: -0.06),
                                              run(" = update(b, y)", ~size: 50.0)),
                                         para(~line_spacing: pair(#'percent, 1.5),
                                              run("v", ~size: 50.0),
                                              run("4", ~size: 50.0, ~baseline: -0.06),
                                              run(" = update(c, v", ~size: 50.0),
                                              run("2", ~size: 50.0, ~baseline: -0.06),
                                              run(")", ~size: 50.0))))))

  // Keynote's yellow speech bubble, as one of our callouts. The spike lands where
  // Keynote's pointed, the right edge of the code box beside `update(a, x)`.
  def stage_2:
    callout(~on: pc.blank(~width: slide_width, ~height: slide_height),
            ~at: pc.Find.abs(824.715, 276.13), ~spike: #'w,
            as_pict(textbox(~width: 840.0, ~height: 48.0, ~anchor: #'center, ~wrap: #false,
                            ~insets: insets(0.0, 0.0, 0.0, 0.0),
                            para(run("Write ", ~font: "Helvetica Neue", ~size: 40.0),
                                 run("v", ~font: "Helvetica Neue", ~size: 40.0, ~bold: #true),
                                 run(" to address ", ~font: "Helvetica Neue", ~size: 40.0),
                                 run("a, ", ~font: "Helvetica Neue", ~size: 40.0, ~bold: #true),
                                 run("return previous value at ", ~font: "Helvetica Neue", ~size: 40.0),
                                 run("a", ~font: "Helvetica Neue", ~size: 40.0, ~bold: #true)))))

  staged(base_canvas, [stage_1, stage_2])

// -------------------------------------------------------------------------------------
// slide_26: Slides 15 through 17, as one animated pict.
//
// Not purely additive, so this is two tracks overlaid rather than one `staged`
// chain. The e-graph nodes fade in additively, but the code block on the left is
// *rewritten* twice -- `y = update(a, v)`, then struck through, then `y=v` -- and a
// reveal can only add, never replace. So the code gets a track of its own that
// cross-fades between its three states, concurrent with the reveals.
//
// Two exporter artifacts are dropped rather than animated:
//   - `Connection Line (3)` is 4.0pt on Slide 15 but 2.0pt on 16 and 17. Every
//     other black connector in the deck is 4.0, so the thinning is a stray edit
//     rather than the animation; it stays 4.0 throughout.
//   - the shapes inside `Group` are only renumbered ("Shape" -> "Shape (3)") from
//     slide to slide, which is the exporter naming them afresh. They draw the same.
fun slide_26():
  // The nodes of the e-graph, bound by name so that the edges can be drawn
  // between them below; the canvas and the stages only place them.
  def n_update = shape_pict(~width: 135.0, ~height: 61.581,
                            ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                            ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                            ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                        para(~align: #'center, run("update", ~size: 30.0))))
  def n_a = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("a", ~size: 30.0))))
  def n_v = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("v", ~size: 30.0))))
  def n_sigma = shape_pict(~width: 62.079, ~height: 61.581,
                           ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                           ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                           ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                       para(~align: #'center, run("σ", ~size: 30.0))))
  def n_x = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("x", ~size: 30.0))))
  def n_sigma_p = shape_pict(~width: 62.079, ~height: 61.581,
                             ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                             ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                             ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                         para(~align: #'center, run("σ", ~size: 30.0),
                                              run("ʹ", ~font: "Times New Roman", ~size: 30.0))))
  def n_update2 = shape_pict(~width: 135.0, ~height: 61.581,
                             ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                             ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                             ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                         para(~align: #'center, run("update", ~size: 30.0))))
  def n_y = shape_pict(~width: 62.079, ~height: 61.581,
                       ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                       ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                       ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                   para(~align: #'center, run("y", ~size: 30.0))))
  def n_sigma_pp = shape_pict(~width: 62.079, ~height: 61.581,
                              ~geom: preset_geom("roundRect", [pair("adj", "val 33878")]),
                              ~fill: hex("FFFFFF"), ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                              ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                          para(~align: #'center, run("σ", ~size: 30.0),
                                               run("ʹʹ", ~font: "Times New Roman", ~size: 30.0))))

  // everything that is on screen the whole time
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(95.0, 85.0, ~tag: "Redundant Update Elimination",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("Redundant Update Elimination", ~font: "Helvetica Neue",
                          ~size: 85.0, ~bold: #true, ~spacing: -1.7)))),
      at(1885.0, 1045.0, ~tag: "Slide Number", shape_pict(~width: 29.016, ~height: 29.496)),
      at(338.516, 704.223, ~tag: "update", n_update),
      at(211.26, 808.407, ~tag: "a", n_a),
      at(326.361, 808.407, ~tag: "v", n_v),
      at(423.091, 808.407, ~tag: "σ", n_sigma),
      at(326.361, 600.04, ~tag: "x", n_x),
      at(423.091, 600.04, ~tag: "σʹ", n_sigma_p),
      at(338.516, 495.856, ~tag: "update (2)", n_update2),
      at(326.361, 391.672, ~tag: "y", n_y),
      at(423.091, 391.672, ~tag: "σʹʹ", n_sigma_pp))

  // adds the second `update` node and its two edges
  def stage_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(243.099, 377.773, ~tag: "Shape",
                  shape_pict(~width: 162.263, ~height: 506.564, ~flip_h: #true,
                             ~geom: custom_geom(
                                                [[[#'move, pair(941, 2072)], [#'curve, pair(991, 2770), pair(1849, 3375), pair(3711, 3645)], [#'curve, pair(5530, 3908), pair(7816, 3696), pair(9530, 4050)], [#'curve, pair(11330, 4421), pair(11609, 5177), pair(12096, 5850)], [#'curve, pair(13191, 7363), pair(15847, 8811), pair(15997, 10409)], [#'curve, pair(16173, 12275), pair(13047, 13933), pair(11664, 15607)], [#'curve, pair(11080, 16314), pair(10600, 17025), pair(8532, 17388)], [#'curve, pair(6852, 17683), pair(4783, 17516), pair(3014, 17739)], [#'curve, pair(1355, 17948), pair(251, 18461), pair(47, 19017)], [#'curve, pair(-293, 19942), pair(1248, 20745), pair(3853, 21070)], [#'curve, pair(6603, 21413), pair(9739, 21106), pair(11787, 20361)], [#'curve, pair(13999, 19557), pair(14481, 18509), pair(15205, 17474)], [#'curve, pair(16572, 15522), pair(19121, 13605), pair(20299, 11570)], [#'curve, pair(21307, 9829), pair(21252, 8010), pair(19067, 6397)], [#'curve, pair(17376, 5149), pair(14421, 4070), pair(13183, 2780)], [#'curve, pair(12463, 2029), pair(12282, 1215), pair(10632, 614)], [#'curve, pair(8820, -47), pair(5890, -187), pair(3675, 258)], [#'curve, pair(1793, 635), pair(890, 1346), pair(941, 2072)], [#'close]]],
                                                20930, 21209), ~fill: hex("929292", ~alpha: 0.4))),
               at(407.265, 375.236, ~tag: "Shape (2)",
                  shape_pict(~width: 126.68, ~height: 300.004,
                             ~geom: custom_geom(
                                                [[[#'move, pair(80, 3510)], [#'curve, pair(302, 4815), pair(2062, 5815), pair(4912, 6141)], [#'curve, pair(7366, 6422), pair(10144, 6041), pair(12337, 6597)], [#'curve, pair(15681, 7443), pair(15529, 9183), pair(15161, 10687)], [#'curve, pair(14820, 12077), pair(14397, 13739), pair(10894, 14508)], [#'curve, pair(8739, 14980), pair(6110, 14723), pair(3852, 15089)], [#'curve, pair(1735, 15433), pair(336, 16291), pair(66, 17205)], [#'curve, pair(-390, 18751), pair(1555, 20096), pair(4923, 20605)], [#'curve, pair(8131, 21089), pair(12103, 20671), pair(15048, 19431)], [#'curve, pair(20600, 17094), pair(20662, 13704), pair(20798, 10655)], [#'curve, pair(20934, 7594), pair(21210, 4191), pair(15993, 1694)], [#'curve, pair(12600, 70), pair(7429, -511), pair(3569, 504)], [#'curve, pair(1152, 1140), pair(-126, 2301), pair(80, 3510)], [#'close]]],
                                                20852, 20801), ~fill: hex("929292", ~alpha: 0.4))))

  // adds 'Is this optimization safe?'
  def stage_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(751.007, 652.254, ~tag: "Is this optimization safe?",
                  textbox(~width: 900.225, ~height: 96.825, ~anchor: #'center, ~wrap: #false,
                          ~autofit: #'grow, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                          para(~line_spacing: pair(#'percent, 0.9), ~space_before: 45.01,
                               run("Is this optimization safe?", ~font: "Helvetica Neue", ~size: 75.0,
                                   ~bold: #true)))))

  // The code block, in the three states it is rewritten through.
  // state 1: 'x = update(a, v)', 'y = update(a, v)'
  def code_1:
    group_pict(~width: slide_width, ~height: slide_height,
               at(703.648, 298.572, ~tag: "x = update(a, v)…",
                  shape_pict(~width: 560.0, ~height: 232.0, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("x = update(a, v)", ~size: 50.0)),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("y = update(a, v)", ~size: 50.0))))))

  // state 2: 'x = update(a, v)', 'y = update(a, v)'
  def code_2:
    group_pict(~width: slide_width, ~height: slide_height,
               at(703.648, 298.572, ~tag: "x = update(a, v)…",
                  shape_pict(~width: 560.0, ~height: 232.0, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("x = update(a, v)", ~size: 50.0)),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("y = update(a, v)", ~size: 50.0, ~strike: #true))))))

  // state 3: 'x = update(a, v)', 'y=v'
  def code_3:
    group_pict(~width: slide_width, ~height: slide_height,
               at(703.648, 298.572, ~tag: "x = update(a, v)…",
                  shape_pict(~width: 560.0, ~height: 232.0, ~fill: hex("FFFFFF"),
                             ~line: make_stroke(hex("000000"), ~width: 1.0),
                             ~body: body(~anchor: #'center, ~insets: insets(4.0, 4.0, 4.0, 4.0),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("x = update(a, v)", ~size: 50.0)),
                                         para(~align: #'center, ~line_spacing: pair(#'percent, 1.8),
                                              run("y=v", ~size: 50.0))))))

  // Keynote drew each edge as a connector between two centres and clipped it
  // at the boxes; these are the same edges as `arrow`s, from border to border.
  // Stage `k` brings the edges of the nodes it adds; stage 0 is `base_canvas`.
  fun wire(p, k):
    match k
    | 0:
        let p = value_edges(p, [[n_x, n_update], [n_update, n_a], [n_update, n_v],
                                [n_y, n_update2], [n_update2, n_a], [n_update2, n_v]])
        let p = state_edges(p, [[n_sigma_p, n_update], [n_update, n_sigma],
                                [n_sigma_pp, n_update2], [n_update2, n_sigma_p]])
        p
    | 1:
        let p = arrows(~on: p, [[n_sigma_p, n_sigma_pp], [n_y, n_v]],
                       ~style: #'line, ~line_style: #'short_dash, ~line_width: 4)
        p
    | ~else: p

  // Both tracks are three epochs long, so click k plays the k'th reveal and the
  // k'th rewrite together -- exactly what the three separate slides did.
  def shown:
    pc.overlay(~horiz: #'left, ~vert: #'top,
               staged(base_canvas, [stage_1, stage_2], ~wire: wire),
               pc.switch(as_pict(code_1),
                         // `cross_fade`, not `fade_through`: the latter holds the two
                         // apart (`~overlap` 0.15), so at the midpoint both sit at 13%
                         // alpha and the code box drops out and comes back -- a flash,
                         // the box being opaque white with a border and a shadow.
                         pc.cross_fade(as_pict(code_1), as_pict(code_2), ~extent: 1.0),
                         pc.cross_fade(as_pict(code_2), as_pict(code_3), ~extent: 1.0)))

  // Keynote's yellow speech bubble, as one of our callouts. The spike lands where
  // Keynote's did, on the right edge of the code box.
  callout(~on: shown, ~at: pc.Find.abs(1263.648, 403.06), ~spike: #'w,
          as_pict(textbox(~width: 384.0, ~height: 48.0, ~anchor: #'center, ~wrap: #false,
                          ~insets: insets(0.0, 0.0, 0.0, 0.0),
                          para(~align: #'center,
                               run("update is idempotent", ~font: "Helvetica Neue", ~size: 40.0)))))

// -------------------------------------------------------------------------------------
// slide_29: Slide 18 through Slide 19, as one animated pict.
//
// These were separate slides, each a copy of the one before plus one more
// element -- so they collapse into a base picture and 1 reveals.
//
// One `fade_in` per stage, so the deck takes the same number of clicks it did.
fun slide_29():
  // The nodes of the e-graph, bound by name so that the edges can be drawn
  // between them below; the canvas and the stages only place them.
  def n_box1 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_box2 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_box3 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_box4 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_box5 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_box6 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_box7 = shape_pict(~width: 23.528, ~height: 23.528,
                          ~geom: preset_geom(
                                   "roundRect",
                                   [pair("adj", "val 30640")]),
                          ~fill: hex("FFFFFF"),
                          ~line: make_stroke(
                                   hex("000000"), ~width: 3.0))
  def n_sigma = shape_pict(~width: 64.0, ~height: 63.486,
                           ~geom: preset_geom(
                                    "roundRect", [pair("adj", "val 33878")]),
                           ~fill: hex("FFFFFF"),
                           ~line: make_stroke(hex("0433FF"), ~width: 4.0),
                           ~body: body(~anchor: #'center,
                                       ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                       para(~align: #'center, run("σ", ~size: 40.0))))
  def n_a = shape_pict(~width: 64.0, ~height: 63.486,
                       ~geom: preset_geom(
                                "roundRect", [pair("adj", "val 33878")]),
