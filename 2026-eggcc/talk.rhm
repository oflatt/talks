                                para(~line_spacing: pair(#'percent, 1.5),
                                     run("(v", ~size: 50.0),
                                     run("3", ~size: 50.0, ~baseline: -0.06),
                                     run(", σ", ~size: 50.0),
                                     run("3", ~size: 50.0, ~baseline: -0.06),
                                     run(") = update(b, y)", ~size: 50.0)),
                                para(~line_spacing: pair(#'percent, 1.5),
                                     run("(v", ~size: 50.0),
                                     run("4", ~size: 50.0, ~baseline: -0.06),
                                     run(", σ", ~size: 50.0),
                                     run("4", ~size: 50.0, ~baseline: -0.06),
