                             at(538.643, 8.75, ~tag: "σ1", n_sigma1),
                             at(384.554, 0.0, ~tag: "v1", n_v1))))

  // Keynote drew each edge as a connector between two centres and clipped it
  // at the boxes; these are the same edges as `arrow`s, from border to border.
  // Stage `k` brings the edges of the nodes it adds; stage 0 is `base_canvas`.
  fun wire(p, k):
    match k
    | 0:
        let p = arrows(~on: p, [[n_box2, n_box1], [n_box2, n_box3], [n_box5, n_box3],
                                [n_box5, n_box6], [n_box7, n_box4], [n_box4, n_box1],
                                [n_box4, n_box2], [n_box4, n_box5]], ~line_width: 2)
        p
    | 1:
        let p = state_edges(p, [[n_update, n_sigma], [n_sigma1, n_update]])
        let p = value_edges(p, [[n_update, n_x], [n_update, n_a], [n_v1, n_update]])
        p
    | ~else: p

  staged(base_canvas, [stage_1], ~wire: wire)

