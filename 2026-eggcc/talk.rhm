#lang rhombus/and_meta
// Generated by glide-pptx from eggcc2.key.
// 40 slides at 1920.0 x 1080.0 pt.
//
// Every slide_N is a pict, and every `at` carries a tag. Open this with
// `raco glide` and what you drag in the editor is written back here --
// nothing else rewrites this file.

import:
  lib("glide-pptx/runtime.rhm") open
  // `fade_in` for the staged reveals -- the same helper the ICFP talk uses.
  "slidehelpers.rhm" open
  // Prefixed, not `open`: rhombus/pict and the runtime above both export
  // `blank`, and opening both would make that name ambiguous.
  pict as pc
  draw

export:
  slide_width
  slide_height
  all_slides
  slide_1
  slide_2
  slide_12
  slide_18
  slide_19
  slide_20
  slide_23
  slide_26
  slide_29
  slide_31
  slide_32
  slide_34
  slide_36
  slide_37
  slide_38
  slide_39

def slide_width = 1920.0
def slide_height = 1080.0

// The theme font. Runs that name no typeface use this one, so restyling
// the whole deck is one edit.
current_default_font("PT Mono")

// ------------------------------------------------------------------------ fonts
// racket/draw substitutes silently when a family is missing, and a substitute
// with different metrics is exactly what goes wrong here: line spacing in this
// runtime is a percentage of the *font size*, so the leading does not move when
// the face does -- only the substitute's ink height does. With Noto Sans
// standing in for Helvetica Neue, the 116pt title's two lines overlapped by
// 5.6pt and ran together.
//
// So name every family the deck asks for and refuse to run on the wrong one. A
// family may declare a stand-in, for the case where it cannot be installed at
// all (Helvetica Neue is Apple's); the stand-in has to be installed, and the
// name has to actually resolve to it, which is checked by measuring -- a font
// reports the face that was asked for, not the one that was drawn.
//
// `fonts` is a folder beside this file. Anything in it is loaded before a
// single glyph is measured, so a deck can carry the faces it is set in rather
// than hope for them: `raco glide fonts talk.rhm` puts them there.
register_fonts("fonts")
check_fonts(
  ["PT Mono"],
  ["Helvetica Neue", "Nimbus Sans"],          // Helvetica clone, Helvetica metrics
  ["Helvetica Neue Medium", "Nimbus Sans"],
  ["Arial", "Arimo"],                         // metric-compatible with Arial
  ["Times New Roman", "Tinos"]                // metric-compatible with Times
)

// Images sit next to this file, so the program travels as a folder.
def media = media_lookup("media")

// The runtime builds Racket picts, but rhombus/pict's animation works on its own
// `Pict`. `Pict.from_handle` is glide-pptx's own bridge between the two -- its
// README calls it exactly that.
// A Racket pict from the runtime crosses over; a `Pict` is already across.
fun as_pict(q): if q is_a pc.Pict | q | pc.Pict.from_handle(q)

// A slide that was several: `base_canvas` is what shows before the first click,
// and each stage fades in over everything already on screen, one click apiece.
//
// `wire(p, k)` adds what is drawn *between* elements -- the edges of a graph --
// to the picture at stage `k`: to the base for `k = 0`, and for each later stage
// to a ghost of the base under the stage's own elements, so that an edge can join
// a node the stage adds to one that was there already, and fades in with it.
// Every animated slide holds its last frame for one more advance.
//
// A slide's final epoch plays as the *outgoing* transition -- the press that runs
// it is the same press that moves on -- so whatever that epoch adds is never seen
// at rest. Sustaining gives the transition a duplicate frame to consume instead,
// which is why the extra epoch is not a wasted press even though `dead_beats`
// reports it as one. A static slide has no closing animation to lose, so it is
// left alone rather than spending a press on a frame nobody needs.
//
// Wrapped around the thunks in `all_slides` rather than written into each slide,
// so it cannot be forgotten on the next one, and so `show_slides` still builds a
// slide only when it is about to show it.
fun held(mk):
  fun ():
    def p = as_pict(mk())
    if p.duration > 1 | p.sustain() | p

fun staged(base_canvas, stages, ~wire: wire = fun (p, k): p):
  def base = wire(as_pict(base_canvas), 0)
  for values(p = base) (st in stages, k in 1..):
    def extra = wire(pc.overlay(~horiz: #'left, ~vert: #'top, base.ghost(), as_pict(st)), k)
    fade_in(p, extra, ~horiz: #'left, ~vert: #'top)

// The two kinds of edge in the effectful e-graph pictures, in the weights and
// colours Keynote gave them: value edges thin and black, state edges thick and
// in its blue.
def keynote_blue = draw.Color(4, 51, 255)
fun value_edges(p, edges): arrows(~on: p, edges, ~line_width: 4)
fun state_edges(p, edges): arrows(~on: p, edges, ~line_width: 6, ~color: keynote_blue)

