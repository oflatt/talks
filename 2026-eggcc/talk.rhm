                        ~fill: hex("FFFFFF"), ~line: make_stroke(hex("000000"), ~width: 3.0),
                        ~body: body(~anchor: #'center, ~insets: insets(0.0, 0.0, 0.0, 0.0),
                                    para(~align: #'center, run("v", ~size: 40.0),
                                         run("4", ~size: 40.0, ~baseline: -0.06))))

  // the picture before the first reveal
  def base_canvas:
    slide_canvas(
      ~width: slide_width, ~height: slide_height,
      ~background: hex("FFFFFF"),
      at(95.0, 85.0, ~tag: "Redundant Update Elimination",
         textbox(~width: 1730.0, ~height: 112.988, ~autofit: #'shrink,
                 ~insets: insets(4.0, 4.0, 4.0, 4.0),
                 para(~line_spacing: pair(#'percent, 0.8),
                      run("Redundant Update Elimination", ~font: "Helvetica Neue",
                          ~size: 85.0, ~bold: #true, ~spacing: -1.7)))),
      at(1885.0, 1045.0, ~tag: "Slide Number", shape_pict(~width: 29.016, ~height: 29.496)),
      at(1476.341, 50.118, ~tag: "Group",
         group_pict(~width: 327.683, ~height: 182.827,
                    at(0.0, 62.869, ~tag: "Group (2)",
                       group_pict(~width: 106.985, ~height: 66.994,
                                  at(0.0, 0.0, ~tag: "Rectangle",
                                     shape_pict(~width: 106.985, ~height: 66.994,
                                                ~fill: hex("FFFFFF"),
                                                ~line: make_stroke(
                                                         hex("000000"), ~width: 1.0))),
                                  at(4.646, 4.397, ~tag: "Rectangle (2)",
                                     shape_pict(~width: 60.549, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(11.612, 11.976, ~tag: "Rectangle (3)",
                                     shape_pict(~width: 64.295, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(11.612, 19.555, ~tag: "Rectangle (4)",
                                     shape_pict(~width: 79.846, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(19.007, 27.133, ~tag: "Rectangle (5)",
                                     shape_pict(~width: 34.404, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(11.612, 34.712, ~tag: "Rectangle (6)",
                                     shape_pict(~width: 49.795, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(19.007, 42.29, ~tag: "Rectangle (7)",
                                     shape_pict(~width: 56.852, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(11.612, 49.869, ~tag: "Rectangle (8)",
                                     shape_pict(~width: 47.325, ~height: 5.15,
                                                ~fill: hex("929292"))),
                                  at(11.612, 57.447, ~tag: "Rectangle (9)",
                                     shape_pict(~width: 90.727, ~height: 5.15,
                                                ~fill: hex("929292"))))),
                    at(193.792, 0.0, ~tag: "Group (3)",
                       group_pict(~width: 133.891, ~height: 182.827,
                                  at(110.363, 159.299, ~tag: "Rounded Rectangle", n_box1),
                                  at(82.772, 107.433, ~tag: "Rounded Rectangle (2)", n_box2),
                                  at(55.182, 159.299, ~tag: "Rounded Rectangle (3)", n_box3),
                                  at(55.182, 53.717, ~tag: "Rounded Rectangle (4)", n_box4),
                                  at(32.239, 107.433, ~tag: "Rounded Rectangle (5)", n_box5),
                                  at(0.0, 159.299, ~tag: "Rounded Rectangle (6)", n_box6),
                                  at(55.182, 0.0, ~tag: "Rounded Rectangle (7)", n_box7))),
