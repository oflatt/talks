def all_slides = [slide_1, slide_2, slide_3, slide_4, slide_5, slide_6, slide_7, slide_8, slide_9, slide_10, slide_11, slide_12, slide_13, slide_14, slide_15, slide_16, slide_17, slide_18, slide_19, slide_20, slide_21, slide_22, slide_23, slide_24, slide_25, slide_26, slide_27, slide_28, slide_29, slide_30, slide_31, slide_32, slide_33, slide_34, slide_35, slide_36, slide_37, slide_38, slide_39, slide_40]

module main:
  import: lib("glide-pptx/show.rhm") open
  show_slides(all_slides, ~width: slide_width, ~height: slide_height)

// The backup PDF, without opening a window:
//   racket -l racket/base -e '(require (submod (file "talk.rhm") pdf))'
module pdf:
  deck_to_pdf(all_slides, "talk.pdf", ~width: slide_width, ~height: slide_height)
  println("wrote " +& "talk.pdf")
