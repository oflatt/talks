#lang rhombus/and_meta
// The slides that say it works.
//
// Both charts used to be pictures of matplotlib output -- the performance one as
// four PNGs, one per build stage, because a picture cannot grow. They are drawn now:
// see `plots.rhm` for the drawing and `plotdata.rhm` for the numbers, which are read
// out of eggcc's own `profile.json`. What the slides add is the order the data
// arrives in.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "theme.rhm" open
  "plots.rhm" open
  "plotdata.rhm".cdf_series
  "plotdata.rhm".cdf_timeout_secs
  "write.rhm".write
  "write.rhm".writer
  "write.rhm".extent_for
  pict as pc
  draw

export:
  slide_cdf
  slide_perf

// -------------------------------------------------------------------------------------
// How long extraction takes, per e-graph region: ours first, then the two solvers
// together, so the gap between them is watched opening up rather than presented
// already open. Each curve draws itself from the left, which is the extractor
// working through the regions.
fun slide_cdf():
  // the chart named, over it, between the slide's title and the plot: what was
  // measured and on what
  def caption:
    pc.text("Eggcc Extraction Performance on Polybench and Bril Benchmark Suites",
            ~font: draw.Font(~name: prose_font, ~size: 34.0, ~weight: #'bold))
  def page:
    put(titled("Extraction is Fast in Practice", ~tag: "Extraction CDF title", ~nudge: [0.0, 0.0]),
        caption, cdf_x + (cdf_w - caption.width) / 2, cdf_y - 66.0)
  fun scene(ks :~ List, ~sweep: sweep = #false, ~sweep_alpha: sweep_alpha = 1.0) :: pc.Pict:
    pc.overlay(~horiz: #'left, ~vert: #'top, page,
               cdf_chart(~draw: ks, ~sweep: sweep, ~sweep_alpha: sweep_alpha))
  // What the curve means, read off it once ours is up: a grey band sweeps out from
  // the left edge to the millisecond mark with the share of regions inside it
  // counting up beside its edge, and when it gets there the words for that share
  // write themselves. The share and the words ride low on the edge, under the
  // curve, which is up near the top by then.
  def share_face = draw.Font(~name: prose_font, ~size: 48.0, ~weight: #'bold)
  fun share_text(frac :: Real) :: pc.Pict:
    def pct = math.exact(math.round(frac * 100.0))
    pc.text(to_string(pct) +& "%", ~font: share_face).colorize(cdf_dp_color)
  def said = prose_text("finish within 1ms", ~size: 40.0, ~bold: #true, ~color: cdf_dp_color)
  def said_w = writer(said)
  def ride = 0.15                   // the height on the plot the words ride at
  // the sweep takes its time, and then the words take theirs
  def sweep_t = 1.3
  def reading_extent = sweep_t + extent_for(said_w.total)
  def sweep_part = sweep_t / reading_extent
  fun reading(k :: Real, w :: Real, ~alpha: alpha :: Real = 1.0) :: pc.Pict:
    def base = scene([1.0, 0.0, 0.0], ~sweep: k, ~sweep_alpha: alpha)
    def secs = sweep_secs(k)
    def share :~ pc.Pict = share_text(sweep_frac(secs)).alpha(alpha)
    def [ex, ey] = cdf_point(secs, ride)
    def with_share = put(base, share, ex + 18.0, ey - share.height / 2)
    if w <= 0.0
    | with_share
    | put(with_share, said_w.frame(w), ex + 18.0 + share.width + 16.0, ey - said.height / 2)
  fun solvers(t :: Real) :: pc.Pict:
    // the band and the words go as the solvers' curves come, over the first part
    // of the press: they were about ours
    def going = 1.0 - clamp01(t / 0.4)
    def secs = sweep_secs(1.0)
    def [ex, ey] = cdf_point(secs, ride)
    def share :~ pc.Pict = share_text(sweep_frac(secs)).alpha(going)
    def base = scene([1.0, t, t], ~sweep: 1.0, ~sweep_alpha: going)
    put(put(base, share, ex + 18.0, ey - share.height / 2),
        said_w.frame(going), ex + 18.0 + share.width + 16.0, ey - said.height / 2)
  // How many regions the better of the two solvers never finished: the gap its
  // curve leaves under the top, at the wall the clock ran out at. Said in red, on a
  // press of its own once the solvers' curves are up, pointing at the shelf where
  // Gurobi's stops. The numbers are the data's, not typed in.
  def gurobi :~ List = cdf_series[1]
  def gave_up :~ Int = gurobi[2]
  def total :~ Int = gurobi[3]
  def finished = (gurobi[1] :~ List).length() / (1.0 * total)
  def timeouts:
    def [px, py] = cdf_point(cdf_timeout_secs, finished)
    def shelf = pc.blank(~width: 16.0, ~height: 16.0)
    bubble_at(shelf, ~spot: [px - 8.0, py - 8.0], ~body: [1510.0, 360.0], ~color: talk_red,
              ~content: prose_stack([[[to_string(gave_up), #'bold],
                                      [" of " +& total +& " cases", #'plain]],
                                     [["time out", #'bold], [" for Gurobi!", #'plain]]]))
  def full = scene([1.0, 1.0, 1.0])
  // long enough to watch a curve being drawn, which is the point of drawing it
  pc.switch(scene([0.0, 0.0, 0.0]),
            pc.animate(~extent: 1.2, fun (t): scene([t, 0.0, 0.0])),
            pc.animate(~extent: reading_extent, ~bend: fun (x): x,
                       fun (t): reading(smooth(clamp01(t / sweep_part)),
                                        clamp01((t - sweep_part) / (1.0 - sweep_part)))),
            pc.animate(~extent: 1.2, fun (t): solvers(t)),
            pc.overlay(~horiz: #'left, ~vert: #'top, full, write(timeouts)).refocus(full))

// -------------------------------------------------------------------------------------
// And how fast the code it picks runs. A series a press: ours grows out of the
// baseline, unoptimized LLVM is tethered to each of our points so the gap is what is
// read, and last the row of crosses for the extractions that never came back.
//
// The green box is Keynote's, kept: it is the sentence the chart is evidence for.
fun slide_perf():
  def page = titled("Fast Effect-safe Extraction in Practice",
                    ~tag: "Perf chart title", ~nudge: [0.0, 0.0])
  fun scene(ours :: Real, llvm :: Real, solver :: Real) :: pc.Pict:
    pc.overlay(~horiz: #'left, ~vert: #'top, page,
               perf_chart(~ours: ours, ~llvm: llvm, ~solver: solver))
  def verdict:
    def bubble :~ pc.Pict:
      make_bubble(~color: talk_green,
                  pc.stack(~horiz: #'center,
                           prose_text("Non-trivial", ~size: 75.0, ~bold: #true),
                           prose_text("e-graphs!", ~size: 75.0, ~bold: #true)))
    // in the plot's own empty quarter: under the row of crosses and over the run of
    // benchmarks where neither compiler has anything to show
    put(blank_slide, bubble, 620.0 - bubble.width / 2, 440.0 - bubble.height / 2)
  def full = scene(1.0, 1.0, 1.0)
  // How to read our series, said on the press after it: the first dot is a program
  // that runs as fast as LLVM's best, the last one six times slower. Both bubbles
  // point at their dots from above, and they go as the next series comes -- they
  // were about ours, and where they sit is where its squares land.
  fun dot_at(i :: Int) :: List:
    def [x, y] = perf_point(i)
    [x - 8.0, y - 8.0]
  def dot = pc.blank(~width: 16.0, ~height: 16.0)
  def first_note:
    bubble_at(dot, ~spot: dot_at(0), ~body: [400.0, 640.0], ~color: talk_green,
              ~content: prose([["matching LLVM O3", #'bold]]))
  def last_note:
    bubble_at(dot, ~spot: dot_at(perf_last()), ~body: [960.0, 400.0], ~color: talk_green,
              ~content: prose([["6x slower than LLVM O3", #'bold]]))
  // a press each, and both go together
  def first_w = writer(first_note)
  def last_w = writer(last_note)
  fun noted(base :: pc.Pict, k1 :: Real, k2 :: Real) :: pc.Pict:
    put(put(base, first_w.frame(k1), 0.0, 0.0), last_w.frame(k2), 0.0, 0.0)
  // The verdict writes itself over the finished chart on the press after the last
  // series. Not `fade_in`, whose first epoch is the picture it starts from: that
  // picture is the one the series press has just ended on, and a press that shows it
  // again is a press that does nothing.
  pc.switch(scene(0.0, 0.0, 0.0),
            pc.animate(~extent: 1.8, fun (t): scene(t, 0.0, 0.0)),
            pc.animate(~extent: extent_for(first_w.total), ~bend: fun (x): x,
                       fun (t): noted(scene(1.0, 0.0, 0.0), t, 0.0)),
            pc.animate(~extent: extent_for(last_w.total), ~bend: fun (x): x,
                       fun (t): noted(scene(1.0, 0.0, 0.0), 1.0, t)),
            pc.animate(~extent: 1.8,
                       fun (t): noted(scene(1.0, t, 0.0), 1.0 - clamp01(t / 0.35),
                                      1.0 - clamp01(t / 0.35))),
            pc.animate(~extent: 1.8, fun (t): scene(1.0, 1.0, t)),
            pc.overlay(~horiz: #'left, ~vert: #'top, full, write(verdict)).refocus(full))
