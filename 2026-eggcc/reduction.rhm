#lang rhombus/and_meta
// Effect-safe extraction is NP-hard, by a reduction from CNF-SAT: the one slide
// that says why the rest of the section is needed at all.

import:
  lib("glide-pptx/runtime.rhm") open
  "slidehelpers.rhm" open
  "magicmove.rhm" open
  "theme.rhm" open
  "egraph.rhm" open
  pict as pc
  draw

export:
  slide_nphard

// -------------------------------------------------------------------------------------
// slide_nphard: effect-safe extraction is NP-hard, by a reduction from CNF-SAT.
//
// This is Figure 5 of the paper, drawn in the deck's own hand. It came over from
// `np-hard.key` as three dozen empty rounded rectangles with the arrowheads landing
// in the middle of them -- every label in that deck is a Keynote *equation*, and
// equations do not port -- so rather than repair the dump, the picture is rebuilt
// here from the formula it encodes, in the vocabulary the rest of the talk uses:
// `ω` for a state, blue for everything that carries one, a grey tube round an
// e-class, and arrows that stop at a border and point at what a node is built from.
//
// The encoding, from Section 5 of the paper:
//
//   ω        the incoming state.
//   xᵢ, ¬xᵢ  effectful operators: they take a state and return a value and a state.
//            The two of them are the two ways to assign xᵢ.
//   ωᵢ       the state each of those leaves behind. The two of them are *equal*, so
//            a walk down the chain takes one assignment per variable and the state
//            it ends at cannot tell which -- but it cannot mix them either.
//   gᵢ       one pure term per literal of clause i, reading the operator that makes
//            that literal true. All the literals of a clause are one e-class, so an
//            extraction takes exactly one of them.
//   R        the root: one term out of every clause class, and the final state.
//
// So a term out of R is effect-safe exactly when the literals it picks read one
// consistent chain of assignments -- which is exactly when the formula is satisfiable.
//
// It is built from the formula rather than drawn, so the picture cannot disagree
// with the words: change `np_clauses` and the chain, the clause classes, their
// edges, the rows they sit on and the extraction at the end all follow.
//
//   ϕ = ¬x₀ ∧ (¬x₁ ∨ x₀) ∧ (x₂ ∨ x₁ ∨ ¬x₂)
//
// A literal is [variable, is it negated]; a clause is a list of them.
def np_vars = 3
def np_clauses:
  [[[0, #true]],
   [[1, #true], [0, #false]],
   [[2, #false], [1, #false], [2, #true]]]

// The assignment the last press extracts: one truth value per variable.
def np_witness = [#false, #false, #true]

def np_sub = ["₀", "₁", "₂", "₃", "₄"]
fun np_lit_name(lit :~ List) :: String:
  (if lit[1] | "¬x" | "x") +& np_sub[lit[0] :~ Int]

// Which of a variable's two operators a literal reads: the left one asserts it,
// the right one denies it.
fun np_lit_side(lit :~ List) :: Int: if lit[1] | 1 | 0

// A clause's literals, left to right, highest target first: an edge that leaves a
// node sideways has to clear its own neighbours, and ordering them this way is what
// lets every one of them leave over the top of the ones beside it.
fun np_lit_rank(lit :~ List) :: Int: (lit[0] :~ Int) * 2 + np_lit_side(lit)
def np_members:
  for List (clause :~ List in np_clauses):
    clause.sort(fun (a :~ List, b :~ List): np_lit_rank(a) < np_lit_rank(b))

// ------------------------------------------------------------------ the picture
// The chain of assignments runs down the right, a variable to a rung: the two
// operators that assign it, and the class of the state either one leaves. The
// clause classes stand to the left, each on the first row below every operator it
// reads, and the root is below all of them.
def np_h = 64.0                  // every node, as tall as the deck's
def np_pitch = 92.0
def np_top = 235.0
fun np_y(row :: Int) :: Real: np_top + row * np_pitch
def np_mid = 1520.0
def np_op_w = 128.0              // an operator, which has a literal written in it
def np_op_dx = 160.0
def np_st_w = 64.0               // a state
def np_st_dx = 48.0
def np_arg_w = 96.0
def np_root_w = 76.0
def np_g_w = 64.0
def np_g_pitch = 150.0           // wide enough that a member's edge clears the next
def np_g_right = 1040.0           // where the first clause's last member sits
def np_g_step = 60.0             // and how much further right each longer one reaches
// The root hangs below the last row rather than on it, so that its arrows up to the
// clause classes are not flat and its arrow up to the last state is not a stub.
def np_root_x = np_mid - 60.0   // clear of the state column, so its arrows up to
                                // the clause classes leave from beside it, not behind it
def np_root_y = np_y(2 * np_vars) + 200.0

// A clause sits on row 2c+2 at the earliest -- below every operator it reads, and
// below the clause before it, so the root can see all three of them at once.
def np_clause_row:
  for List (clause :~ List in np_members, c in 0..):
    for values(m = 2 * c + 2) (lit :~ List in clause):
      math.max(m, 2 * (lit[0] :~ Int) + 2)

// Where each thing in the picture sits, before any of it is drawn: the edges have
// to be worked out from these, and one of them decides where a whole row goes.
fun np_op_middle(lit :~ List) :: List:
  def v = lit[0] :~ Int
  [np_mid + (if np_lit_side(lit) == 0 | 0.0 - np_op_dx | np_op_dx), np_y(2 * v + 1) + np_h / 2]
fun np_g_x(c :: Int, k :: Int) :: Real:
  def last = ((np_members :~ List)[c] :~ List).length() - 1
  np_g_right + c * np_g_step - (last - k) * np_g_pitch

// A clause hangs a little *below* the row it is allowed on. Its members sit side by
// side and every one of them but the last has to send an edge out over the ones to
// its right; the further the row is below what it reads, the steeper that edge
// leaves, and this is the smallest drop that gets all of them over the top of their
// neighbours. Left to itself a clause takes no drop at all -- which is what keeps
// the last member's edge from sinking into the row above on its way out.
def np_clear = 8.0               // and how much daylight to leave over a neighbour
def np_clause_drop:
  for List (clause :~ List in np_members, c in 0..):
    def base = np_y((np_clause_row :~ List)[c]) + np_h / 2
    def want:
      for values(m :~ Real = base) (lit :~ List in clause, k in 0..):
        skip_when k == clause.length() - 1
        def [tx, ty] = np_op_middle(lit)
        math.max(m, ty + (np_h / 2 + np_clear) * (tx - np_g_x(c, k))
                           / (np_g_pitch - np_g_w / 2))
    want - base
fun np_clause_y(c :: Int) :: Real:
  np_y((np_clause_row :~ List)[c]) + (np_clause_drop :~ List)[c]

// A clause colour is not one the deck already spends on something else: green is
// what a state equivalence is drawn in, and blue is what carries a state.
def np_colors = ["C7006A", "BF8200", "6A2FA0"]
def np_dashes: [draw.Color(199, 0, 106), draw.Color(191, 130, 0), draw.Color(106, 47, 160)]

//   [key, what is written in it, its colour, its width, x, y]
def np_nodes:
  [[[#'arg], "ω", stateful_hex, np_arg_w, np_mid - np_arg_w / 2, np_y(0)]]
    ++ List.append(
         & for List (v in 0..np_vars):
             [[[#'op, v, 0], "x" +& np_sub[v], stateful_hex, np_op_w,
               np_mid - np_op_dx - np_op_w / 2, np_y(2 * v + 1)],
              [[#'op, v, 1], "¬x" +& np_sub[v], stateful_hex, np_op_w,
               np_mid + np_op_dx - np_op_w / 2, np_y(2 * v + 1)],
              [[#'st, v, 0], "ω" +& np_sub[v + 1], stateful_hex, np_st_w,
               np_mid - np_st_dx - np_st_w / 2, np_y(2 * v + 2)],
              [[#'st, v, 1], "ω" +& np_sub[v + 1], stateful_hex, np_st_w,
               np_mid + np_st_dx - np_st_w / 2, np_y(2 * v + 2)]])
    ++ List.append(
         & for List (clause :~ List in np_members, c in 0..):
             for List (k in 0..clause.length()):
               [[#'g, c, k], "g" +& np_sub[c + 1], np_colors[c], np_g_w,
                np_g_x(c, k) - np_g_w / 2, np_clause_y(c)])
    ++ [[[#'root], "R", stateful_hex, np_root_w, np_root_x - np_root_w / 2, np_root_y]]

def np_at:
  for values(m :~ Map = {}) ([key, _, _, w, x, y] in np_nodes): m ++ { key: [x, y, w] }
fun np_middle(key) :: List:
  def [x, y, w] = np_at[key]
  [x + (w :~ Real) / 2, y + np_h / 2]

// The state the extraction settles on for each variable, and the member of each
// clause class that assignment makes true.
fun np_pick_side(v :: Int) :: Int: if (np_witness :~ List)[v] | 0 | 1
fun np_pick_member(clause :~ List) :: Int:
  for values(found = -1) (lit :~ List in clause, k in 0..):
    cond
    | found >= 0: found
    | (np_witness :~ List)[lit[0] :~ Int] != lit[1]: k
    | ~else: found

//   [what kind of edge, from, to] -- `#'state` for the ones a memory passes along,
// and otherwise the clause the edge belongs to, which is what colours it.
// `~picked` re-aims the root at the members an extraction actually takes.
fun np_edge_list(~picked: picked :: Boolean) :: List:
  def last_state = [#'st, np_vars - 1, np_pick_side(np_vars - 1)]
  List.append(
    & for List (v in 0..np_vars):
        List.append(
          & for List (side in 0..2):
              [[#'state, [#'op, v, side], (if v == 0 | [#'arg] | [#'st, v - 1, side])],
               [#'state, [#'st, v, side], [#'op, v, side]]]))
    ++ List.append(
         & for List (clause :~ List in np_members, c in 0..):
             for List (lit :~ List in clause, k in 0..):
               [c, [#'g, c, k], [#'op, lit[0], np_lit_side(lit)]])
    ++ [[#'state, [#'root], last_state]]
    ++ (for List (clause :~ List in np_members, c in 0..):
          def k:
            if picked | np_pick_member(clause) | clause.length() - 1
          [#'root, [#'root], [#'g, c, k]])

// Everything the extraction takes: one operator and one state per variable, one
// term out of each clause class, and the root.
def np_picked_keys:
  [[#'arg]]
    ++ List.append(
         & for List (v in 0..np_vars):
             [[#'op, v, np_pick_side(v)], [#'st, v, np_pick_side(v)]])
    ++ (for List (clause :~ List in np_members, c in 0..):
          [#'g, c, np_pick_member(clause)])
    ++ [[#'root]]

// The slide. The formula, then what the proof is going to do with it, then the
// chain of assignments, a clause class at a time, the root, and last the thing the
// whole picture is for: an effect-safe extraction is a satisfying assignment.
fun slide_nphard():
  def page = with_icon(titled("Effect-Safe Extraction is NP-Hard"))
  // A label, and a node with one in the middle of it.
  //
  // The box is drawn empty and the label laid over it as a pict, rather than handed
  // to the runtime as the box's body: the formula is set in this same face at this
  // same size, so a literal that flies out of the line and a label sitting in a box
  // are the *same glyphs*, and a literal arriving is a recolour on the spot rather
  // than one word being swapped for another.
  def np_label_size = 40.0
  fun np_label(text :: String) :: pc.Pict:
    pc.text(text, ~font: draw.Font(~name: node_font, ~size: np_label_size))
  // every node in its two drawings, plain and picked, each built once
  fun np_pict(color :: String, w :: Real, text :: String, ~fill: fill :: String):
    pc.overlay(as_pict(graph_node(~width: w, ~height: np_h, ~adj: "33878",
                                  ~line: color,
                                  ~line_width: if color == stateful_hex | 4.0 | 3.0,
                                  ~fill: fill)),
               np_label(text))
  fun np_drawings(~fill: fill :: String) :: Map:
    for values(m :~ Map = {}) ([key, text, color, w, _, _] in np_nodes):
      m ++ { key: np_pict(color, w, text, ~fill: fill) }
  def np_plain = np_drawings(~fill: node_white)
  def np_green = np_drawings(~fill: node_green)
  fun np_spots(keys :~ List, ~picked: picked :~ List = []) :: Map:
    for values(m :~ Map = {}) ([key, _, _, _, x, y] in np_nodes):
      skip_when !keys.contains(key)
      m ++ { key: [(if picked.contains(key) | np_green | np_plain)[key], x, y] }

  // which keys are on the slide after each press
  fun np_kind_keys(kinds :~ List) :: List:
    for List ([key, _, _, _, _, _] in np_nodes):
      keep_when kinds.contains((key :~ List)[0])
      key
  def np_chain_keys = np_kind_keys([#'arg, #'op, #'st])
  fun np_clause_keys(upto :: Int) :: List:
    for List ([key, _, _, _, _, _] in np_nodes):
      keep_when (key :~ List)[0] == #'g && (key :~ List)[1] < upto
      key
  // an edge is drawn once both of its ends are up
  fun np_wires(keys :~ List, ~picked: picked :: Boolean = #false) :: List:
    for List (e :~ List in np_edge_list(~picked: picked)):
      keep_when keys.contains(e[1]) && keys.contains(e[2])
      e

  // The classes: the two states a variable's two operators leave are one class, and
  // a clause is a class of its literals. A one-literal clause is a class too, and
  // comes out as a blob round the single node.
  //
  // Built once and picked from, not rebuilt per press: a region rebuilt for each
  // frame is a new pict every time, and a new pict fades in over the old one
  // instead of staying where it is.
  fun np_tube(a, b, ~dash: dash) :: List:
    eclass_region(np_middle(a), np_middle(b), ~dash: dash) ++ [band_below]
  def np_state_classes:
    for values(m :~ Map = {}) (v in 0..np_vars):
      m ++ { [#'cls, #'st, v]: np_tube([#'st, v, 0], [#'st, v, 1], ~dash: state_class) }
  def np_class_picts:
    for values(m :~ Map = {}) (clause :~ List in np_members, c in 0..):
      m ++ { [#'cls, #'g, c]: np_tube([#'g, c, 0], [#'g, c, clause.length() - 1],
                                      ~dash: np_dashes[c]) }
  fun np_clause_classes(upto :: Int) :: Map:
    for values(m :~ Map = {}) (c in 0..np_clauses.length()):
      skip_when c >= upto
      m ++ { [#'cls, #'g, c]: (np_class_picts :~ Map)[[#'cls, #'g, c]] }

  // ------------------------------------------------------------------- the formula
  // Set in pieces rather than as one string, because the pieces are what fly out.
  // Each literal is tagged with the operator it becomes and each clause with the
  // e-class it becomes; a copy of a piece is laid exactly over the words it was
  // copied from -- so it starts invisible against them -- and the next frame puts
  // that key somewhere else, which makes the press a move rather than a fade. It is
  // the trick the rules are applied with; see `chain_rule_pieces`.
  //
  //   [the clause it belongs to, what it becomes, the pict]
  fun np_math_text(s :: String) :: pc.Pict: np_label(s)
  fun np_tint(s :: String, c :: Int) :: pc.Pict: np_math_text(s).colorize(np_dashes[c])
  def np_formula_segs:
    [[#false, #false, np_math_text("ϕ = ")]]
      ++ List.append(
           & for List (clause :~ List in np_clauses, c in 0..):
               def brackets = clause.length() > 1
               (if c == 0 | [] | [[#false, #false, np_math_text(" ∧ ")]])
                 ++ (if brackets | [[c, #false, np_tint("(", c)]] | [])
                 ++ List.append(
                      & for List (lit :~ List in clause, k in 0..):
                          (if k == 0 | [] | [[c, #false, np_tint(" ∨ ", c)]])
                            ++ [[c, [#'op, lit[0] :~ Int, np_lit_side(lit)],
                                 np_tint(np_lit_name(lit), c)]])
                 ++ (if brackets | [[c, #false, np_tint(")", c)]] | []))
  def np_line:
    pc.beside(~vert: #'bottom, & for List ([_, _, p] in np_formula_segs): p)
  def np_formula_x = 95.0
  def np_formula_y = 240.0
  // under everything, so that a copy on its way out of the line is never behind it
  def np_formula = { #'formula: [np_line, np_formula_x, np_formula_y, band_rule] }
  // how far along the line each piece starts, and so where it is on the slide
  def np_seg_dx:
    def values(out, _):
      for values(acc :~ List = [], dx :~ Real = 0.0) ([_, _, p] in np_formula_segs):
        values(acc ++ [dx], dx + (p :~ pc.Pict).width)
    out
  fun np_seg_at(i :: Int, p :: pc.Pict) :: List:
    [np_formula_x + ((np_seg_dx :~ List)[i] :~ Real),
     np_formula_y + np_line.height - p.height]

  // Each literal, copied and keyed by the operator it becomes. Laundered and built
  // once: the same pict has to be under the key in both frames for the press to be
  // a move, and the same pict drawn twice is one the edge finder cannot tell apart.
  // A literal the formula never mentions has no copy, and its operator simply
  // arrives with the rest of the chain.
  def np_lit_home:
    for values(m :~ Map = {}) ([_, tag, p] in np_formula_segs, i in 0..):
      skip_when tag == #false || m.has_key(tag)
      m ++ { tag: [(p :~ pc.Pict).launder()] ++ np_seg_at(i, p) }
  // Each of them padded out to the size of the box it is going to land in, and built
  // once. A press draws the two picts of a key at one *top left corner*, so a word
  // and the box arriving over it line up only if they are the same size; padded, the
  // word sits in the middle of a box-shaped nothing and the box comes down exactly
  // around it. Unpadded, the label ends up half a box to one side of the word it is
  // replacing, which is the tell that something was swapped rather than settled.
  def np_lit_pads:
    for values(m :~ Map = {}) (key in (np_lit_home :~ Map).keys()):
      def [p, x, y] = (np_lit_home :~ Map)[key]
      def word :~ pc.Pict = p
      def node :~ pc.Pict = as_pict(np_plain[key])
      def pad = pc.overlay(pc.blank(~width: node.width, ~height: node.height), word)
      m ++ { key: [pad,
                   x - (pad.width - word.width) / 2,
                   y - (pad.height - word.height) / 2] }
  def np_lit_words:
    for values(m :~ Map = {}) (key in (np_lit_pads :~ Map).keys()):
      def [p, x, y] = (np_lit_pads :~ Map)[key]
      m ++ { key: [p, x, y, band_flight + 1] }
  def np_lit_flown:
    for values(m :~ Map = {}) (key in (np_lit_pads :~ Map).keys()):
      def [p, _, _] = (np_lit_pads :~ Map)[key]
      def [x, y, _] = np_at[key]
      m ++ { key: [p, x, y, band_flight + 1] }
  // and the same words again, carried over to where their operators go.
  //
  // They travel *first* and turn into boxes when they get there, rather than turning
  // into boxes where they stand and travelling after. A box grown over the line
  // covers the very words it is about -- the formula reads as half deleted for a
  // press, which is the one thing this slide cannot afford, since every later press
  // points back at it. Moving first leaves the line whole: what flies is a copy, so
  // the reader keeps the formula and watches a second set of the same words go and
  // find their places. Nothing disappears anywhere; the only thing that changes in
  // place is a word settling into the box that has arrived around it.

  // Each clause, copied whole and keyed by the e-class it becomes. The copy is
  // padded out to the class's own size so that the two share a top left corner:
  // a press interpolates one position for a key, and the padding is what puts the
  // words in the middle of the region they turn into rather than at its corner.
  def np_clause_home:
    def spans:
      for values(m :~ Map = {}) ([c, _, _] in np_formula_segs, i in 0..):
        skip_when c == #false
        m ++ { c: (if m.has_key(c) | (m[c] :~ List) ++ [i] | [i]) }
    for values(m :~ Map = {}) (c in 0..np_clauses.length()):
      def idx :~ List = (spans :~ Map)[c]
      def words:
        pc.beside(~vert: #'bottom,
                  & for List (i in idx): ((np_formula_segs[i] :~ List)[2] :~ pc.Pict))
          .launder()
      def region :~ pc.Pict = as_pict(((np_class_picts :~ Map)[[#'cls, #'g, c]] :~ List)[0])
      def padded:
        pc.overlay(pc.blank(~width: region.width, ~height: region.height), words)
      def [x, y] = np_seg_at(idx[0], words)
      m ++ { [#'cls, #'g, c]: [padded,
                               x - (padded.width - words.width) / 2,
                               y - (padded.height - words.height) / 2,
                               band_flight] }
  fun np_clause_words(flown :: Int) :: Map:
    for values(m :~ Map = {}) (c in 0..np_clauses.length()):
      skip_when c < flown
      m ++ { [#'cls, #'g, c]: (np_clause_home :~ Map)[[#'cls, #'g, c]] }

  // At the end, the assignment the extraction spells out, said where the formula
  // can still be read above it.
  def np_answer:
    def head = pc.text("Satisfying assignment:",
                       ~font: draw.Font(~name: prose_font, ~size: 38.0, ~weight: #'bold))
    // on one line rather than three: what is under it is the last word of the
    // section, and the assignment has already been read off the picture by then
    def body:
      pc.stack(~sep: 14.0, ~horiz: #'left, head,
               np_math_text(
                 for values(t = "") (v in 0..np_vars):
                   t +& (if v == 0 | "" | "     ") +& "x" +& np_sub[v] +& " = "
                     +& (if (np_witness :~ List)[v] | "⊤" | "⊥")))
    { #'answer: [body, 95.0, 420.0, band_callout] }

  // The two things to say once the picture has been read: that the problem the
  // slide just proved hard is the problem this talk is about, and that being hard
  // in general is not the same as being hard in practice. They are notes rather
  // than callouts -- neither of them is about any one node -- so they get the
  // bubble without the spike, stacked in the column the formula started in.
  fun np_note(key, ~at: at :~ List, ~color: color, ~rows: rows :: List) :: Map:
    { key: [make_bubble(~color: color, prose_stack(rows)), at[0], at[1], band_callout] }
  def np_give_up:
    { #'giveup: [make_bubble(~color: talk_red,
                             robot_says(#'puzzled,
                                        prose_stack([[["Problem is NP-hard!", #'bold]],
                                                     [["Give up??", #'bold]]]),
                                        ~sep: 14.0, ~scale: 0.8)),
                 95.0, 420.0, band_callout] }
  def np_no:
    np_note(#'no, ~at: [95.0, 640.0], ~color: talk_green,
            ~rows: [[["No! Real-world e-graphs", #'bold]],
                    [["are easier, measured", #'bold]],
                    [["with a ", #'bold], ["parameter", #'bold_italic]]])
  // and the parameter, named, with the bound it buys: Section 6 of the paper --
  // STATEWALK DP is fixed-parameter tractable in the statewalk width, O(k n²) for
  // an e-graph of size n, against the O(n²) of the greedy algorithm for pure
  // e-graphs. The measured mean width across the benchmarks is 33.15.
  def np_width:
    np_note(#'width, ~at: [95.0, 890.0], ~color: talk_green,
            ~rows: [[["statewalk width", #'bold_italic],
                     [" is low in practice!", #'bold]],
                    [["Complexity is ", #'bold], ["O(kn²)", #'bold_italic]]])

  fun np_callout(key, target, ~body: body :~ List, ~color: color,
                 ~content: content :: pc.Pict) :: Map:
    def [x, y, _] = np_at[target]
    { key: [bubble_at(np_plain[target], ~spot: [x, y], ~body: body,
                      ~color: color, ~content: content),
            0.0, 0.0, band_callout] }
  def np_says_assign:
    np_callout(#'says, [#'op, np_vars - 1, 0], ~body: [700.0, 700.0], ~color: talk_blue,
               ~content: prose_stack([[["state walks encode", #'bold]],
                                      [["assignments", #'bold]]]))
  def np_says_clause:
    np_callout(#'says, [#'g, np_clauses.length() - 1, 0], ~body: [170.0, 900.0],
               ~color: talk_blue,
               ~content: prose_stack([[["e-classes encode", #'bold]],
                                      [["clauses", #'bold]]]))

  // What each press has on it. The chain arrives in two movements -- the words turn
  // into boxes where they stand, and then those boxes travel -- because one press
  // that is both a morph and a journey is one the audience has to read twice. A
  // clause arrives in one: its words become the e-class, and the terms in the class
  // come up inside it.
  fun frame(~chain: chain :: Int = 0,       // 0 in the line, 1 in place, 2 in boxes
            ~clauses: clauses :: Int = 0,   // how many clause classes have flown
            ~root: root :: Boolean = #false,
            ~picked: picked :: Boolean = #false,
            ~over: over :~ Map = {}) :: Frame:
    def keys:
      (if chain == 2 | np_chain_keys | [])
        ++ np_clause_keys(clauses) ++ (if root | [[#'root]] | [])
    Frame(~picts: np_spots(keys, ~picked: if picked | np_picked_keys | [])
                    ++ np_formula
                    ++ (cond
                        | chain == 0: np_lit_words
                        | chain == 1: np_lit_flown
                        | ~else: {})
                    ++ (if chain == 2 | np_state_classes | {})
                    ++ np_clause_classes(clauses) ++ np_clause_words(clauses)
                    ++ over,
          ~edges: np_wires(keys, ~picked: picked))
  magic_slide(
    page,
    [// the formula
     frame(),
     // a copy of each literal leaves the line and goes to where its operator belongs
     frame(~chain: 1),
     // and there it becomes that operator: a box arrives around the word, one thread
     // of state runs through all of them, and the state after either assignment of a
     // variable is the same state
     frame(~chain: 2, ~over: np_says_assign),
     // then a clause at a time -- the words become the class, and the one term per
     // literal comes up inside it, each reading the operator that makes it true
     frame(~chain: 2, ~clauses: 1),
     frame(~chain: 2, ~clauses: 2),
     frame(~chain: 2, ~clauses: 3, ~over: np_says_clause),
     // and the root, which takes one term out of every clause class
     frame(~chain: 2, ~clauses: 3, ~root: #true),
     // what the picture is for: the extraction is the satisfying assignment
     frame(~chain: 2, ~clauses: 3, ~root: #true, ~picked: #true, ~over: np_answer),
     // and so the problem this talk is about is NP-hard, which is a fact about the
     // worst case and not about any e-graph a compiler has ever built
     frame(~chain: 2, ~clauses: 3, ~root: #true, ~picked: #true,
           ~over: np_give_up),
     frame(~chain: 2, ~clauses: 3, ~root: #true, ~picked: #true,
           ~over: np_give_up ++ np_no),
     // and the parameter that makes it tractable in practice, which is what the
     // next section is about
     frame(~chain: 2, ~clauses: 3, ~root: #true, ~picked: #true,
           ~over: np_give_up ++ np_no ++ np_width)],
    ~wire: np_wire_specs, ~edge_band: band_wires)

// The reduction's own edges. A state edge is thick and blue, like every other edge
// in this deck that a memory passes along; a clause's edges are thin and in the
// clause's own colour, since what they say is which operator that literal needs.
fun np_wire_specs(layer :: pc.Pict, es :~ List, at :~ Map) :: pc.Pict:
  for values(q :~ pc.Pict = layer) (e :~ List in es):
    cond
    | e[0] == #'state:
        arrow(~on: q, at[e[1]], at[e[2]], ~color: keynote_blue, ~line_width: 6, ~gap: 4)
    | e[0] == #'root:
        arrow(~on: q, at[e[1]], at[e[2]], ~color: "black", ~line_width: 4, ~gap: 4)
    | ~else:
        arrow(~on: q, at[e[1]], at[e[2]], ~color: np_dashes[e[0] :~ Int],
              ~line_width: 3, ~gap: 4)
