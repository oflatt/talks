def all_slides = [slide_1, slide_2, slide_3, slide_4, slide_5, slide_6, slide_7, slide_8, slide_9, slide_10, slide_11]

module main:
  import: lib("glide-pptx/show.rhm") open
  show_slides(all_slides, ~width: slide_width, ~height: slide_height)

// The backup PDF, without opening a window:
//   racket -l racket/base -e '(require (submod (file "np-hard.rhm") pdf))'
module pdf:
  deck_to_pdf(all_slides, "np-hard.pdf", ~width: slide_width, ~height: slide_height)
  println("wrote " +& "np-hard.pdf")
