def slide_width = 1920.0
def slide_height = 1080.0

// The theme font. Runs that name no typeface use this one, so restyling
// the whole deck is one edit.
current_default_font("Helvetica Neue")

// The typefaces this deck is set in. A font file in `fonts` beside this
// program is loaded from there; anything else has to be installed.
//
// Add a stand-in to any of these to accept a metric-compatible clone --
//   ["Helvetica Neue", "Nimbus Sans"]
// -- which is checked by measuring, since a font reports the face that was
// asked for and not the one that was drawn.
register_fonts("fonts")
check_fonts(
  ["Helvetica Neue", "Nimbus Sans"],
  ["PT Mono"],
  ["Times New Roman", "Tinos"]
)

// Images sit next to this file, so the program travels as a folder.
def media = media_lookup("media")

