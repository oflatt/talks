#lang rhombus/static
import:
  pict open

export:
  wiggle

fun wiggle(p :: Pict) :: Pict:
  animate(
    fun (n):
      let q = p.rotate(1/10 * math.sin(n * 2 * math.pi))
      overlay(p.ghost(), q.launder()).refocus(p),
  )

module main:
  import:
    slideshow open
  // Two ways to view `wiggle` effect by itself:
  explain_anim(wiggle(text("hello")).sustain(),
               ~steps: 8,
               ~end: 1)
  slide(wiggle(text("hello").scale(10)).sustain())

module code:
  import:
    pict/rhombus open

  export:
    wiggle_code

  def wiggle_code:
    rhombusblock(
      fun wiggle(p :: Pict) :: Pict:
        animate(
          fun (n :: Real.in(0, 1)):
            let q = p.rotate(1/10 * math.sin(n * 2 * math.pi))
            overlay(p.ghost(), q.launder()).refocus(p),
        )
    )
